<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
        xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="620"
        Width="820"
        Height="620"
        x:Class="UiharuMind.Shared.Windows.TextFileWindow"
        Title="TextFileWindow">

    <!-- 顶栏只有一行：左边标题（可拖动，未保存时跟一个点），右边工具按钮、「更多」与关闭。
         从前标题栏下面还压着一行「文件 / 编辑 / 视图」菜单栏，两层叠着又笨又旧；
         菜单项收进「更多」，快捷键照旧（Ctrl+N / O / S / F 在 OnKeyDown 里接，撤回重做归编辑器自己） -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <DockPanel Height="36" Margin="0,0,0,6" Background="Transparent"
                   PointerPressed="InputElement_OnPointerPressed">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <ThemedIconButton Width="28" Height="28" IconWidth="16" IconHeight="16" Focusable="False"
                                  IconName="copy" ToolTip.Tip="{loc:Loc LongTextCopyAll}"
                                  Click="CopyButton_Click" />
                <ThemedIconToggleButton Name="WordWrapButton" Width="28" Height="28" IconWidth="16" IconHeight="16"
                                        Focusable="False"
                                        IconName="text-wrap"
                                        ToolTip.Tip="{loc:Loc LongTextWordWrap}"
                                        CheckedForeground="{DynamicResource SemiBlue5}"
                                        Click="WordWrapButton_Click" />
                <ThemedIconButton Width="28" Height="28" IconWidth="16" IconHeight="16" Focusable="False"
                                  IconName="search" ToolTip.Tip="{loc:Loc LongTextSearch}"
                                  Click="SearchButton_Click" />
                <ThemedIconToggleButton Name="PreviewButton" Width="28" Height="28" IconWidth="16" IconHeight="16"
                                        Focusable="False"
                                        IconName="eye"
                                        ToolTip.Tip="{loc:Loc TextFileMenuPreview}"
                                        CheckedForeground="{DynamicResource SemiBlue5}"
                                        Click="PreviewButton_Click" />
                <ThemedIconButton Width="28" Height="28" IconWidth="16" IconHeight="16" Focusable="False"
                                  IconName="ellipsis" ToolTip.Tip="{loc:Loc MoreActions}">
                    <ThemedIconButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="MoreMenu_Opening">
                            <MenuItem Name="NewMenuItem" Header="{loc:Loc TextFileMenuNew}"
                                      InputGesture="Ctrl+N" Click="NewMenuItem_Click" />
                            <MenuItem Name="OpenMenuItem" Header="{loc:Loc TextFileMenuOpen}"
                                      InputGesture="Ctrl+O" Click="OpenMenuItem_Click" />
                            <MenuItem Name="RecentMenuItem" Header="{loc:Loc TextFileMenuRecent}" />
                            <Separator />
                            <MenuItem Name="SaveMenuItem" Header="{loc:Loc TextFileMenuSave}"
                                      InputGesture="Ctrl+S" IsEnabled="False" Click="SaveMenuItem_Click" />
                            <MenuItem Name="SaveAsMenuItem" Header="{loc:Loc TextFileMenuSaveAs}"
                                      Click="SaveAsMenuItem_Click" />
                            <Separator />
                            <MenuItem Name="UndoMenuItem" Header="{loc:Loc TextFileMenuUndo}" Click="UndoMenuItem_Click" />
                            <MenuItem Name="RedoMenuItem" Header="{loc:Loc TextFileMenuRedo}" Click="RedoMenuItem_Click" />
                            <Separator />
                            <MenuItem Name="LineNumbersMenuItem" Header="{loc:Loc TextFileMenuLineNumbers}"
                                      ToggleType="CheckBox" Click="LineNumbersMenuItem_Click" />
                            <MenuItem Name="SyntaxMenuItem" Header="{loc:Loc TextFileMenuSyntaxHighlight}"
                                      ToggleType="CheckBox" IsChecked="True" Click="SyntaxMenuItem_Click" />
                        </MenuFlyout>
                    </ThemedIconButton.Flyout>
                </ThemedIconButton>
                <ThemedIconButton Classes="WindowCloseButton" IconName="x" Margin="6,0,0,0"
                                  Click="CloseButton_Click" />
            </StackPanel>
            <!-- 未保存的点做成同一个 TextBlock 里的 Run：跟在文件名后面，长文件名照样省略号截断 -->
            <TextBlock Name="TitleTextBlock" FontSize="15" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis">
                <Run Name="TitleRun" />
                <Run Name="DirtyRun" FontSize="12" Foreground="{DynamicResource SemiBlue5}" />
            </TextBlock>
        </DockPanel>

        <DockPanel Grid.Row="1">
            <!-- 磁盘上的文件被外部改了或删了（智能体改了正开着的文件）：有未保存改动时才停下来问，
                 没改动的直接重新载入、不出这条 -->
            <Border Name="DiskChangeBar" DockPanel.Dock="Top" IsVisible="False" Margin="0,0,0,6"
                    Padding="10,6" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource SemiOrange5}" Background="{DynamicResource SemiOrange1}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                        <Button Name="ReloadFromDiskButton" Classes="Small Primary"
                                Content="{loc:Loc TextFileDiskReload}" Click="ReloadFromDiskButton_Click" />
                        <Button Classes="Small Tertiary" Content="{loc:Loc TextFileDiskKeepMine}"
                                Click="KeepMineButton_Click" />
                    </StackPanel>
                    <TextBlock Name="DiskChangeText" FontSize="13" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <!-- 原文与 Markdown 预览：看法的切换、定位与跟底都在组件里 -->
            <controls:TextDocumentView Name="DocumentView" />
        </DockPanel>

        <!-- 底部状态栏：左路径（只读文本是它的来源）、右编码 / 行数 / 字符数 / 文件大小。
             编辑区自带细框定界，这里不再另画分隔线，字色走主题灰 -->
        <Grid Grid.Row="2" Margin="0,6,0,-5" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Name="PathTextBlock" FontSize="12" Foreground="{DynamicResource SemiGrey5}"
                       VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis" />
            <!-- 光标行列：点它或 Ctrl+G 跳到行。只读文本喂给编辑器的是硬切过的副本，行号对不上原文，不显示 -->
            <Button Name="CaretButton" Grid.Column="1" Classes="NoneStyle" Cursor="Hand"
                    Margin="12,0,0,0" VerticalAlignment="Center" Focusable="False"
                    ToolTip.Tip="{loc:Loc TextFileGoToLine}">
                <TextBlock Name="CaretTextBlock" FontSize="12" FontWeight="Normal" VerticalAlignment="Center"
                           Foreground="{DynamicResource SemiGrey5}" />
                <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedRight" Opened="GoToLineFlyout_Opened">
                        <TextBox Name="GoToLineBox" Width="180" KeyDown="GoToLineBox_KeyDown" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <TextBlock Name="StatusTextBlock" Grid.Column="2" FontSize="12"
                       Foreground="{DynamicResource SemiGrey5}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <!-- 拖放高亮：文件拖进来时整窗亮起，盖在一切之上但不拦事件；
             可见性由 code-behind 按 DragOver/DragLeave/Drop 控制（对照 ConversationView） -->
        <Rectangle Name="DropOverlay" Grid.Row="0" Grid.RowSpan="3"
                   Margin="2" RadiusX="8" RadiusY="8"
                   Fill="#1F2F81F7" Stroke="#2F81F7" StrokeThickness="2" StrokeDashArray="8,4"
                   IsHitTestVisible="False" IsVisible="False" />
    </Grid>

</Window>