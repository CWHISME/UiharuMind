<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewData="clr-namespace:UiharuMind.Shared.Data"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="500"
             x:Class="UiharuMind.Shared.Controls.ModelRuntimeBasicSettingsView"
             x:DataType="viewData:ModelRuntimeBasicSettingsData">

    <Design.DataContext>
        <viewData:ModelRuntimeBasicSettingsData />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.runtime-strip">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey2}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.runtime-number">
            <Setter Property="Width" Value="84" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <!-- 滑块：轨道 1px 浅灰线太淡，悬空一个蓝圈看不出可拖。
             全仓 Slider 就这两处，局部模板画 4px 圆角轨道 + 大 thumb，不碰全局主题 -->
        <Style Selector="Slider.runtime-slider">
            <Setter Property="Template">
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" MinHeight="24">
                        <Border Height="4"
                                CornerRadius="2"
                                Background="{DynamicResource SemiGrey3}"
                                VerticalAlignment="Center" />
                        <Track Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}"
                               Orientation="Horizontal"
                               VerticalAlignment="Center">
                            <Track.DecreaseButton>
                                <RepeatButton Background="Transparent"
                                              BorderThickness="0" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Background="Transparent"
                                              BorderThickness="0" />
                            </Track.IncreaseButton>
                            <Thumb Width="16" Height="16">
                                <!-- 主题的 thumb 样式不会跟进自定义模板，这里内联画：蓝圆点 + 细描边，
                                     轨道 4px + 抓手 16px，一眼看得出可拖 -->
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse Fill="{DynamicResource SemiBlue5}"
                                                 Stroke="{DynamicResource SemiGrey1}"
                                                 StrokeThickness="1" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Border x:Name="OuterBorder"
            MaxHeight="460"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource SemiGrey2}"
            Background="{DynamicResource SemiGrey0}"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*,Auto"
              RowSpacing="0">

            <Border Padding="14,12"
                    BorderBrush="{DynamicResource SemiGrey2}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentModelName}"
                                   FontSize="15"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentModelDetailText}"
                                   Classes="muted"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="130"
                              IsVisible="{Binding HasEngineChoice}"
                              ItemsSource="{Binding LocalEngineOptions}"
                              SelectedItem="{Binding SelectedLocalEngine}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewData:LocalEngineOption">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="12,10,12,0"
                    Classes="runtime-strip">
                <!-- 窄窗下四段并排会溢出被裁：换 WrapPanel 自动折行，间距走子项 Margin -->
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,4">
                        <TextBlock Text="{loc:Loc ModelRuntimeEstimatedMemoryUsage}" />
                        <Border CornerRadius="4"
                                Padding="4,1"
                                Background="{DynamicResource SemiGrey2}">
                            <TextBlock Text="{loc:Loc ModelRuntimeBeta}"
                                       FontSize="11" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,16,4">
                        <TextBlock Text="{loc:Loc ModelRuntimeAvailableMemory}" />
                        <Border CornerRadius="4" Padding="5,1" Background="{DynamicResource SemiGrey0}">
                            <TextBlock Text="{Binding AvailableMemoryText}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,16,4">
                        <TextBlock Text="{loc:Loc ModelRuntimeTotalMemory}" />
                        <Border CornerRadius="4" Padding="5,1" Background="{DynamicResource SemiGrey0}">
                            <TextBlock Text="{Binding EstimatedTotalMemoryText}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="{loc:Loc ModelRuntimeRiskLevel}" />
                        <Border CornerRadius="4" Padding="5,1" Background="{DynamicResource SemiGrey0}">
                            <TextBlock Text="{Binding RuntimeRiskText}"
                                       ToolTip.Tip="{Binding RuntimeRiskDetailText}" />
                        </Border>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <ScrollViewer x:Name="ContentScroll"
                          Grid.Row="2"
                          MaxHeight="245"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18"
                            Margin="14,18,14,16">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc ModelRuntimeContextSize}" />
                                <TextBlock Text="{loc:Loc ModelRuntimeContextSizeDesc}"
                                           Classes="muted"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Classes="runtime-number"
                                     Text="{Binding ContextSize}" />
                        </Grid>
                        <Slider Grid.Row="1"
                                Classes="runtime-slider"
                                Minimum="0"
                                Maximum="{Binding MaxContextSize}"
                                Value="{Binding ContextSize}" />
                        <TextBlock Grid.Row="2"
                                   Text="{loc:Loc ModelRuntimeContextLimitHint}"
                                   Classes="muted" />
                    </Grid>

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc ModelRuntimeGpuLayers}" />
                                <TextBlock Text="{loc:Loc ModelRuntimeGpuLayersDesc}"
                                           Classes="muted"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Classes="runtime-number"
                                     Text="{Binding GpuLayers}" />
                        </Grid>
                        <Slider Grid.Row="1"
                                Classes="runtime-slider"
                                Minimum="0"
                                Maximum="{Binding MaxGpuLayers}"
                                Value="{Binding GpuLayers}" />
                    </Grid>

                    <ToggleSwitch Content="{loc:Loc ModelRuntimeShowAdvancedSettings}"
                                  IsChecked="{Binding ShowAdvancedSettings}" />

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="12"
                          IsVisible="{Binding ShowAdvancedSettings}">
                        <Grid ColumnDefinitions="*,84" ColumnSpacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc ModelRuntimeBatchSize}" />
                                <TextBlock Text="{loc:Loc ModelRuntimeBatchSizeDesc}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Classes="runtime-number" Text="{Binding BatchSize}" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,84" ColumnSpacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc ModelRuntimeUBatchSize}" />
                                <TextBlock Text="{loc:Loc ModelRuntimeUBatchSizeDesc}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Classes="runtime-number" Text="{Binding UBatchSize}" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="*,84" ColumnSpacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc ModelRuntimeThreads}" />
                                <TextBlock Text="{loc:Loc ModelRuntimeThreadsDesc}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Classes="runtime-number" Text="{Binding Threads}" />
                        </Grid>
                        <CheckBox Grid.Row="3"
                                  Content="{loc:Loc ModelRuntimeFlashAttention}"
                                  IsChecked="{Binding FlashAttention}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3"
                    Padding="14,10"
                    BorderBrush="{DynamicResource SemiGrey2}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <TextBlock Grid.Column="1"
                               Text="{loc:Loc ModelRuntimeChangeHint}"
                               Classes="muted"
                               TextWrapping="Wrap"
                               MaxWidth="320" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
