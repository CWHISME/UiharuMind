<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             x:Class="UiharuMind.Shared.Controls.KindBadge">
    <!-- 徽章：圆角胶囊 + 文本。纯展示组件，不掺业务语义：
         底色完全由调用方给 BadgeBackground（角色类别配色在 CharacterKindPresentation，
         模型状态标签在调用页给字面色），前景统一深字，浅底上才读得清。 -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="KindBadgeForeground" Color="#2F4F4F" /> <!-- 深字，浅底上才读得清 -->
    </UserControl.Resources>
    <Border Background="{Binding BadgeBackground, RelativeSource={RelativeSource AncestorType=controls:KindBadge}}"
            MinHeight="18"
            MaxHeight="18"
            CornerRadius="9"
            Padding="8,0"
            VerticalAlignment="Center">
        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=controls:KindBadge}}"
                   Foreground="{StaticResource KindBadgeForeground}"
                   FontSize="12"
                   Classes="line-tight"
                   VerticalAlignment="Center" />
    </Border>
</UserControl>