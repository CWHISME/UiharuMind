<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        模型页各页签（对话、生图、语音模型）与「获取模型」共用的列表样式。
        原先写在 ModelPage 里，别的页签单独挂载（如无头测试）时样式就丢了
    -->
    <!-- 与「获取模型」同一套：卡片里放列表，行间细分隔线，悬停铺整行底色。
         page-card 是同一张卡给模型页以外的页面用（如日志页） -->
    <Style Selector="Border.model-card, Border.page-card">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey2}" />
        <Setter Property="Background" Value="{DynamicResource SemiGrey0}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ListBox.model-list">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.model-list ListBoxItem">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey1}" />
    </Style>
    <Style Selector="ListBox.model-list ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
    </Style>
    <Style Selector="ListBox.model-list ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource SemiBlue0}" />
    </Style>
    <!-- 自带行内按钮、不需要选中痕迹的扁平列表（角色选择器、产物列表共用）：
         ListBoxItem 只是容器，视觉全交给行内的 Button；选中/悬停不染色、无焦点框 -->
    <Style Selector="ListBox.flat-list">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.flat-list ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.flat-list ListBoxItem:pointerover /template/ Border#PART_Border, ListBox.flat-list ListBoxItem:selected /template/ Border#PART_Border">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 不进 ListBox 的分组列表（语音模型、音色库）用的行：与 model-list 的行同一几何，只悬停不选中 -->
    <Style Selector="Border.model-row">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey1}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.model-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
    </Style>
    <!-- 「默认」徽标与「设为默认」：语音、生图页签共用 -->
    <!-- 与 KindBadge（远程、视觉等徽标）同一个尺寸：18 高、左右 8、12 号字 -->
    <Style Selector="Border.default-badge">
        <Setter Property="Background" Value="{DynamicResource SemiBlue5}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.default-badge TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 与「默认」徽标同高，切换时行高不跳 -->
    <Style Selector="Button.set-default">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="18" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Border.model-icon">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ThemedIconButton.row-action">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="IconWidth" Value="16" />
        <Setter Property="IconHeight" Value="16" />
    </Style>
    <Style Selector="Button.toolbar-link">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
