<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- 数字框超出范围时夹到上下限；默认会拒收这次输入、退回上一个值，看起来像吞掉了最后一个字 -->
    <Style Selector="NumericUpDown">
        <Setter Property="ClipValueToMinMax" Value="True" />
    </Style>

    <!-- ============================= 输入区域修改(标记为 composer-input 的，主要用于聊天信息时的发送输入区域) ========================-->
    <Style Selector="TextBox.composer-input">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="MaxHeight" Value="240" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBox.composer-input /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.composer-input:pointerover /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.composer-input:focus /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.composer-input:focus-within /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.composer-input /template/ Panel">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ============================= 分段切换（标记为 segmented 的横排 ListBox：获取模型的分类、添加音色的来源） ========================-->
    <Style Selector="ListBox.segmented">
        <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource SemiGrey0}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</Styles>
