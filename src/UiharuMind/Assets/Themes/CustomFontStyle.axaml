<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    <!-- 类型选择器一律用 :is() 而不用裸类型名:裸类型按 StyleKey 精确匹配,
         子类(如 DiffTextBlock、MarkdownTextBlock)命中不了,字体又会飘一次。
         :is() 按继承匹配,新控件自动吃到 -->
    <Style Selector=":is(TextBlock)">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
    </Style>
    <Style Selector=":is(TextBox)">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
    </Style>
    <Style Selector=":is(SelectableTextBlock)">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
    </Style>
    <Style Selector=":is(CheckBox)">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
    </Style>
    <Style Selector=":is(Button)">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
    </Style>
    
    <!-- 淡淡的灰色字体 -->
    <Style Selector=":is(TextBlock).muted">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
    </Style>
    <!-- 代码/路径等宽语义:字体与正文统一走 MainFont(单点,换字体只改 MainFont),
         mono 只保留"小字号"的语义,以后想换回等宽只改这一处 -->
    <Style Selector=":is(TextBlock).mono">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector=":is(SelectableTextBlock).muted">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
    </Style>
    <Style Selector=":is(SelectableTextBlock).mono">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- 折叠条标题行的文本垂直微调。字形视觉中心天然偏上(ascent>descent),
         VerticalAlignment=Center 只居中行盒、管不了盒内文本——用 RenderTransform 平移
         做纯视觉修正(不参与布局,数值可按字体微调) -->
    <Style Selector="TextBlock.title-tweak">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="1" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 单行文字在「固定高度容器里要视觉居中」的通用解法(比 title-tweak 更彻底):
         默认行高≈1.4×字号,字形按 ascent 排在行盒里偏上。让行盒收紧到字号本尊,
         字形即填满行盒——VerticalAlignment=Center 居中行盒时字形也跟着居中。
         LineHeight 绑定自身 FontSize,12/13/14 任何字号都各自匹配,不用手算。
         只对显式挂类的 TextBlock 生效,全局行距(多行正文)一概不动。
         需要就在 TextBlock 上加 class: line-tight -->
    <Style Selector=":is(TextBlock).line-tight">
        <Setter Property="LineHeight" Value="{Binding FontSize, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- 图标与旁边文字并排时的垂直微调。与 title-tweak 同因:字形视觉中心天然偏上,
         图标按自己的盒居中时也一样看着偏上——用 RenderTransform 上移 1px 对齐视觉中心。
         纯视觉、不参与布局(不用负 Margin:它参与测量,会把所在行高带偏)。
         用 :is 罩住 ThemedIconButton 及其子类(与 CustomButtonStyle 同一口径)。
         需要就说一句挂 class: icon-tweak -->
    <Style Selector=":is(ThemedIconButton).icon-tweak">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="-1" />
            </Setter.Value>
        </Setter>
    </Style>
</Styles>