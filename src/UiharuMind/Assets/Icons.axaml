<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style>
        <Style.Resources>
            <!--
                Icons are loaded from SVG files in Assets/Icons/
                via Svg.Controls.Skia.Avalonia library.
                Used via <controls:ThemedSvgIcon IconName="icon-name" />
            -->
        </Style.Resources>
    </Style>
</Styles>
