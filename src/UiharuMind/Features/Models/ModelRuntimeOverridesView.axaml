<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:UiharuMind.Features.Models"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:data="clr-namespace:UiharuMind.Shared.Data"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             x:Class="UiharuMind.Features.Models.ModelRuntimeOverridesView"
             x:DataType="models:ModelRuntimeOverridesViewData">
    <UserControl.Styles>
        <Style Selector="NumericUpDown.runtime-field">
            <Setter Property="Width" Value="160" />
            <Setter Property="FormatString" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.runtime-field">
            <Setter Property="Width" Value="160" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <!-- 每行：改了值就记成这个模型自己的，撤销按钮改回跟随全局 -->
    <StackPanel>
        <controls:SettingsRow Header="{loc:Loc ModelRuntimeContextSize}"
                              Description="{Binding ContextSize.StatusText}"
                              ResetCommand="{Binding ContextSize.ResetCommand}"
                              ResetVisible="{Binding ContextSize.IsOverridden}"
                              ResetToolTip="{loc:Loc ModelParamsResetTip}">
            <controls:SettingsRow.Field>
                <NumericUpDown Classes="runtime-field" Minimum="0" Maximum="{Binding MaxContextSize}" Increment="1024"
                               Value="{Binding ContextSize.Value}" />
            </controls:SettingsRow.Field>
        </controls:SettingsRow>
        <controls:SettingsRow Header="{loc:Loc ModelRuntimeGpuLayers}"
                              Description="{Binding GpuLayers.StatusText}"
                              ResetCommand="{Binding GpuLayers.ResetCommand}"
                              ResetVisible="{Binding GpuLayers.IsOverridden}"
                              ResetToolTip="{loc:Loc ModelParamsResetTip}">
            <controls:SettingsRow.Field>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumericUpDown Classes="runtime-field" Width="96" Minimum="1"
                                   Maximum="{Binding MaxGpuLayers}"
                                   IsVisible="{Binding IsCustomGpuLayers}"
                                   Value="{Binding GpuLayers.Value}" />
                    <ComboBox Classes="runtime-field" ItemsSource="{Binding GpuLayerModeOptions}"
                              SelectedItem="{Binding SelectedGpuLayerMode}"
                              DisplayMemberBinding="{Binding DisplayName, DataType=data:ISettingChoice}" />
                </StackPanel>
            </controls:SettingsRow.Field>
        </controls:SettingsRow>
        <controls:SettingsRow Header="{loc:Loc ModelRuntimeBatchSize}"
                              Description="{Binding BatchSize.StatusText}"
                              ResetCommand="{Binding BatchSize.ResetCommand}"
                              ResetVisible="{Binding BatchSize.IsOverridden}"
                              ResetToolTip="{loc:Loc ModelParamsResetTip}">
            <controls:SettingsRow.Field>
                <NumericUpDown Classes="runtime-field" Minimum="0" Maximum="65536" Increment="256"
                               Value="{Binding BatchSize.Value}" />
            </controls:SettingsRow.Field>
        </controls:SettingsRow>
        <controls:SettingsRow Header="{loc:Loc ModelRuntimeUBatchSize}"
                              Description="{Binding UBatchSize.StatusText}"
                              ResetCommand="{Binding UBatchSize.ResetCommand}"
                              ResetVisible="{Binding UBatchSize.IsOverridden}"
                              ResetToolTip="{loc:Loc ModelParamsResetTip}">
            <controls:SettingsRow.Field>
                <NumericUpDown Classes="runtime-field" Minimum="0" Maximum="65536" Increment="128"
                               Value="{Binding UBatchSize.Value}" />
            </controls:SettingsRow.Field>
        </controls:SettingsRow>
        <controls:SettingsRow Header="{loc:Loc ModelRuntimeThreads}"
                              Description="{Binding Threads.StatusText}"
                              ResetCommand="{Binding Threads.ResetCommand}"
                              ResetVisible="{Binding Threads.IsOverridden}"
                              ResetToolTip="{loc:Loc ModelParamsResetTip}">
            <controls:SettingsRow.Field>
                <NumericUpDown Classes="runtime-field" Minimum="0" Maximum="512"
                               Value="{Binding Threads.Value}" />
            </controls:SettingsRow.Field>
        </controls:SettingsRow>
        <controls:SettingsRow Header="{loc:Loc ModelParamsKvCacheType}"
                              Description="{Binding KvCacheType.StatusText}"
                              ResetCommand="{Binding KvCacheType.ResetCommand}"
                              ResetVisible="{Binding KvCacheType.IsOverridden}"
                              ResetToolTip="{loc:Loc ModelParamsResetTip}"
                              DividerVisible="False">
            <controls:SettingsRow.Field>
                <ComboBox Classes="runtime-field" ItemsSource="{Binding KvCacheTypeOptions}"
                          SelectedIndex="{Binding KvCacheType.Value}" />
            </controls:SettingsRow.Field>
        </controls:SettingsRow>

        <StackPanel Margin="0,10,0,0" Spacing="4">
            <TextBlock Text="{Binding GpuLayersWarning}" TextWrapping="Wrap"
                       Foreground="{DynamicResource MessageStatusWarningBrush}"
                       IsVisible="{Binding GpuLayersWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding EstimateText}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Loc ModelParamsReloadHint}" Classes="muted" TextWrapping="Wrap"
                       Foreground="{DynamicResource MessageStatusWarningBrush}"
                       IsVisible="{Binding IsRunning}" />
        </StackPanel>
    </StackPanel>
</UserControl>
