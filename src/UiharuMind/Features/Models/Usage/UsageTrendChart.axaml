<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:usage="clr-namespace:UiharuMind.Features.Models.Usage"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1180"
             x:Class="UiharuMind.Features.Models.Usage.UsageTrendChart"
             x:DataType="usage:UsagePageData">

    <Border Classes="usage-card">
        <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc UsageTrendTitle}" Classes="section-title" />
                    <TextBlock Text="{loc:Loc UsageTrendSessionTitle}"
                               Classes="muted"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsSessionView}" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Classes="compact"
                          Width="170"
                          IsVisible="{Binding !IsSessionView}"
                          ItemsSource="{Binding TrendMetricOptions}"
                          SelectedItem="{Binding TrendMetricOption}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="usage:UsageOptionViewData">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- 会话视图的摘要：请求数、费用、首末时间，以及骤降点提示 -->
            <Border Classes="usage-subcard" IsVisible="{Binding IsSessionView}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding SessionSummary.SummaryText}" />
                    <TextBlock Text="{Binding SessionSummary.RangeText}" Classes="muted" />
                    <TextBlock Text="{Binding SessionSummary.SessionId}"
                               Classes="mono"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding TrendHint}"
                       Classes="muted"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasTrendHint}" />

            <Grid Height="250">
                <lvc:CartesianChart Series="{Binding TrendSeries}"
                                    XAxes="{Binding TrendXAxes}"
                                    YAxes="{Binding TrendYAxes}"
                                    TooltipPosition="Top"
                                    LegendPosition="Hidden"
                                    ZoomMode="None"
                                    DrawMarginFrame="{x:Null}" />
                <TextBlock Text="{loc:Loc UsageTrendEmpty}"
                           Classes="muted"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsEmptyTrend}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
