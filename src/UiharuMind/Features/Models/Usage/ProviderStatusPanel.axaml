<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:usage="clr-namespace:UiharuMind.Features.Models.Usage"
             x:Class="UiharuMind.Features.Models.Usage.ProviderStatusPanel"
             x:DataType="usage:ProviderStatusViewData">
    <!-- 供应商读数点开的明细：各窗口一条、余额、数据年龄。
         「额度是账户级的」这行是必须的：用户切模型看到读数不变，否则会以为坏了 -->
    <StackPanel Width="320" Spacing="10" Margin="4">
        <TextBlock Text="{Binding PanelTitle}" FontWeight="SemiBold" />

        <StackPanel Spacing="4" IsVisible="{Binding HasCredentialWarning}">
            <TextBlock Text="{Binding CredentialHint}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource MessageStatusErrorBrush}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding MeterRows}" IsVisible="{Binding HasMeters}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="usage:ProviderStatusMeterRow">
                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="12"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Ratio}" Height="6"
                                     MinHeight="6" CornerRadius="3" />
                        <TextBlock Text="{Binding ResetText}" Classes="muted" FontSize="11"
                                   IsVisible="{Binding HasReset}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 月度进度：分母是「剩余 + 本周期已用」推的（接口不给上限），推不出来时这整块隐藏，只留桶行 -->
        <StackPanel Spacing="3" IsVisible="{Binding HasMonthlyProgress}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{loc:Loc ProviderStatusBucketMonthly}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding MonthlyPercentText}" FontSize="12"
                           VerticalAlignment="Center" />
            </Grid>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding MonthlyRatio}" Height="6"
                         MinHeight="6" CornerRadius="3" />
            <TextBlock Text="{Binding MonthlyAmountText}" Classes="muted" FontSize="11" />
            <TextBlock Text="{Binding MonthlyResetText}" Classes="muted" FontSize="11" />
        </StackPanel>

        <!-- 当前模型的挂牌单价（来自构建期价格表）：峰时按下方的倍率放大，那才是此刻的实价 -->
        <StackPanel Spacing="2" IsVisible="{Binding HasModelPrice}">
            <!-- 一行说完：单价：输入 $0.3 · 输出 $1.2 · 缓存读 $0.006。
                 单位不进标签（那会把价格顶出面板），也不进悬停提示——提示框宽度一被压就折行，
                 而高度只按一行算，后半截直接看不见。放在下面一行明说 -->
            <TextBlock FontSize="12" TextWrapping="Wrap"><Run
                    Text="{loc:Loc ProviderStatusPriceLabel}" /><Run
                    Text="{Binding ModelPriceText}" /></TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{loc:Loc ProviderStatusPriceUnit}" Classes="muted" FontSize="11" />
                <TextBlock Text="{Binding ModelPriceHint}" Classes="muted" FontSize="11"
                           IsVisible="{Binding ModelPriceHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding UsageStatsText}" Classes="muted" FontSize="11"
                   IsVisible="{Binding HasUsageStats}" />

        <TextBlock Text="{Binding BalanceText}" FontSize="12" IsVisible="{Binding HasBalance}" />
        <!-- 余额是三个桶的和，合起来说不清「本月还剩多少」：有钱的那几个桶各列一行 -->
        <ItemsControl ItemsSource="{Binding BucketRows}" IsVisible="{Binding HasBuckets}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="usage:ProviderStatusBucketRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Label}" Classes="muted" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontSize="12" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator />
        <TextBlock Text="{loc:Loc ProviderStatusAccountLevelHint}" Classes="muted" FontSize="12"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding DataAgeText}" Classes="muted" FontSize="12"
                   IsVisible="{Binding DataAgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
</UserControl>
