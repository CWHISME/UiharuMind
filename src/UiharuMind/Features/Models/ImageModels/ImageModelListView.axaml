<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:images="clr-namespace:UiharuMind.Features.Models.ImageModels"
             xmlns:pages="clr-namespace:UiharuMind.Features.Models"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UiharuMind.Features.Models.ImageModels.ImageModelListView"
             x:DataType="images:ImageModelListViewData">

    <!-- 卡片、列表行、图标、行按钮复用模型页同一套（model-card / model-list / model-icon / row-action，见 Themes） -->
    <DockPanel Margin="0,14,0,0">
        <!-- 工具条：左边本地模型目录，右边画图、获取本地模型、添加在线模型（与对话、语音页签同一条） -->
        <pages:ModelFolderBar DockPanel.Dock="Top" Margin="0,0,0,12" Path="{Binding ModelRoot}"
                              OpenCommand="{Binding OpenFolderCommand}" RefreshCommand="{Binding RescanCommand}">
            <pages:ModelFolderBar.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding DrawCommand}" CommandParameter="{x:Null}" IsEnabled="{Binding HasItems}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:ThemedSvgIcon Width="14" Height="14" IconName="sparkles" />
                            <TextBlock Text="{loc:Loc ImageDrawOpen}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GoToMarketCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:ThemedSvgIcon Width="14" Height="14" IconName="download" />
                            <TextBlock Text="{loc:Loc ImageModelGetLocal}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:ThemedSvgIcon Width="14" Height="14" IconName="globe" />
                            <TextBlock Text="{loc:Loc AddBtn}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </pages:ModelFolderBar.Actions>
        </pages:ModelFolderBar>

        <pages:EngineStatusStrip DockPanel.Dock="Top" Margin="0,0,0,12" Status="{Binding EngineStatus}"
                                 IsVisible="{Binding EngineStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Border Classes="model-card">
            <Panel>
                <!-- 空状态：与对话模型页签同式，居中图标加文字引去添加 -->
                <controls:EmptyStateView IsVisible="{Binding !HasItems}" IconName="image"
                                         Title="{loc:Loc ImageModelListEmpty}" Hint="{loc:Loc ImageModelListHint}">
                    <controls:EmptyStateView.Actions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="Primary" Content="{loc:Loc ImageModelGetLocal}" Command="{Binding GoToMarketCommand}" />
                            <Button Content="{loc:Loc AddBtn}" Command="{Binding AddCommand}" />
                        </StackPanel>
                    </controls:EmptyStateView.Actions>
                </controls:EmptyStateView>

                <ListBox Classes="model-list"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemsSource="{Binding Items}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="images:ImageModelItemViewData">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <!-- 与对话模型同一套：本地用种类图标、远程用地球加「远程」徽标 -->
                                <Border Classes="model-icon">
                                    <Panel>
                                        <controls:ThemedSvgIcon Width="18" Height="18" IconName="image"
                                                                IsVisible="{Binding IsLocal}" />
                                        <controls:ThemedSvgIcon Width="18" Height="18" IconName="globe"
                                                                IsVisible="{Binding !IsLocal}" />
                                    </Panel>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <controls:CenteredStackPanel Spacing="8">
                                        <!-- 序号即回退顺序 -->
                                        <TextBlock Text="{Binding Order, StringFormat='{}{0}.'}" Classes="muted"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <controls:ModelStateBadges IsRemote="{Binding !IsLocal}"
                                                                   VerticalAlignment="Center" />
                                        <controls:KindBadge Header="{loc:Loc ImageModelEditingBadge}"
                                                            BadgeBackground="Gold"
                                                            IsVisible="{Binding SupportsEditing}"
                                                            VerticalAlignment="Center" />
                                    </controls:CenteredStackPanel>
                                    <!-- 远程：接口格式 · 模型 id · 分辨率档；本地：家族 · 档位 · 大小 -->
                                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Endpoint}" Classes="muted" FontSize="12"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Endpoint}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MessageStatusErrorBrush}"
                                               IsVisible="{Binding !IsReady}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                            VerticalAlignment="Center">
                                    <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="sparkles"
                                                      ToolTip.Tip="{loc:Loc ImageModelTry}"
                                                      CommandParameter="{Binding}"
                                                      Command="{Binding $parent[ListBox].((images:ImageModelListViewData)DataContext).DrawCommand}" />
                                    <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="chevron-up"
                                                      ToolTip.Tip="{loc:Loc ImageModelMoveUp}"
                                                      IsEnabled="{Binding CanMoveUp}"
                                                      CommandParameter="{Binding}"
                                                      Command="{Binding $parent[ListBox].((images:ImageModelListViewData)DataContext).MoveUpCommand}" />
                                    <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="chevron-down"
                                                      ToolTip.Tip="{loc:Loc ImageModelMoveDown}"
                                                      IsEnabled="{Binding CanMoveDown}"
                                                      CommandParameter="{Binding}"
                                                      Command="{Binding $parent[ListBox].((images:ImageModelListViewData)DataContext).MoveDownCommand}" />
                                    <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="pencil"
                                                      ToolTip.Tip="{loc:Loc ModifyBtn}"
                                                      CommandParameter="{Binding}"
                                                      Command="{Binding $parent[ListBox].((images:ImageModelListViewData)DataContext).EditCommand}" />
                                    <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="trash-2"
                                                      ToolTip.Tip="{loc:Loc Delete}"
                                                      CommandParameter="{Binding}"
                                                      Command="{Binding $parent[ListBox].((images:ImageModelListViewData)DataContext).DeleteCommand}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Panel>
        </Border>
    </DockPanel>
</UserControl>
