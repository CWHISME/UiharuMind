<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:images="clr-namespace:UiharuMind.Features.Models.ImageModels"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UiharuMind.Features.Models.ImageModels.ImageModelListView"
             x:DataType="images:ImageModelListViewData">

    <!-- 卡片、列表行、图标、行按钮直接复用模型页同一套（model-card / model-list / model-icon / row-action），
         样式定义在 ModelPage.axaml，本视图只在模型页里使用 -->
    <DockPanel>
        <!-- 工具条：左边说明，右边添加生图模型（与对话模型页签的添加远程模型同式） -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="{loc:Loc ImageModelListHint}" Classes="muted"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Command="{Binding AddCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:ThemedSvgIcon Width="14" Height="14" IconName="image" />
                    <TextBlock Text="{loc:Loc AddBtn}" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Classes="model-card">
            <Panel>
                <!-- 空状态：与对话模型页签同式，居中图标加文字引去添加 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                            Margin="24" IsVisible="{Binding !HasItems}">
                    <controls:ThemedSvgIcon Width="32" Height="32" IconName="image" Opacity="0.5" />
                    <TextBlock Text="{loc:Loc ImageModelListEmpty}" HorizontalAlignment="Center"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc ImageModelListHint}" Classes="muted"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Classes="Primary" Content="{loc:Loc AddBtn}" Command="{Binding AddCommand}"
                            HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <ListBox Classes="model-list"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemsSource="{Binding Items}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="images:ImageModelItemViewData">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Classes="model-icon">
                                    <controls:ThemedSvgIcon Width="18" Height="18" IconName="image" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- 序号即回退顺序 -->
                                        <TextBlock Text="{Binding Order, StringFormat='{}{0}.'}" Classes="muted"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <controls:KindBadge Header="{loc:Loc ImageModelEditingBadge}"
                                                            BadgeBackground="Gold"
                                                            IsVisible="{Binding SupportsEditing}"
                                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- 接口格式 · 模型 id · 分辨率档 -->
                                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Endpoint}" Classes="muted" FontSize="12"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Endpoint}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SemiGreen6}"
                                               IsVisible="{Binding IsReady}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MessageStatusErrorBrush}"
                                               IsVisible="{Binding !IsReady}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                            VerticalAlignment="Center">
                                    <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="chevron-up"
                                                      ToolTip.Tip="{loc:Loc ImageModelMoveUp}"
                                                      IsEnabled="{Binding CanMoveUp}"
                                                      CommandParameter="{Binding}"
                                                      Command="{Binding $parent[ListBox].((images:ImageModelListViewData)DataContext).MoveUpCommand}" />
                                    <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="chevron-down"
                                                      ToolTip.Tip="{loc:Loc ImageModelMoveDown}"
                                                      IsEnabled="{Binding CanMoveDown}"
                                                      CommandParameter="{Binding}"
                                                      Command="{Binding $parent[ListBox].((images:ImageModelListViewData)DataContext).MoveDownCommand}" />
                                    <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="pencil"
                                                      ToolTip.Tip="{loc:Loc ModifyBtn}"
                                                      CommandParameter="{Binding}"
                                                      Command="{Binding $parent[ListBox].((images:ImageModelListViewData)DataContext).EditCommand}" />
                                    <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="trash-2"
                                                      ToolTip.Tip="{loc:Loc Delete}"
                                                      CommandParameter="{Binding}"
                                                      Command="{Binding $parent[ListBox].((images:ImageModelListViewData)DataContext).DeleteCommand}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Panel>
        </Border>
    </DockPanel>
</UserControl>
