<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:images="clr-namespace:UiharuMind.Features.Models.ImageModels"
        xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
        xmlns:imageGen="clr-namespace:UiharuMind.Core.AI.ImageGeneration;assembly=UiharuMind.Core"
        xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
        x:Class="UiharuMind.Features.Models.ImageModels.ImageDrawWindow"
        x:DataType="images:ImageDrawViewData"
        Width="760"
        Height="720"
        MinWidth="520"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc ImageDrawTitle}">

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SemiGrey0}">
        <!-- 输入：提示词 + 模型 + 生成 / 停止 -->
        <Border Padding="16,14" BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="10">
                <TextBox Text="{Binding Prompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="160"
                         PlaceholderText="{loc:Loc ImageDrawPromptPlaceholder}" />
                <!-- 参考图：有就是改图，第一张是要改的那张 -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsGenerating}">
                    <ItemsControl ItemsSource="{Binding References.Items}" IsVisible="{Binding References.HasItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="images:ImageDrawReference">
                                <Panel Width="56" Height="56" ToolTip.Tip="{Binding FileName}">
                                    <Border CornerRadius="6" ClipToBounds="True" BorderThickness="1"
                                            BorderBrush="{DynamicResource SemiGrey3}">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <Button Classes="NoneStyle" Cursor="Hand" Padding="0" Margin="0,3,3,0" MinHeight="0" MinWidth="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            ToolTip.Tip="{loc:Loc ImageDrawRemoveReference}"
                                            Command="{Binding $parent[ItemsControl].((images:ImageDrawViewData)DataContext).References.RemoveCommand}"
                                            CommandParameter="{Binding}">
                                        <!-- 底色画在 Border 上：NoneStyle 的模板不画按钮背景，深色图上光一个叉看不见 -->
                                        <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1"
                                                Background="{DynamicResource SemiGrey0}"
                                                BorderBrush="{DynamicResource SemiGrey3}">
                                            <controls:ThemedSvgIcon Width="9" Height="9" IconName="x" />
                                        </Border>
                                    </Button>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Width="56" Height="56" Padding="0" CornerRadius="6" Cursor="Hand"
                            Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource SemiGrey3}"
                            ToolTip.Tip="{loc:Loc ImageDrawAddReference}"
                            Command="{Binding AddReferencesCommand}" IsVisible="{Binding References.CanAdd}">
                        <controls:ThemedSvgIcon Width="18" Height="18" IconName="plus" Opacity="0.6" />
                    </Button>
                    <TextBlock Text="{loc:Loc ImageDrawAddReference}" Classes="muted" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                               IsVisible="{Binding !References.HasItems}" />
                </StackPanel>
                <TextBlock Text="{Binding CannotEditHint}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SemiOrange5}"
                           IsVisible="{Binding CannotEditHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                    <TextBlock Text="{loc:Loc ImageDrawModel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Models}"
                              SelectedItem="{Binding SelectedModel}" IsEnabled="{Binding !IsGenerating}"
                              DisplayMemberBinding="{Binding Name, DataType=imageGen:ImageModelInfo}" />
                    <TextBlock Grid.Column="2" Text="{loc:Loc ImageDrawRatio}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3" MinWidth="88" ItemsSource="{Binding Ratios}"
                              SelectedItem="{Binding SelectedRatio}" IsEnabled="{Binding !IsGenerating}" />
                    <Panel Grid.Column="4">
                        <Button Classes="Primary" Command="{Binding GenerateCommand}" IsVisible="{Binding !IsGenerating}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:ThemedSvgIcon Width="15" Height="15" IconName="image" />
                                <TextBlock Text="{loc:Loc ImageDrawGenerate}" />
                            </StackPanel>
                        </Button>
                        <Button Content="{loc:Loc ImageDrawStop}" Command="{Binding StopCommand}"
                                IsVisible="{Binding IsGenerating}" />
                    </Panel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 图：生成中是预览，画好是结果 -->
        <Border Grid.Row="1" Margin="16" CornerRadius="8" Background="{DynamicResource SemiGrey1}" ClipToBounds="True">
            <Panel>
                <TextBlock Text="{loc:Loc ImageDrawEmpty}" Classes="muted" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}" />
                <Image Source="{Binding Image}" Stretch="Uniform" />
                <ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" VerticalAlignment="Top"
                             IsVisible="{Binding IsGenerating}" />
            </Panel>
        </Border>

        <!-- 状态 + 画好之后的动作；本地引擎内存不够没起时，说清楚差多少并给「仍然加载」 -->
        <Border Grid.Row="2" Padding="16,10" BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
                <Border Classes="result-panel" Padding="12,8" IsVisible="{Binding HasMemoryRisk}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding MemoryRiskText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="Primary" Content="{Binding ReleaseOthersText}"
                                    IsVisible="{Binding CanReleaseOthers}" Command="{Binding ReleaseOthersAndGenerateCommand}" />
                            <Button Content="{loc:Loc ImageDrawLoadAnyway}" Command="{Binding GenerateAnywayCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasResult}">
                        <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="image-edit"
                                          ToolTip.Tip="{loc:Loc ImageDrawEditResult}" Command="{Binding EditResultCommand}" />
                        <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="copy"
                                          ToolTip.Tip="{loc:Loc Copy}" Command="{Binding CopyCommand}" />
                        <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="save"
                                          ToolTip.Tip="{loc:Loc ImageDrawSaveAs}" Command="{Binding SaveAsCommand}" />
                        <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="eye"
                                          ToolTip.Tip="{loc:Loc ImageDrawPin}" Command="{Binding PinCommand}" />
                        <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="folder-open"
                                          ToolTip.Tip="{loc:Loc ShowInExplorer}" Command="{Binding OpenFolderCommand}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
