<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             x:Class="UiharuMind.Features.Models.EngineStatusStrip"
             x:Name="Root">
    <!-- 已装模型页签里本地引擎的状态条：圆点 + 说明，右边跑着时释放内存、再是引擎设置 -->
    <Border Classes="result-panel" Padding="12,4">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                        Margin="12,0,0,0">
                <Button Classes="toolbar-link" Content="{loc:Loc LocalEngineRelease}"
                        ToolTip.Tip="{loc:Loc LocalEngineReleaseTip}"
                        IsVisible="{Binding #Root.Status.IsRunning, FallbackValue=False}"
                        Command="{Binding #Root.Status.ReleaseCommand, FallbackValue={x:Null}}" />
                <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="settings"
                                  ToolTip.Tip="{loc:Loc LocalEngineSettingsTip}"
                                  IsVisible="{Binding #Root.Status.HasSettings, FallbackValue=False}"
                                  Command="{Binding #Root.Status.OpenSettingsCommand, FallbackValue={x:Null}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Classes="status-dot" Tag="Ready" IsVisible="{Binding #Root.Status.IsRunning, FallbackValue=False}"
                        VerticalAlignment="Center" />
                <Border Classes="status-dot" Tag="Idle" IsVisible="{Binding !#Root.Status.IsRunning, FallbackValue=True}"
                        VerticalAlignment="Center" />
                <TextBlock Text="{Binding #Root.Status.Text, FallbackValue=''}" FontSize="12" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
