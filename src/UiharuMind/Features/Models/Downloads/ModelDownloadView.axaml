<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:downloads="clr-namespace:UiharuMind.Features.Models.Downloads"
             xmlns:audio="clr-namespace:UiharuMind.Features.Models.Downloads.Audio"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="UiharuMind.Features.Models.Downloads.ModelDownloadView"
             x:DataType="downloads:ModelDownloadPageData">

    <UserControl.Styles>
        <!-- 与服务页同一套卡片：浅底、细框、8 圆角 -->
        <Style Selector="Border.download-card">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey2}" />
            <Setter Property="Background" Value="{DynamicResource SemiGrey0}" />
        </Style>
        <Style Selector="ListBox.repo-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <!-- 行间细分隔线（参照 Jan 的模型列表），悬停/选中铺整行底色 -->
        <Style Selector="ListBox.repo-list ListBoxItem">
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey1}" />
        </Style>
        <Style Selector="ListBox.repo-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
        </Style>
        <Style Selector="ListBox.repo-list ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SemiBlue0}" />
        </Style>
        <!-- 抽屉的返回钮只在窄窗出现 -->
        <Style Selector="Button.drawer-back">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="downloads|ModelDownloadView.narrow Button.drawer-back">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- 详情里的下载行：表格式，行间细分隔线（参照 Jan），不给每行套框；推荐行淡蓝底。两个分类共用 -->
        <Style Selector="Border.quant-row">
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey1}" />
        </Style>
        <Style Selector="Border.quant-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
        </Style>
        <Style Selector="Border.quant-row.recommended">
            <Setter Property="Background" Value="{DynamicResource SemiBlue0}" />
        </Style>
        <Style Selector="Button.quant-action">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Border.feature-tag">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey2}" />
        </Style>
        <!-- 分类切换：分段按钮 -->
    </UserControl.Styles>

    <DockPanel Margin="0,14,0,0">
        <downloads:DownloadQueueView DockPanel.Dock="Bottom" DataContext="{Binding Queue}" Margin="0,12,0,0" />

        <!-- 窄窗时详情盖在列表上（见后台代码），宽窗左右两栏。两栏内容都按当前分类的类型挑模板 -->
        <Grid x:Name="BodyGrid" ColumnDefinitions="1*,1.45*" ColumnSpacing="16">
            <DockPanel x:Name="ListPane" MinWidth="240">
                <ListBox DockPanel.Dock="Top" Classes="segmented" Margin="0,0,0,12"
                         ItemsSource="{Binding Markets}" SelectedItem="{Binding SelectedMarket}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="downloads:IModelMarket">
                            <TextBlock Text="{Binding Title}" FontSize="13" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ContentControl Content="{Binding SelectedMarket}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="downloads:GgufMarketData" x:DataType="downloads:GgufMarketData">
                            <downloads:GgufMarketListView />
                        </DataTemplate>
                        <DataTemplate DataType="audio:AudioMarketData" x:DataType="audio:AudioMarketData">
                            <audio:AudioMarketListView />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </DockPanel>

            <Border x:Name="DetailPane" Grid.Column="1" Classes="download-card" Padding="18,16">
                <ContentControl Content="{Binding SelectedMarket}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="downloads:GgufMarketData" x:DataType="downloads:GgufMarketData">
                            <Panel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                            IsVisible="{Binding !HasDetail}">
                                    <controls:ThemedSvgIcon Width="28" Height="28" IconName="download" Opacity="0.35" />
                                    <TextBlock Classes="muted" Text="{loc:Loc ModelDownloadPickRepo}" TextAlignment="Center" />
                                </StackPanel>
                                <downloads:ModelRepoDetailView DataContext="{Binding Detail}" IsVisible="{Binding $parent[Panel].((downloads:GgufMarketData)DataContext).HasDetail}" />
                            </Panel>
                        </DataTemplate>
                        <DataTemplate DataType="audio:AudioMarketData" x:DataType="audio:AudioMarketData">
                            <Panel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                            IsVisible="{Binding !HasDetail}">
                                    <controls:ThemedSvgIcon Width="28" Height="28" IconName="audio-lines" Opacity="0.35" />
                                    <TextBlock Classes="muted" Text="{loc:Loc AudioMarketPickFamily}" TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <audio:AudioFamilyDetailView DataContext="{Binding Detail}" IsVisible="{Binding $parent[Panel].((audio:AudioMarketData)DataContext).HasDetail}" />
                            </Panel>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
