<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:downloads="clr-namespace:UiharuMind.Features.Models.Downloads"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="200"
             x:Class="UiharuMind.Features.Models.Downloads.DownloadQueueView"
             x:DataType="downloads:DownloadQueueViewData"
             IsVisible="{Binding HasItems}">

    <UserControl.Styles>
        <Style Selector="Button.job-action">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Button.job-action:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- 标题行文字用正文色：按钮主题给的是强调色 -->
        <Style Selector="Button.queue-header TextBlock:not(.muted)">
            <Setter Property="Foreground" Value="{Binding $parent[downloads:DownloadQueueView].Foreground}" />
        </Style>
    </UserControl.Styles>

    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource SemiGrey2}"
            Background="{DynamicResource SemiGrey0}" Padding="14,8">
        <DockPanel>
            <Button DockPanel.Dock="Top" Classes="NoneStyle queue-header" Cursor="Hand" Padding="0,2"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Command="{Binding ToggleExpandedCommand}">
                <DockPanel>
                    <Panel DockPanel.Dock="Right" VerticalAlignment="Center" Opacity="0.6">
                        <controls:ThemedSvgIcon Width="14" Height="14" IconName="chevron-down"
                                                IsVisible="{Binding IsExpanded}" />
                        <controls:ThemedSvgIcon Width="14" Height="14" IconName="chevron-up"
                                                IsVisible="{Binding !IsExpanded}" />
                    </Panel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:ThemedSvgIcon Width="14" Height="14" IconName="download" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Loc ModelDownloadQueueTitle}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Button>

            <ScrollViewer MaxHeight="168" Margin="0,8,0,0" IsVisible="{Binding IsExpanded}"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="downloads:DownloadJobItemData">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Classes="muted"
                                                   FontSize="12" Margin="12,0,0,0" ToolTip.Tip="{Binding Detail}"
                                                   MaxWidth="320" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Name}" />
                                    </DockPanel>
                                    <ProgressBar Value="{Binding Percent}" Maximum="100" Height="3" MinHeight="3" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button Classes="NoneStyle job-action" ToolTip.Tip="{loc:Loc ModelDownloadPause}"
                                            IsVisible="{Binding CanPause}"
                                            Command="{Binding $parent[ItemsControl].((downloads:DownloadQueueViewData)DataContext).PauseCommand}"
                                            CommandParameter="{Binding}">
                                        <controls:ThemedSvgIcon Width="14" Height="14" IconName="pause" />
                                    </Button>
                                    <Button Classes="NoneStyle job-action" ToolTip.Tip="{loc:Loc ModelDownloadResume}"
                                            IsVisible="{Binding CanResume}"
                                            Command="{Binding $parent[ItemsControl].((downloads:DownloadQueueViewData)DataContext).ResumeCommand}"
                                            CommandParameter="{Binding}">
                                        <controls:ThemedSvgIcon Width="14" Height="14" IconName="play" />
                                    </Button>
                                    <Button Classes="NoneStyle job-action" ToolTip.Tip="{loc:Loc ModelDownloadCancel}"
                                            Command="{Binding $parent[ItemsControl].((downloads:DownloadQueueViewData)DataContext).CancelCommand}"
                                            CommandParameter="{Binding}">
                                        <controls:ThemedSvgIcon Width="14" Height="14" IconName="x" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
