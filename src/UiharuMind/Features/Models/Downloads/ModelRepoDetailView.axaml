<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:downloads="clr-namespace:UiharuMind.Features.Models.Downloads"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="UiharuMind.Features.Models.Downloads.ModelRepoDetailView"
             x:DataType="downloads:ModelRepoDetailData">

    <UserControl.Styles>
        <!-- 量化行：表格式，行间细分隔线（参照 Jan），不给每行套框；推荐行淡蓝底 -->
        <Style Selector="Border.quant-row">
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey1}" />
        </Style>
        <Style Selector="Border.quant-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
        </Style>
        <Style Selector="Border.quant-row.recommended">
            <Setter Property="Background" Value="{DynamicResource SemiBlue0}" />
        </Style>
        <Style Selector="Button.detail-tab">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.detail-tab TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey6}" />
        </Style>
        <Style Selector="Button.detail-tab.active TextBlock">
            <Setter Property="Foreground" Value="{Binding $parent[downloads:ModelRepoDetailView].Foreground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.tab-underline">
            <Setter Property="Height" Value="2" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.detail-tab.active Border.tab-underline">
            <Setter Property="Background" Value="{DynamicResource SemiBlue5}" />
        </Style>
        <Style Selector="Button.quant-action">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- 标题：仓库名为主，作者与概况弱化 -->
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Left" Classes="NoneStyle drawer-back" Padding="4" Margin="-4,0,6,0"
                    Cursor="Hand" VerticalAlignment="Top"
                    Command="{Binding $parent[downloads:ModelDownloadView].((downloads:ModelDownloadPageData)DataContext).CloseDetailCommand}">
                <controls:ThemedSvgIcon Width="18" Height="18" IconName="arrow-left" />
            </Button>
            <StackPanel Spacing="3">
                <SelectableTextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="12">
                    <Run Text="{Binding Owner}" />
                    <Run Text="  ·  " />
                    <Run Text="{Binding SummaryText}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" MinHeight="2" Margin="0,12,0,0"
                     IsVisible="{Binding IsLoading}" />

        <!-- 受限仓库：就地提示，不弹窗 -->
        <Border DockPanel.Dock="Top" Classes="result-panel" Margin="0,14,0,0" IsVisible="{Binding NeedsToken}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:Loc ModelDownloadGoToSettings}" Classes="quant-action"
                        Command="{Binding OpenSourceSettingsCommand}" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Loc ModelDownloadNeedsToken}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,14,0,0"
                   Text="{Binding ErrorText}"
                   IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="0,14,0,0" Text="{loc:Loc ModelDownloadNoQuants}"
                   IsVisible="{Binding IsEmpty}" />

        <!-- 视觉投影：随主模型一起下 -->
        <Border DockPanel.Dock="Top" Classes="result-panel" Margin="0,14,0,0" Padding="10,6"
                IsVisible="{Binding ShowProjectorOption}">
            <CheckBox IsChecked="{Binding IncludeProjector}" FontSize="13">
                <TextBlock Text="{Binding ProjectorText}" TextWrapping="Wrap" />
            </CheckBox>
        </Border>

        <!-- 页签：可下载文件 / 模型说明（说明第一次切过去才拉） -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="20" Margin="2,16,0,0"
                    IsVisible="{Binding !IsEmpty}">
            <Button Classes="NoneStyle detail-tab" Classes.active="{Binding !IsReadmeTab}"
                    Command="{Binding ShowFilesCommand}">
                <StackPanel Spacing="5">
                    <TextBlock Text="{loc:Loc ModelDownloadFilesHeader}" />
                    <Border Classes="tab-underline" />
                </StackPanel>
            </Button>
            <Button Classes="NoneStyle detail-tab" Classes.active="{Binding IsReadmeTab}"
                    Command="{Binding ShowReadmeCommand}">
                <StackPanel Spacing="5">
                    <TextBlock Text="{loc:Loc ModelDownloadReadmeTab}" />
                    <Border Classes="tab-underline" />
                </StackPanel>
            </Button>
        </StackPanel>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource SemiGrey2}" Margin="0,0,0,4"
                IsVisible="{Binding !IsEmpty}" />

        <Panel>
            <Panel IsVisible="{Binding IsReadmeTab}">
                <ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" VerticalAlignment="Top"
                             IsVisible="{Binding IsReadmeLoading}" />
                <TextBlock Classes="muted" Margin="2,12" TextWrapping="Wrap" Text="{Binding ReadmeStatus}"
                           IsVisible="{Binding ReadmeStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <!-- 分段渲染：只建进了视口的段，长说明也不卡 -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <controls:ChunkedMarkdownViewer x:Name="ReadmeViewer" Margin="2,10,8,10" />
                </ScrollViewer>
            </Panel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsReadmeTab}">
            <ItemsControl x:Name="QuantList" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="downloads:ModelQuantRowData">
                        <Border Classes="quant-row" Classes.recommended="{Binding IsRecommended}">
                            <Grid ColumnDefinitions="Auto,*,72,Auto" ColumnSpacing="12">
                                <!-- 圆点只有 8px，套一层透明底放大悬停区 -->
                                <Panel Width="16" Height="24" Background="Transparent" ToolTip.Tip="{Binding RiskTip}">
                                    <Border Classes="status-dot" Tag="{Binding RiskTag}" HorizontalAlignment="Center" />
                                </Panel>

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <!-- 实底白字：KindBadge 写死深色字，暗色主题下读不清 -->
                                        <Border Background="{DynamicResource SemiBlue5}" CornerRadius="9" Padding="7,1"
                                                VerticalAlignment="Center" IsVisible="{Binding IsRecommended}">
                                            <TextBlock Text="{loc:Loc ModelDownloadRecommended}" FontSize="11"
                                                       Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{Binding PartsText}" Classes="muted" FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- 状态行：下载相关时带一条细进度 -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressBar Value="{Binding Percent}" Maximum="100" Width="90"
                                                     Height="3" MinHeight="3" VerticalAlignment="Center"
                                                     IsVisible="{Binding ShowProgress}" />
                                        <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12"
                                                   ToolTip.Tip="{Binding ConflictTip}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource SemiGrey7}" />

                                <Panel Grid.Column="3" VerticalAlignment="Center" MinWidth="64">
                                    <Button Classes="quant-action" Content="{Binding ActionText}"
                                            IsVisible="{Binding !IsDownloaded}"
                                            IsEnabled="{Binding CanDownload}"
                                            ToolTip.Tip="{Binding ConflictTip}"
                                            Command="{Binding $parent[ItemsControl].((downloads:ModelRepoDetailData)DataContext).DownloadCommand}"
                                            CommandParameter="{Binding}" />
                                    <controls:ThemedSvgIcon Width="16" Height="16" IconName="check"
                                                            HorizontalAlignment="Center"
                                                            IsVisible="{Binding IsDownloaded}" />
                                </Panel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
