<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:downloads="clr-namespace:UiharuMind.Features.Models.Downloads"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             x:Class="UiharuMind.Features.Models.Downloads.GgufMarketListView"
             x:DataType="downloads:GgufMarketData">

    <DockPanel>
        <!-- 放大镜叠在框内左侧，与会话列表的搜索框同式 -->
        <Grid DockPanel.Dock="Top">
            <TextBox Text="{Binding SearchText}" Padding="31,7,8,7"
                     PlaceholderText="{loc:Loc ModelDownloadSearchHint}" />
            <controls:ThemedSvgIcon Width="15" Height="15" Margin="10,0,0,0" IconName="search"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    IsHitTestVisible="False" />
        </Grid>

        <!-- 排序优先占位，窄栏时让下载源那行去截断 -->
        <DockPanel DockPanel.Dock="Top" Margin="2,12,2,6">
            <ComboBox DockPanel.Dock="Left" Classes="Small" VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip.Tip="{loc:Loc ModelSearchSortTip}"
                      ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="downloads:ModelSearchSortOption">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <downloads:DownloadSourceButton HorizontalAlignment="Right" Label="{Binding SourceLabel}"
                                           Command="{Binding OpenSourceSettingsCommand}" />
        </DockPanel>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" MinHeight="2"
                     Margin="0,0,0,4" IsVisible="{Binding IsSearching}" />
        <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="2,8"
                   Text="{Binding SearchError}"
                   IsVisible="{Binding SearchError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="2,8"
                   Text="{loc:Loc ModelDownloadNoResults}" IsVisible="{Binding IsResultEmpty}" />

        <ProgressBar DockPanel.Dock="Bottom" IsIndeterminate="True" Height="2" MinHeight="2"
                     Margin="0,4,0,0" IsVisible="{Binding IsLoadingMore}" />

        <ListBox x:Name="ResultList" Classes="repo-list" ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="downloads:ModelRepoListItem">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" ToolTip.Tip="{Binding Repository}">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Owner}" Classes="muted" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3"
                                    VerticalAlignment="Center" Opacity="0.7">
                            <controls:ThemedSvgIcon Width="12" Height="12" IconName="{Binding MetricIcon}" />
                            <TextBlock Text="{Binding MetricText}" Classes="muted" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
