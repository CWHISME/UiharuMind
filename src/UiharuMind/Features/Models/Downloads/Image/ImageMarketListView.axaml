<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:image="clr-namespace:UiharuMind.Features.Models.Downloads.Image"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             x:Class="UiharuMind.Features.Models.Downloads.Image.ImageMarketListView"
             x:DataType="image:ImageMarketData">

    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <TextBox Text="{Binding SearchText}" Padding="31,7,8,7"
                     PlaceholderText="{loc:Loc ImageMarketSearchHint}" />
            <controls:ThemedSvgIcon Width="15" Height="15" Margin="10,0,0,0" IconName="search"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    IsHitTestVisible="False" />
        </Grid>

        <Button DockPanel.Dock="Top" Classes="NoneStyle" Cursor="Hand" Padding="0" Margin="2,12,2,6"
                HorizontalAlignment="Right" ToolTip.Tip="{loc:Loc ModelDownloadSourceTip}"
                Command="{Binding OpenSourceSettingsCommand}">
            <DockPanel>
                <controls:ThemedSvgIcon DockPanel.Dock="Right" Width="12" Height="12" Margin="4,0,0,0"
                                        IconName="settings" Opacity="0.6" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SourceLabel}" Classes="muted" FontSize="12" FontWeight="Normal"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Button>

        <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="2,8" Text="{loc:Loc ImageMarketNoResults}"
                   IsVisible="{Binding IsResultEmpty}" />

        <!-- 没装引擎：列表照常可看可下，顶上提示装引擎 -->
        <Border DockPanel.Dock="Top" Classes="result-panel" Padding="10,8" Margin="0,0,0,8"
                IsVisible="{Binding ShowEnginePrompt}">
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Loc ImageMarketNeedsEngine}" TextWrapping="Wrap" FontSize="12" />
                <Panel HorizontalAlignment="Left">
                    <Button Classes="Primary" Content="{loc:Loc ImageInstallEngine}"
                            Command="{Binding InstallEngineCommand}" IsVisible="{Binding !IsEngineQueued}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsEngineQueued}">
                        <SpinnerIcon VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Loc ImageMarketEngineInstalling}" Classes="muted"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Panel>
            </StackPanel>
        </Border>

        <ListBox Classes="repo-list" ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="image:ImageFamilyListItem">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <Border Background="{DynamicResource SemiBlue5}" CornerRadius="8" Padding="6,0"
                                        VerticalAlignment="Center" IsVisible="{Binding IsRecommended}">
                                    <TextBlock Text="{loc:Loc ModelDownloadRecommended}" FontSize="10" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding SubText}" Classes="muted" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc ImageFamilyUntested}" Classes="muted" FontSize="11"
                                       VerticalAlignment="Center" ToolTip.Tip="{loc:Loc ImageFamilyUntestedTip}"
                                       IsVisible="{Binding IsUntested}" />
                            <controls:ThemedSvgIcon Width="14" Height="14" IconName="check" Opacity="0.75"
                                                    ToolTip.Tip="{loc:Loc ImageFamilyInstalledTip}"
                                                    IsVisible="{Binding IsInstalled}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
