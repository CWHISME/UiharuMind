<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:UiharuMind.Features.Models"
        xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
        xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="620"
        x:Class="UiharuMind.Features.Models.CreateRemoteLlmModelWindow" x:DataType="common:RemoteModelEditViewData"
        Width="860"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc RemoteModelWindowTitle}">

    <Design.DataContext>
        <common:RemoteModelEditViewData />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.error">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MessageStatusErrorBrush}" />
        </Style>
        <Style Selector="Button.copy-chip">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SemiGrey0}">

        <!-- 头部:图标 + 标题 -->
        <Border Padding="18,15" BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="50,*" ColumnSpacing="12">
                <Border Width="50" Height="50" CornerRadius="8"
                        Background="{DynamicResource SemiBlue0}">
                    <controls:ThemedSvgIcon Width="24" Height="24" IconName="bot" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{loc:Loc RemoteModelCreateTitle}" FontSize="20"
                               IsVisible="{Binding !IsEditMode}" />
                    <TextBlock Text="{loc:Loc RemoteModelEditTitle}" FontSize="20"
                               IsVisible="{Binding IsEditMode}" />
                    <TextBlock Text="{loc:Loc RemoteModelSelectProviderHint}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding !IsEditMode}" />
                    <TextBlock Text="{loc:Loc RemoteModelConfigHint}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding IsEditMode}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体:左侧服务商列表 / 右侧配置详情 -->
        <Grid Grid.Row="1" ColumnDefinitions="230,*">

            <Border BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="{loc:Loc RemoteModelSelectProviderTitle}"
                               Margin="16,14,16,8" />
                    <ListBox Grid.Row="1" Background="Transparent"
                             ItemsSource="{Binding Providers}"
                             SelectedItem="{Binding SelectedProvider}"
                             IsEnabled="{Binding !IsEditMode}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="14" />
                                    <TextBlock Text="{Binding DefaultEndpoint}" Classes="muted"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding DefaultEndpoint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Margin="18" Spacing="14">

                    <!-- 当前服务商下的已有模型:一键复制 -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasCopySources}">
                        <TextBlock Text="{loc:Loc RemoteModelCopyFromExisting}" />
                        <TextBlock Text="{loc:Loc RemoteModelCopyFromExistingHint}" Classes="muted"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding CopySources}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="copy-chip" Margin="0,0,8,8"
                                            Content="{Binding ModelName}"
                                            ToolTip.Tip="{Binding ModelPath}"
                                            Command="{Binding ((common:RemoteModelEditViewData)DataContext).SelectCopySourceCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc ApiKey}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding ApiKey}" PasswordChar="*"
                                     PlaceholderText="{loc:Loc RemoteModelApiKeyPlaceholder}" />
                            <Button Grid.Column="1" VerticalAlignment="Stretch" Padding="14,0"
                                    Click="OpenWebsite_Click"
                                    IsVisible="{Binding CanOpenProviderWebsite}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:ThemedSvgIcon Width="14" Height="14" IconName="square-arrow-out-up-right" />
                                    <TextBlock Text="{loc:Loc RemoteModelOpenWebsite}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{loc:Loc RemoteModelApiKeyHint}" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock Classes="error" Text="{loc:Loc NotInputModelApiKey}"
                                   IsVisible="{Binding HasApiKeyError}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc RemoteModelNameLabel}" />
                        <TextBox Text="{Binding ModelName}"
                                 PlaceholderText="{loc:Loc RemoteModelNamePlaceholder}" />
                        <TextBlock Text="{loc:Loc RemoteModelNameHint}" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock Classes="error" Text="{loc:Loc NotInputModelNameTips}"
                                   IsVisible="{Binding HasNameError}" />
                        <TextBlock Classes="error" Text="{loc:Loc RepeatModelNameTips}"
                                   IsVisible="{Binding HasDuplicateNameError}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc RemoteModelIdLabel}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <!-- 候选选择器：一个输入框 + 右侧箭头，箭头开的是带排序头的浮层。
                                 刻意不用 ComboBox：它的弹层里只有 ItemsPresenter，塞不进排序行，
                                 排序控件就只剩「挂在框外」一条路——那会把这一行的排版带歪 -->
                            <Panel x:Name="ModelIdPickerHost">
                                <TextBox x:Name="ModelIdBox"
                                         Text="{Binding ModelId}"
                                         PlaceholderText="{loc:Loc RemoteModelIdPlaceholder}"
                                         Padding="10,0,30,0" />
                                <Button x:Name="ModelIdDropDownButton"
                                        Classes="picker-arrow"
                                        IsVisible="{Binding HasModelIdOptions}"
                                        Click="ToggleModelPicker_Click">
                                    <Path Data="M0,0 L4.5,4.5 L9,0"
                                          Stroke="{DynamicResource SemiGrey6}"
                                          StrokeThickness="1.4" />
                                </Button>
                                <!-- 浮层：顶部是按单价的排序头（只有存在价格时出现），下面是候选列表 -->
                                <Popup x:Name="ModelIdPopup"
                                       IsOpen="{Binding IsModelPickerOpen, Mode=TwoWay}"
                                       PlacementTarget="{Binding #ModelIdPickerHost}"
                                       Placement="BottomEdgeAlignedLeft"
                                       VerticalOffset="4"
                                       IsLightDismissEnabled="True"
                                       MinWidth="{Binding #ModelIdPickerHost.Bounds.Width}">
                                    <Border Background="{DynamicResource ComboBoxPopupBackground}"
                                            BorderBrush="{DynamicResource ComboBoxPopupBorderBrush}"
                                            BorderThickness="{DynamicResource ComboBoxPopupBorderThickness}"
                                            BoxShadow="{DynamicResource ComboBoxPopupBoxShadow}"
                                            CornerRadius="{DynamicResource ComboBoxPopupBoxCornerRadius}"
                                            Padding="6">
                                        <Grid RowDefinitions="Auto,*">
                                            <ListBox Grid.Row="0"
                                                     Classes="segmented stretch"
                                                     ItemsSource="{Binding SortOptions}"
                                                     SelectedItem="{Binding SelectedSortOption}"
                                                     IsVisible="{Binding HasSortablePrices}"
                                                     Margin="0,2,0,6"
                                                     ToolTip.Tip="{loc:Loc RemoteModelSortTip}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="common:ModelSortOption">
                                                        <TextBlock Text="{Binding Display}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <ScrollViewer Grid.Row="1" MaxHeight="300"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding VisibleModelIdOptions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="common:ModelIdOptionItem">
                                                            <Button Classes="model-option" Click="ModelOption_Click">
                                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding ContextDisplay}"
                                                                               Classes="muted" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding PriceDisplay}"
                                                                               Classes="muted" VerticalAlignment="Center" />
                                                                    <controls:ModelStateBadges IsVision="{Binding IsVision}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Panel>
                            <Button Grid.Column="1"
                                    Content="{loc:Loc RemoteModelCatalogFetch}"
                                    Command="{Binding RefreshCatalogCommand}"
                                    IsEnabled="{Binding !IsFetchingCatalog}"
                                    IsVisible="{Binding HasCatalog}"
                                    VerticalAlignment="Stretch"
                                    Padding="14,0" />
                        </Grid>
                        <TextBlock Text="{loc:Loc RemoteModelIdHint}" Classes="muted" TextWrapping="Wrap" />
                        <!-- 选中模型的能力摘要：上下文、挂牌单价、声明的思考档位 -->
                        <TextBlock Text="{Binding SelectedCapabilitySummary}" Classes="muted" TextWrapping="Wrap"
                                   IsVisible="{Binding SelectedCapabilitySummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Classes="error" Text="{loc:Loc RemoteModelCatalogFetchFailed}"
                                   IsVisible="{Binding CatalogFetchErrorVisible}" />
                        <TextBlock Classes="error" Text="{loc:Loc NotInputModelIdTips}"
                                   IsVisible="{Binding HasModelIdError}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc RemoteModelContextLengthLabel}" />
                        <ComboBox IsEditable="True"
                                  ItemsSource="{Binding ContextLengthOptions}"
                                  Text="{Binding ContextLengthText}"
                                  PlaceholderText="{loc:Loc RemoteModelContextLengthPlaceholder}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Text="{loc:Loc RemoteModelContextLengthHint}" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock Classes="error" Text="{loc:Loc RemoteModelContextLengthInvalid}"
                                   IsVisible="{Binding HasContextLengthError}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc RemoteModelThinkingModeLabel}" />
                        <ComboBox ItemsSource="{Binding ThinkingModeOptions}"
                                  SelectedIndex="{Binding ThinkingModeIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="common:ThinkingModeOptionItem">
                                    <TextBlock Text="{Binding Display}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{loc:Loc RemoteModelThinkingModeHint}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 自定义配置:接口地址等全部平铺 -->
                    <StackPanel Spacing="14" IsVisible="{Binding !IsPresetProvider}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc RemoteModelCatalogUrlLabel}" />
                            <TextBox Text="{Binding CatalogUrlText}"
                                     PlaceholderText="{loc:Loc RemoteModelCatalogUrlPlaceholder}" />
                            <TextBlock Text="{loc:Loc RemoteModelCatalogUrlHint}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc RemoteModelPathLabel}" />
                            <TextBox Text="{Binding ModelPath}"
                                     PlaceholderText="{loc:Loc RemoteModelPathPlaceholder}" />
                            <TextBlock Text="{loc:Loc RemoteModelPathHint}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc RemoteModelDescriptionLabel}" />
                            <TextBox Text="{Binding ModelDescription}" MinHeight="80" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10"
                                     PlaceholderText="{loc:Loc RemoteModelDescriptionPlaceholder}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc RemoteModelVisionLabel}" />
                                <TextBlock Text="{loc:Loc RemoteModelVisionHint}" Classes="muted"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsChecked="{Binding IsVision}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc RemoteModelOmitSamplingParamsLabel}" />
                                <TextBlock Text="{loc:Loc RemoteModelOmitSamplingParamsHint}" Classes="muted"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsChecked="{Binding OmitSamplingParams}" />
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc RemoteModelReasoningRoundtripLabel}" />
                            <TextBlock Text="{loc:Loc RemoteModelReasoningRoundtripHint}" Classes="muted"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
                                <RadioButton GroupName="ReasoningRoundtrip"
                                             Content="{loc:Loc RemoteModelReasoningRoundtripAutoDetect}"
                                             IsChecked="{Binding IsReasoningRoundtripAutoDetect}" />
                                <RadioButton GroupName="ReasoningRoundtrip"
                                             Content="{loc:Loc RemoteModelReasoningRoundtripForceOn}"
                                             IsChecked="{Binding IsReasoningRoundtripForceOn}" />
                                <RadioButton GroupName="ReasoningRoundtrip"
                                             Content="{loc:Loc RemoteModelReasoningRoundtripForceOff}"
                                             IsChecked="{Binding IsReasoningRoundtripForceOff}" />
                            </StackPanel>
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       IsVisible="{Binding IsReasoningRoundtripPresetAuto}"
                                       Text="{loc:Loc RemoteModelReasoningRoundtripPresetAuto}" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       IsVisible="{Binding PresetReplaysExistingReasoning}"
                                       Text="{loc:Loc RemoteModelReasoningRoundtripPresetOn}" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       IsVisible="{Binding IsReasoningRoundtripPresetOff}"
                                       Text="{loc:Loc RemoteModelReasoningRoundtripPresetOff}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc RemoteModelMaxTokensLabel}" />
                            <TextBox Text="{Binding MaxTokensText}"
                                     PlaceholderText="{Binding MaxTokensPlaceholder}"
                                     HorizontalAlignment="Stretch" />
                            <TextBlock Text="{loc:Loc RemoteModelMaxTokensHint}" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock Classes="error" Text="{loc:Loc RemoteModelMaxTokensInvalid}"
                                       IsVisible="{Binding HasMaxTokensError}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 预设服务商:默认参数收进高级设置 -->
                    <Expander Header="{loc:Loc RemoteModelAdvancedSettings}"
                              HorizontalAlignment="Stretch"
                              IsVisible="{Binding IsPresetProvider}">
                        <StackPanel Spacing="14" Margin="0,8,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc RemoteModelPathLabel}" />
                                <TextBox Text="{Binding ModelPath}"
                                         PlaceholderText="{loc:Loc RemoteModelPathPlaceholder}" />
                                <TextBlock Text="{loc:Loc RemoteModelPathHint}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc RemoteModelDescriptionLabel}" />
                                <TextBox Text="{Binding ModelDescription}" MinHeight="80" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10"
                                         PlaceholderText="{loc:Loc RemoteModelDescriptionPlaceholder}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc RemoteModelVisionLabel}" />
                                    <TextBlock Text="{loc:Loc RemoteModelVisionHint}" Classes="muted"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                              IsChecked="{Binding IsVision}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc RemoteModelOmitSamplingParamsLabel}" />
                                    <TextBlock Text="{loc:Loc RemoteModelOmitSamplingParamsHint}" Classes="muted"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                              IsChecked="{Binding OmitSamplingParams}" />
                            </Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc RemoteModelReasoningRoundtripLabel}" />
                                <TextBlock Text="{loc:Loc RemoteModelReasoningRoundtripHint}" Classes="muted"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
                                    <RadioButton GroupName="ReasoningRoundtripPreset"
                                                 Content="{loc:Loc RemoteModelReasoningRoundtripAutoDetect}"
                                                 IsChecked="{Binding IsReasoningRoundtripAutoDetect}" />
                                    <RadioButton GroupName="ReasoningRoundtripPreset"
                                                 Content="{loc:Loc RemoteModelReasoningRoundtripForceOn}"
                                                 IsChecked="{Binding IsReasoningRoundtripForceOn}" />
                                    <RadioButton GroupName="ReasoningRoundtripPreset"
                                                 Content="{loc:Loc RemoteModelReasoningRoundtripForceOff}"
                                                 IsChecked="{Binding IsReasoningRoundtripForceOff}" />
                                </StackPanel>
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           IsVisible="{Binding IsReasoningRoundtripPresetAuto}"
                                           Text="{loc:Loc RemoteModelReasoningRoundtripPresetAuto}" />
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           IsVisible="{Binding PresetReplaysExistingReasoning}"
                                           Text="{loc:Loc RemoteModelReasoningRoundtripPresetOn}" />
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           IsVisible="{Binding IsReasoningRoundtripPresetOff}"
                                           Text="{loc:Loc RemoteModelReasoningRoundtripPresetOff}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc RemoteModelMaxTokensLabel}" />
                                <TextBox Text="{Binding MaxTokensText}"
                                         PlaceholderText="{Binding MaxTokensPlaceholder}"
                                         HorizontalAlignment="Stretch" />
                                <TextBlock Text="{loc:Loc RemoteModelMaxTokensHint}" Classes="muted" TextWrapping="Wrap" />
                                <TextBlock Classes="error" Text="{loc:Loc RemoteModelMaxTokensInvalid}"
                                           IsVisible="{Binding HasMaxTokensError}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部按钮条 -->
        <Border Grid.Row="2" Padding="14" BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Loc CancelBtn}" Click="CancelButton_Click" />
                <Button IsEnabled="{Binding CanConfirm}" Click="ConfirmButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:ThemedSvgIcon Width="15" Height="15" IconName="save" />
                        <TextBlock Text="{loc:Loc CreateBtn}" IsVisible="{Binding !IsEditMode}" />
                        <TextBlock Text="{loc:Loc SaveBtn}" IsVisible="{Binding IsEditMode}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
