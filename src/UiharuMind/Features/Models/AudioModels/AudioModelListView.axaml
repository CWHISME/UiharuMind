<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:UiharuMind.Features.Models.AudioModels"
             xmlns:voices="clr-namespace:UiharuMind.Features.Models.AudioModels.Voices"
             xmlns:online="clr-namespace:UiharuMind.Features.Models.AudioModels.Online"
             xmlns:pages="clr-namespace:UiharuMind.Features.Models"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             x:Class="UiharuMind.Features.Models.AudioModels.AudioModelListView"
             x:DataType="models:AudioModelListViewData">

    <UserControl.Styles>
        <Style Selector="TextBlock.group-header">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="14,12,14,6" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- 在线服务一行：朗读、听写两组共用；试听只有朗读的有 -->
        <DataTemplate x:Key="OnlineServiceRow" x:DataType="online:AudioServiceItemData">
            <Border Classes="model-row">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Classes="model-icon">
                        <controls:ThemedSvgIcon Width="18" Height="18" IconName="globe" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <controls:ModelStateBadges IsRemote="True" VerticalAlignment="Center" />
                            <Border Classes="default-badge" IsVisible="{Binding IsDefault}">
                                <Panel>
                                    <TextBlock Text="{loc:Loc AudioModelsDefaultTts}" Classes="line-tight"
                                               IsVisible="{Binding IsTts}" />
                                    <TextBlock Text="{loc:Loc AudioModelsDefaultAsr}" Classes="line-tight"
                                               IsVisible="{Binding !IsTts}" />
                                </Panel>
                            </Border>
                            <Button Classes="toolbar-link set-default" Content="{loc:Loc ModelSetDefault}"
                                    ToolTip.Tip="{loc:Loc AudioPackageSetDefaultTip}" IsVisible="{Binding !IsDefault}"
                                    Command="{Binding $parent[UserControl].((models:AudioModelListViewData)DataContext).Online.SetDefaultCommand}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Panel Width="28" Height="28" IsVisible="{Binding IsTts}">
                            <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="play"
                                              ToolTip.Tip="{loc:Loc AudioPreviewTip}" IsVisible="{Binding !IsPreviewing}"
                                              Command="{Binding $parent[UserControl].((models:AudioModelListViewData)DataContext).Online.PreviewCommand}"
                                              CommandParameter="{Binding}" />
                            <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="stop" CurrentColor="Red"
                                              ToolTip.Tip="{loc:Loc AudioPreviewStopTip}" IsVisible="{Binding IsPreviewing}"
                                              Command="{Binding $parent[UserControl].((models:AudioModelListViewData)DataContext).Online.PreviewCommand}"
                                              CommandParameter="{Binding}" />
                        </Panel>
                        <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="pencil" ToolTip.Tip="{loc:Loc Edit}"
                                          Command="{Binding $parent[UserControl].((models:AudioModelListViewData)DataContext).Online.EditCommand}"
                                          CommandParameter="{Binding}" />
                        <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="trash-2" ToolTip.Tip="{loc:Loc Delete}"
                                          Command="{Binding $parent[UserControl].((models:AudioModelListViewData)DataContext).Online.DeleteCommand}"
                                          CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="0,14,0,0">
        <!-- 工具条：左边语音模型目录，右边获取模型与添加远程模型（在线服务）都由目录条统一下发 -->
        <pages:ModelFolderBar DockPanel.Dock="Top" Margin="0,0,0,12" Path="{Binding ModelsDirectory}"
                               OpenCommand="{Binding OpenFolderCommand}" RefreshCommand="{Binding RefreshCommand}"
                               GetModelsCommand="{Binding GoToMarketCommand}"
                               AddRemoteCommand="{Binding AddServiceCommand}" />

        <!-- 引擎状态：装没装、在不在跑、加载了几个、多久自动卸载（三个已装模型页签同一条） -->
        <pages:EngineStatusStrip DockPanel.Dock="Top" Margin="0,0,0,12" Status="{Binding EngineStatus}" />

        <Border Classes="model-card">
            <Panel>
                <ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" VerticalAlignment="Top"
                             IsVisible="{Binding IsLoading}" />

                <!-- 空状态：引去获取 -->
                <controls:EmptyStateView IsVisible="{Binding ShowEmpty}" IconName="audio-lines"
                                         Title="{loc:Loc AudioModelsEmptyTitle}" Hint="{loc:Loc AudioModelsEmptyHint}">
                    <controls:EmptyStateView.Actions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="Primary" Content="{loc:Loc ModelPageGetModelsBtn}" Command="{Binding GoToMarketCommand}" />
                            <Button Content="{loc:Loc ModelListAddRemote}" Command="{Binding AddServiceCommand}"
                                    IsVisible="{Binding Online, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </controls:EmptyStateView.Actions>
                </controls:EmptyStateView>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasAnything}">
                    <StackPanel>
                        <!-- 朗读分组标题，右边是语速：改完点试听就能听到 -->
                        <DockPanel IsVisible="{Binding HasTts}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="0,8,14,2"
                                        VerticalAlignment="Center" DataContext="{Binding Preferences}"
                                        x:DataType="models:AudioPreferencesViewData"
                                        IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}"
                                        ToolTip.Tip="{loc:Loc AudioSpeedTip}">
                                <Button Classes="toolbar-link" Content="{loc:Loc AudioSpeedReset}"
                                        IsVisible="{Binding IsSpeedChanged}" Command="{Binding ResetSpeedCommand}" />
                                <TextBlock Text="{loc:Loc AudioSpeed}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                                <Slider Width="140" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Speed}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SpeedText}" FontSize="12" Width="36" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Classes="group-header" Text="{loc:Loc AudioModelsTtsGroup}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding TtsModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AudioModelItemData">
                                    <Border Classes="model-row">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Classes="model-icon">
                                                <controls:ThemedSvgIcon Width="18" Height="18" IconName="audio-lines" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <controls:CenteredStackPanel Spacing="8">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Classes="default-badge" IsVisible="{Binding IsDefault}">
                                                        <TextBlock Text="{loc:Loc AudioModelsDefaultTts}" Classes="line-tight" />
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                                IsVisible="{Binding IsLoaded}"
                                                                ToolTip.Tip="{loc:Loc AudioModelsLoadedTip}">
                                                        <Border Classes="status-dot" Tag="Ready" VerticalAlignment="Center" />
                                                        <TextBlock Text="{loc:Loc AudioModelsLoaded}" FontSize="11"
                                                                   Foreground="{DynamicResource MessageStatusSuccessBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{loc:Loc AudioOptionsTuned}" Classes="muted" FontSize="11"
                                                               VerticalAlignment="Center" IsVisible="{Binding IsTuned}" />
                                                    <Button Classes="toolbar-link set-default" Content="{loc:Loc ModelSetDefault}"
                                                            ToolTip.Tip="{loc:Loc AudioPackageSetDefaultTip}"
                                                            IsVisible="{Binding !IsDefault}"
                                                            Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).SetDefaultCommand}"
                                                            CommandParameter="{Binding}" />
                                                </controls:CenteredStackPanel>
                                                <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding FamilyName}" />
                                                    <Run Text="{Binding SizeText, StringFormat='  ·  {0}'}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                        VerticalAlignment="Center">
                                                <Panel Width="28" Height="28" Margin="0,0,6,0">
                                                    <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="play"
                                                                      ToolTip.Tip="{loc:Loc AudioPreviewTip}"
                                                                      IsVisible="{Binding !IsPreviewing}"
                                                                      Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).PreviewCommand}"
                                                                      CommandParameter="{Binding}" />
                                                    <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="stop" CurrentColor="Red"
                                                                      ToolTip.Tip="{loc:Loc AudioPreviewStopTip}"
                                                                      IsVisible="{Binding IsPreviewing}"
                                                                      Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).PreviewCommand}"
                                                                      CommandParameter="{Binding}" />
                                                </Panel>
                                                <TextBlock Text="{loc:Loc AudioVoice}" Classes="muted" FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <ComboBox Classes="Small" Width="130" VerticalAlignment="Center"
                                                          ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}"
                                                          DisplayMemberBinding="{ReflectionBinding DisplayName}" />
                                                <Panel Width="28" Height="28">
                                                    <SpinnerIcon VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                 IsVisible="{Binding IsLoadingVoices}" />
                                                    <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="refresh-cw"
                                                                      ToolTip.Tip="{loc:Loc AudioLoadVoicesTip}"
                                                                      IsVisible="{Binding !IsLoadingVoices}"
                                                                      Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).LoadVoicesCommand}"
                                                                      CommandParameter="{Binding}" />
                                                </Panel>
                                                <Panel IsVisible="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).CanTune}">
                                                    <ThemedIconButton Classes="row-action" CornerRadius="6"
                                                                      IconName="sliders-horizontal"
                                                                      ToolTip.Tip="{loc:Loc AudioOptionsTip}"
                                                                      IsVisible="{Binding HasOptions}"
                                                                      Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).OpenOptionsCommand}"
                                                                      CommandParameter="{Binding}" />
                                                </Panel>
                                                <ThemedIconButton Classes="row-action" CornerRadius="6"
                                                                  IconName="square-arrow-out-up-right"
                                                                  ToolTip.Tip="{loc:Loc ModelListShowFileTip}"
                                                                  Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).OpenFolderCommand}"
                                                                  CommandParameter="{Binding}" />
                                                <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="trash-2"
                                                                  ToolTip.Tip="{loc:Loc Delete}"
                                                                  Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).DeleteCommand}"
                                                                  CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Online.TtsServices}"
                                      ItemTemplate="{StaticResource OnlineServiceRow}" />

                        <Panel IsVisible="{Binding ShowVoices}">
                            <voices:VoiceLibraryView DataContext="{Binding Voices}" />
                        </Panel>

                        <TextBlock Classes="group-header" Text="{loc:Loc AudioModelsAsrGroup}"
                                   IsVisible="{Binding HasAsr}" />
                        <ItemsControl ItemsSource="{Binding AsrModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AudioModelItemData">
                                    <Border Classes="model-row">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Classes="model-icon">
                                                <controls:ThemedSvgIcon Width="18" Height="18" IconName="mic" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <controls:CenteredStackPanel Spacing="8">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Classes="default-badge" IsVisible="{Binding IsDefault}">
                                                        <TextBlock Text="{loc:Loc AudioModelsDefaultAsr}" Classes="line-tight" />
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                                IsVisible="{Binding IsLoaded}"
                                                                ToolTip.Tip="{loc:Loc AudioModelsLoadedTip}">
                                                        <Border Classes="status-dot" Tag="Ready" VerticalAlignment="Center" />
                                                        <TextBlock Text="{loc:Loc AudioModelsLoaded}" FontSize="11"
                                                                   Foreground="{DynamicResource MessageStatusSuccessBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{loc:Loc AudioOptionsTuned}" Classes="muted" FontSize="11"
                                                               VerticalAlignment="Center" IsVisible="{Binding IsTuned}" />
                                                    <Button Classes="toolbar-link set-default" Content="{loc:Loc ModelSetDefault}"
                                                            ToolTip.Tip="{loc:Loc AudioPackageSetDefaultTip}"
                                                            IsVisible="{Binding !IsDefault}"
                                                            Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).SetDefaultCommand}"
                                                            CommandParameter="{Binding}" />
                                                </controls:CenteredStackPanel>
                                                <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding FamilyName}" />
                                                    <Run Text="{Binding SizeText, StringFormat='  ·  {0}'}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                        VerticalAlignment="Center">
                                                <Panel IsVisible="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).CanTune}">
                                                    <ThemedIconButton Classes="row-action" CornerRadius="6"
                                                                      IconName="sliders-horizontal"
                                                                      ToolTip.Tip="{loc:Loc AudioOptionsTip}"
                                                                      IsVisible="{Binding HasOptions}"
                                                                      Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).OpenOptionsCommand}"
                                                                      CommandParameter="{Binding}" />
                                                </Panel>
                                                <ThemedIconButton Classes="row-action" CornerRadius="6"
                                                                  IconName="square-arrow-out-up-right"
                                                                  ToolTip.Tip="{loc:Loc ModelListShowFileTip}"
                                                                  Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).OpenFolderCommand}"
                                                                  CommandParameter="{Binding}" />
                                                <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="trash-2"
                                                                  ToolTip.Tip="{loc:Loc Delete}"
                                                                  Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).DeleteCommand}"
                                                                  CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Online.AsrServices}"
                                      ItemTemplate="{StaticResource OnlineServiceRow}" />

                        <!-- 默认关：开了会等本地加载、换声音、占内存，由用户自己决定 -->
                        <CheckBox Margin="14,12" IsVisible="{Binding ShowFallbackOption}"
                                  IsChecked="{Binding Preferences.FallbackToLocal}"
                                  ToolTip.Tip="{loc:Loc AudioFallbackToLocalTip}">
                            <TextBlock Text="{loc:Loc AudioFallbackToLocal}" FontSize="13" />
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Border>
    </DockPanel>
</UserControl>
