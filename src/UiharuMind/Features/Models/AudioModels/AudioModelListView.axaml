<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:UiharuMind.Features.Models.AudioModels"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             x:Class="UiharuMind.Features.Models.AudioModels.AudioModelListView"
             x:DataType="models:AudioModelListViewData">

    <UserControl.Styles>
        <Style Selector="TextBlock.group-header">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="14,12,14,6" />
        </Style>
        <Style Selector="Border.default-badge">
            <Setter Property="Background" Value="{DynamicResource SemiBlue5}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 与「默认」徽标同高，切换时行高不跳 -->
        <Style Selector="Button.set-default">
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Border.audio-row">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey1}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.audio-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="0,14,0,0">
        <!-- 工具条：左边语音模型目录，右边去获取 -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,12">
            <controls:ThemedSvgIcon Width="15" Height="15" IconName="folder-open" Opacity="0.7" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding ModelsDirectory}" Classes="muted" VerticalAlignment="Center"
                           TextTrimming="PrefixCharacterEllipsis" MaxWidth="420" ToolTip.Tip="{Binding ModelsDirectory}" />
                <Button Classes="toolbar-link" Content="{loc:Loc ShowInExplorer}" Command="{Binding OpenFolderCommand}"
                        CommandParameter="{x:Null}" />
                <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="refresh-cw"
                                  ToolTip.Tip="{loc:Loc ModelListRescanTip}" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <Button Grid.Column="2" Command="{Binding GoToMarketCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:ThemedSvgIcon Width="14" Height="14" IconName="download" />
                    <TextBlock Text="{loc:Loc AudioModelsGetMore}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 有模型但没装引擎：模型用不了，引去设置 -->
        <Border DockPanel.Dock="Top" Classes="result-panel" Margin="0,0,0,12" Padding="12,8"
                IsVisible="{Binding !HasEngine}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:Loc AudioModelsOpenEngineSettings}"
                        Command="{Binding OpenEngineSettingsCommand}" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Loc AudioModelsNoEngine}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <Border Classes="model-card">
            <Panel>
                <ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" VerticalAlignment="Top"
                             IsVisible="{Binding IsLoading}" />

                <!-- 空状态：引去获取 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="24"
                            IsVisible="{Binding ShowEmpty}">
                    <controls:ThemedSvgIcon Width="32" Height="32" IconName="audio-lines" Opacity="0.5" />
                    <TextBlock Text="{loc:Loc AudioModelsEmptyTitle}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc AudioModelsEmptyHint}" Classes="muted" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Classes="Primary" HorizontalAlignment="Center" Margin="0,4,0,0"
                            Content="{loc:Loc AudioModelsGetMore}" Command="{Binding GoToMarketCommand}" />
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasModels}">
                    <StackPanel>
                        <TextBlock Classes="group-header" Text="{loc:Loc AudioModelsTtsGroup}"
                                   IsVisible="{Binding HasTtsModels}" />
                        <ItemsControl ItemsSource="{Binding TtsModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AudioModelItemData">
                                    <Border Classes="audio-row">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Classes="model-icon">
                                                <controls:ThemedSvgIcon Width="18" Height="18" IconName="audio-lines" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Classes="default-badge" IsVisible="{Binding IsDefault}">
                                                        <TextBlock Text="{loc:Loc AudioModelsDefaultTts}" FontSize="11"
                                                                   Foreground="White" />
                                                    </Border>
                                                    <Button Classes="toolbar-link set-default" Content="{loc:Loc AudioPackageSetDefault}"
                                                            ToolTip.Tip="{loc:Loc AudioPackageSetDefaultTip}"
                                                            IsVisible="{Binding !IsDefault}"
                                                            Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).SetDefaultCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding FamilyName}" />
                                                    <Run Text="{Binding SizeText, StringFormat='  ·  {0}'}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc AudioVoice}" Classes="muted" FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <ComboBox Classes="Small" Width="130" VerticalAlignment="Center"
                                                          ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}"
                                                          DisplayMemberBinding="{ReflectionBinding DisplayName}" />
                                                <Panel Width="28" Height="28">
                                                    <SpinnerIcon VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                 IsVisible="{Binding IsLoadingVoices}" />
                                                    <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="refresh-cw"
                                                                      ToolTip.Tip="{loc:Loc AudioLoadVoicesTip}"
                                                                      IsVisible="{Binding !IsLoadingVoices}"
                                                                      Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).LoadVoicesCommand}"
                                                                      CommandParameter="{Binding}" />
                                                </Panel>
                                                <ThemedIconButton Classes="row-action" CornerRadius="6"
                                                                  IconName="square-arrow-out-up-right"
                                                                  ToolTip.Tip="{loc:Loc ModelListShowFileTip}"
                                                                  Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).OpenFolderCommand}"
                                                                  CommandParameter="{Binding}" />
                                                <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="trash-2"
                                                                  ToolTip.Tip="{loc:Loc Delete}"
                                                                  Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).DeleteCommand}"
                                                                  CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="group-header" Text="{loc:Loc AudioModelsAsrGroup}"
                                   IsVisible="{Binding HasAsrModels}" />
                        <ItemsControl ItemsSource="{Binding AsrModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AudioModelItemData">
                                    <Border Classes="audio-row">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Classes="model-icon">
                                                <controls:ThemedSvgIcon Width="18" Height="18" IconName="mic" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Classes="default-badge" IsVisible="{Binding IsDefault}">
                                                        <TextBlock Text="{loc:Loc AudioModelsDefaultAsr}" FontSize="11"
                                                                   Foreground="White" />
                                                    </Border>
                                                    <Button Classes="toolbar-link set-default" Content="{loc:Loc AudioPackageSetDefault}"
                                                            ToolTip.Tip="{loc:Loc AudioPackageSetDefaultTip}"
                                                            IsVisible="{Binding !IsDefault}"
                                                            Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).SetDefaultCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding FamilyName}" />
                                                    <Run Text="{Binding SizeText, StringFormat='  ·  {0}'}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                        VerticalAlignment="Center">
                                                <ThemedIconButton Classes="row-action" CornerRadius="6"
                                                                  IconName="square-arrow-out-up-right"
                                                                  ToolTip.Tip="{loc:Loc ModelListShowFileTip}"
                                                                  Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).OpenFolderCommand}"
                                                                  CommandParameter="{Binding}" />
                                                <ThemedIconButton Classes="row-action" CornerRadius="6" IconName="trash-2"
                                                                  ToolTip.Tip="{loc:Loc Delete}"
                                                                  Command="{Binding $parent[ItemsControl].((models:AudioModelListViewData)DataContext).DeleteCommand}"
                                                                  CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Border>
    </DockPanel>
</UserControl>
