<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UiharuMind.Features.Models.ModelPage"
             xmlns:pages="clr-namespace:UiharuMind.Features.Models"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:lang="clr-namespace:UiharuMind.Resources.Lang"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
              x:DataType="pages:ModelPageData"
             xmlns:images="clr-namespace:UiharuMind.Features.Models.ImageModels"
             xmlns:chat="clr-namespace:UiharuMind.Features.Models.ChatModels"
             xmlns:downloads="clr-namespace:UiharuMind.Features.Models.Downloads"
             xmlns:audioModels="clr-namespace:UiharuMind.Features.Models.AudioModels"
             xmlns:usage="clr-namespace:UiharuMind.Features.Models.Usage"
                             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:converters="clr-namespace:UiharuMind.Shared.Converters"
             xmlns:core="clr-namespace:UiharuMind.Core.AI.Core;assembly=UiharuMind.Core">

    <Design.DataContext>
        <pages:ModelPageData />
    </Design.DataContext>

    <!-- 与角色页同一圈留白；页签本身就是页头，不另放大标题（其他页都没有） -->
    <Panel Margin="12,6,12,12">
        <!-- 生图模型单独一张表(ADR 0052):不进对话模型列表,也就不出现在任何对话模型选择器里。
             页签头与内容分开放：内容建出来就常驻、只切可见性，切页签不再整棵摘下重挂（重套样式与模板约 80ms） -->
        <DockPanel>
            <!-- 页签行：整机余量与页签挤同一格、靠右压在页签行上。页签主题画的那条通栏下边框
                 从读数底下整条穿过去（读数背景透明，只字显形），读数在线条上方与页签文字齐平 -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <TabStrip SelectedIndex="{Binding SelectedTabIndex}" VerticalAlignment="Center">
                    <TabStripItem Content="{loc:Loc ModelPageChatModelsTab}" />
                    <TabStripItem Content="{loc:Loc ModelPageImageModelsTab}" />
                    <TabStripItem Content="{loc:Loc ModelPageAudioModelsTab}" />
                    <TabStripItem>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{loc:Loc ModelPageDownloadsTab}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource SemiBlue5}" CornerRadius="8" Padding="5,0" MinWidth="16"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding DownloadQueue.HasActive, FallbackValue=False}">
                                <TextBlock Text="{Binding DownloadQueue.ActiveCount}" FontSize="11" Foreground="White"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </TabStripItem>
                </TabStrip>
                <!-- 整机余量，点开看各本地模型占用 -->
                <usage:LocalUsageIndicator HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Panel>
                <!-- 可见性放在外层：视图自己换了 DataContext，绑在它身上就找不到页签序号 -->
                <Panel IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IndexEqualsConverter.Instance}, ConverterParameter=0}">
                    <chat:ChatModelListView DataContext="{Binding ChatModels}" />
                </Panel>
                <Panel IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IndexEqualsConverter.Instance}, ConverterParameter=1}">
                    <images:ImageModelListView DataContext="{Binding ImageModels}" />
                </Panel>
                <!-- 只列本机装了的；下载在「获取模型」的语音分类。后两页绑数据而不是内联写视图：第一次选中才建 -->
                <ContentControl Content="{Binding AudioModels}"
                                IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IndexEqualsConverter.Instance}, ConverterParameter=2}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="audioModels:AudioModelListViewData">
                            <audioModels:AudioModelListView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
                <ContentControl Content="{Binding Downloads}"
                                IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IndexEqualsConverter.Instance}, ConverterParameter=3}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="downloads:ModelDownloadPageData">
                            <downloads:ModelDownloadView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Panel>
        </DockPanel>
    </Panel>

</UserControl>
