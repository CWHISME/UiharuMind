<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="480"
        x:Class="UiharuMind.Features.WorldBooks.WorldBookSelectWindow"
        Title="{loc:Loc WorldBookSelectTitle}"
        Width="420" Height="480"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <TextBox x:Name="NewBookName" PlaceholderText="{loc:Loc WorldBookNewPlaceholder}"
                     Width="200" VerticalContentAlignment="Center" />
            <Button Content="{loc:Loc WorldBookNew}" Click="OnCreateNewClick" />
            <Button Classes="Primary" Content="{loc:Loc WorldBookChoose}" Click="OnChooseClick"
                    HorizontalAlignment="Right" />
        </StackPanel>

        <ListBox x:Name="BookList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Margin="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Summary}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>