<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
        Width="960"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        x:Class="UiharuMind.Features.Settings.SettingsWindow"
        Icon="/Assets/Icon.png"
        Title="{loc:Loc SettingsWindowTitle}"
        xmlns:controls="clr-namespace:UiharuMind.Shared.Controls">

    <Window.Styles>
        <!-- 左栏导航项。悬停/选中的底色由主题画在模板内 ContentPresenter 上，
             只设按钮自己的 Background 压不住（同 CustomButtonStyle 的 picker-row） -->
        <Style Selector="Button.SettingsNavButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.SettingsNavButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiGrey2}" />
        </Style>
        <Style Selector="Button.SettingsNavButton.selected">
            <Setter Property="Background" Value="{DynamicResource SemiBlue5}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.SettingsNavButton.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiBlue5}" />
        </Style>
        <!-- 分组标题：给左栏入口立结构 -->
        <Style Selector="TextBlock.SettingsNavGroup">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
            <Setter Property="Margin" Value="10,0,0,6" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="216,*" Background="{DynamicResource SemiGrey0}">
        <Border Grid.Column="0"
                Background="{DynamicResource SemiGrey1}"
                BorderBrush="{DynamicResource SemiGrey2}"
                BorderThickness="0,0,1,0"
                Padding="12">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Text="{loc:Loc SettingsWindowTitle}"
                           FontSize="15"
                           Margin="4,4,4,16" />

                <!-- 导航按页表生成（见后台代码），加页不改这里 -->
                <StackPanel Name="NavHost" Grid.Row="1" Spacing="18" />

                <StackPanel Grid.Row="2" Margin="4,12,4,4">
                    <TextBlock Text="UiharuMind"
                               FontSize="13" />
                    <TextBlock Name="VersionText"
                               Foreground="{DynamicResource SemiGrey6}"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <!-- 页头：当前页标题 + 全局设置搜索 -->
            <Border Height="52"
                    BorderBrush="{DynamicResource SemiGrey2}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto" Margin="24,0,20,0">
                    <TextBlock Name="TitleText"
                               VerticalAlignment="Center"
                               FontSize="16" />
                    <TextBox Name="SearchBox"
                             Grid.Column="1"
                             Width="220"
                             VerticalAlignment="Center"
                             PlaceholderText="{loc:Loc SettingsSearchPlaceholder}"
                             TextChanged="OnSearchTextChanged" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ContentControl Name="SettingsContent"
                                Margin="24" />

                <!-- 搜索结果：盖住内容区，点一条跳到那一页那一行 -->
                <Border Name="SearchResultPanel"
                        Margin="24"
                        Padding="8"
                        CornerRadius="8"
                        Background="{DynamicResource SemiGrey0}"
                        BorderBrush="{DynamicResource SemiGrey2}"
                        BorderThickness="1"
                        IsVisible="False">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Name="SearchEmptyText"
                                   Classes="muted"
                                   Margin="8,6"
                                   Text="{loc:Loc SettingsSearchNoResult}"
                                   IsVisible="False" />
                        <ListBox Name="SearchResultList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="OnSearchResultSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
