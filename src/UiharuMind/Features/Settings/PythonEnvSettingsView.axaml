<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UiharuMind.Features.Settings"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="240"
             x:Class="UiharuMind.Features.Settings.PythonEnvSettingsView"
             x:DataType="vm:PythonEnvSettingsViewData">

    <!-- 内嵌小卡片：HeaderFontSize=13（晨曦留的口子），说明走全局 muted，本地 form-pane 样式已删 -->
    <controls:SettingsSection Header="{loc:Loc AgentSettingPython}"
                              Description="{loc:Loc AgentSettingPythonDesc}"
                              HeaderFontSize="13">
        <controls:SettingsSection.Body>
            <StackPanel Spacing="6">
                <controls:SettingsRow Header="{loc:Loc AgentSettingPythonInterpreter}"
                                      ResetCommand="{Binding ResetInterpreterPathCommand}"
                                      ResetVisible="{Binding IsInterpreterPathNotDefault}">
                    <controls:SettingsRow.Field>
                        <TextBox Text="{Binding InterpreterPath}" PlaceholderText="{loc:Loc AgentSettingPythonAutoDetect}" Width="360" />
                    </controls:SettingsRow.Field>
                </controls:SettingsRow>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="{loc:Loc AgentSettingPythonProbe}"
                            IsEnabled="{Binding !IsBusy}" Command="{Binding ProbeCommand}" />
                    <Button Content="{loc:Loc AgentSettingPythonCreate}"
                            IsEnabled="{Binding !IsBusy}" Command="{Binding CreateCommand}" />
                    <Button Content="{loc:Loc AgentSettingPythonRemove}"
                            IsEnabled="{Binding IsReady}" Command="{Binding RemoveCommand}" />
                </StackPanel>

                <!-- 就绪与否是这一块唯一要一眼看到的事实:纪律段发不发、模型知不知道有 Python,全看它 -->
                <TextBlock Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap"
                           IsVisible="{Binding IsReady}" Text="{Binding EnvironmentRoot}" />
                <SelectableTextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Status}"
                                     IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </controls:SettingsSection.Body>
    </controls:SettingsSection>
</UserControl>
