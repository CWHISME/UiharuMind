<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UiharuMind.Features.Settings"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="360"
             x:Class="UiharuMind.Features.Settings.DownloadSourceSettingsView"
             x:DataType="vm:DownloadSourceSettingsViewData">

    <controls:SettingsSection Header="{loc:Loc DownloadSourceSection}"
                              Description="{loc:Loc DownloadSourceSectionDesc}">
        <controls:SettingsSection.Body>
            <StackPanel Spacing="6">
                <controls:SettingsRow Header="{loc:Loc DownloadSourceModelSource}"
                                      Description="{loc:Loc DownloadSourceModelSourceDesc}">
                    <controls:SettingsRow.Field>
                        <ComboBox Width="300" ItemsSource="{Binding SourceOptions}"
                                  SelectedItem="{Binding SelectedSource}" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModelSourceOption">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingsRow.Field>
                </controls:SettingsRow>

                <!-- 只有选了自定义才有意义 -->
                <controls:SettingsRow Header="{loc:Loc DownloadSourceCustomEndpoint}"
                                      Description="{loc:Loc DownloadSourceCustomEndpointDesc}"
                                      IsVisible="{Binding IsCustomSource}">
                    <controls:SettingsRow.Field>
                        <StackPanel Spacing="4" Width="300">
                            <TextBox Text="{Binding CustomEndpoint}" PlaceholderText="https://example.com" />
                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MessageStatusErrorBrush}"
                                       Text="{loc:Loc DownloadSourceCustomEndpointInvalid}"
                                       IsVisible="{Binding IsCustomEndpointInvalid}" />
                        </StackPanel>
                    </controls:SettingsRow.Field>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc DownloadSourceHfToken}"
                                      Description="{loc:Loc DownloadSourceHfTokenDesc}">
                    <controls:SettingsRow.Field>
                        <TextBox Width="300" PasswordChar="●" Text="{Binding HuggingFaceToken}" />
                    </controls:SettingsRow.Field>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc DownloadSourceModelScopeToken}"
                                      Description="{loc:Loc DownloadSourceModelScopeTokenDesc}">
                    <controls:SettingsRow.Field>
                        <TextBox Width="300" PasswordChar="●" Text="{Binding ModelScopeToken}" />
                    </controls:SettingsRow.Field>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc DownloadSourceGitHubProxy}"
                                      Description="{loc:Loc DownloadSourceGitHubProxyDesc}"
                                      DividerVisible="False">
                    <controls:SettingsRow.Field>
                        <TextBox Width="300" Text="{Binding GitHubProxyPrefix}"
                                 PlaceholderText="https://ghproxy.example/" />
                    </controls:SettingsRow.Field>
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsSection.Body>
    </controls:SettingsSection>
</UserControl>
