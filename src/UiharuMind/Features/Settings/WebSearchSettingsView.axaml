<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UiharuMind.Features.Settings"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="420"
             x:Class="UiharuMind.Features.Settings.WebSearchSettingsView"
             x:DataType="vm:WebSearchSettingsViewData">

    <!-- 联网搜索整卡：凭据 + 链路状态合并进一个 Border（HeaderInsideCard 整卡样式）。
         外层不设标题，内部两个小节各带小标题；凭据行走 SettingsRow（进搜索索引），
         状态行保留「圆点+回显」的局部视觉（SemiGrey1 底板内联，status-dot/result-panel 是全局样式） -->
    <controls:SettingsSection HeaderInsideCard="True" HeaderFontSize="13">
        <controls:SettingsSection.Body>
            <StackPanel Spacing="12">
                <!-- 小节：凭据。Firecrawl 不填也能用，另两个不填就等于没这一环 -->
                <StackPanel Spacing="6">
                    <TextBlock FontSize="13" Text="{loc:Loc AgentSettingWebSearchKeys}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="{loc:Loc AgentSettingWebSearchKeysDesc}" />
                    <StackPanel Spacing="6">
                        <controls:SettingsRow Header="Firecrawl"
                                              ResetCommand="{Binding ResetFirecrawlApiKeyCommand}"
                                              ResetVisible="{Binding IsFirecrawlApiKeyNotDefault}">
                            <controls:SettingsRow.Field>
                                <TextBox Width="300" PasswordChar="●" Text="{Binding FirecrawlApiKey}" />
                            </controls:SettingsRow.Field>
                        </controls:SettingsRow>
                        <controls:SettingsRow Header="Tavily"
                                              ResetCommand="{Binding ResetTavilyApiKeyCommand}"
                                              ResetVisible="{Binding IsTavilyApiKeyNotDefault}">
                            <controls:SettingsRow.Field>
                                <TextBox Width="300" PasswordChar="●" Text="{Binding TavilyApiKey}" />
                            </controls:SettingsRow.Field>
                        </controls:SettingsRow>
                        <controls:SettingsRow Header="Brave" ResetCommand="{Binding ResetBraveSearchApiKeyCommand}" ResetVisible="{Binding IsBraveSearchApiKeyNotDefault}" DividerVisible="False">
                            <controls:SettingsRow.Field>
                                <TextBox Width="300" PasswordChar="●" Text="{Binding BraveSearchApiKey}" />
                            </controls:SettingsRow.Field>
                        </controls:SettingsRow>
                    </StackPanel>
                </StackPanel>

                <!-- 小节：链路状态。谁配好了、谁在冷却、上次为什么不通，以及实测抓到了什么 -->
                <StackPanel Spacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="13" Text="{loc:Loc AgentSettingSearchHealth}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="{loc:Loc AgentSettingSearchHealthDesc}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                Content="{loc:Loc AgentSettingSearchRefresh}"
                                Command="{Binding RefreshCommand}" />
                        <Button Grid.Column="2" Classes="Primary" Margin="6,0,0,0" VerticalAlignment="Center"
                                Content="{Binding ProbeAllButtonText}"
                                IsEnabled="{Binding !IsProbingAll}"
                                Command="{Binding ProbeAllCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WebSearchProviderItem">
                                <Border Margin="0,3" CornerRadius="6" Padding="10,7"
                                        Background="{DynamicResource SemiGrey1}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="18,Auto,*,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center"
                                                       Text="{Binding Order}" />
                                            <Border Grid.Column="1" Classes="status-dot" Tag="{Binding StatusKey}" />
                                            <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="13" Text="{Binding Name}" />
                                                <TextBlock Classes="muted"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Message}"
                                                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Spacing="1" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Classes="muted" TextAlignment="Right"
                                                           Text="{Binding StateText}" />
                                                <TextBlock Classes="mono" TextAlignment="Right"
                                                           Text="{Binding ProbeText}"
                                                           IsVisible="{Binding ProbeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                            <!-- 单测：改完一个 key 就想立刻确认它通不通，没必要把整条链跑一遍。
                                                 这里的 DataContext 是本控件的 VM，强转才立得住 -->
                                            <Button Grid.Column="4" FontSize="11" Padding="8,3" CornerRadius="6"
                                                    VerticalAlignment="Center"
                                                    Content="{loc:Loc AgentSettingSearchProbeOne}"
                                                    IsEnabled="{Binding !IsProbing}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding $parent[ItemsControl].((vm:WebSearchSettingsViewData)DataContext).ProbeOneCommand}" />
                                        </Grid>

                                        <!-- 实测抓回来的原物。条数对不代表内容对，摆出来才看得出真假 -->
                                        <Border Classes="result-panel" Margin="26,0,0,0"
                                                IsVisible="{Binding Preview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
                                                <SelectableTextBlock Classes="mono"
                                                                     Text="{Binding Preview}" TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </controls:SettingsSection.Body>
    </controls:SettingsSection>
</UserControl>
