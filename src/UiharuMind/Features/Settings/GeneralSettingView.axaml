<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settingViews="clr-namespace:UiharuMind.Features.Settings"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:common="clr-namespace:UiharuMind.Features.Settings"
             xmlns:u="https://irihi.tech/ursa"
              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              x:Class="UiharuMind.Features.Settings.GeneralSettingView"
                             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls">

    <Design.DataContext>
        <settingViews:GeneralSettingViewModel />
    </Design.DataContext>

    <!-- 样板页：分节卡片 + 设置行两件共用件拼装，页面里不再出现字号/灰阶/行高/分隔线的字面值。
         卡片铺满内容区：不限 MaxWidth，宽窗下右侧不留空（与智能体页一致） -->
    <ScrollViewer controls:SettingsScrollMemory.ScrollKey="GeneralSetting">
        <StackPanel Spacing="22">
            <controls:SettingsSection Header="{loc:Loc ApplicationUpdate}">
                <controls:SettingsSection.Body>
                    <StackPanel>
                        <controls:SettingsRow Header="{loc:Loc InstalledVersion}">
                            <controls:SettingsRow.Field>
                                <TextBlock Text="{Binding VersionText}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SemiGrey7}" />
                            </controls:SettingsRow.Field>
                        </controls:SettingsRow>

                        <controls:SettingsRow Header="{loc:Loc CheckAppUpdate}"
                                              Description="{loc:Loc CheckAppUpdateDesc}"
                                              DividerVisible="False">
                            <controls:SettingsRow.Field>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{Binding CheckApplicationUpdateCommand}"
                                            IsEnabled="{Binding !IsCheckingForAppUpdate}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:ThemedSvgIcon Width="14" Height="14" IconName="refresh-cw" />
                                            <TextBlock Text="{loc:Loc CheckUpdate}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenUpdatePageCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:ThemedSvgIcon Width="14" Height="14" IconName="square-arrow-out-up-right" />
                                            <TextBlock Text="{loc:Loc ApplicationUpdateGoTo}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingsRow.Field>
                        </controls:SettingsRow>

                        <!-- 更新状态条：挂在卡片里、跟随「检查更新」这一行，不进设置行口径 -->
                        <Border Margin="0,12,0,0"
                                Padding="10"
                                CornerRadius="7"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource MessageStatusInfoBrush}"
                                Background="{DynamicResource SemiGrey1}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <controls:ThemedSvgIcon Width="16"
                                          Height="16"
                                          VerticalAlignment="Top"
                                          IconName="refresh-cw"
                                           />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding AppUpdateStatusText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LatestVersionText, StringFormat={}{0}}"
                                               Classes="muted"
                                               TextWrapping="Wrap" />
                                    <SelectableTextBlock Text="{Binding AppUpdateErrorText}"
                                                         Classes="muted"
                                                         Foreground="{DynamicResource MessageStatusErrorBrush}"
                                                         TextWrapping="Wrap"
                                                         IsVisible="{Binding HasAppUpdateError}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsCheckingForAppUpdate}">
                                    <SpinnerIcon VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc CheckingForUpdates}"
                                               Classes="muted"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border IsVisible="{Binding HasAppUpdate}"
                                Margin="0,10,0,0"
                                Padding="10"
                                CornerRadius="7"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource SemiGrey2}"
                                Background="{DynamicResource SemiGrey1}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Loc ApplicationUpdateDownloadTitle}" />
                                <TextBlock Text="{loc:Loc ApplicationUpdateDownloadDesc}"
                                           Classes="muted"
                                           TextWrapping="Wrap" />
                                <common:DownloadListView DataContext="{Binding ApplicationUpdateDownloadListViewModel}"
                                                         MaxHeight="150"
                                                         IsVisible="{Binding HasApplicationUpdateAsset}" />
                                <TextBlock Text="{loc:Loc ApplicationUpdateNoAsset}"
                                           Classes="muted"
                                           Foreground="{DynamicResource MessageStatusWarningBrush}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding !HasApplicationUpdateAsset}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </controls:SettingsSection.Body>
            </controls:SettingsSection>

            <controls:SettingsSection Header="{loc:Loc UserInterfaceSetting}">
                <controls:SettingsSection.Body>
                    <StackPanel>
                        <controls:SettingsRow Header="{loc:Loc LanguageSetting}"
                                              Description="{loc:Loc LanguageSettingDesc}">
                            <controls:SettingsRow.Field>
                                <ComboBox Width="220"
                                          ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguage}"
                                          VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:SettingsRow.Field>
                        </controls:SettingsRow>

                        <controls:SettingsRow Header="{loc:Loc ThemeSetting}"
                                              Description="{loc:Loc ThemeSettingDesc}"
                                              DividerVisible="False">
                            <controls:SettingsRow.Field>
                                <ComboBox Width="220"
                                          ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding SelectedTheme}"
                                          VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:SettingsRow.Field>
                        </controls:SettingsRow>
                    </StackPanel>
                </controls:SettingsSection.Body>
            </controls:SettingsSection>

            <controls:SettingsSection Header="{loc:Loc GeneralSettings}">
                <controls:SettingsSection.Body>
                    <StackPanel>
                        <!-- 日志等级那一项已搬到日志页顶部的下拉:改等级时人正看着日志,
                             跑到设置里改再回来看是多余的一趟 -->
                        <!-- 分隔线跟着「下面还有一行吗」走:全屏输入那行只在 Windows 出现,
                             不是 Windows 时这行就是末行,不该留一条尾巴 -->
                        <controls:SettingsRow Header="{loc:Loc ClipboardRetentionTitle}"
                                              Description="{loc:Loc ClipboardRetentionDesc}"
                                              ResetCommand="{Binding ResetClipboardRetentionDaysCommand}"
                                              ResetVisible="{Binding IsClipboardRetentionNotDefault}"
                                              DividerVisible="{Binding IsWindows}">
                            <controls:SettingsRow.Field>
                                <NumericUpDown Width="120"
                                               Minimum="0" Maximum="3650" Increment="1"
                                               FormatString="0"
                                               VerticalAlignment="Center"
                                               Value="{Binding ClipboardRetentionDays}" />
                            </controls:SettingsRow.Field>
                        </controls:SettingsRow>

                        <controls:SettingsRow Header="{loc:Loc FullscreenGameInputSupport}"
                                              Description="{loc:Loc FullscreenGameInputSupportDesc}"
                                              ResetCommand="{Binding ResetFullscreenGameInputSupportCommand}"
                                              ResetVisible="{Binding IsFullscreenGameInputNotDefault}"
                                              DividerVisible="False"
                                              IsVisible="{Binding IsWindows}">
                            <controls:SettingsRow.Field>
                                <CheckBox IsChecked="{Binding EnableFullscreenGameInputSupport}"
                                          VerticalAlignment="Center" />
                            </controls:SettingsRow.Field>
                        </controls:SettingsRow>
                        <!-- 「保存目录」那一行已删:托盘菜单的 TrayMenuOpenSaveDir 开的是同一个
                             AppPaths.Root,日志目录另有日志页的入口 -->
                    </StackPanel>
                </controls:SettingsSection.Body>
            </controls:SettingsSection>
        </StackPanel>
    </ScrollViewer>
</UserControl>
