<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:audio="clr-namespace:UiharuMind.Features.Settings.Audio"
             xmlns:engines="clr-namespace:UiharuMind.Features.Settings.Engines"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             x:Class="UiharuMind.Features.Settings.Audio.AudioEngineSettingView"
             x:DataType="audio:AudioEngineSettingData">

    <UserControl.Styles>
        <Style Selector="NumericUpDown.runtime-field">
            <Setter Property="Width" Value="180" />
            <Setter Property="FormatString" Value="0" />
            <Setter Property="Increment" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer controls:SettingsScrollMemory.ScrollKey="AudioEngineSetting"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="22">
            <controls:SettingsSection Header="{loc:Loc AudioEngineTitle}" Description="{loc:Loc AudioEngineDesc}">
                <controls:SettingsSection.Body>
                    <engines:EngineVersionsView DataContext="{Binding Engine}" />
                </controls:SettingsSection.Body>
            </controls:SettingsSection>

            <!-- 模型的下载、默认与音色都在模型页，这里只给入口 -->
            <controls:SettingsSection Header="{loc:Loc AudioModelsTitle}" Description="{loc:Loc AudioModelsDesc}">
                <controls:SettingsSection.Body>
                    <controls:SettingsRow Header="{loc:Loc AudioManageModels}" Description="{loc:Loc AudioManageModelsDesc}"
                                          DividerVisible="False">
                        <controls:SettingsRow.Field>
                            <Button Content="{loc:Loc AudioManageModelsBtn}" Click="OnManageModelsClick" />
                        </controls:SettingsRow.Field>
                    </controls:SettingsRow>
                </controls:SettingsSection.Body>
            </controls:SettingsSection>

            <controls:SettingsSection Header="{loc:Loc AudioRuntimeTitle}" Description="{loc:Loc AudioRuntimeDesc}">
                <controls:SettingsSection.Body>
                    <StackPanel DataContext="{Binding Runtime}" x:DataType="audio:AudioCppRuntimeSettingsViewData">
                        <controls:SettingsRow Header="{loc:Loc ModelRuntimeThreads}" Description="{loc:Loc AudioThreadsDesc}">
                            <controls:SettingsRow.Field>
                                <NumericUpDown Classes="runtime-field" Minimum="1" Maximum="512" Value="{Binding Threads}" />
                            </controls:SettingsRow.Field>
                        </controls:SettingsRow>
                        <controls:SettingsRow Header="{loc:Loc AudioMaxLoadedModels}" Description="{loc:Loc AudioMaxLoadedModelsDesc}">
                            <controls:SettingsRow.Field>
                                <NumericUpDown Classes="runtime-field" Minimum="1" Maximum="16" Value="{Binding MaxLoadedModels}" />
                            </controls:SettingsRow.Field>
                        </controls:SettingsRow>
                        <controls:SettingsRow Header="{loc:Loc AudioIdleUnload}" Description="{loc:Loc AudioIdleUnloadDesc}">
                            <controls:SettingsRow.Field>
                                <NumericUpDown Classes="runtime-field" Minimum="1" Maximum="1440" Value="{Binding IdleUnloadMinutes}" />
                            </controls:SettingsRow.Field>
                        </controls:SettingsRow>
                        <controls:SettingsRow Header="{loc:Loc LLamaCppLoadTimeout}" Description="{loc:Loc AudioReadyTimeoutDesc}"
                                              DividerVisible="False">
                            <controls:SettingsRow.Field>
                                <NumericUpDown Classes="runtime-field" Minimum="10" Maximum="600" Increment="10"
                                               Value="{Binding ReadyTimeoutSeconds}" />
                            </controls:SettingsRow.Field>
                        </controls:SettingsRow>
                    </StackPanel>
                </controls:SettingsSection.Body>
            </controls:SettingsSection>
        </StackPanel>
    </ScrollViewer>
</UserControl>
