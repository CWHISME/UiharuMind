<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settingViewData="clr-namespace:UiharuMind.Features.Settings"
             xmlns:settings="clr-namespace:UiharuMind.Features.Settings"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="620"
             x:Class="UiharuMind.Features.Settings.RuntimeEngineSettingView"
             x:DataType="settingViewData:RuntimeEngineSettingData">

    <Design.DataContext>
        <settingViewData:RuntimeEngineSettingData />
    </Design.DataContext>

    <!-- 第一块不套 SettingsSection：控件自带一张卡，再套就是卡中卡（双描边 + 双标题）。
         标题行手写成 15 + muted，与 SettingsSection 的节标题同口径 -->
    <ScrollViewer controls:SettingsScrollMemory.ScrollKey="RuntimeEngineSetting"
                   HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!-- 卡片铺满内容区：不限 MaxWidth，宽窗下右侧不留空（与智能体页一致） -->
        <StackPanel Spacing="22">
            <StackPanel Spacing="8">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="15"
                               Text="{loc:Loc ModelRuntimeSectionTitle}"
                               TextWrapping="Wrap" />
                    <TextBlock Classes="muted"
                               Text="{loc:Loc ModelRuntimeSectionDesc}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <!-- 高度不限制：内容全展开跟页面一起滚，不然底部提示会被内部 245px 视口裁掉 -->
                <controls:ModelRuntimeBasicSettingsView DataContext="{Binding RuntimeSettings}"
                                                        IsHeightLimited="False" />
            </StackPanel>

            <!-- LLamaSharp 引擎：只有标题+说明，没有设置项；卡片内留空 -->
            <controls:SettingsSection Header="{loc:Loc ModelRuntimeLLamaSharpTitle}"
                                      Description="{loc:Loc ModelRuntimeLLamaSharpDesc}"
                                      IsVisible="{Binding IsLLamaSharpEngine}" />

            <controls:SettingsSection Header="{loc:Loc ModelRuntimeLLamaCppTitle}"
                                      Description="{loc:Loc ModelRuntimeLLamaCppDesc}"
                                      IsVisible="{Binding IsLLamaCppEngine}">
                <controls:SettingsSection.Body>
                    <StackPanel Spacing="12">
                        <!-- 版本选择 + 目录/检查更新：操作行，不进设置行口径。
                             两行摆：选择框独占一行自适应，按钮另起一行，窄窗下互不挤 -->
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc CurrentEngineTypeSetting}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          MinWidth="140"
                                          ItemsSource="{Binding AvailableVersions}"
                                          SelectedItem="{Binding SelectedVersion}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button Content="{loc:Loc OpenDirectory}"
                                        Command="{Binding OpenFolderCommand}" />
                                <Button Content="{loc:Loc CheckUpdate}"
                                        Command="{Binding UpdateRemoteVersionsCommand}" />
                                <StackPanel Orientation="Horizontal" IsVisible="{Binding IsCheckingForUpdate}">
                                    <SpinnerIcon VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Loc CheckingForUpdates}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- 更新结果原样摆出来：可选中复制，限高自滚 -->
                        <Border BorderThickness="1"
                                BorderBrush="{DynamicResource SemiGrey2}"
                                Background="{DynamicResource SemiGrey0}"
                                CornerRadius="7"
                                IsVisible="{Binding UpdatedResutInfo,FallbackValue=True, TargetNullValue=False}">
                            <ScrollViewer MaxHeight="160">
                                <SelectableTextBlock Text="{Binding UpdatedResutInfo}" Margin="10" />
                            </ScrollViewer>
                        </Border>

                        <settings:DownloadListView DataContext="{Binding RemoteDwnloadListViewModel}" />
                    </StackPanel>
                </controls:SettingsSection.Body>
            </controls:SettingsSection>
        </StackPanel>
    </ScrollViewer>
</UserControl>
