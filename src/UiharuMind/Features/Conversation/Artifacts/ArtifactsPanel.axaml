<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:art="clr-namespace:UiharuMind.Features.Conversation.Artifacts"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
             x:Class="UiharuMind.Features.Conversation.Artifacts.ArtifactsPanel"
             x:DataType="art:ArtifactsViewData">

    <!-- 产物区：群或单聊到底落了哪些盘。点开看文件，右键在文件夹中显示 -->
    <Border BorderThickness="1" BorderBrush="{DynamicResource SemiGrey2}" CornerRadius="8" Padding="8">
        <!-- 列表行用 * 拿受限高度：放纵向 StackPanel 里的话 ListBox 收到无限高度，虚拟化失效 -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                           Text="{Binding Title}" />
                <ThemedIconButton Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center"
                                  IconName="folder-open"
                                  ToolTip.Tip="{Binding DraftRoom}"
                                  Command="{Binding OpenDraftRoomCommand}" />
                <!-- 只看草稿 / 查看全部：翻行可见开关，不重建实例 -->
                <ThemedIconToggleButton Grid.Column="2" Width="24" Height="24" VerticalAlignment="Center"
                                        IconName="sliders-horizontal"
                                        CheckedForeground="{DynamicResource SemiBlue5}"
                                        IsChecked="{Binding DraftOnly, Mode=TwoWay}"
                                        ToolTip.Tip="{Binding FilterTip}" />
            </Grid>
            <TextBlock Grid.Row="1" Classes="muted" Text="{Binding Hint}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Classes="muted" FontSize="11" IsVisible="{Binding IsEmpty}"
                       Text="{loc:Loc GroupArtifactsEmpty}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Classes="muted" FontSize="11" IsVisible="{Binding IsDraftEmpty}"
                       Text="{loc:Loc GroupArtifactsDraftEmpty}" TextWrapping="Wrap" />
            <ListBox Grid.Row="4" ItemsSource="{Binding Items}" Classes="flat-list"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.BringIntoViewOnFocusChange="False">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="art:ArtifactItem">
                        <Button Classes="Tertiary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Margin="0,1" Padding="6,4" Command="{Binding OpenCommand}"
                                IsVisible="{Binding MatchesFilter}"
                                ToolTip.Tip="{Binding FullPath}"
                                ToolTip.Placement="Left">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc GroupArtifactOpen}" Command="{Binding OpenCommand}" />
                                    <MenuItem Header="{loc:Loc GroupArtifactReveal}" Command="{Binding RevealCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <!-- 两行：文件名 + 来源 | 路径与谁、什么时候。名字列用 Grid 约束宽度，省略号才算得准 -->
                            <StackPanel Spacing="1" MinWidth="0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <controls:KindBadge Grid.Column="1" Header="{loc:Loc GroupArtifactDraftBadge}"
                                                        BadgeBackground="{DynamicResource SemiGrey5}"
                                                        VerticalAlignment="Center" IsVisible="{Binding IsDraft}" />
                                    <controls:KindBadge Grid.Column="1" Header="{loc:Loc GroupArtifactWorkspaceBadge}"
                                                        BadgeBackground="{DynamicResource SemiOrange5}"
                                                        VerticalAlignment="Center" IsVisible="{Binding !IsDraft}" />
                                </Grid>
                                <TextBlock Classes="muted" FontSize="10" Text="{Binding DisplayPath}"
                                           TextTrimming="PrefixCharacterEllipsis" MaxLines="1" />
                                <TextBlock Classes="muted" FontSize="10" Text="{Binding MetaText}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
