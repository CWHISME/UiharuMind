<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sessions="clr-namespace:UiharuMind.Features.Conversation.SessionList"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:u="https://irihi.tech/ursa"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="520"
             x:Class="UiharuMind.Features.Conversation.SessionList.SessionListView"
             x:DataType="sessions:SessionListModel">

    <!-- 会话列表。两页共用一份：条目类型本来就是同一个 SessionListItem,
         而两份模板此前是拷贝后各自演化(一边有头像与描述、一边有悬停删除),观感因此飘了。
         唯一有意保留的差异是头像——工作区页要的是密度,见 ShowAvatar。
         搜索行与批量动作条也在这一层：都是列表的事，与页面的类型切换器无关 -->
    <UserControl.Resources>
        <!-- 整个列表共用一份右键菜单,右键时才弹(见 OnListContextRequested)。
             放在行模板里则每行都要建一套菜单与五个菜单项,而行模板每次回收都重建。
             弹出时挂在被右键的那一行上,数据上下文随之继承那一行的条目 -->
        <ContextMenu x:Key="SessionRowMenu" x:DataType="sessions:SessionListItem">
            <MenuItem Header="{loc:Loc EditCharacter}" Command="{Binding EditCharacterCommand}" />
            <MenuItem Header="{loc:Loc Rename}" Command="{Binding RenameCommand}" />
            <MenuItem Header="{loc:Loc Copy}" Command="{Binding CopyCommand}" />
            <MenuItem Header="{loc:Loc ClearChatHistory}" ToolTip.Tip="{Binding BusyTip}"
                      Command="{Binding ClearChatHistoryCommand}" />
            <MenuItem Header="{loc:Loc Delete}" ToolTip.Tip="{Binding BusyTip}"
                      Command="{Binding DeleteCommand}" />
        </ContextMenu>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SemiBlue0}" />
        </Style>
        <!-- 「在消息里搜索」与「消息里提到的」摘要行:沿用内联选择器的行(picker-row),内容铺满整行。
             正文色取列表本身的:按钮主题给的是强调色,一侧栏蓝字读着像一串链接(muted 的标签自己有色) -->
        <Style Selector="Button.picker-row.content-hit">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.content-hit TextBlock:not(.muted)">
            <Setter Property="Foreground" Value="{Binding $parent[sessions:SessionListView].Foreground}" />
        </Style>
        <!-- 删除按钮只在悬停时露出:常驻会把每一条都塞得很挤 -->
        <Style Selector="ListBoxItem Button.session-delete">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBoxItem:pointerover Button.session-delete">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- 搜索行：没东西可筛时收起来（刚装好一个会话都没有时不占地方）。
             放大镜叠在框内左侧，与知识库搜索框同式；批量入口是小图标按钮，
             与标题行的图标按钮同密度，选中态沿用导航栏的 SemiBlue1 高亮 -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,0,8"
              IsVisible="{Binding ShowSearchRow}">
            <Grid>
                <TextBox Text="{Binding SearchText}"
                         Padding="31,6,8,6"
                         FontSize="12"
                         PlaceholderText="{loc:Loc SessionSearchPlaceholder}"
                         VerticalAlignment="Center">
                    <!-- 打字只按标题滤;回车才去消息里搜(同下方那一行) -->
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ContentSearch.StartCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <controls:ThemedSvgIcon Width="15" Height="15" Margin="9,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        IconName="search" />
            </Grid>
            <controls:ThemedIconToggleButton Grid.Column="1"
                                             IsChecked="{Binding IsBatchMode, Mode=OneWay}"
                                             Command="{Binding ToggleBatchModeCommand}"
                                             IconName="list-checks"
                                             CheckedBackground="{DynamicResource SemiBlue1}"
                                             ToolTips="{loc:Loc SessionBatchMode}" />
        </Grid>

        <!-- 紧挨搜索框:打字只按标题滤,要去消息里搜点这一行(或回车)。放在下方结果段那里的话,
             标题一个都没匹配时它沉在空列表最底下,离输入框整整一屏 -->
        <Button DockPanel.Dock="Top" Classes="picker-row content-hit" Margin="0,0,0,8"
                IsVisible="{Binding ContentSearch.CanStart}"
                Command="{Binding ContentSearch.StartCommand}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <controls:ThemedSvgIcon Width="14" Height="14" VerticalAlignment="Center" IconName="search" />
                <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding ContentSearch.StartText}" />
            </Grid>
        </Button>

        <!-- 批量动作条：只在批量模式出现。删的口径是"勾了的"（含被搜索滤掉的），
             不是"看得见的"；计数同此，"3/12"这种纯数字格式不牵本地化。
             退出走搜索行右边的图标（有按下态），这里不再另给 ✕ -->
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="0,8,0,0"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SemiGrey2}"
                IsVisible="{Binding IsBatchMode}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                <Button Grid.Column="0" Content="{loc:Loc SessionSelectAll}"
                        FontSize="11" Padding="8,4"
                        Command="{Binding ToggleSelectAllCommand}" />
                <Button Grid.Column="1" Content="{loc:Loc Delete}"
                        FontSize="11" Padding="8,4"
                        Command="{Binding DeleteCheckedCommand}"
                        IsEnabled="{Binding HasChecked}" />
                <!-- 计数沉右端：右方空着也是空着，数字靠右正好填上 -->
                <TextBlock Grid.Column="3" Classes="muted" FontSize="11"
                           VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}/{1}">
                            <Binding Path="CheckedCount" />
                            <Binding Path="Sessions.Count" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 消息里提到的：同一个搜索词在这一侧全部会话的消息里搜（见 ADR 0057）。要点下面那一行（或回车）才扫，
             打字本身只按标题滤。沉在列表下方、自己滚，标题匹配的列表照旧在上面；点一条摘要切过去，并在会话内搜索栏里跳到那条 -->
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="0,8,0,0" MaxHeight="340"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SemiGrey2}"
                IsVisible="{Binding ContentSearch.IsActive}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="11" Margin="2,0,0,6"
                           Text="{Binding ContentSearch.HeaderText}" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ContentSearch.Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sessions:SessionContentResultRow">
                                <StackPanel Margin="0,0,0,8" Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="2,0">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Session.Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Classes="muted" FontSize="11"
                                                   VerticalAlignment="Center" Text="{Binding CountText}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Hits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sessions:SessionContentHitRow">
                                                <Button Classes="picker-row content-hit"
                                                        Command="{Binding $parent[sessions:SessionListView].((sessions:SessionListModel)DataContext).ContentSearch.OpenCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                        <TextBlock Classes="muted" FontSize="11" Margin="0,1,0,0"
                                                                   VerticalAlignment="Top" Text="{Binding Label}" />
                                                        <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap"
                                                                   MaxLines="2" TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding Snippet}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 行模板要轻:Avalonia 的 ListBox 回收容器时会清掉 Content,行模板随之整棵重建,
             滚动每露出一行、拖滚动条每换一屏都要重建。所以平时看不见的部件一律用到才建:
             条件型的走 ConditionalContent,删除按钮悬停才建,右键菜单整个列表共用一份(见后台代码) -->
        <ListBox ItemsSource="{Binding Sessions}"
                 SelectedItem="{Binding SelectedSession}"
                 ContextRequested="OnListContextRequested">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="sessions:SessionListItem">
                    <!-- 悬停给全文:标题与描述在这窄侧栏里都是单行截断的,看不到尾 -->
                    <Grid Classes="session-row" ColumnDefinitions="Auto,Auto,*,Auto" Background="Transparent"
                          ToolTip.ShowDelay="600"
                          ToolTip.Placement="Pointer">
                        <!-- 明确给换行与上限宽度:标题本来就是因为放不下才截断的,
                             提示里再拉成一条长横条等于没解决问题 -->
                        <ToolTip.Tip>
                            <TextBlock Text="{Binding FullTextTip}" TextWrapping="Wrap" MaxWidth="320" />
                        </ToolTip.Tip>

                        <!-- 批量勾选列：只在批量模式占位。点行依然是选中（看会话），
                             勾选才管删哪几个——两套状态，见 SessionListItem.IsBatchChecked -->
                        <controls:ConditionalContent Grid.Column="0"
                                                     When="{Binding $parent[ListBox].((sessions:SessionListModel)DataContext).IsBatchMode}">
                            <controls:ConditionalContent.ContentTemplate>
                                <DataTemplate x:DataType="sessions:SessionListItem">
                                    <CheckBox Margin="0,0,10,0" VerticalAlignment="Center"
                                              IsChecked="{Binding IsBatchChecked}" />
                                </DataTemplate>
                            </controls:ConditionalContent.ContentTemplate>
                        </controls:ConditionalContent>

                        <!-- 间距给在头像自己的 Margin 上而不是 ColumnSpacing:
                             不建时它整体退出布局,列宽归零,不会留下一道空白缩进 -->
                        <controls:ConditionalContent Grid.Column="1" VerticalAlignment="Center"
                                                     When="{Binding $parent[sessions:SessionListView].ShowAvatar}">
                            <controls:ConditionalContent.ContentTemplate>
                                <DataTemplate x:DataType="sessions:SessionListItem">
                                    <controls:CircleAvatar Width="38" Height="38" Margin="0,0,10,0" Source="{Binding Icon}" />
                                </DataTemplate>
                            </controls:ConditionalContent.ContentTemplate>
                        </controls:ConditionalContent>

                        <!-- 指示器与「标题+描述」并列,而不是塞进标题那一行:
                             塞进去的话标题会被指示器那一列推右、描述不动,两行左边就对不齐,
                             而且缩进还随运行态变。间距同样给在自己的 Margin 上,隐藏时不留空位 -->
                        <Grid Grid.Column="2" ColumnDefinitions="Auto,*" MinWidth="0" VerticalAlignment="Center">
                            <!-- 在跑用转圈(动效最能说明"它在动"),待审批用橙点(那是要你去处理的)。
                                 两者**可以同时出现**且刻意叠在同一格:名下几个委派在跑、其中一个在等你批,
                                 是两件正交的事。橙点声明在转圈之后,所以画在它上面 -->
                            <controls:ConditionalContent Grid.Column="0" VerticalAlignment="Center"
                                                         When="{Binding IsRunning}">
                                <controls:ConditionalContent.ContentTemplate>
                                    <DataTemplate>
                                        <SpinnerIcon Width="13" Height="13" Margin="0,0,6,0" />
                                    </DataTemplate>
                                </controls:ConditionalContent.ContentTemplate>
                            </controls:ConditionalContent>
                            <!-- 压在转圈之上,所以比从前的 8 收一点:13 的圈里留得下 7,
                                 再大就把转圈整个盖住、动效白做了 -->
                            <controls:ConditionalContent Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         When="{Binding IsAwaitingApproval}">
                                <controls:ConditionalContent.ContentTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="#FF9800" />
                                    </DataTemplate>
                                </controls:ConditionalContent.ContentTemplate>
                            </controls:ConditionalContent>

                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" MinWidth="0">
                                <!-- 草稿标记:非当前会话且有未发送输入时在标题前亮一个小圆点 -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" MinWidth="0">
                                    <controls:ConditionalContent Grid.Column="0" VerticalAlignment="Center"
                                                                 When="{Binding IsDraftVisible}">
                                        <controls:ConditionalContent.ContentTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="#7AA2F7" />
                                            </DataTemplate>
                                        </controls:ConditionalContent.ContentTemplate>
                                    </controls:ConditionalContent>
                                    <!-- 群徽章放标题行:扫列表时眼睛只落在标题上,放描述行的灰字前缀分不出群与单聊。
                                         用带字的徽章而不是 SVG 图标:图标每建一个都要走一遍 SVG 加载,
                                         而这一格每行都在、每次回收都重建。外边距上 -1.5 下 -0.5:抵掉徽章比标题行高出的那 2px,
                                         同时上移半个逻辑像素——居中时底板下沿比基线多出 3px、上沿只比字顶高 2px,看着靠下。
                                         Retina 下半像素正好是一个物理像素,布局取整会把它落在整像素上,不发虚。
                                         底色给固定浅蓝而不是 SemiBlue1:徽章字是写死的深色,主题资源到深色主题会变成深底,字就看不清 -->
                                    <controls:ConditionalContent Grid.Column="1" VerticalAlignment="Center"
                                                                 When="{Binding IsGroup}">
                                        <controls:ConditionalContent.ContentTemplate>
                                            <DataTemplate>
                                                <controls:KindBadge Margin="0,-1.5,5,-0.5"
                                                                    Header="{loc:Loc SessionGroupBadge}"
                                                                    BadgeBackground="#CBE7FE" />
                                            </DataTemplate>
                                        </controls:ConditionalContent.ContentTemplate>
                                    </controls:ConditionalContent>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Name}"
                                               Foreground="{DynamicResource SemiGrey7}"
                                               TextWrapping="NoWrap"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <!-- 中间行:描述(对话页)。agent 页通常没有描述,这行自动隐藏。
                                     群壳的描述是成员名单,群身份已由标题行的徽章表明 -->
                                <TextBlock Grid.Row="1" Classes="muted" FontSize="11"
                                           Text="{Binding Description}" TextTrimming="CharacterEllipsis"
                                           MaxLines="1"
                                           IsVisible="{Binding HasDistinctDescription}" />
                                <!-- 末行:agent 页(不显头像)是「工作区名(项目色) + 时间」,聊天页(显头像)只有时间。
                                     工作区名打头让同角色不同项目一眼分开;角色名已从末行移除
                                     (同工作区多个会话角色不同是常态,身份靠标题与右侧栏呈现)。
                                     负边距只抵消末行基线以下的一小截空白:先试 -1,不够/过头再调 -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,0,0,-5">
                                    <TextBlock Classes="muted"
                                               Text="{Binding WorkspaceName}"
                                               Foreground="{Binding WorkspaceColor}"
                                               IsVisible="{Binding !$parent[sessions:SessionListView].ShowAvatar}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="110" />
                                    <TextBlock Classes="muted"
                                               Text="{Binding TimeString}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 悬停才建:不悬停时它透明不可见,逐行预建纯属浪费。
                             MinHeight 顶住按钮原本撑出的行高,否则一悬停整行长高、列表跟着跳。
                             批量模式下收起单删：避免"删一个"和"删一批"两个入口打架 -->
                        <controls:HoverDeferredContent Grid.Column="3" HostClass="session-row" VerticalAlignment="Center"
                                                       MinHeight="32"
                                                       IsVisible="{Binding !$parent[ListBox].((sessions:SessionListModel)DataContext).IsBatchMode}">
                            <controls:HoverDeferredContent.ContentTemplate>
                                <DataTemplate x:DataType="sessions:SessionListItem">
                                    <Button Classes="session-delete" Padding="4"
                                            FontSize="10" Content="✕"
                                            ToolTip.Tip="{Binding BusyTip}"
                                            Command="{Binding DeleteCommand}" />
                                </DataTemplate>
                            </controls:HoverDeferredContent.ContentTemplate>
                        </controls:HoverDeferredContent>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
