<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:search="clr-namespace:UiharuMind.Features.Conversation.Search"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="360"
             x:Class="UiharuMind.Features.Conversation.Search.ConversationSearchBar"
             x:DataType="search:ConversationSearchViewData">

    <UserControl.Styles>
        <Style Selector="ThemedIconButton.search-nav">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
        </Style>
        <Style Selector="ListBox.search-hits ListBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Styles>

    <!-- 浮在消息流右上角，不占会话流的行（开关它不该让整条流重排） -->
    <Border Width="360" Padding="8" CornerRadius="10"
            Background="{DynamicResource SemiGrey0}"
            BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="1"
            BoxShadow="0 4 16 0 #22000000">
        <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="2">
                <Grid>
                    <TextBox Name="QueryBox" Text="{Binding Query}"
                             Padding="29,5,8,5" FontSize="12"
                             PlaceholderText="{loc:Loc ConversationSearchPlaceholder}"
                             VerticalAlignment="Center" />
                    <ThemedSvgIcon Width="14" Height="14" Margin="9,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   IsHitTestVisible="False" IconName="search" />
                </Grid>
                <!-- 「3/17」是纯数字，不走本地化 -->
                <TextBlock Grid.Column="1" Classes="muted" FontSize="11" Margin="6,0,4,0"
                           VerticalAlignment="Center" Text="{Binding StatusText}" />
                <ThemedIconButton Grid.Column="2" Classes="search-nav" IconName="chevron-up"
                                  Command="{Binding OlderCommand}"
                                  IsEnabled="{Binding HasHits}"
                                  ToolTips="{loc:Loc ConversationSearchOlder}" />
                <ThemedIconButton Grid.Column="3" Classes="search-nav" IconName="chevron-down"
                                  Command="{Binding NewerCommand}"
                                  IsEnabled="{Binding HasHits}"
                                  ToolTips="{loc:Loc ConversationSearchNewer}" />
                <ThemedIconButton Grid.Column="4" Classes="search-nav" IconName="x"
                                  Command="{Binding CloseCommand}"
                                  ToolTips="{loc:Loc ConversationSearchClose}" />
            </Grid>

            <!-- 范围：默认只搜正文，思考与工具结果又长又多，要搜自己勾上 -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="filter-pill" Classes.selected="{Binding IncludeThinking}"
                        Content="{loc:Loc ConversationSearchThinking}"
                        ToolTip.Tip="{loc:Loc ConversationSearchThinkingTip}"
                        Command="{Binding ToggleThinkingCommand}" />
                <Button Classes="filter-pill" Classes.selected="{Binding IncludeTools}"
                        Content="{loc:Loc ConversationSearchTools}"
                        ToolTip.Tip="{loc:Loc ConversationSearchToolsTip}"
                        Command="{Binding ToggleToolsCommand}" />
            </StackPanel>

            <!-- 定位粒度是卡片，摘要让人不跳也能先认出是不是要找的那条 -->
            <ListBox Name="HitList" Classes="search-hits" MaxHeight="220"
                     Background="Transparent" Padding="0"
                     ItemsSource="{Binding Hits}"
                     SelectedIndex="{Binding SelectedIndex}"
                     IsVisible="{Binding HasHits}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="search:ConversationSearchHitRow">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Top"
                                       Margin="0,1,0,0" Text="{Binding Label}" />
                            <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis" Text="{Binding Snippet}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>
