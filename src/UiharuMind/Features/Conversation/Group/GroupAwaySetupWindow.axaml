<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:group="clr-namespace:UiharuMind.Features.Conversation.Group"
        xmlns:panels="clr-namespace:UiharuMind.Features.Conversation.SidePanels"
        xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
        xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
        mc:Ignorable="d"
        x:Class="UiharuMind.Features.Conversation.Group.GroupAwaySetupWindow"
        x:DataType="group:GroupAwayViewData"
        Width="460"
        MinWidth="400"
        SizeToContent="Height"
        Title="{loc:Loc GroupAwaySetupTitle}">
    <Window.Styles>
        <Style Selector="ComboBox">
            <Setter Property="MaxDropDownHeight" Value="240" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SemiGrey0}">
        <Border Padding="18,15" BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="50,*" ColumnSpacing="12">
                <Border Width="50" Height="50" CornerRadius="8"
                        Background="{DynamicResource SemiBlue0}">
                    <controls:ThemedSvgIcon Width="24" Height="24" IconName="clock" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{loc:Loc GroupAwaySetupTitle}" FontSize="20" />
                    <TextBlock Text="{loc:Loc GroupAwayHint}" Classes="muted" MaxLines="2"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="18" Spacing="12">
            <!-- 化身模型放最上：下拉朝下展开有足够空间，不会被窗口底边顶回去盖住上面的内容 -->
            <panels:SessionModelPanel DataContext="{Binding ModelPicker}" IsEnabled="{Binding IsIdle}" />
            <!-- 目标与提醒都只私下交代给化身，不进群 -->
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc GroupAwayGoalLabel}" ToolTip.Tip="{loc:Loc GroupAwayGoalTip}" />
                <TextBox Text="{Binding Goal}" PlaceholderText="{loc:Loc GroupAwayGoalPlaceholder}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="160"
                         VerticalContentAlignment="Top" Padding="10" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc GroupAwayReminderLabel}" ToolTip.Tip="{loc:Loc GroupAwayReminderTip}" />
                <TextBox Text="{Binding Reminder}" PlaceholderText="{loc:Loc GroupAwayReminderPlaceholder}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="120"
                         VerticalContentAlignment="Top" Padding="10" />
            </StackPanel>
            <!-- 开关自带的文字位就放说明，开/关两态同一句 -->
            <ToggleSwitch IsChecked="{Binding Infinite}" IsEnabled="{Binding IsIdle}"
                          OnContent="{loc:Loc GroupAwayInfiniteLabel}"
                          OffContent="{loc:Loc GroupAwayInfiniteLabel}"
                          ToolTip.Tip="{loc:Loc GroupAwayInfiniteTip}" />
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding IsAway}" Text="{Binding StatusLine}" />
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding HasCountdown}" Text="{Binding CountdownLine}" />
        </StackPanel>

        <Border Grid.Row="2" Padding="14" BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <!-- 没在离席：取消 / 开始离席 -->
                <Button Content="{loc:Loc CancelBtn}" Click="CancelButton_Click"
                        IsVisible="{Binding IsIdle}" />
                <Button Classes="Primary" Content="{loc:Loc GroupAwayStart}"
                        IsVisible="{Binding IsIdle}"
                        IsEnabled="{Binding StartCommand.CanExecute}"
                        Click="StartButton_Click" />
                <!-- 离席中：立即唤醒 / 结束离席 / 关闭 -->
                <Button Classes="Tertiary" Content="{loc:Loc GroupAwayWakeNow}"
                        IsVisible="{Binding HasCountdown}"
                        Click="WakeNowButton_Click" />
                <Button Content="{loc:Loc GroupAwayEnd}"
                        IsVisible="{Binding IsAway}"
                        Click="EndButton_Click" />
                <Button Content="{loc:Loc CancelBtn}"
                        IsVisible="{Binding IsAway}"
                        Click="CancelButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
