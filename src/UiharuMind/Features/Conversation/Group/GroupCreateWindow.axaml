<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:group="clr-namespace:UiharuMind.Features.Conversation.Group"
        xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
        xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
        mc:Ignorable="d"
        x:Class="UiharuMind.Features.Conversation.Group.GroupCreateWindow"
        x:DataType="group:GroupCreateWindowModel"
        Width="560"
        Height="660"
        MinWidth="480"
        MinHeight="520"
        Title="{loc:Loc GroupCreateTitle}">
    <Design.DataContext>
        <group:GroupCreateWindowModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SemiGrey0}">
        <Border Padding="18,15" BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="50,*" ColumnSpacing="12">
                <Border Width="50" Height="50" CornerRadius="8"
                        Background="{DynamicResource SemiBlue0}">
                    <controls:ThemedSvgIcon Width="24" Height="24" IconName="users-round" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{loc:Loc GroupCreateTitle}" FontSize="20" />
                    <TextBlock Text="{Binding TypeHint}" Classes="muted" MaxLines="2"
                               TextTrimming="PathSegmentEllipsis"
                               ToolTip.Tip="{Binding TypeHint}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
            <!-- 标签贴输入框（Spacing 4），区块之间用 12 拉开：之前标签和区块都是 8，看不出分组 -->
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc GroupNameLabel}" />
                <TextBox Text="{Binding Name}" PlaceholderText="{loc:Loc GroupNamePlaceholder}" />
            </StackPanel>

            <!-- 挑人：筛选、候选、各自的模型（与之后加人共用） -->
            <group:GroupCandidatePickerView Grid.Row="1" DataContext="{Binding Picker}" />

            <!-- 勾选顺序即发言顺序:这件事不写出来,用户只会以为是列表顺序 -->
            <StackPanel Grid.Row="2" Spacing="2">
                <TextBlock Classes="muted" Text="{loc:Loc GroupSpeakingOrderLabel}" />
                <TextBlock Text="{Binding SpeakingOrder}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 调度与主持人：建后都能在右栏改 -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Classes="muted" Text="{loc:Loc GroupScheduleLabel}" />
                    <group:GroupScheduleSelector DataContext="{Binding Schedule}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" Width="150">
                    <TextBlock Classes="muted" Text="{loc:Loc GroupHostLabel}" ToolTip.Tip="{loc:Loc GroupHostHint}" />
                    <ComboBox ItemsSource="{Binding HostOptions}" SelectedItem="{Binding SelectedHost}"
                              HorizontalAlignment="Stretch" ToolTip.Tip="{loc:Loc GroupHostHint}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="group:GroupHostOption">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="14" BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Loc CancelBtn}" Click="CancelButton_Click" />
                <Button Classes="Primary" IsEnabled="{Binding CanCreate}" Click="CreateButton_Click"
                        Content="{loc:Loc GroupCreateAction}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
