<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:group="clr-namespace:UiharuMind.Features.Conversation.Group"
        xmlns:chars="clr-namespace:UiharuMind.Features.Characters"
        xmlns:panels="clr-namespace:UiharuMind.Features.Conversation.SidePanels"
        xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
        xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
        mc:Ignorable="d"
        x:Class="UiharuMind.Features.Conversation.Group.GroupCreateWindow"
        x:DataType="group:GroupCreateWindowModel"
        Width="560"
        Height="660"
        MinWidth="480"
        MinHeight="520"
        Title="{loc:Loc GroupCreateTitle}">
    <Design.DataContext>
        <group:GroupCreateWindowModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SemiGrey0}">
        <Border Padding="18,15" BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="50,*" ColumnSpacing="12">
                <Border Width="50" Height="50" CornerRadius="8"
                        Background="{DynamicResource SemiBlue0}">
                    <controls:ThemedSvgIcon Width="24" Height="24" IconName="users-round" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{loc:Loc GroupCreateTitle}" FontSize="20" />
                    <TextBlock Text="{Binding TypeHint}" Classes="muted" MaxLines="2"
                               TextTrimming="PathSegmentEllipsis"
                               ToolTip.Tip="{Binding TypeHint}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
            <!-- 标签贴输入框（Spacing 4），区块之间用 12 拉开：之前标签和区块都是 8，看不出分组 -->
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc GroupNameLabel}" />
                <TextBox Text="{Binding Name}" PlaceholderText="{loc:Loc GroupNamePlaceholder}" />
            </StackPanel>

            <!-- 挑人前先筛:搜索按名字与描述,胶囊按类别。普通群里点「智能体」会筛空,是正常语义。
                 刻意只有一条轴:两组胶囊并排会出现两个「全部」,那个比排版更别扭。
                 选项由枚举派生,不落回「下标 + Tag」那套 -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding SearchText}"
                         PlaceholderText="{loc:Loc CharacterSearchPlaceholder}"
                         VerticalAlignment="Center" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding KindPills}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="chars:CharacterFilterPill">
                            <Button Classes="filter-pill" Classes.selected="{Binding IsSelected}"
                                    Content="{Binding Label}" Command="{Binding PickCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Border Grid.Row="2" BorderThickness="1" CornerRadius="8"
                    BorderBrush="{DynamicResource SemiGrey2}" Padding="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="4,6"
                               Text="{loc:Loc CharacterPickerEmpty}"
                               IsVisible="{Binding IsEmpty}" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Candidates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="group:GroupCandidate">
                                <!-- 整行可点：CheckBox 只占左列，内容用 Grid 约束宽度以便截断；
                                     模型下拉只在勾选后出现（未选行整行让给名字和描述）——点行勾选、
                                     点下拉只选模型，互不抢事件；行高由头像撑起，下拉显隐不跳布局 -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="4,5"
                                      VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsPicked}"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
                                              VerticalAlignment="Center">
                                            <controls:CircleAvatar Width="32" Height="32" Source="{Binding Icon}"
                                                                   VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <!-- 名字占剩余宽度截断，徽章贴名字右边 -->
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               FontSize="13" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Left" />
                                                    <controls:KindBadge Grid.Column="1"
                                                                        Header="{Binding KindName}"
                                                                        BadgeBackground="{Binding KindColor}" />
                                                </Grid>
                                                <!-- 描述一行：截断靠 ToolTip 看全文 -->
                                                <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Description}"
                                                           IsVisible="{Binding HasDescription}" />
                                            </StackPanel>
                                        </Grid>
                                    </CheckBox>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ModelOptions}"
                                              SelectedItem="{Binding SelectedModelOption}"
                                              IsVisible="{Binding IsPicked}"
                                              Width="190" VerticalAlignment="Center"
                                              ToolTip.Tip="{Binding SelectedModelOption.DisplayName}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="panels:SessionModelOption">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <controls:KindBadge Header="{loc:Loc ModelStateRemote}"
                                                                        BadgeBackground="LimeGreen"
                                                                        IsVisible="{Binding IsRemoteModel, Mode=OneWay}" />
                                                    <controls:KindBadge Header="{loc:Loc ModelStateVision}"
                                                                        BadgeBackground="Gold"
                                                                        IsVisible="{Binding IsVisionModel, Mode=OneWay}" />
                                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBox.SelectionBoxItemTemplate>
                                            <DataTemplate x:DataType="panels:SessionModelOption">
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.SelectionBoxItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 勾选顺序即发言顺序:这件事不写出来,用户只会以为是列表顺序 -->
            <StackPanel Grid.Row="3" Spacing="2">
                <TextBlock Classes="muted" Text="{loc:Loc GroupSpeakingOrderLabel}" />
                <TextBlock Text="{Binding SpeakingOrder}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 调度与主持人：建后都能在右栏改 -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Classes="muted" Text="{loc:Loc GroupScheduleLabel}" />
                    <group:GroupScheduleSelector DataContext="{Binding Schedule}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" Width="150">
                    <TextBlock Classes="muted" Text="{loc:Loc GroupHostLabel}" ToolTip.Tip="{loc:Loc GroupHostHint}" />
                    <ComboBox ItemsSource="{Binding HostOptions}" SelectedItem="{Binding SelectedHost}"
                              HorizontalAlignment="Stretch" ToolTip.Tip="{loc:Loc GroupHostHint}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="group:GroupHostOption">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="14" BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Loc CancelBtn}" Click="CancelButton_Click" />
                <Button Classes="Primary" IsEnabled="{Binding CanCreate}" Click="CreateButton_Click"
                        Content="{loc:Loc GroupCreateAction}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
