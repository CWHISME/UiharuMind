<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:group="clr-namespace:UiharuMind.Features.Conversation.Group"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
             x:Class="UiharuMind.Features.Conversation.Group.GroupMembersPanel"
             x:DataType="group:GroupMembersViewData">

    <!-- 群的成员:按发言顺序,点开是他自己的会话(只读)。那里看得到他收到了什么、自己干了什么 -->
    <Border BorderThickness="1" BorderBrush="{DynamicResource SemiGrey2}" CornerRadius="8" Padding="8">
        <StackPanel Spacing="8">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{loc:Loc GroupMembersTitle}" />
            <TextBlock Classes="muted" Text="{loc:Loc GroupMembersHint}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="group:GroupMemberItem">
                        <Button Classes="Tertiary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Margin="0,2" Command="{Binding OpenCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Width="24" Height="24" Source="{Binding Icon}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
