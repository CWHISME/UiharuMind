<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:group="clr-namespace:UiharuMind.Features.Conversation.Group"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
             x:Class="UiharuMind.Features.Conversation.Group.GroupMembersPanel"
             x:DataType="group:GroupMembersViewData">

    <UserControl.Styles>
        <!-- 成员占用的细进度条：蓝色随主题强调色，轨道显形（占用低时进度块只有几像素） -->
        <Style Selector="ProgressBar.member-usage /template/ Border#PART_Indicator">
            <Setter Property="Background" Value="{DynamicResource MessageStatusInfoBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- 群的成员:按发言顺序,点开是他自己的会话(可看可聊)。那里看得到他收到了什么、自己干了什么 -->
    <Border BorderThickness="1" BorderBrush="{DynamicResource SemiGrey2}" CornerRadius="8" Padding="8">
        <StackPanel Spacing="8">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{loc:Loc GroupMembersTitle}" />
            <TextBlock Classes="muted" Text="{loc:Loc GroupMembersHint}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="group:GroupMemberItem">
                        <Button Classes="Tertiary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Margin="0,2" Command="{Binding OpenCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Width="28" Height="28" Source="{Binding Icon}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" />
                                        <!-- 正在说的那一位：蓝点跟着调度器的发言人变化走 -->
                                        <Border Classes="status-dot" Tag="Progress" IsVisible="{Binding IsSpeaking}" />
                                    </StackPanel>
                                    <!-- 成员会话实际用的模型（钉选 → 跟随全局） -->
                                    <TextBlock Classes="muted" FontSize="10" Text="{Binding ModelLabel}" />
                                    <!-- 真实占用 / 模型上限：与右栏上下文占用同一形状，随每圈落盘刷新 -->
                                    <TextBlock Classes="muted" FontSize="10" Text="{Binding ContextLine}"
                                               ToolTip.Tip="{loc:Loc GroupMemberContextTip}" />
                                    <!-- 占用进度条：一眼看出离上限还有多远 -->
                                    <ProgressBar Classes="member-usage" Minimum="0" Maximum="100"
                                                 Value="{Binding UsagePercent}" Height="3" CornerRadius="1.5"
                                                 MinWidth="0" Margin="0,1,0,0"
                                                 Background="{DynamicResource SemiGrey3}"
                                                 IsVisible="{Binding HasUsage}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
