<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:group="clr-namespace:UiharuMind.Features.Conversation.Group"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
             x:Class="UiharuMind.Features.Conversation.Group.GroupMembersPanel"
             x:DataType="group:GroupMembersViewData">

    <UserControl.Styles>
        <!-- 成员占用的细进度条：蓝色随主题强调色，轨道显形（占用低时进度块只有几像素） -->
        <Style Selector="ProgressBar.member-usage /template/ Border#PART_Indicator">
            <Setter Property="Background" Value="{DynamicResource MessageStatusInfoBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- 群的成员:按发言顺序,点开是他自己的会话(可看可聊)。那里看得到他收到了什么、自己干了什么 -->
    <Border BorderThickness="1" BorderBrush="{DynamicResource SemiGrey2}" CornerRadius="8" Padding="8">
        <StackPanel Spacing="8">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{loc:Loc GroupMembersTitle}" />
            <TextBlock Classes="muted" Text="{loc:Loc GroupMembersHint}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="group:GroupMemberItem">
                        <Button Classes="Tertiary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Margin="0,2" Command="{Binding OpenCommand}"
                                ToolTip.Tip="{Binding CardTip}">
                            <!-- Grid 定列：横向 StackPanel 给不了文本列宽度约束，省略号会算不准、 half 切 -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Image Grid.Column="0" Width="32" Height="32" Source="{Binding Icon}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" MinWidth="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                        <!-- 正在说的那一位：蓝点 + 文字，跟着调度器的发言人变化走 -->
                                        <Border Classes="status-dot" Tag="Progress" IsVisible="{Binding IsSpeaking}" />
                                        <TextBlock FontSize="10" IsVisible="{Binding IsSpeaking}"
                                                   Foreground="{DynamicResource MessageStatusInfoBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="{loc:Loc GroupMemberSpeaking}" />
                                    </StackPanel>
                                    <!-- 角色描述为主行；模型彻底收进整卡 tooltip，行内不再出现 -->
                                    <TextBlock Classes="muted" FontSize="11" Text="{Binding Description}"
                                               ToolTip.Tip="{Binding Description}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               IsVisible="{Binding HasDescription}" />
                                    <!-- 真实占用 / 模型上限：与右栏上下文占用同一形状，随每圈落盘刷新 -->
                                    <TextBlock Classes="muted" FontSize="10" Text="{Binding ContextLine}"
                                               IsVisible="{Binding HasUsage}" />
                                    <!-- 占用进度条：一眼看出离上限还有多远 -->
                                    <ProgressBar Classes="member-usage" Minimum="0" Maximum="100"
                                                 Value="{Binding UsagePercent}" Height="4" CornerRadius="2"
                                                 MinWidth="0" Margin="0,3,0,2"
                                                 Background="{DynamicResource SemiGrey3}"
                                                 IsVisible="{Binding HasUsage}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
