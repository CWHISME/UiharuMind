<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:group="clr-namespace:UiharuMind.Features.Conversation.Group"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
             x:Class="UiharuMind.Features.Conversation.Group.GroupMembersPanel"
             x:DataType="group:GroupMembersViewData">

    <!-- 群的成员:按发言顺序,点开是他自己的会话(可看可聊)。那里看得到他收到了什么、自己干了什么 -->
    <Border BorderThickness="1" BorderBrush="{DynamicResource SemiGrey2}" CornerRadius="8" Padding="8">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                           Text="{loc:Loc GroupMembersTitle}" />
                <!-- 全群累计：看得到这个群一共烧了多少，只是仪表，不做任何自动干预（方案 v6 §3.4） -->
                <TextBlock Grid.Column="1" Classes="muted" FontSize="11" VerticalAlignment="Center"
                           Text="{Binding TotalCostLine}" IsVisible="{Binding HasTotalCost}" />
                <!-- 建群之后加人（含加回退群的人），只占一个图标位；移出与调整顺序在成员行的右键菜单里 -->
                <ThemedIconButton Grid.Column="2" Width="24" Height="24" VerticalAlignment="Center"
                                  IconName="user-plus"
                                  ToolTip.Tip="{loc:Loc GroupAddMembers}"
                                  Command="{Binding AddMembersCommand}" />
            </Grid>
            <TextBlock Classes="muted" Text="{loc:Loc GroupMembersHint}" TextWrapping="Wrap" />
            <!-- 调度设置：改了下一波起生效，正在跑的这一波不打断 -->
            <group:GroupScheduleSelector DataContext="{Binding Schedule}" />
            <!-- 主持人：改了各成员下一轮开口时生效（写在他们系统提示的场景段里） -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" ToolTip.Tip="{loc:Loc GroupHostHint}">
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{loc:Loc GroupHostLabel}" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding HostOptions}" SelectedItem="{Binding SelectedHost, Mode=OneWay}"
                          DropDownClosed="OnHostDropDownClosed">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="group:GroupHostChoice">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="group:GroupMemberItem">
                        <Button Classes="Tertiary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Margin="0,2" Command="{Binding OpenCommand}">
                            <!-- 上半部（头像/名字/描述）悬停：名称 + 描述；底部 usage 行自己挂了模型 tooltip 覆盖这份继承 -->
                            <ToolTip.Tip>
                                <StackPanel MaxWidth="320" Spacing="3">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                               IsVisible="{Binding HasDescription}" />
                                </StackPanel>
                            </ToolTip.Tip>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc GroupMoveUp}" Command="{Binding MoveUpCommand}" />
                                    <MenuItem Header="{loc:Loc GroupMoveDown}" Command="{Binding MoveDownCommand}" />
                                    <Separator />
                                    <MenuItem Header="{loc:Loc GroupRemoveMember}" Command="{Binding RemoveCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <!-- 上身份（头像只跨名字+描述两行、垂直居中），下统计（统一一行 + 全宽进度条）。
                                 发言状态只占第一行最右，只跟名字争宽——描述跨到最右，状态出现时不再挤出省略号 -->
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto"
                                   ColumnSpacing="8" RowSpacing="1">
                                <controls:CircleAvatar Grid.RowSpan="2" Width="32" Height="32" Source="{Binding Icon}"
                                                        VerticalAlignment="Center" />
                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <controls:KindBadge Grid.Column="1" Header="{loc:Loc GroupHostLabel}"
                                                        BadgeBackground="{DynamicResource SemiOrange5}"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsHost}" />
                                </Grid>
                                <!-- 角色描述为主行；模型收进底部 usage 行自己的 tooltip，行内不再出现 -->
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                           Classes="muted" FontSize="11" Text="{Binding Description}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"
                                           IsVisible="{Binding HasDescription}" />
                                <!-- 下半部分：模型统计。整条都是模型 tooltip 的宿主——usage 没数据时行内是空的，
                                     这层容器不被隐藏（MinHeight 兜底），鼠标落在这条的任何位置都出模型 tooltip。
                                     必须给透明背景：没背景的 Border 空白处不参与 hit test，会穿透到 Button 显示上半部分 tooltip -->
                                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" MinHeight="18"
                                        Background="Transparent"
                                        ToolTip.Tip="{Binding Usage.Tip}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                        <!-- 占用 / 上限、累计与占用进度条，随每次用量上报刷新 -->
                                        <group:SessionUsageBar DataContext="{Binding Usage}" />
                                        <!-- 模型图标：视觉提示这里悬停看模型信息；tooltip 由整条容器统一给 -->
                                        <controls:ThemedSvgIcon Grid.Column="1" Width="14" Height="14"
                                                                IconName="bot" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <!-- 正在说的那一位（并行时可能几位）：蓝点 + 文字，跟着调度器的发言人变化走 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ShowsSpeaking}">
                                    <Border Classes="status-dot" Tag="Progress" VerticalAlignment="Center" />
                                    <TextBlock FontSize="10" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MessageStatusInfoBrush}"
                                               Text="{loc:Loc GroupMemberSpeaking}" />
                                </StackPanel>
                                <!-- 在他自己的窗口里私聊：跑着，但回复不进群 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ShowsPrivateChat}">
                                    <Border Classes="status-dot" Tag="Progress" VerticalAlignment="Center" />
                                    <TextBlock FontSize="10" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MessageStatusInfoBrush}"
                                               Text="{loc:Loc GroupMemberPrivateChat}" />
                                </StackPanel>
                                <!-- 他这一轮停着等审批：批在群输入框上方那条，或点开他的会话 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsAwaitingApproval}">
                                    <Border Classes="status-dot" Tag="Warning" VerticalAlignment="Center" />
                                    <TextBlock FontSize="10" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SemiOrange5}"
                                               Text="{loc:Loc GroupMemberAwaitingApproval}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 已退出：默认折叠。会话留着，「查看」看他在群里时的那段；「加回」走加人弹窗、预先勾上他 -->
            <Expander IsVisible="{Binding HasFormerMembers}" HorizontalAlignment="Stretch"
                      Header="{Binding FormerMembersTitle}">
                <ItemsControl ItemsSource="{Binding FormerMembers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="group:GroupFormerMemberItem">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                                <controls:CircleAvatar Width="24" Height="24" Source="{Binding Icon}"
                                                       VerticalAlignment="Center" Opacity="0.6" />
                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="Tertiary" Padding="6,2" FontSize="11"
                                        Content="{loc:Loc GroupOpenSession}" Command="{Binding OpenCommand}" />
                                <Button Grid.Column="3" Classes="Tertiary" Padding="6,2" FontSize="11"
                                        Content="{loc:Loc GroupRejoin}" Command="{Binding RejoinCommand}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
