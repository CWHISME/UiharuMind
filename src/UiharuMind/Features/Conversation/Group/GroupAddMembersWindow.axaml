<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:group="clr-namespace:UiharuMind.Features.Conversation.Group"
        xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
        xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
        mc:Ignorable="d"
        x:Class="UiharuMind.Features.Conversation.Group.GroupAddMembersWindow"
        x:DataType="group:GroupAddMembersWindowModel"
        Width="560"
        Height="620"
        MinWidth="480"
        MinHeight="480"
        Title="{loc:Loc GroupAddMembers}">
    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SemiGrey0}">
        <Border Padding="18,15" BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="50,*" ColumnSpacing="12">
                <Border Width="50" Height="50" CornerRadius="8"
                        Background="{DynamicResource SemiBlue0}">
                    <controls:ThemedSvgIcon Width="24" Height="24" IconName="users-round" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{loc:Loc GroupAddMembers}" FontSize="20" />
                    <TextBlock Text="{Binding Hint}" Classes="muted" TextWrapping="Wrap" MaxLines="2" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18" RowDefinitions="*,Auto" RowSpacing="12">
            <group:GroupCandidatePickerView DataContext="{Binding Picker}" />

            <!-- 补历史：新成员与加回的人共用一种；摘要由主持人或最近发言的成员写 -->
            <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Classes="muted" Text="{loc:Loc GroupBackfillLabel}" />
                <RadioButton GroupName="Backfill" IsChecked="{Binding IsBackfillNone}"
                             Content="{loc:Loc GroupBackfillNone}" />
                <RadioButton GroupName="Backfill" IsChecked="{Binding IsBackfillSummary}"
                             Content="{loc:Loc GroupBackfillSummary}" />
                <RadioButton GroupName="Backfill" IsChecked="{Binding IsBackfillFull}"
                             Content="{Binding FullLabel}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Padding="14" BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Loc CancelBtn}" Click="CancelButton_Click" />
                <Button Classes="Primary" IsEnabled="{Binding CanAdd}" Click="AddButton_Click"
                        Content="{loc:Loc GroupAddAction}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
