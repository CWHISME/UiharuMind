<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:panels="clr-namespace:UiharuMind.Features.Conversation.SidePanels"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:lang="clr-namespace:UiharuMind.Resources.Lang"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UiharuMind.Features.Conversation.SidePanels.TranslationPanel">

    <Design.DataContext>
        <panels:TranslationViewData />
    </Design.DataContext>

    <Border BorderThickness="1" BorderBrush="{DynamicResource SemiGrey2}" Padding="5">
        <StackPanel Spacing="10">
            <u:Divider Content="{loc:Loc ParamsLang}" />
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                      HorizontalAlignment="Stretch" />
        </StackPanel>
    </Border>

</UserControl>