<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:panels="clr-namespace:UiharuMind.Features.Conversation.SidePanels"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="200"
             x:Class="UiharuMind.Features.Conversation.SidePanels.ContextUsagePanel"
             x:Name="Root"
             x:DataType="panels:ContextUsageViewData">

    <!-- 上下文占用的统计面板：模型名与上限、两段进度条、压缩水位刻度与三段归因。
         配对的数据是 ContextUsageViewData。
         两处复用：输入框那个环点开的面板（完整，含水位说明）与右侧栏（只读摘要，ShowDetails=False）。

         进度条<b>两段叠放</b>：上层是服务端报的那段（实色），下层画到有效占用、半透明，
         区分出「这一截是我们估的、服务端没计入」。口径见 ADR 0009。 -->

    <UserControl.Styles>
        <!-- 上下文占用条:颜色即压缩档位。轨道必须可见——占用低时进度块只有一两像素,
             没有轨道衬着就看不出这是一根进度条,只像一个小色块。
             轨道背景直接走 ProgressBar.Background(Semi 模板里没有 PART_Track,
             背景由模板里的 ProgressBarRoot 用 TemplateBinding 取) -->
        <Style Selector="ProgressBar.contextUsage[Tag=Normal] /template/ Border#PART_Indicator">
            <Setter Property="Background" Value="MediumSeaGreen" />
        </Style>
        <Style Selector="ProgressBar.contextUsage[Tag=Evicting] /template/ Border#PART_Indicator">
            <Setter Property="Background" Value="Orange" />
        </Style>
        <Style Selector="ProgressBar.contextUsage[Tag=Truncating] /template/ Border#PART_Indicator">
            <Setter Property="Background" Value="OrangeRed" />
        </Style>
        <!-- 两段叠放:上层轨道必须透明才不会盖住底层。Semi 没有 PART_Track,
             轨道背景在 ProgressBarRoot 上,由 ProgressBar.Background 驱动,
             所以表现在直接把 reported 的 Background 设为 Transparent -->
        <Style Selector="ProgressBar.contextUsage.unreported /template/ Border#PART_Indicator">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="6">
    <!-- 模型名 + 上下文上限 -->
    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasData}">
        <TextBlock Text="{Binding ModelName}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Classes="muted" Margin="8,0,0,0"
                   Text="{Binding LimitText}" />
    </Grid>

    <!-- 占用条：颜色随压缩档位变，Tag 由样式选择器取用。
         两段叠放——底层画到有效占用（含服务端未计入的那截，淡色），
         上层只画服务端报的那段（实色，可与官方控制台对账）。
         上层轨道必须透明，否则会把底层那截盖掉。
         两个都要 MinWidth=0:Semi 主题对横向 ProgressBar 有 MinWidth=200 的默认,
         右栏窄时会把进度条撑出可视区、整条被裁掉,拉宽才出现。
         轨道灰色直接给底层(Background),上层 Transparent,与模板结构一致 -->
    <Grid IsVisible="{Binding HasData}" Height="6">
        <ProgressBar Classes="contextUsage unreported" Tag="{Binding StateKey}"
                     Minimum="0" Maximum="100" Value="{Binding EffectivePercent}"
                     Height="6" CornerRadius="3" MinWidth="0"
                     Background="{DynamicResource SemiGrey3}" />
        <ProgressBar Classes="contextUsage reported" Tag="{Binding StateKey}"
                     Minimum="0" Maximum="100" Value="{Binding UsagePercent}"
                     Height="6" CornerRadius="3" MinWidth="0"
                     Background="Transparent" />
    </Grid>

    <!-- 没有模型就没有上限,整个面板算不出来:说清楚为什么,别只给一个空框 -->
    <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="11"
               IsVisible="{Binding !HasData}" Text="{loc:Loc ContextNoModel}" />

    <!-- 没有上限时也显示占用(会话本体恢复出来的),只是没有分母。
         这一格的悬停要给成显式的 NoWrap 文本：tip 是字符串时它会被塞进一个会换行的 TextBlock，
         而「134.1k / 308k」正好在斜杠处折行——折出来的第二行有时不显示，屏幕上就是半句 -->
    <controls:BaselineStackPanel Spacing="8"
          IsVisible="{Binding UsageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="muted" Text="{loc:Loc ContextUsageLabel}" />
        <TextBlock HorizontalAlignment="Right" Text="{Binding UsageText}" TextTrimming="CharacterEllipsis">
            <ToolTip.Tip>
                <TextBlock Text="{Binding UsageText}" TextWrapping="NoWrap" />
            </ToolTip.Tip>
        </TextBlock>
    </controls:BaselineStackPanel>

    <!-- 报告占用:只有服务端少报(有未计入差额)时才出现,与「未计入」配对对账。
         平时不显示——绝大多数服务端报全量,亮出来只是跟上面的「上下文」重复 -->
    <controls:BaselineStackPanel Name="ReportedRow" Spacing="8"
          IsVisible="{Binding ReportedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="muted" Text="{loc:Loc ContextReportedLabel}" />
        <TextBlock HorizontalAlignment="Right" Text="{Binding ReportedText}" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding ReportedText}" />
        <ToolTip.Tip>
            <TextBlock Text="{loc:Loc ContextReportedTip}" TextWrapping="Wrap" />
        </ToolTip.Tip>
    </controls:BaselineStackPanel>

    <!-- 服务端没计入的那段。口径一致时整行不出现——绝大多数服务端报的就是全量 -->
    <controls:BaselineStackPanel Spacing="8"
          IsVisible="{Binding UnreportedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="muted" Text="{loc:Loc ContextUnreportedLabel}" />
        <TextBlock HorizontalAlignment="Right" Text="{Binding UnreportedText}" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding UnreportedText}" />
        <ToolTip.Tip>
            <TextBlock Text="{loc:Loc ContextUnreportedTip}" TextWrapping="Wrap" />
        </ToolTip.Tip>
    </controls:BaselineStackPanel>

    <!-- 折叠(或截断)压掉的那截。进度条画的是发出去的那份,压过之后可能落回交接线下,
         这一行交代交接为什么照样会来。没压时整行不出现 -->
    <controls:BaselineStackPanel Spacing="8"
          IsVisible="{Binding CompactedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="muted" Text="{loc:Loc ContextCompactedLabel}" />
        <TextBlock HorizontalAlignment="Right" Text="{Binding CompactedText}" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding CompactedText}" />
        <ToolTip.Tip>
            <TextBlock Text="{loc:Loc ContextCompactedTip}" TextWrapping="Wrap" />
        </ToolTip.Tip>
    </controls:BaselineStackPanel>

    <!-- 输入框草稿的估算：只在面板打开时数一次，数过才有这一行。
         它是「发出去会变成多少」，与上面那个「现在已经占了多少」是两个数，所以单列 -->
    <controls:BaselineStackPanel Spacing="8"
          IsVisible="{Binding DraftText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="muted" Text="{loc:Loc ContextDraftLabel}" />
        <TextBlock HorizontalAlignment="Right" Text="{Binding DraftText}" />
    </controls:BaselineStackPanel>

    <!-- 缓存命中:正文报会话累计命中率,本轮与最近一次两个口径在悬停里对照。
         单次那个数按构造接近全命中(轮内上下文单调增长,最后一发前缀就是上一发的全部),
         拿它当命中率会虚高——所以它不上正文。
         长文案的 tip 一律给显式宽度:tip 是字符串时按外层给的约束量,在弹出层里那个约束是错的,
         量出来的高度少一行,最后一句就被裁掉 -->
    <controls:BaselineStackPanel Name="CachedRow" Spacing="8"
          IsVisible="{Binding CachedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="muted" Text="{loc:Loc ContextCachedLabel}" />
        <TextBlock Name="CachedValue" HorizontalAlignment="Right" Text="{Binding CachedText}"
                   TextTrimming="CharacterEllipsis">
            <ToolTip.Tip>
                <TextBlock Text="{Binding CachedTip}" TextWrapping="Wrap" />
            </ToolTip.Tip>
        </TextBlock>
    </controls:BaselineStackPanel>

    <!-- 交接/折叠/截断三条水位的说明。属补充信息：右侧栏常驻时藏掉（ShowDetails=False），
         只在输入框那个环弹出的面板里完整显示 -->
    <Grid IsVisible="{Binding HasData}">
        <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="11"
                   IsVisible="{Binding #Root.ShowDetails}"
                   Text="{Binding ThresholdText}" />
    </Grid>

    <!-- 请求次数:会话累计调用了多少次模型。次数不是 token、没有量级换算,整数原样显示-->
    <controls:BaselineStackPanel Spacing="8"
                                 IsVisible="{Binding RequestCountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="muted" Text="{loc:Loc ContextRequestsLabel}" />
        <TextBlock HorizontalAlignment="Right" Text="{Binding RequestCountText}" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding RequestCountText}" />
    </controls:BaselineStackPanel>
    
    <!-- 思考统计:属补充信息,跟水位说明一起只在完整显示时出现（ShowDetails）。
         只显示会话累计数量,不摆比率(比率底数是累计消耗,跟「上下文」的最近占用不是一回事)。
         放在本轮/累计之前,它是累计口径但只报一个数,不跟下面两行排成同一形状 -->
    <!-- <Grid IsVisible="{Binding #Root.ShowDetails}"> -->
    <controls:BaselineStackPanel Spacing="8"
          IsVisible="{Binding ReasoningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="muted" Text="{loc:Loc ContextReasoningLabel}" />
        <TextBlock HorizontalAlignment="Right" Text="{Binding ReasoningText}" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding ReasoningText}" />
    </controls:BaselineStackPanel>
    <!-- </Grid> -->

    <!-- 累计消耗:本轮收进这一行的悬停。正文只留累计——本轮与累计是同一个数的两个范围,
         摆成上下两行会被当成两个量在比。同理,累计命中率也不单列一行 -->
    <controls:BaselineStackPanel Spacing="8"
          IsVisible="{Binding SessionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="muted" Text="{loc:Loc ContextSessionLabel}" />
        <TextBlock HorizontalAlignment="Right" Text="{Binding SessionText}" TextTrimming="CharacterEllipsis">
            <ToolTip.Tip>
                <TextBlock Text="{Binding SessionTip}" TextWrapping="NoWrap" />
            </ToolTip.Tip>
        </TextBlock>
    </controls:BaselineStackPanel>

    <!-- 生图按张计费、不报 token,不混进上面的 token 累计,单列一行 -->
    <controls:BaselineStackPanel Spacing="8"
          IsVisible="{Binding GeneratedImagesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="muted" Text="{loc:Loc ContextGeneratedImagesLabel}" />
        <TextBlock HorizontalAlignment="Right" Text="{Binding GeneratedImagesText}" />
    </controls:BaselineStackPanel>
    </StackPanel>

</UserControl>
