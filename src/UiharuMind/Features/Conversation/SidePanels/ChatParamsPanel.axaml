<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settingViews="clr-namespace:UiharuMind.Features.Settings"
             xmlns:lang="clr-namespace:UiharuMind.Resources.Lang"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:panels="clr-namespace:UiharuMind.Features.Conversation.SidePanels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UiharuMind.Features.Conversation.SidePanels.ChatParamsPanel">

    <Design.DataContext>
        <panels:ChatParamsViewData />
    </Design.DataContext>

    <Border BorderThickness="1" BorderBrush="{DynamicResource SemiGrey2}">
        <StackPanel>
            <u:Divider Content="{loc:Loc ParameterSettings}" />
            <Grid ColumnDefinitions="*,Auto" Margin="10,4,10,4">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc RemoteModelOmitSamplingParamsLabel}" />
                    <TextBlock Text="{loc:Loc RemoteModelOmitSamplingParamsHint}" Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding Draft.OmitSamplingParams}" />
            </Grid>
            <settingViews:SettingPanelView Padding="10,0"
                                           IsVerticleTitle="True"
                                           IsTitleVisible="False"
                                           SettingConfig="{Binding Draft}"
                                           IsEnabled="{Binding !Draft.OmitSamplingParams}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="10,8,10,10">
                <Button Content="{loc:Loc CancelBtn}" Command="{Binding CancelCommand}" />
                <Button Content="{loc:Loc SaveBtn}" Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>