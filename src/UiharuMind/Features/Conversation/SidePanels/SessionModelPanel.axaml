<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:panels="clr-namespace:UiharuMind.Features.Conversation.SidePanels"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UiharuMind.Features.Conversation.SidePanels.SessionModelPanel">

    <Design.DataContext>
        <panels:SessionModelViewData />
    </Design.DataContext>

    <Border BorderThickness="1" BorderBrush="{DynamicResource SemiGrey2}" Padding="5"
            IsVisible="{Binding HasSession, FallbackValue=False}">
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{loc:Loc SessionModelTitle}" VerticalAlignment="Center" />
                <controls:KindBadge Header="{loc:Loc SessionModelOverrideBadge}"
                                    BadgeBackground="#CBE7FE"
                                    IsVisible="{Binding HasOverride}" />
            </StackPanel>
            <panels:SessionModelComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                         HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding EffectiveHint}" Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding EffectiveHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </Border>

</UserControl>
