<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:UiharuMind.Features.Conversation.Pages"
             xmlns:panels="clr-namespace:UiharuMind.Features.Conversation.SidePanels"
             xmlns:chars="clr-namespace:UiharuMind.Features.Characters"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="320"
             x:Class="UiharuMind.Features.Conversation.SidePanels.AgentWorkspacePanel"
             x:DataType="pages:ConversationPageData">

    <!-- 工作区卡片:运行态、换角色、固定开销统计、目录展示与切换。
         从 AgentPage 拆出来:右栏是"一个容器 + 若干面板",以后加一块就是加一个控件 -->
    <UserControl.Resources>
        <!-- 一行统计:标签占满并省略,数值靠右贴到整栏边缘;合计行的数值列走同一条右缘线,
             与右上角的图标按钮在同一竖直线上(去掉定宽右留白后不再有悬空的一截)。
             数值列不能定宽:合计文案是「25.6k / 128k」这种带分母的,定宽会把分母截掉 -->
        <DataTemplate x:Key="CapabilityStatRow" x:DataType="panels:CapabilityStatItem">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0"
                  ToolTip.Tip="{Binding Tip}">
                <TextBlock Grid.Column="0" Classes="muted" FontSize="10"
                           TextTrimming="CharacterEllipsis" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Classes="muted" FontSize="10" Text="{Binding TokenText}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 本控件不再自带样式:路径与最近条目那种「看着是文本、点起来是按钮」的行用全局
         Button.picker-row(此前是本地手抄的 workspace-reveal/workspace-recent,只差几像素内边距),
         统计块那种「顺带能点、不该有选中感」的用全局 Button.text-row,
         muted 文本走全局 TextBlock.muted。三者都在 Assets/Themes 下 -->

    <Border Background="{DynamicResource SemiGrey1}" CornerRadius="10" Padding="10">
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- 状态点的配色由 Tag 选,所以一个 Border 绑 key 即可;
                     文案那两条仍是两个 TextBlock——loc 标记要能跟着切语言重取,换成绑定字符串就跟不了 -->
                <Border Classes="status-dot icon-tweak" Tag="{Binding Conversation.RunStatusKey}" />
                <TextBlock FontSize="12" Text="{loc:Loc AgentStatusRunning}"
                           IsVisible="{Binding Conversation.IsGenerating}" />
                <!-- 第三档:本会话闲着但名下的后台子代理还没回来。少了它,用户看到的是「空闲」,
                     而实际上还有活在跑——这正是默认后台化之后的常态 -->
                <TextBlock FontSize="12" Text="{loc:Loc AgentStatusBackgroundWork}"
                           IsVisible="{Binding Conversation.HasBackgroundWorkOnly}" />
                <TextBlock FontSize="12" Text="{loc:Loc AgentStatusIdle}"
                           IsVisible="{Binding !Conversation.HasPendingWork}" />
            </StackPanel>
            <!-- 角色行:竖排大头像在上、名字在下,整块一个换角色按钮,点哪都出角色选择(空态即预选,发送才建会话);
                 名字单独一行居中,与头像同一条中心线;换角色提示走 ToolTip -->
            <Button Classes="text-row" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                    HorizontalContentAlignment="Stretch"
                    ToolTip.Tip="{loc:Loc AgentCharacterSwitch}">
                <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center"
                            ClipToBounds="True">
                        <Image Source="{Binding Conversation.ActiveCharacterIcon}"
                               Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Border>
                    <TextBlock FontSize="14" HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource SemiGrey7}"
                               TextTrimming="CharacterEllipsis" MaxWidth="170"
                               Text="{Binding Conversation.ActiveCharacterName}" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft"
                            Opening="OnCharacterPickerOpening">
                        <chars:CharacterPickerView Name="CharacterPicker" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <!-- 编辑入口暂隐藏:对齐优先,恢复时把铅笔挪回名字行右侧 -->
            <ThemedIconButton IsVisible="False" Width="24" Height="24"
                              IconName="pencil"
                              Command="{Binding Conversation.EditActiveCharacterCommand}"
                              ToolTip.Tip="{loc:Loc AgentCharacterEdit}" />

            <!-- 固定开销统计:竖排纯文字,五档 + 合计。整块点击=跳右栏「能力」页签看明细。
                 与下面工作目录那块同一个路子——看着是文本,点起来是按钮。
                 摆在这里而不是只在页签里,是因为它跟着角色与工作区走——换个角色这几个数就全变了。
                 首轮发送前也有数:会话还不存在时面板会预演一次装配,与首轮之后同一条路径算出来,
                 因此发出第一句话时这几个数不会跳(见 CharacterRunnerFactory.PreviewCapabilitiesAsync)。
                 仍绑 HasStats:非智能体档本就不装配任何东西,那时整块不出 -->
            <!-- 内容也要撑满:text-row 默认把内容靠左(它多数场合是一行短文本),
                 只撑按钮不撑内容的话数值仍旧挤在标题后面,右半边空着。
                 左右各留 8 内收:统计块是"嵌进去的一段账",不与上下行的名字/目录名贴在同一竖线上 -->
            <Button Classes="text-row" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsVisible="{Binding Conversation.Capabilities.HasStats}"
                    Command="{Binding ShowCapabilitiesCommand}"
                    ToolTip.Tip="{loc:Loc AgentCapabilityTokenTip}">
                <StackPanel Spacing="1">
                    <!-- 合计加重:它是这几个数里唯一要对着上下文上限看的。
                         告警三角夹在 label 与数值之间——数值列恒在最右、贴内容区右缘
                         (整体随卡片 Padding 内收 8),与明细行的数值列同一条竖线;三角出现时不占数值列的位置 -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" Classes="muted" FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{loc:Loc AgentCapabilityTotal}" />
                        <TextBlock Grid.Column="1" FontSize="10" Text="▲"
                                   Foreground="{DynamicResource SemiOrange5}"
                                   IsVisible="{Binding Conversation.Capabilities.IsOverBudget}" />
                        <TextBlock Grid.Column="2" FontSize="10"
                                   Text="{Binding Conversation.Capabilities.TotalText}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Conversation.Capabilities.Stats}"
                                  ItemTemplate="{StaticResource CapabilityStatRow}" />
                </StackPanel>
            </Button>

            <!-- 工作区段：只有智能体档有这概念，普通对话整段不出。与群卡共用同一个组件 -->
            <panels:WorkspacePickerView DataContext="{Binding Conversation.Workspace}"
                                        IsVisible="{Binding IsAgentType}" />
        </StackPanel>
    </Border>
</UserControl>
