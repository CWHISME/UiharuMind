<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:UiharuMind.Features.Conversation"
             xmlns:pages="clr-namespace:UiharuMind.Features.Conversation.Pages"
             xmlns:panels="clr-namespace:UiharuMind.Features.Conversation.SidePanels"
             xmlns:sessions="clr-namespace:UiharuMind.Features.Conversation.SessionList"
             xmlns:convs="clr-namespace:UiharuMind.Shared.Converters"
             xmlns:chars="clr-namespace:UiharuMind.Features.Characters"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:art="clr-namespace:UiharuMind.Features.Conversation.Artifacts"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="420"
             x:Class="UiharuMind.Features.Conversation.SidePanels.AgentSidePanel"
             x:DataType="pages:ConversationPageData">

    <!-- 能力 / Todo / 定时任务 页签 -->
    <UserControl.Resources>
        <!-- 工具/技能两处共用一行:名字占满并省略,token 靠右对齐成一列。
             token 紧跟在变长的名字后面时,长名字会把数字顶出右边界,而且数字对不齐等于没法比 -->
        <DataTemplate x:Key="CapabilityRow" x:DataType="panels:CapabilityItem">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,1">
                <TextBlock Grid.Column="0" FontSize="12" TextTrimming="CharacterEllipsis"
                           Text="{Binding Name}" ToolTip.Tip="{Binding Description}" />
                <TextBlock Grid.Column="1" Classes="muted" FontSize="10" VerticalAlignment="Center"
                           IsVisible="{Binding HasTokenCost}" Text="{Binding TokenText}" />
            </Grid>
        </DataTemplate>

        <!-- 系统提示的一段:点开看全文。这一栏存在的意义是回答「模型现在到底看得见什么」,
             而工具那半边一直是明细、提示词这半边原先连一个数都没有 -->
        <DataTemplate x:Key="PromptSegmentRow" x:DataType="panels:PromptSegmentItem">
            <!-- text-row 是全局样式(CustomButtonStyle.axaml):无 hover 底色、无最小尺寸,
                 行高与上下那些纯文本行对得上 -->
            <Button Classes="text-row" HorizontalAlignment="Stretch" Margin="0,1">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" FontSize="12" TextTrimming="CharacterEllipsis"
                               Text="{Binding Label}" />
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="10" VerticalAlignment="Center"
                               Text="{Binding TokenText}" />
                </Grid>
                <Button.Flyout>
                    <!-- 全文可选可复制:调机时要把它跟角色卡、跟磁盘上的 AGENTS.md 对着看 -->
                    <Flyout Placement="Left">
                        <ScrollViewer MaxHeight="420" MaxWidth="520" HorizontalScrollBarVisibility="Disabled">
                            <SelectableTextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding Text}" />
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.todo-completed">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey4}" />
        </Style>
        <Style Selector="TextBlock.capability-section">
            <Setter Property="FontSize" Value="11" />            <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
        </Style>
    </UserControl.Styles>

                <TabControl Padding="0"
                            SelectedIndex="{Binding SelectedSidePanelIndex, Mode=TwoWay}">
                    <!-- 能力:本会话实际挂上的工具/技能/扩展。只读,要改去角色编辑页 -->
                    <!-- 标题带计数:不点开也知道里面有没有东西,"默认选哪个"因此无关紧要。
                         这一个的计数要跨三个集合求和,axaml 算不了,故在 VM 里拼好 -->
                    <TabItem Header="{Binding Conversation.Capabilities.TabHeader}" FontSize="13">
                        <!-- 横向一律不滚:右栏窄,长名字用省略号收,而不是把整栏推出去 -->
                        <ScrollViewer Margin="0,6,0,0" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           IsVisible="{Binding Conversation.Capabilities.IsEmpty}"
                                           Text="{loc:Loc AgentCapabilityEmpty}" />

                                <!-- 合计已经在工作区卡片上了,这里只留超额告警 -->
                                <TextBlock FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SemiOrange5}"
                                           IsVisible="{Binding Conversation.Capabilities.IsOverBudget}"
                                           Text="{loc:Loc AgentCapabilityOverBudget}" />

                                <!-- 提示词排在最前:它通常是这几档里最大的一笔(角色卡 + 一份 AGENTS.md),
                                     而卡片上新加的那两行正指向这里,落点要在不滚动就看得见的地方 -->
                                <StackPanel Spacing="2"
                                            IsVisible="{Binding Conversation.Capabilities.HasPromptSegments}">
                                    <TextBlock Classes="capability-section" Margin="0,4,0,2"
                                               Text="{loc:Loc AgentCapabilityPrompt}"
                                               ToolTip.Tip="{loc:Loc AgentCapabilityPromptTip}" />
                                    <ItemsControl ItemsSource="{Binding Conversation.Capabilities.PromptSegments}"
                                                  ItemTemplate="{StaticResource PromptSegmentRow}" />
                                </StackPanel>

                                <!-- MCP server:每个是一个扩展,工具不进请求(ADR 0079),这里只报来源、状态与要执行的命令。
                                     没挂上的(待确认/被覆盖/被禁用)也列着,否则用户看不见「有东西因为没授权而没用上」 -->
                                <StackPanel Spacing="2"
                                            IsVisible="{Binding Conversation.Capabilities.HasMcpPlanned}">
                                    <TextBlock Classes="capability-section" Margin="0,4,0,2"
                                               Text="{loc:Loc AgentCapabilityMcpPlanned}"
                                               ToolTip.Tip="{loc:Loc AgentCapabilityMcpPlannedTip}" />
                                    <ItemsControl ItemsSource="{Binding Conversation.Capabilities.McpPlanned}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="panels:McpPlannedServerItem">
                                                <StackPanel Spacing="1" Margin="0,2,0,0"
                                                            Opacity="{Binding Opacity}">
                                                    <controls:CenteredStackPanel Spacing="6">
                                                        <TextBlock FontSize="11" Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Classes="muted" FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding OriginText}" />
                                                    </controls:CenteredStackPanel>
                                                    <!-- 待确认用醒目色:它挡着一个本该可用的能力,且只差用户一下 -->
                                                    <TextBlock FontSize="10" TextWrapping="Wrap"
                                                               Text="{Binding StatusText}"
                                                               Foreground="{DynamicResource SemiGrey5}"
                                                               IsVisible="{Binding !NeedsApproval}" />
                                                    <TextBlock FontSize="10" TextWrapping="Wrap"
                                                               Text="{Binding StatusText}"
                                                               Foreground="{DynamicResource SemiOrange5}"
                                                               IsVisible="{Binding NeedsApproval}" />
                                                     <!-- 命令原文是安全信息,不折叠不省略 -->
                                                     <TextBlock Classes="muted mono" FontSize="10" TextWrapping="Wrap"
                                                                Text="{Binding CommandLine}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Spacing="2"
                                            IsVisible="{Binding Conversation.Capabilities.HasTools}">
                                    <TextBlock Classes="capability-section" Margin="0,4,0,2"
                                               Text="{Binding Conversation.Capabilities.ToolsHeader}" />
                                    <ItemsControl ItemsSource="{Binding Conversation.Capabilities.Tools}"
                                                  ItemTemplate="{StaticResource CapabilityRow}" />
                                </StackPanel>

                                <StackPanel Spacing="2"
                                            IsVisible="{Binding Conversation.Capabilities.HasSkills}">
                                    <TextBlock Classes="capability-section" Margin="0,4,0,2"
                                               Text="{Binding Conversation.Capabilities.SkillsHeader}"
                                               ToolTip.Tip="{loc:Loc AgentCapabilitySkillResidentTip}" />
                                    <ItemsControl ItemsSource="{Binding Conversation.Capabilities.Skills}"
                                                  ItemTemplate="{StaticResource CapabilityRow}" />
                                </StackPanel>

                                <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,2"
                                           IsVisible="{Binding Conversation.Capabilities.HasSkillSectionNote}"
                                           Text="{Binding Conversation.Capabilities.SkillSectionNote}" />

                                <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"
                                           IsVisible="{Binding !Conversation.Capabilities.IsEmpty}"
                                           Text="{loc:Loc AgentCapabilityEditHint}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- 这两个的计数来自会通知的集合,直接在标题里拼即可,不必绕 VM -->
                    <TabItem FontSize="13" IsVisible="{Binding Conversation.IsTodoListVisible}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{loc:Loc AgentTodoTitle}" />
                                <TextBlock Text="{Binding Conversation.Todos.Count}"
                                           IsVisible="{Binding Conversation.HasTodos}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Classes="muted"
                                           IsVisible="{Binding !Conversation.HasTodos}"
                                           Text="{loc:Loc AgentTodoEmpty}" />
                                <ItemsControl ItemsSource="{Binding Conversation.Todos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="conv:TodoDisplayItem">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3">
                                                <TextBlock Text="{Binding StatusGlyph}" FontSize="12"
                                                           Foreground="{DynamicResource SemiBlue5}" />
                                                <TextBlock Text="{Binding Content}" FontSize="12"
                                                           TextWrapping="Wrap" MaxWidth="220"
                                                           Classes.todo-completed="{Binding IsCompleted}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- 子代理:本会话派过的子会话索引。<b>常驻显示不条件隐藏</b>——
                         右栏页签靠下标绑定(见 AgentPageData.SelectedSidePanelIndex),
                         Todo 已经会飘一次了,再来一个条件页签就是复利 -->
                    <TabItem FontSize="13">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{loc:Loc AgentSubAgentTitle}" />
                                <TextBlock Text="{Binding SubAgents.Items.Count}"
                                           IsVisible="{Binding SubAgents.Items.Count}" />
                                <!-- 「总共派过几个」与「现在还有几个没完」是两件事,后者才是用户
                                     此刻要知道的。委派默认后台执行之后它常态大于 1 -->
                                <Border Classes="status-dot" Tag="Ready"
                                        IsVisible="{Binding SubAgents.HasRunning}" />
                                <TextBlock Text="{Binding SubAgents.RunningCount}"
                                           IsVisible="{Binding SubAgents.HasRunning}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer Margin="0,6,0,0">
                            <!-- 时间列跨行等宽（SharedSizeGroup）：每行是独立 Grid，Auto 列按本行内容算宽，
                                 时间文本一长一短（"末轮 08:42" / "05/06 07:08" / "1:02:03"）会把复制按钮
                                 顶到每行不同的 x 上。组内取最宽的那一格，按钮右边缘就对齐了 -->
                            <StackPanel Grid.IsSharedSizeScope="True">
                                <!-- 脑不列条目（没名字、量大会刷屏），只在顶部给一个数量提示（ADR 0082） -->
                                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6"
                                           IsVisible="{Binding SubAgents.HasBrains}"
                                           Text="{Binding SubAgents.BrainCountText}" />
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           IsVisible="{Binding !SubAgents.Items.Count}"
                                           Text="{loc:Loc AgentSubAgentEmpty}" />
                                <ItemsControl ItemsSource="{Binding SubAgents.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="panels:SubSessionDisplayItem">
                                             <!-- text-row 默认把内容左对齐（与纯文本行左边缘对齐），这一行要撑满：
                                                  不撑满的话 Grid 只包内容，标题长的行更宽，尾部时间+按钮每行 x 都不一样。
                                                  参考角色选择器的 picker-row（Stretch），* 列吃掉标题差，尾部自然右对齐 -->
                                             <Button Classes="text-row" HorizontalAlignment="Stretch"
                                                     HorizontalContentAlignment="Stretch"
                                                     Margin="0,3" Command="{Binding Open}"
                                                     ToolTip.Tip="{Binding Title}">
                                                <Grid ColumnSpacing="6">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="Auto" />
                                                         <ColumnDefinition Width="*" />
                                                         <ColumnDefinition Width="Auto" SharedSizeGroup="SubAgentRunTime" />
                                                         <ColumnDefinition Width="Auto" />
                                                     </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Classes="status-dot"
                                                            VerticalAlignment="Center"
                                                            Tag="{Binding StatusKey}" />
                                                     <StackPanel Grid.Column="1" Spacing="2"
                                                                VerticalAlignment="Center">
                                                        <TextBlock FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding Title}" />
                                                        <TextBlock Classes="muted" FontSize="10"
                                                                   IsVisible="{Binding HasAgentName}"
                                                                   Text="{Binding AgentName}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Classes="muted" FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding RunTimeText}"
                                                               ToolTip.Tip="{Binding RunTimeTip}" />
                                                    <!-- 复制编号:ContinueSubAgent 认的是它,而它原先只出现在
                                                         工具卡的结果里,跑几十轮就滚没了 -->
                                                    <ThemedIconButton Grid.Column="3"
                                                                      Classes="message-action"
                                                                      IconName="copy"
                                                                      VerticalAlignment="Center"
                                                                      ToolTip.Tip="{loc:Loc SubAgentCopyIdTip}"
                                                                      Command="{Binding CopyId}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem FontSize="13">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{loc:Loc AgentScheduledTitle}" />
                                <TextBlock Text="{Binding Scheduled.Tasks.Count}"
                                           IsVisible="{Binding Scheduled.Tasks.Count}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Classes="muted"
                                           IsVisible="{Binding !Scheduled.Tasks.Count}"
                                           Text="{loc:Loc AgentScheduledEmpty}" />
                                <ItemsControl ItemsSource="{Binding Scheduled.Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sessions:ScheduledTaskDisplayItem">
                                            <Border Background="{DynamicResource SemiGrey1}"
                                                    CornerRadius="8" Padding="10,8" Margin="0,3">
                                                <StackPanel Spacing="4">
                                                    <TextBlock FontSize="12"
                                                               Text="{Binding DisplayName}"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Classes="muted"
                                                                   Text="{Binding FireAtText}" />
                                                        <TextBlock Classes="muted"
                                                                   Text="{Binding StatusText}" />
                                                        <!-- 跑过的任务只显示当时那一档(改不动了),没跑的用下面的下拉选 -->
                                                        <TextBlock Classes="muted"
                                                                   IsVisible="{Binding !CanEditPermission}"
                                                                   Text="{Binding PermissionText}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <!-- 三档选择:与设置页「默认权限档」同一形状、同一套文案,
                                                             无人值守跑的就是这一档 -->
                                                        <ComboBox FontSize="10" Padding="6,2" CornerRadius="5"
                                                                  MinHeight="0" VerticalAlignment="Center"
                                                                  IsVisible="{Binding CanEditPermission}"
                                                                  SelectedIndex="{Binding PermissionModeIndex}"
                                                                  ToolTip.Tip="{loc:Loc AgentTaskPermission}">
                                                            <ComboBoxItem Content="{loc:Loc AgentPermissionReadOnly}" />
                                                            <ComboBoxItem Content="{loc:Loc AgentPermissionAutoEdit}" />
                                                            <ComboBoxItem Content="{loc:Loc AgentPermissionFullAuto}" />
                                                        </ComboBox>
                                                        <Button FontSize="10" Padding="6,2" CornerRadius="5"
                                                                IsVisible="{Binding CanRunNow}"
                                                                Command="{Binding $parent[TabControl].((pages:ConversationPageData)DataContext).Scheduled.RunTaskNowCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="{loc:Loc AgentTaskRunNow}" />
                                                        <Button FontSize="10" Padding="6,2" CornerRadius="5"
                                                                IsVisible="{Binding CanCancel}"
                                                                Command="{Binding $parent[TabControl].((pages:ConversationPageData)DataContext).Scheduled.CancelTaskCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="{loc:Loc AgentTaskCancel}" />
                                                        <Button FontSize="10" Padding="6,2" CornerRadius="5"
                                                                IsVisible="{Binding HasResultSession}"
                                                                Command="{Binding $parent[TabControl].((pages:ConversationPageData)DataContext).Scheduled.OpenTaskSessionCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="{loc:Loc AgentTaskOpenSession}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- 目标模式：与定时任务同页签（统一清单）。进行中的在前，最近结束的回执在后 -->
                                <TextBlock Classes="capability-section" Margin="0,12,0,2"
                                           Text="{loc:Loc GoalModeListTitle}" />
                                <TextBlock Classes="muted"
                                           IsVisible="{Binding !GoalModes.Items.Count}"
                                           Text="{loc:Loc GoalModeEmpty}" />
                                <ItemsControl ItemsSource="{Binding GoalModes.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sessions:GoalModeDisplayItem">
                                            <Border Background="{DynamicResource SemiGrey1}"
                                                    CornerRadius="8" Padding="10,8" Margin="0,3">
                                                <StackPanel Spacing="4">
                                                    <TextBlock FontSize="12" Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="muted" FontSize="10"
                                                               Text="{Binding Goal}"
                                                               TextWrapping="Wrap" MaxLines="2" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Classes="muted" FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding StatusText}" />
                                                        <Button FontSize="10" Padding="6,2" CornerRadius="5"
                                                                IsVisible="{Binding IsActive}"
                                                                Command="{Binding $parent[TabControl].((pages:ConversationPageData)DataContext).GoalModes.StopCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="{loc:Loc GoalModeStop}" />
                                                        <Button FontSize="10" Padding="6,2" CornerRadius="5"
                                                                Command="{Binding $parent[TabControl].((pages:ConversationPageData)DataContext).GoalModes.OpenCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="{loc:Loc GoalModeOpen}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button FontSize="10" Padding="6,2" CornerRadius="5" HorizontalAlignment="Left"
                                        IsVisible="{Binding GoalModes.HasDone}"
                                        Command="{Binding GoalModes.ClearDoneCommand}"
                                        Content="{loc:Loc GoalModeClearDone}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- 产物：本会话落了哪些盘，与群聊右栏同一个组件。放最后，不挪前面页签的下标 -->
                    <TabItem FontSize="13">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{loc:Loc SessionArtifactsTab}" />
                                <TextBlock Text="{Binding Conversation.Artifacts.Items.Count}"
                                           IsVisible="{Binding Conversation.Artifacts.Items.Count}" />
                            </StackPanel>
                        </TabItem.Header>
                        <!-- 焦点变化不自动滚：产物行点按半截会被默认 BringIntoViewOnFocusChange 拽走。
                             判空守卫必须挂在外层（继承页面 DataContext），不能与 DataContext 写在同一元素上——
                             同一元素上的绑定按新的 DataContext 求值，空时守卫恒为真，面板带着空 DataContext
                             裸奔：标题与说明全空、文件夹按钮点不了，只剩静态空文案 -->
                        <Border Margin="0,6,0,0"
                                IsVisible="{Binding Conversation.Artifacts, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <!-- 列表在 ArtifactsPanel 内部自己滚（ListBox 虚拟化需要受限高度，外层不能再套 ScrollViewer） -->
                            <art:ArtifactsPanel DataContext="{Binding Conversation.Artifacts}" />
                        </Border>
                    </TabItem>

                </TabControl>
</UserControl>
