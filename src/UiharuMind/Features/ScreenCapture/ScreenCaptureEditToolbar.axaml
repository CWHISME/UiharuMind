<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="40"
             x:Class="UiharuMind.Features.ScreenCapture.ScreenCaptureEditToolbar">

    <!-- 编辑模式工具条：只摆按钮与取色器，不碰编辑器。所有操作经事件交回宿主转发。
         固定按钮尺寸，杜绝宿主（停靠窗）宽窄变化把按钮撑大 -->
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <!-- 选中的工具要跟浏览面板那颗 OCR 开关同一套选中色，而不是只靠背景深浅区分 -->
        <Style Selector=":is(ThemedIconToggleButton)">
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal" Spacing="6">
        <controls:ThemedIconToggleButton Name="GeometryRectangleButton" Width="30" Height="30" Padding="0"
                                         IconName="square" IconWidth="18" IconHeight="18"
                                         CheckedForeground="{DynamicResource SemiBlue5}"
                                         ToolTip.Tip="Rectangle · Shift=Square" />
        <controls:ThemedIconToggleButton Name="GeometryEllipseButton" Width="30" Height="30" Padding="0"
                                         IconName="ellipse" IconWidth="18" IconHeight="18"
                                         CheckedForeground="{DynamicResource SemiBlue5}"
                                         ToolTip.Tip="Ellipse · Shift=Circle" />
        <controls:ThemedIconToggleButton Name="GeometryLineButton" Width="30" Height="30" Padding="0"
                                         IconName="minus" IconWidth="18" IconHeight="18"
                                         CheckedForeground="{DynamicResource SemiBlue5}"
                                         ToolTip.Tip="Line" />
        <controls:ThemedIconToggleButton Name="GeometryArrowLineButton" Width="30" Height="30" Padding="0"
                                         IconName="arrow-line" IconWidth="18" IconHeight="18"
                                         CheckedForeground="{DynamicResource SemiBlue5}"
                                         ToolTip.Tip="ArrowLine" />
        <controls:ThemedIconToggleButton Name="GeometryTextButton" Width="30" Height="30" Padding="0"
                                         IconName="type" IconWidth="18" IconHeight="18"
                                         CheckedForeground="{DynamicResource SemiBlue5}"
                                         ToolTip.Tip="Text" />
        <controls:ThemedIconToggleButton Name="GeometryPenButton" Width="30" Height="30" Padding="0"
                                         IconName="pencil" IconWidth="18" IconHeight="18"
                                         CheckedForeground="{DynamicResource SemiBlue5}"
                                         ToolTip.Tip="Pen" />

        <ColorPicker Name="GeometryColorPicker" Theme="{StaticResource SimpleColorPicker}" />

        <Button Name="UndoButton" Width="30" Height="30" Padding="0" ToolTip.Tip="Undo (Ctrl+Z)">
            <controls:ThemedSvgIcon IconName="undo" Width="16" Height="16" />
        </Button>
        <Button Name="RedoButton" Width="30" Height="30" Padding="0" ToolTip.Tip="Redo (Ctrl+Y)">
            <controls:ThemedSvgIcon IconName="redo" Width="16" Height="16" />
        </Button>

        <Button Name="SaveButton" Width="30" Height="30" Padding="0" ToolTip.Tip="{loc:Loc SaveBtn}">
            <controls:ThemedSvgIcon IconName="save" Width="16" Height="16" />
        </Button>
        <Button Name="CancelButton" Width="30" Height="30" Padding="0" ToolTip.Tip="{loc:Loc CancelBtn}">
            <controls:ThemedSvgIcon IconName="trash-2" Width="16" Height="16" />
        </Button>
    </StackPanel>
</UserControl>
