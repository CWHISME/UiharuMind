<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="UiharuMind.Features.ScreenCapture.Drawing.ImageAnnotationEditor">

    <!-- 画布永远固定为原始位图像素尺寸，缩放/平移走 RenderTransform（见 ImageAnnotationEditor.axaml.cs）。
         第一个子元素必须是 ImageContent 底，命令控件加在其后 -->
    <Canvas Name="DrawingCanvas" Background="Transparent" ClipToBounds="True">
        <Image Name="ImageContent" Stretch="None" />
    </Canvas>
</UserControl>
