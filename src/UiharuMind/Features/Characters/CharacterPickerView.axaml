<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:chars="clr-namespace:UiharuMind.Features.Characters"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="360"
             x:Class="UiharuMind.Features.Characters.CharacterPickerView"
             x:DataType="chars:CharacterPickerViewData">

    <!-- picker-row 是全局样式(CustomButtonStyle.axaml),两个选择器共用 -->

    <DockPanel Width="300" MaxHeight="380">
        <TextBox DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="12"
                 Text="{Binding SearchText}"
                 PlaceholderText="{loc:Loc CharacterPickerSearch}" />
        <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="12" Margin="4,6"
                   Text="{loc:Loc CharacterPickerEmpty}"
                   IsVisible="{Binding IsEmpty}" />
        <!-- 行模板在代码里给（FuncDataTemplate + 可复用），XAML 的 DataTemplate 在滚动时不会复用行内容 -->
        <ListBox x:Name="CharacterList" ItemsSource="{Binding Items}" Classes="flat-list"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.BringIntoViewOnFocusChange="False" />
    </DockPanel>
</UserControl>
