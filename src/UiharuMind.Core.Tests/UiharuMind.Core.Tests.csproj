<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- .NET 10 SDK 起 dotnet test 不再走 VSTest,要显式认新运行器,否则 dotnet test 直接报错 -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- MAAI001: Microsoft.Agents.AI Harness 面为 Experimental API -->
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <!-- Core 对框架包是 PrivateAssets,装配不变量测试要直接看框架类型,版本须与 Core 一致 -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.22.0" />
    <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.22.0" />
    <PackageReference Include="Microsoft.Agents.AI.Tools.Shell" Version="1.22.0-preview.260918.1" />
    <!-- 判据测试要点名 MCP 协议层异常 McpException；Core 的 MCP 包是 compile-only 私有资产，
         不随引用透传，故这里直引（版本须与 Core 的 Agents.AI.Mcp 解析到的保持一致） -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- 真实响应的 fixture（-empty / -real 是实测原文脱敏，-pro 假拟，只钉容错分支） -->
    <None Include="AI/Status/fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiharuMind.Core\UiharuMind.Core.csproj" />
  </ItemGroup>

</Project>