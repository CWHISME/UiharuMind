<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CFBundleVersion / CFBundleShortVersionString 由 buildMac.sh 用 <Version> 覆写，此处为占位 -->
	<key>CFBundleIdentifier</key>
	<string>com.cwhisme.uiharumind</string>
	<key>CFBundleName</key>
	<string>UiharuMind</string>
	<key>CFBundleVersion</key>
	<string>1.0.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>10.12</string>
	<key>CFBundleExecutable</key>
	<string>UiharuMind.Desktop</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>Icon.png</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- 语音输入要麦克风：没有这条说明，打包后的应用一碰麦克风就会被系统直接终止 -->
	<key>NSMicrophoneUsageDescription</key>
	<string>UiharuMind 用麦克风做语音输入，录音只交给本机或你配置的语音识别服务。</string>
</dict>
</plist>
