<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use Windows/MacOS native APIs you will need to create 3 projects.
    One for Windows with net7.0-windows TFM, one for MacOS with net7.0-macos and one with net7.0 TFM for Linux.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\UiharuMind\Assets\Icon.ico</ApplicationIcon>
    <Copyright>Made by WangJiaYing (ᓚᘏᗢ)</Copyright>
    <PackageProjectUrl>https://github.com/CWHISME/UiharuMind</PackageProjectUrl>
    <PackageLicenseUrl>https://github.com/CWHISME/UiharuMind?tab=Apache-2.0-1-ov-file</PackageLicenseUrl>
    <RepositoryUrl>https://github.com/CWHISME/UiharuMind</RepositoryUrl>
  </PropertyGroup>

  <!-- Windows 上构建或发布 win-* 时换成 -windows 目标框架，接上 Windows 平台层（桌面扩展的 UI Automation 与 OCR，ADR 0084）。
       别的平台照旧 net10.0，不碰它 -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) Or $(RuntimeIdentifier.StartsWith('win'))">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsPlatform>true</UseWindowsPlatform>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseWindowsPlatform)' == 'true'">
    <ProjectReference Include="..\UiharuMind.Platform.Windows\UiharuMind.Platform.Windows.csproj" />
  </ItemGroup>

  <!-- 发布口径：三个平台共用，脚本与 CI 都只需给 -r <RID>。
       不开 PublishTrimmed（ADR 0029）：当初的理由是全仓反射绑定（裁剪会剪掉绑定属性、且静默挂），
       b05e363f 已把 AvaloniaUseCompiledBindingsByDefault 翻成全仓 =true，这条理由被削弱；
       是否可开 Trim 见 ADR 0029「§待重估（2026-10-14）」，现状维持 R2R 不裁剪。
       TieredPGO 自 .NET 8 起默认开启，不必显式声明。 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- AOT 并行发布通道（ADR 0029：R2R 仍是终点，AOT 是 buildAotMac.sh 的另一条通道）：
         PublishAot 放项目条件属性而非命令行全局——命令行 -p:PublishAot=true 会传给 netstandard 的
         Localization.Generator，NETSDK1207。buildAotMac.sh 经 -p:PublishAotOverride=true 打开；
         通道已验绿（2026-10-14：构建 + brain 冒烟通过），开关保留给脚本用 -->
    <PublishAot Condition="'$(PublishAotOverride)' == 'true'">true</PublishAot>
  </PropertyGroup>

  <!-- macOS 走 .app 目录形态：单文件会妨碍 codesign 逐 dylib 签名 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'linux-x64'">
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <!-- 仅为 UIHARU_LINUX_BACKEND=wayland 的对照实验而引入；默认仍跑 X11(XWayland)，
         因为纯 Wayland 协议不支持按坐标定位窗口 -->
    <PackageReference Include="Avalonia.Wayland" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiharuMind\UiharuMind.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\UiharuMind\Assets\Icon.ico">
      <Link>Icon.ico</Link>
    </None>
  </ItemGroup>
</Project>
