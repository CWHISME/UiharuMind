<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- MAAI001: Microsoft.Agents.AI Harness 面为 Experimental API -->
        <NoWarn>$(NoWarn);MAAI001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <!-- 装配不变量测试需要访问 internal 装配函数 -->
      <InternalsVisibleTo Include="UiharuMind.Core.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="AngleSharp" Version="1.8.2" />
      <PackageReference Include="CommunityToolkit.VectorData.SqliteVec" Version="1.0.1-preview" />
      <!-- 剪贴板历史直接用它,不靠 SqliteVec 的传递引用 -->
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
      <!-- tiktoken o200k 词表数据:Microsoft.ML.Tokenizers 本体已由 Agents.AI 传递引入 -->
      <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
      <PackageReference Include="CliWrap" Version="3.10.5" />
      <PackageReference Include="Downloader" Version="5.9.6" />
      <PackageReference Include="Glacier.Grep" Version="1.0.1" />
      <PackageReference Include="LLamaSharp" Version="0.27.0" />
      <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
      <PackageReference Include="Meziantou.Framework.Globbing" Version="5.0.5" />
      <!-- Agent Framework 面(含 preview/alpha 包)只挡编译期外流:UI 层若直接引用其类型将变成编译错误,
           迫使一切经 ICharacterRunner 收口。
           必须是 compile 而非 all —— all 会连 runtime 资产一起挡掉,
           导致这些包及其传递依赖(如 ModelContextProtocol.Core)不进 app head 输出目录,运行时抛 FileNotFoundException。
           后三项是 PrivateAssets 的默认值,显式写出以免被覆盖。
           Microsoft.Extensions.AI 是稳定的公共货币,完全不设限。 -->
      <PackageReference Include="Microsoft.Agents.AI" Version="1.22.0">
        <PrivateAssets>compile;contentfiles;analyzers;build</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.22.0">
        <PrivateAssets>compile;contentfiles;analyzers;build</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Agents.AI.Tools.Shell" Version="1.22.0-preview.260918.1">
        <PrivateAssets>compile;contentfiles;analyzers;build</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Agents.AI.Mcp" Version="1.22.0-alpha.260918.1">
        <PrivateAssets>compile;contentfiles;analyzers;build</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
      <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
      <PackageReference Include="ScreenCapture.NET.DX11" Version="3.0.0" />
      <PackageReference Include="SharpCompress" Version="1.0.0" />
      <PackageReference Include="SharpHook" Version="8.0.0" />
      <!-- Avalonia.FreeDesktop 已传递引入同一版本，这里显式声明是因为 Core 不引用 Avalonia，
           而 Wayland 下的截图必须经 xdg-desktop-portal 的 D-Bus 接口 -->
      <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
      <PackageReference Include="UTF.Unknown" Version="2.7.0" />
    </ItemGroup>

    <ItemGroup>
      <!-- 内置角色卡(内容卡与代码点名卡都在这里，按 Agents/Tools/Characters 分子目录)与提示词片段库；Help 在根目录 -->
      <EmbeddedResource Include="Resources\Cards\**\*.json" />
      <EmbeddedResource Include="Resources\Cards\**\*.md" />
      <EmbeddedResource Include="Resources\Snippets\*.json" />
      <EmbeddedResource Include="Resources\Help*.md" />
    </ItemGroup>

</Project>
