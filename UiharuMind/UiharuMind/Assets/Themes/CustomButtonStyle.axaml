<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->

    <!-- pointerover 之类的效果想修改必须通过设置模板实现 -->
    <!-- https://github.com/AvaloniaUI/Avalonia/discussions/8382 -->

    <!-- SimpleSolidButton：单纯的按钮，无任何效果 -->
    <!-- 移除 Button 的悬停效果 -->
    <Style Selector="Button.SimpleSolidButton:pointerover /template/ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 移除 Button 的选中效果 -->
    <Style Selector="Button.SimpleSolidButton:pressed /template/ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 确保覆盖 Button 默认样式 -->
    <Style Selector="Button.SimpleSolidButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ThemedIconButton 图标按钮统一为无背景 -->
    <Style Selector="ThemedIconButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ThemedIconToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- 什么表现都没有 -->
    <Style Selector="ThemedIconToggleButton.NoneStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 什么表现都没有 -->
    <Style Selector="ToggleButton.NoneStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 什么表现都没有 -->
    <Style Selector="Button.NoneStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 变成圆形按钮 -->
    <Style Selector="Button.CircleButton">
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
    </Style>

    <!-- ==================== 内联选择器里的一行(角色选择器、片段选择器共用) ==================== -->
    <Style Selector="Button.picker-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.picker-row:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SemiGrey2}" />
    </Style>

    <!-- ==================== 一行文本形态的按钮(看着是文本,点起来是按钮) ==================== -->
    <!-- 与上面 picker-row 的分工:那个是「列表里的一项」,选中反馈该有;
         这个是「一行数据顺带能点」,上下常与纯文本行紧挨着排,
         一划过就亮起一条灰带反而读起来像这一行被选中了。可点由手型指针交代。

         MinWidth/MinHeight 必须压掉:主题给 Button 的最小尺寸会把行高顶到 32,
         夹在十几像素行高的纯文本行中间,整节看着比邻居松一大截。
         横向零内边距:与相邻的纯文本行左边缘对齐,不然整节往右缩一格。 -->
    <Style Selector="Button.text-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,1" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey7}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- 悬停/按下的底色是主题画在模板内 ContentPresenter 上的,
         只设按钮自己的 Background 压不掉它 -->
    <Style Selector="Button.text-row:pointerover /template/ ContentPresenter,
                     Button.text-row:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ============================= 聊天信息下方的小图标按钮那种 ========================-->
    <Style Selector="ThemedIconButton.message-action">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="MaxWidth" Value="18" />
        <Setter Property="MaxHeight" Value="18" />
    </Style>


</Styles>