<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
    </Style>
    <Style Selector="SelectableTextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
    </Style>
    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
    </Style>
    
    <!-- 淡淡的灰色字体 -->
    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Consolas,Menlo,Monaco,monospace" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="SelectableTextBlock.muted">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
    </Style>
    <Style Selector="SelectableTextBlock.mono">
        <Setter Property="FontFamily" Value="Consolas,Menlo,Monaco,monospace" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- 折叠条标题行的文本垂直微调。字形视觉中心天然偏上(ascent>descent),
         VerticalAlignment=Center 只居中行盒、管不了盒内文本——用 RenderTransform 平移
         做纯视觉修正(不参与布局,数值可按字体微调) -->
    <Style Selector="TextBlock.title-tweak">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="2" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标与旁边文字并排时的垂直微调。与 title-tweak 同因:字形视觉中心天然偏上,
         图标按自己的盒居中时也一样看着偏上——用 RenderTransform 上移 1px 对齐视觉中心。
         纯视觉、不参与布局(不用负 Margin:它参与测量,会把所在行高带偏)。
         用 :is 罩住 ThemedIconButton 及其子类(与 CustomButtonStyle 同一口径)。
         需要就说一句挂 class: icon-tweak -->
    <Style Selector=":is(ThemedIconButton).icon-tweak">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="-1" />
            </Setter.Value>
        </Setter>
    </Style>
</Styles>