<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<!-- 生成器为 LangKey 枚举成员生成 XML 文档注释时使用的文案语言（Lang.zh-hans.resx）；不设则用 Lang.resx 默认文案 -->
		<LangKeysCommentCulture>zh-hans</LangKeysCommentCulture>
	</PropertyGroup>
	
	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<!-- 纯逻辑测试需要访问 internal 成员（与 UiharuMind.Core 同一口径） -->
		<InternalsVisibleTo Include="UiharuMind.App.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
		<!-- 显式引用:Avalonia 自己在用它,但我们要的 JPEG 编码 Avalonia 的 Bitmap.Save 给不了
		     (它只写 PNG,quality 参数不改格式),照片用 PNG 存下来是 JPEG 的 5~10 倍 -->
		<PackageReference Include="SkiaSharp" Version="4.152.1" />
		<!-- 长文本查看/编辑内核。要的是它内建的<b>按行虚拟化</b>:SelectableTextBlock 与 TextBox
		     都没有文本虚拟化,几十万字的工具结果塞进去必然卡死。搜索/行号/跨行选中是白得的 -->
		<PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
		<!-- 语法高亮。不用 AvaloniaEdit.TextMate 官方集成:它在渲染每个可视行时同步 tokenize,
		     拖选长行越过右边缘会触发上游 issue #606 的无限事件循环(12.0.0 未修)冻死 UI。
		     这里自己用 TextMateSharp 分帧预 tokenize + 查表渲染,循环里只剩查表 -->
		<PackageReference Include="TextMateSharp" Version="2.0.4" />
		<PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
		<PackageReference Include="Clowd.Clipboard.Gdi" Version="1.1.4" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="LiveMarkdown.Avalonia" Version="2.4.3" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
		<!--主题包-->
		<PackageReference Include="Irihi.Ursa" Version="2.2.0" />

		<PackageReference Include="Irihi.Ursa.Themes.Semi" Version="2.2.0" />
		<PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
		<PackageReference Include="Semi.Avalonia.ColorPicker" Version="12.1.0.1" />
		<PackageReference Include="SharpHook" Version="8.0.0" />
		<PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\ClassicDiagnostics.Avalonia\src\ClassicDiagnostics.Avalonia.csproj" />
	  <ProjectReference Include="..\UiharuMind.Core\UiharuMind.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <!-- 强类型 key 生成器: 读取下面的 resx/axaml 作为 AdditionalFiles, 编译期产出 UiharuMind.Generated.LangKey -->
	  <ProjectReference Include="..\UiharuMind.Localization\Generator\UiharuMind.Localization.Generator.csproj"
	                    OutputItemType="Analyzer"
	                    ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
	  <AdditionalFiles Include="Resources\Lang\*.resx" />
	  <!-- XAML 消费点扫描：{loc:Loc X} 的拼写校验（LK2001）与死 key 报告（LK2002） -->
	  <AdditionalFiles Include="**\*.axaml" Exclude="bin\**;obj\**" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Assets\Lang\zh-CN.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>zh-CN.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Assets\Lang\Lang.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Lang.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\Lang\Lang.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>Lang.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\Lang\Lang.zh-hans.resx">
	    <DependentUpon>Lang.resx</DependentUpon>
	  </EmbeddedResource>
	  <None Remove="Resources\Characters\GenerateStory.yaml" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Assets\Lang\zh-CN.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>zh-CN.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Assets\Icons\" />
	</ItemGroup>
</Project>
