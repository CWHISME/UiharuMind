<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>
	
	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<!-- 纯逻辑测试需要访问 internal 成员（与 UiharuMind.Core 同一口径） -->
		<InternalsVisibleTo Include="UiharuMind.App.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
		<!-- 显式引用:Avalonia 自己在用它,但我们要的 JPEG 编码 Avalonia 的 Bitmap.Save 给不了
		     (它只写 PNG,quality 参数不改格式),照片用 PNG 存下来是 JPEG 的 5~10 倍 -->
		<PackageReference Include="SkiaSharp" Version="3.119.3-preview.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
		<!-- 长文本查看/编辑内核。要的是它内建的<b>按行虚拟化</b>:SelectableTextBlock 与 TextBox
		     都没有文本虚拟化,几十万字的工具结果塞进去必然卡死。搜索/行号/跨行选中是白得的 -->
		<PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
		<PackageReference Include="Clowd.Clipboard.Gdi" Version="1.1.4" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
		<PackageReference Include="LiveMarkdown.Avalonia" Version="2.2.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
		<!--主题包-->
		<PackageReference Include="Irihi.Ursa" Version="2.0.1" />

		<PackageReference Include="Irihi.Ursa.Themes.Semi" Version="2.0.1" />
		<PackageReference Include="ProDiagnostics" Version="12.0.4" />
		<PackageReference Include="Semi.Avalonia" Version="12.0.3" />
		<PackageReference Include="Semi.Avalonia.ColorPicker" Version="12.0.3" />
		<PackageReference Include="SharpHook" Version="7.1.1" />
		<PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.13" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\UiharuMind.Core\UiharuMind.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Assets\Lang\zh-CN.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>zh-CN.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Assets\Lang\Lang.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Lang.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\Lang\Lang.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>Lang.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\Lang\Lang.zh-hans.resx">
	    <DependentUpon>Lang.resx</DependentUpon>
	  </EmbeddedResource>
	  <None Remove="Resources\Characters\GenerateStory.yaml" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Assets\Lang\zh-CN.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>zh-CN.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Memory\MemoryCreateWindow.axaml.cs">
	    <DependentUpon>MemoryCreateWindow.axaml</DependentUpon>
	  </Compile>
	  <Compile Update="Shared\Windows\ApplicationNotificationWindow.axaml.cs">
	    <DependentUpon>ApplicationNotificationWindow.axaml</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Assets\Icons\" />
	</ItemGroup>
</Project>
