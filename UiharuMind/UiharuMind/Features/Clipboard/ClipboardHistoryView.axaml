<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:clipboardViewData="clr-namespace:UiharuMind.Features.Clipboard"
             xmlns:lang="clr-namespace:UiharuMind.Resources.Lang"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:converters="clr-namespace:UiharuMind.Shared.Converters"
              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              x:Class="UiharuMind.Features.Clipboard.ClipboardHistoryView"
                             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls">

    <UserControl.Resources>
        <converters:FilePathToImageConverter x:Key="FilePathToImageConverter" />
    </UserControl.Resources>


    <Design.DataContext>
        <clipboardViewData:ClipboardHistoryViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="Gray" />
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" Margin="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" 
                           FontSize="12" 
                           VerticalAlignment="Center" 
                           Margin="0,0,5,0"
                           Padding="2,1" />
                <ToggleButton Name="SearchToggleButton" 
                              IsChecked="{Binding IsSearchActive}" 
                              Click="SearchToggleButton_Click" 
                              VerticalAlignment="Center"
                              Height="20"
                              Width="20"
                              MinHeight="20"
                              MinWidth="20"
                              Padding="2,1">
                    <controls:ThemedSvgIcon IconName="search" />
                </ToggleButton>
                <ToggleButton IsChecked="{Binding IsImageFilterActive}" 
                              VerticalAlignment="Center"
                              Height="20"
                              Width="20"
                              MinHeight="20"
                              MinWidth="20"
                              Padding="2,1">
                    <controls:ThemedSvgIcon IconName="image" />
                </ToggleButton>
                <ToggleButton IsChecked="{Binding IsFavoriteFilterActive}" 
                              VerticalAlignment="Center"
                              Height="20"
                              Width="20"
                              MinHeight="20"
                              MinWidth="20"
                              Padding="2,1">
                    <controls:ThemedSvgIcon IconName="star" />
                </ToggleButton>
            </StackPanel>
        </Grid>
        
        <!-- 搜索输入框 - 初始隐藏 -->
        <TextBox Grid.Row="1" 
                 Name="SearchTextBox" 
                 Text="{Binding SearchText, Mode=TwoWay}" 
                 Margin="3" 
                 IsVisible="{Binding IsChecked, ElementName=SearchToggleButton}"
                 KeyUp="SearchTextBox_KeyUp"/>
        
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource BorderCardBorderBrush }">
            <ListBox Name="HistoryListBox" ItemsSource="{Binding Items}" FontSize="10">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBorderBrush}" />
                        <Setter Property="CornerRadius" Value="0" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="80" RowDefinitions="Auto,*,Auto" Background="Transparent"
                              ToolTip.ShowDelay="500"
                              PointerReleased="InputElement_OnPointerReleased" PointerEntered="Item_OnPointerEntered">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc Favorite}" Click="MenuItemToggleFavorite_Click" />
                                    <MenuItem Header="{loc:Loc Delete}" Click="MenuItemDelete_Click" />
                                    <MenuItem Header="{loc:Loc DeleteAll}" Click="MenuItemDeleteAll_Click" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Image MaxHeight="80" Source="{Binding ImageSource, Converter={StaticResource FilePathToImageConverter}, ConverterParameter=80}" Stretch="Uniform" StretchDirection="Both" IsVisible="{Binding IsImage}" />
                            <TextBlock Grid.Row="1" Text="{Binding Preview}" IsVisible="{Binding !IsImage}"
                                       TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Text="{Binding Date}" FontSize="9" HorizontalAlignment="Right" />
                            <controls:ThemedSvgIcon Grid.Row="2" IconName="star" IsVisible="{Binding IsFavorite}" 
                                                     Height="12" Width="12" HorizontalAlignment="Left" />
                            <!-- 图片:内联控件的绑定要悬停才求值(实测未悬停时转换器零调用),故这里不必延迟,
                                 只需限住解码高度:整屏截图的悬停预览没必要按原分辨率解。
                                 文本:正文不在内存里,由 Item_OnPointerEntered 防抖后按主键现取,
                                 取回来的也只是前若干字——全文塞进 tooltip 是个布局炸弹。
                                 宽高都要封顶:无约束的 TextBlock/Image 在异步内容到达时会把 tooltip 撑开,
                                 表现为悬停窗突然拉伸;ShowDelay 盖住防抖+读盘也是为此 -->
                            <ToolTip.Tip>
                                <Panel MaxWidth="420">
                                    <Image Source="{Binding ImageSource, Converter={StaticResource FilePathToImageConverter}, ConverterParameter=400}"
                                           IsVisible="{Binding IsImage}" MaxWidth="400" MaxHeight="300" Stretch="Uniform" />
                                    <TextBlock Text="{Binding TooltipText}" IsVisible="{Binding !IsImage}"
                                               MaxWidth="400" MaxLines="20" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                </Panel>
                            </ToolTip.Tip>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>

</UserControl>