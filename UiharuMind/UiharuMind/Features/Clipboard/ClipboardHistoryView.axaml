<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:clipboardViewData="clr-namespace:UiharuMind.Features.Clipboard"
             xmlns:lang="clr-namespace:UiharuMind.Resources.Lang"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:converters="clr-namespace:UiharuMind.Shared.Converters"
              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              x:Class="UiharuMind.Features.Clipboard.ClipboardHistoryView"
                             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls">

    <UserControl.Resources>
        <converters:FilePathToImageConverter x:Key="FilePathToImageConverter" />
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <!-- 悬停预览。挂成隐式模板而非内联在 ToolTip.Tip 里:内联那份随列表条目一起构造,
             整屏截图会在没人悬停时就被解码;交给 ToolTip 这个 ContentControl 则弹出才 realize。
             列表条目走 ListBox.ItemTemplate,显式模板优先,不会被这份顶掉 -->
        <DataTemplate DataType="clipboardViewData:ClipboardItem">
            <Panel>
                <Image Source="{Binding ImageSource, Converter={StaticResource FilePathToImageConverter}, ConverterParameter=400}"
                       IsVisible="{Binding IsImage}" />
                <TextBlock Text="{Binding Text}" IsVisible="{Binding !IsImage}" />
            </Panel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Design.DataContext>
        <clipboardViewData:ClipboardHistoryViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="Gray" />
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" Margin="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" 
                           FontSize="12" 
                           VerticalAlignment="Center" 
                           Margin="0,0,5,0"
                           Padding="2,1" />
                <ToggleButton Name="SearchToggleButton" 
                              IsChecked="{Binding IsSearchActive}" 
                              Click="SearchToggleButton_Click" 
                              VerticalAlignment="Center"
                              Height="20"
                              Width="20"
                              MinHeight="20"
                              MinWidth="20"
                              Padding="2,1">
                    <controls:ThemedSvgIcon IconName="search" />
                </ToggleButton>
                <ToggleButton IsChecked="{Binding IsImageFilterActive}" 
                              VerticalAlignment="Center"
                              Height="20"
                              Width="20"
                              MinHeight="20"
                              MinWidth="20"
                              Padding="2,1">
                    <controls:ThemedSvgIcon IconName="image" />
                </ToggleButton>
                <ToggleButton IsChecked="{Binding IsFavoriteFilterActive}" 
                              VerticalAlignment="Center"
                              Height="20"
                              Width="20"
                              MinHeight="20"
                              MinWidth="20"
                              Padding="2,1">
                    <controls:ThemedSvgIcon IconName="star" />
                </ToggleButton>
            </StackPanel>
        </Grid>
        
        <!-- 搜索输入框 - 初始隐藏 -->
        <TextBox Grid.Row="1" 
                 Name="SearchTextBox" 
                 Text="{Binding SearchText, Mode=TwoWay}" 
                 Margin="3" 
                 IsVisible="{Binding IsChecked, ElementName=SearchToggleButton}"
                 KeyUp="SearchTextBox_KeyUp"/>
        
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource BorderCardBorderBrush }">
            <ListBox Name="HistoryListBox" ItemsSource="{Binding FilteredClipboardHistoryItems}" FontSize="10">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBorderBrush}" />
                        <Setter Property="CornerRadius" Value="0" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="80" RowDefinitions="Auto,*,Auto" Background="Transparent" PointerReleased="InputElement_OnPointerReleased">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc Favorite}" Click="MenuItemToggleFavorite_Click" />
                                    <MenuItem Header="{loc:Loc Delete}" Click="MenuItemDelete_Click" />
                                    <MenuItem Header="{loc:Loc DeleteAll}" Click="MenuItemDeleteAll_Click" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Image MaxHeight="80" Source="{Binding ImageSource, Converter={StaticResource FilePathToImageConverter}, ConverterParameter=80}" Stretch="Uniform" StretchDirection="Both" IsVisible="{Binding IsImage}" />
                            <TextBlock Grid.Row="1" Text="{Binding Text}" IsVisible="{Binding !IsImage}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Text="{Binding Date}" FontSize="9" HorizontalAlignment="Right" />
                            <controls:ThemedSvgIcon Grid.Row="2" IconName="star" IsVisible="{Binding IsFavorite}" 
                                                     Height="12" Width="12" HorizontalAlignment="Left" />
                            <!-- 内容交给上面那份隐式 DataTemplate,悬停时才解码 -->
                            <ToolTip.Tip>
                                <Binding />
                            </ToolTip.Tip>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>

</UserControl>