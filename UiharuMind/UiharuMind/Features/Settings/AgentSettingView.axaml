<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UiharuMind.Features.Settings"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="640"
             x:Class="UiharuMind.Features.Settings.AgentSettingView"
             x:DataType="vm:AgentSettingViewData">

    <UserControl.Styles>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style Selector="Border.form-pane">
            <Setter Property="Background" Value="{DynamicResource SemiGrey0}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </UserControl.Styles>

    <TabControl>
        <!-- ===================== 常规 ===================== -->
        <TabItem Header="{loc:Loc AgentSettingGeneral}">
            <StackPanel Margin="0,12" Spacing="4" MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Classes="field-label" Text="{loc:Loc AgentSettingDefaultPermission}" />
                <ComboBox SelectedIndex="{Binding DefaultPermissionModeIndex}" MinWidth="200">
                    <ComboBoxItem Content="{loc:Loc AgentPermissionReadOnly}" />
                    <ComboBoxItem Content="{loc:Loc AgentPermissionAutoEdit}" />
                    <ComboBoxItem Content="{loc:Loc AgentPermissionFullAuto}" />
                </ComboBox>

                <TextBlock Classes="field-label" Text="{loc:Loc AgentSettingDefaultWorkspace}" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding DefaultWorkspacePath}" />
                    <Button Grid.Column="1" Margin="6,0,0,0" Content="…"
                            Command="{Binding BrowseDefaultWorkspaceCommand}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <ToggleSwitch IsChecked="{Binding DefaultPlanMode}" />
                    <TextBlock VerticalAlignment="Center" Text="{loc:Loc AgentSettingDefaultPlanMode}" />
                </StackPanel>

            </StackPanel>
        </TabItem>

        <!-- 能力门控:左列 toggle+名称,右栏详细描述/提示词/专属设置 -->
        <TabItem Header="{loc:Loc AgentSettingCapabilities}">
            <ScrollViewer Margin="0,12">
                <StackPanel Spacing="12">
                    <!-- 工具开关与技能启停已下沉到角色(ADR 0003):这里只剩全局共用的搜索凭据 -->
                    <Border Classes="form-pane" Padding="14">
                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                   Text="{loc:Loc AgentSettingCapabilitiesMoved}" />
                    </Border>

                    <!-- 联网搜索(凭据 + 链路状态)自成一块，见 WebSearchSettingsView -->
                    <vm:WebSearchSettingsView DataContext="{Binding WebSearch}" />

                    <!-- 受管 Python 环境。它不是能力开关:agent 用 Shell 调那个解释器,见 ADR 0019 -->
                    <vm:PythonEnvSettingsView DataContext="{Binding PythonEnv}" />

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 子 agent 档案页已移除:子 agent 就是普通角色,在角色编辑器里维护,
             由 agent 角色的委托挂载列表决定启用哪些。 -->

        <!-- ===================== MCP Servers ===================== -->
        <TabItem Header="{loc:Loc AgentSettingMcp}">
            <vm:McpSettingsView DataContext="{Binding Mcp}" />
        </TabItem>

        <!-- ===================== 技能包 ===================== -->
        <TabItem Header="{loc:Loc AgentSettingSkills}">
            <Grid RowDefinitions="Auto,Auto,*" Margin="0,12">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Loc AgentSkillsCreate}" Command="{Binding CreateSkillCommand}" />
                    <Button Content="{loc:Loc AgentSkillsOpenFolder}" Command="{Binding OpenSkillsFolderCommand}" />
                    <Button Content="{loc:Loc AgentSkillsReload}" Command="{Binding ReloadSkillsCommand}" />
                    <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center"
                               MaxWidth="420" TextWrapping="Wrap"
                               Text="{loc:Loc AgentSkillsPerAgentHint}" />
                </StackPanel>
                <!-- 路径可选中复制:第三方生成器(如 Unity-MCP 的 setup-skills)要往这里落文件 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center"
                               Text="{loc:Loc AgentSkillsRootPath}" />
                    <SelectableTextBlock Classes="muted" FontSize="11" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis" Text="{Binding SkillsRootPath}" />
                </StackPanel>
                <ScrollViewer Grid.Row="2" Margin="0,10,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,6"
                                   Text="{loc:Loc AgentSkillsEmpty}" IsVisible="{Binding HasNoSkills}" />
                        <!-- 两级:包 → 分类。生态里的技能包普遍是「包名/skills/分类/技能名」,
                             只按包名分会得到一个几十条的大组,等于没分(见 SkillGrouping) -->
                        <ItemsControl ItemsSource="{Binding SkillGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SkillGroupItem">
                                    <Expander Margin="0,2" IsExpanded="True" HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                           Text="{Binding SkillCount}" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Categories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SkillCategoryItem">
                                                    <StackPanel Margin="0,2">
                                                        <TextBlock Classes="muted" FontSize="11" Margin="2,6,0,2"
                                                                   IsVisible="{Binding HasName}"
                                                                   Text="{Binding Name}" />
                                                        <ItemsControl ItemsSource="{Binding Skills}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:SkillDisplayItem">
                                                                    <Border Classes="form-pane" Margin="0,3" Padding="12,8">
                                                                        <StackPanel Spacing="2">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                                                <!-- 只读标记:模型自选由 SKILL.md 自己声明,用户不能覆盖 -->
                                                                                <TextBlock FontSize="11" VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource SemiBlue5}"
                                                                                           IsVisible="{Binding IsUserInvokedOnly}"
                                                                                           Text="{loc:Loc AgentSkillsUserInvoked}"
                                                                                           ToolTip.Tip="{loc:Loc AgentSkillsUserInvokedTip}" />
                                                                                <TextBlock FontSize="11" VerticalAlignment="Center"
                                                                                           Foreground="IndianRed"
                                                                                           IsVisible="{Binding !IsLoaded}"
                                                                                           Text="{loc:Loc AgentSkillsNotLoaded}" />
                                                                            </StackPanel>
                                                                            <TextBlock FontSize="12"
                                                                                       Foreground="{DynamicResource SemiGrey5}"
                                                                                       Text="{Binding Description}" TextWrapping="Wrap"
                                                                                       IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                            <TextBlock FontSize="12" Foreground="IndianRed" TextWrapping="Wrap"
                                                                                       Text="{Binding LoadFailureHint}"
                                                                                       IsVisible="{Binding LoadFailureHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
