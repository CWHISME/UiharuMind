<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settingViews="clr-namespace:UiharuMind.Features.Settings"
             xmlns:lang="clr-namespace:UiharuMind.Resources.Lang"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UiharuMind.Features.Settings.DebugSetting">

    <Design.DataContext>
        <settingViews:DebugSettingViewModel />
    </Design.DataContext>

    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{loc:Loc SettingLogLevelTitle}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding LogLevelList}" SelectedIndex="{Binding LogSelectedTypeIndex}"></ComboBox>
        </StackPanel>
    </StackPanel>

</UserControl>