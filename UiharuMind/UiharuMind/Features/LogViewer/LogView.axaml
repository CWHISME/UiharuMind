<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewData="clr-namespace:UiharuMind.Features.LogViewer"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:log="clr-namespace:UiharuMind.Core.Core.SimpleLog;assembly=UiharuMind.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UiharuMind.Features.LogViewer.LogView"
             x:DataType="viewData:LogViewModel">

    <Design.DataContext>
        <viewData:LogViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <viewData:LogLevelToColorConverter x:Key="LogLevelToColorConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto,200" Background="Transparent">
        <!-- toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="10,4">
            <ComboBox SelectedIndex="{Binding CategoryFilterIndex}" MinWidth="110" VerticalAlignment="Center">
                <ComboBoxItem>全部</ComboBoxItem>
                <ComboBoxItem>通用</ComboBoxItem>
                <ComboBoxItem>模型请求</ComboBoxItem>
                <ComboBoxItem>模型响应</ComboBoxItem>
            </ComboBox>
            <Button Content="打开日志目录" Command="{Binding OpenFolderCommand}" />
            <Button Content="导出当前筛选" Command="{Binding ExportCommand}" />
            <Button Content="清空" Command="{Binding ClearCommand}" />
        </StackPanel>

        <!-- log items: 最新的在最顶上 -->
        <ListBox Grid.Row="1" Name="LogList" ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedEntry}"
                 SelectionMode="Single" Background="Transparent">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="log:LogIndexEntry">
                    <TextBlock Text="{Binding Preview}" MaxLines="1" TextTrimming="CharacterEllipsis"
                               Background="Transparent"
                               Foreground="{Binding LogType, Converter={StaticResource LogLevelToColorConverter}}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- for resizing -->
        <GridSplitter Grid.Row="2" ResizeBehavior="PreviousAndNext" Height="5" HorizontalAlignment="Stretch" />

        <!-- detail text -->
        <controls:LongTextView Grid.Row="3" Name="DetailText"
                               Text="{Binding DetailText, Mode=OneWay}"
                               IsEditable="False" IsToolbarVisible="False"
                               ShowLineNumbers="False" WordWrap="True" />
    </Grid>
</UserControl>
