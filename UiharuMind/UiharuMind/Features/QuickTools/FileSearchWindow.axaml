<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UiharuMind.Features.QuickTools"
        xmlns:icons="clr-namespace:UiharuMind.Shared.Controls"
        xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
        xmlns:convs="clr-namespace:UiharuMind.Shared.Converters"
        x:Class="UiharuMind.Features.QuickTools.FileSearchWindow"
        Title="{loc:Loc FileSearchTitle}"
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner"
        MinWidth="500" MinHeight="400"
        DragDrop.AllowDrop="True">

    <Design.DataContext>
        <vm:SearchViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="10">

        <!-- Row 0: 搜索栏 -->
        <StackPanel Orientation="Vertical">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                <TextBox Text="{Binding SearchQuery}"
                         PlaceholderText="{loc:Loc FileSearchInputWatermark}"
                         KeyDown="OnSearchBoxKeyDown"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Column="1"
                        Command="{Binding SearchCommand}"
                        IsEnabled="{Binding !IsSearching}"
                        Margin="5,0">
                    <TextBlock Text="{loc:Loc FileSearchBtn}"/>
                </Button>
            </Grid>
            <TextBlock Text="{Binding StatusMessage}"/>
        </StackPanel>
        
        <!-- Row 1: 搜索选项 -->
        <Border Grid.Row="1"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="5" Padding="8"
                Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox Content="{loc:Loc FileSearchContentSearchMode}" IsChecked="{Binding IsContentMode}">
                    <ToolTip.Tip>
                        <TextBlock Text="{loc:Loc FileSearchContentSearchModeTip}" />
                    </ToolTip.Tip>
                </CheckBox>
                <CheckBox Content="{loc:Loc FileSearchRegexMode}" IsChecked="{Binding IsRegexMode}"/>
                <CheckBox Content="{loc:Loc FileSearchCaseSensitive}" IsChecked="{Binding IsCaseSensitive}"/>
                <CheckBox Content="{loc:Loc FileSearchAutoSearch}" IsChecked="{Binding AutoSearch}"/>
            </StackPanel>
        </Border>

        <!-- Row 2: 目录 -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,5">
            <TextBlock Grid.Column="0" Text="{loc:Loc FileSearchCurrentDirectory}"
                       VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11" Foreground="Gray"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding HistoryDirectories}"
                      SelectedItem="{Binding CurrentDirectory}"
                      IsEditable="True"
                      LostFocus="OnDirectoryLostFocus"
                      KeyDown="OnDirectoryKeyDown"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"/>
            <icons:ThemedIconButton Grid.Column="2"
                                    IconName="folder-cog"
                                    Command="{Binding SelectDirectoryCommand}"
                                    Width="28" Height="28"
                                    Margin="4,0,0,0"
                                    ToolTip.Tip="{loc:Loc FileSearchSelectDirectory}"/>
            <icons:ThemedIconButton Grid.Column="3"
                                    IconName="square-arrow-out-up-right"
                                    Command="{Binding OpenCurrentDirectoryCommand}"
                                    Width="28" Height="28"
                                    Margin="4,0,0,0"
                                    ToolTip.Tip="{loc:Loc FileSearchCtxOpenDir}"/>
        </Grid>

        <!-- Row 3: 结果 -->
        <Grid Grid.Row="3">
            <ListBox ItemsSource="{Binding Results}"
                     SelectionMode="Single"
                     DoubleTapped="OnResultDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderCardBorderBrush}" BorderThickness="0,0,0,1" Padding="5">
                            <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:Loc FileSearchCtxOpenFile}" Tag="OpenFile" Click="OnContextMenuItemClick"/>
                                        <MenuItem Header="{loc:Loc FileSearchCtxOpenDir}" Tag="OpenDir" Click="OnContextMenuItemClick"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <icons:ThemedSvgIcon Grid.Column="0"
                                                     Width="16" Height="16"
                                                     IconName="{Binding IsContentSearch, Converter={x:Static convs:BoolToIconConverter.Instance}}"
                                                     Margin="0,0,10,0"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="Gray"
                                               MaxLines="2" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="Gray"
                                               MaxLines="2" TextWrapping="Wrap"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           IsVisible="{Binding IsContentSearch}"
                                           Text="{Binding LineNumber, StringFormat='Line: {0}'}"
                                           FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel IsVisible="{Binding HasNoResults}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="12">
                <icons:ThemedSvgIcon IconName="search"
                                     Width="48" Height="48"
                                     HorizontalAlignment="Center"
                                     Opacity="0.4"/>
                <TextBlock Text="{loc:Loc FileSearchEmptyHint}"
                           FontSize="14" Foreground="Gray"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>

            <Border Background="#80000000" IsVisible="{Binding IsSearching}" VerticalAlignment="Top" Height="30">
                <TextBlock Text="{loc:Loc FileSearchSearching}" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
            </Border>
        </Grid>
    </Grid>
</Window>
