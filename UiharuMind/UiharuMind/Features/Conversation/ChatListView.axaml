<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewData="clr-namespace:UiharuMind.Features.Conversation"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:u="https://irihi.tech/ursa"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="520"
             x:Class="UiharuMind.Features.Conversation.ChatListView">

    <Design.DataContext>
        <viewData:ChatListViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SemiBlue0}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
        </Style>
    </UserControl.Styles>

    <ListBox ItemsSource="{Binding ChatSessions}"
             SelectedItem="{Binding SelectedSession}">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Border Padding="10" Background="Transparent" CornerRadius="8">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc EditCharacter}" Command="{Binding EditCharacterCommand}" />
                            <MenuItem Header="{loc:Loc Rename}" Command="{Binding RenameCommand}" />
                            <MenuItem Header="{loc:Loc Copy}" Command="{Binding CopyCommand}" />
                            <MenuItem Header="{loc:Loc ClearChatHistory}" ToolTip.Tip="{Binding BusyTip}"
                                      Command="{Binding ClearChatHistoryCommand}" />
                            <MenuItem Header="{loc:Loc Delete}" ToolTip.Tip="{Binding BusyTip}"
                                      Command="{Binding DeleteCommand}" />
                        </ContextMenu>
                    </Border.ContextMenu>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Ellipse Width="38" Height="38" Stroke="{DynamicResource SemiGrey2}" StrokeThickness="1">
                            <Ellipse.Fill>
                                <ImageBrush Source="{Binding Icon}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" MinWidth="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <!-- 运行指示器:在跑用转圈,待审批用橙点(要你去处理,不是在自己跑) -->
                                <!-- 必须经 Viewbox 缩:LoadingIcon 模板里的弧线是固定尺寸的,
                                     直接给它 Width/Height 是裁剪而不是缩放,只会剩中间一块 -->
                                <Viewbox Grid.Column="0" Width="13" Height="13"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding IsRunning}">
                                    <u:LoadingIcon IsLoading="True" />
                                </Viewbox>
                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="#FF9800"
                                         IsVisible="{Binding IsAwaitingApproval}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SemiGrey7}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Classes="muted"
                                           Text="{Binding TimeString}" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Classes="muted"
                                       Text="{Binding Description}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2" />
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
