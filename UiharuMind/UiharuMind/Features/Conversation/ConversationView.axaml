<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:composer="clr-namespace:UiharuMind.Features.Conversation.Composer"
             xmlns:conv="clr-namespace:UiharuMind.Features.Conversation"
             xmlns:items="clr-namespace:UiharuMind.Features.Conversation.Items"
             xmlns:panels="clr-namespace:UiharuMind.Features.Conversation.SidePanels"
             xmlns:uiHolder="clr-namespace:UiharuMind.Shared.UIHolder"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:skills="clr-namespace:UiharuMind.Core.AI.Execution.Skills;assembly=UiharuMind.Core"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="640"
             x:Class="UiharuMind.Features.Conversation.ConversationView"
             x:DataType="conv:ConversationViewModel">

    <UserControl.Resources>
        <composer:AttachmentToImageConverter x:Key="AttachmentToImageConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.tool-row">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="ListBox.option-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.option-list ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <!-- 工具行图标态:Tag 驱动颜色区分当前状态 -->
        <Style Selector="ThemedIconButton.mode-state[Tag=Plan] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="DodgerBlue" />
        </Style>
        <Style Selector="ThemedIconButton.mode-state[Tag=Execute] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="MediumSeaGreen" />
        </Style>
        <Style Selector="ThemedIconButton.permission-state[Tag=ReadOnly] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="Gray" />
        </Style>
        <Style Selector="ThemedIconButton.permission-state[Tag=AutoEdit] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="Orange" />
        </Style>
        <Style Selector="ThemedIconButton.permission-state[Tag=FullAuto] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="OrangeRed" />
        </Style>
        <Style Selector="ThemedIconButton.thinking-state[Tag=Default] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="Gray" />
        </Style>
        <Style Selector="ThemedIconButton.thinking-state[Tag=None] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="DimGray" />
        </Style>
        <Style Selector="ThemedIconButton.thinking-state[Tag=Medium] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="DodgerBlue" />
        </Style>
        <Style Selector="ThemedIconButton.thinking-state[Tag=High] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="Orange" />
        </Style>
        <Style Selector="ThemedIconButton.thinking-state[Tag=Max] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="OrangeRed" />
        </Style>
        <Style Selector="ThemedIconButton.sender-state[Tag=User] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="LightGreen" />
        </Style>
        <Style Selector="ThemedIconButton.sender-state[Tag=Assistant] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="DeepSkyBlue" />
        </Style>
        <Style Selector="ThemedIconButton.memory-status controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="Gray" />
        </Style>
        <Style Selector="ThemedIconButton.memory-status[Tag=Dirty] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="DarkRed" />
        </Style>
        <Style Selector="ThemedIconButton.memory-status[Tag=Error] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="Red" />
        </Style>
        <Style Selector="ThemedIconButton.memory-status[Tag=Ready] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="LawnGreen" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SemiGrey0}">

        <!-- 头部:标题 + 宿主注入的动作区 -->
        <Border Grid.Row="0" Padding="14,10"
                BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel MinWidth="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"
                               TextTrimming="CharacterEllipsis" MaxLines="1"
                               Foreground="{DynamicResource SemiGrey7}" />
                    <!-- 模型跟随会话,当前会话用的模型在此处可见 -->
                    <TextBlock Classes="muted"
                               Text="{Binding SessionModelLabel}"
                               TextTrimming="CharacterEllipsis" MaxLines="1"
                               IsVisible="{Binding SessionModelLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ThemedIconButton IconName="repeat"
                                      Command="{Binding RegenerateLastCommand}"
                                      IsVisible="{Binding CanRegenerate}"
                                      ToolTips="{loc:Loc RegenerateBtn}" />
                    <ContentPresenter
                        Content="{Binding HeaderExtra, RelativeSource={RelativeSource AncestorType=conv:ConversationView}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 消息列表:非虚拟化 + 数据层开窗(只渲染最近一窗,顶部按批加载更早)。
             虚拟化面板在不定高气泡下 Extent 是估算值,进度条跳变/滚动回跳/跟底互搏均源于此,
             已实测不可用;开窗后布局全为真实测量,自动跟底直接复用 ScrollViewerAutoScrollHolder -->
        <Grid Grid.Row="1">
            <!-- 空状态(宿主注入):切会话分帧会先渲染一帧空列表,加载中不算"空",否则空态图标闪烁 -->
            <ContentPresenter Margin="10"
                              Content="{Binding EmptyContent, RelativeSource={RelativeSource AncestorType=conv:ConversationView}}">
                <ContentPresenter.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!Items.Count" />
                        <Binding Path="!IsSessionLoading" />
                    </MultiBinding>
                </ContentPresenter.IsVisible>
            </ContentPresenter>

            <ScrollViewer Name="Viewer"
                          Margin="0,0,3,0"
                          BringIntoViewOnFocusChange="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          uiHolder:ScrollViewExtensions.ScrollToEnd="{Binding ScrollToEnd}">
                <StackPanel Margin="10">
                    <Button HorizontalAlignment="Center"
                            Margin="0,0,0,10"
                            IsVisible="{Binding HasEarlierMessages}"
                            Click="OnLoadEarlierClick"
                            Content="{loc:Loc ChatLoadEarlier}" />
                    <ItemsControl Name="MessageList" ItemsSource="{Binding Items}">
                        <ItemsControl.DataTemplates>
                    <!-- 思考过程:弱化折叠条。视觉与行为都在 ThinkingCardView 里,
                         与工具卡片同一套几何(会话流与子代理过程窗口共用同一份组件) -->
                    <DataTemplate DataType="{x:Type items:ThinkingItem}">
                        <items:ThinkingCardView />
                    </DataTemplate>

                    <!-- 交接文档:模型从这条往前看不见了,默认折叠 -->
                    <DataTemplate DataType="{x:Type items:HandoffItem}">
                        <Border Background="{DynamicResource SemiGrey1}"
                                BorderBrush="{DynamicResource SemiGrey3}" BorderThickness="1"
                                CornerRadius="8" Padding="4,0" Margin="0,6,0,6">
                            <Expander IsExpanded="{Binding IsExpanded}" Background="Transparent"
                                      BorderThickness="0" HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <TextBlock Classes="muted" Text="{loc:Loc HandoffHeader}" />
                                </Expander.Header>
                                <SelectableTextBlock Classes="muted" Text="{Binding Message}"
                                                     TextWrapping="Wrap" Margin="0,0,0,8" />
                            </Expander>
                        </Border>
                    </DataTemplate>

                    <!-- 错误条目(两个页面通用) -->
                    <DataTemplate DataType="{x:Type items:ErrorItem}">
                        <Border Background="{DynamicResource SemiGrey1}"
                                BorderBrush="IndianRed" BorderThickness="1"
                                CornerRadius="8" Padding="10" Margin="0,4,0,4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="⚠" Foreground="IndianRed" Margin="0,0,8,0"/>
                                <SelectableTextBlock Foreground="IndianRed" Text="{Binding Message}"
                                                     TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>

                    <!-- 标准文本气泡;特型条目模板由宿主页在其资源中提供,沿逻辑树向上查找生效 -->
                    <!-- 文本气泡:与工具/审批/思考三张卡并列,各自成组件 -->
                    <DataTemplate DataType="{x:Type items:TextConversationItem}">
                        <items:TextMessageCardView />
                    </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- composer -->
        <Border Grid.Row="2" Margin="5" Padding="5" Classes="tool-row" Name="ComposerBorder">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="4">
                <!-- 附件 chips:附件盘挂在共用 VM 上,粘贴/拖入在本组件内处理,因此 chips 也内置。
                     DataContext 整体切到附件盘,下面模板里的 $parent[ItemsControl] 才拿得到它 -->
                <StackPanel Grid.Row="0" DataContext="{Binding Tray}">
                    <ItemsControl ItemsSource="{Binding Attachments}"
                                  IsVisible="{Binding Attachments.Count}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="composer:ConversationAttachment">
                                <Border Background="{DynamicResource SemiGrey2}" CornerRadius="10"
                                        Padding="6,4" Margin="0,0,6,4" MaxWidth="180">
                                    <Grid>
                                        <Button Classes="NoneStyle" Padding="0"
                                                Cursor="Hand" HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((composer:AttachmentTrayViewData)DataContext).PreviewAttachmentCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid VerticalAlignment="Center">
                                                <Image Source="{Binding Converter={StaticResource AttachmentToImageConverter}, ConverterParameter=48}"
                                                       MaxHeight="48" MaxWidth="48" Stretch="Uniform"
                                                       IsVisible="{Binding IsImage}" />
                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            IsVisible="{Binding !IsImage}"
                                                            VerticalAlignment="Center">
                                                    <ThemedSvgIcon IconName="file-text" Width="16" Height="16"
                                                                   VerticalAlignment="Center" />
                                                    <TextBlock FontSize="11" Text="{Binding FileName}"
                                                               Margin="0,3,0,0"
                                                               MaxWidth="120" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <ThemedIconButton Classes="message-action"
                                                          IconName="trash-2"
                                                          HorizontalAlignment="Right" VerticalAlignment="Top"
                                                          Margin="0,-8,-8,0"
                                                          Command="{Binding $parent[ItemsControl].((composer:AttachmentTrayViewData)DataContext).RemoveAttachmentCommand}"
                                                          CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 发图白发的警示:当前模型看不了图,角色档又没有 ask_vision 兜底(纯提示词档)。
                         只提示,不阻止发送、不替用户换模型;换视觉模型或删掉图片后自行消失 -->
                    <TextBlock Classes="muted" FontSize="11" Margin="2,0,2,2"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SemiOrange5}"
                               Text="{loc:Loc ChatImageUnreadableWarning}"
                               IsVisible="{Binding IsImageUnreadableWarningVisible}" />
                </StackPanel>

                <!-- 宿主注入:输入框上方区域 -->
                <ContentPresenter Grid.Row="1"
                                  Content="{Binding ComposerTop, RelativeSource={RelativeSource AncestorType=conv:ConversationView}}" />

                <!-- 点名补全:整行以 / 开头且技能名未写完时弹出。上下移动、回车/Tab 采纳、Esc 收起。
                     ↑↓/Esc 在 code-behind 拦;回车与 Tab 绑在下面的 KeyBindings 上,
                     而 Avalonia 在 raise 路由事件之前就处理 KeyBindings,所以那两个键
                     是在 SendMessage/InputExtra 命令入口改道的 -->
                <Border Grid.Row="2" Padding="6" CornerRadius="8" MaxHeight="200"
                        Background="{DynamicResource SemiGrey0}"
                        BorderBrush="{DynamicResource SemiGrey2}"
                        BorderThickness="1"
                        IsVisible="{Binding Palette.IsSkillPickerOpen}">
                    <ListBox Name="SkillPicker" Classes="option-list" Focusable="False"
                             ItemsSource="{Binding Palette.SkillCandidates}"
                             SelectedIndex="{Binding Palette.SkillCandidateIndex}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="skills:SkillCatalogEntry">
                                <StackPanel Spacing="1" Margin="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Name, StringFormat='/{0}'}" />
                                        <TextBlock FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SemiBlue5}"
                                                   IsVisible="{Binding !IsModelInvocable}"
                                                   Text="{loc:Loc AgentSkillsUserInvoked}"
                                                   ToolTip.Tip="{loc:Loc AgentSkillsUserInvokedTip}" />
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource SemiGrey5}"
                                               Text="{Binding Description}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBox Grid.Row="3" Name="InputBox" Classes="composer-input"
                         Text="{Binding InputText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         PlaceholderText="{Binding InputPlaceholder}">
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding SendMessageCommand}" Gesture="{Binding SendGesture}" />
                        <KeyBinding Command="{Binding InputExtraCommand}" Gesture="Tab" />
                    </TextBox.KeyBindings>
                </TextBox>

                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <!-- 工具行:两类会话共用,按 IsAgentSession 切换差异项;ComposerTools 槽保留给宿主追加 -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ThemedIconButton Classes="mode-state"
                                          IconName="route"
                                          Tag="{Binding ModeKey}"
                                          Command="{Binding CycleModeCommand}"
                                          ToolTips="{Binding ModeTooltip}"
                                          IsVisible="{Binding IsModeSwitchVisible}" />
                        <ThemedIconButton Classes="sender-state"
                                          IconName="{Binding SenderIconName}"
                                          Tag="{Binding SenderModeKey}"
                                          Command="{Binding ChangeSendModeCommand}"
                                          ToolTips="{Binding SenderTooltip}"
                                          IsVisible="{Binding !IsAgentSession}" />
                        <!-- 垂直分隔线 -->
                        <Rectangle Width="1" Height="16" Fill="Gray" Margin="4,0" VerticalAlignment="Center" IsVisible="{Binding !IsAgentSession}"/>

                        <ThemedIconButton Classes="permission-state"
                                          IconName="shield"
                                          Tag="{Binding PermissionModeKey}"
                                          ToolTips="{Binding PermissionTooltip}"
                                          IsVisible="{Binding IsAgentSession}">
                            <ThemedIconButton.Flyout>
                                <Flyout Placement="Top">
                                    <Border Padding="6" CornerRadius="8"
                                            Background="{DynamicResource SemiGrey0}"
                                            BorderBrush="{DynamicResource SemiGrey2}"
                                            BorderThickness="1">
                                        <ListBox Classes="option-list"
                                                 SelectedIndex="{Binding PermissionModeIndex}">
                                            <ListBoxItem>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc AgentPermissionReadOnly}" />
                                                    <TextBlock Classes="muted"
                                                               Text="{loc:Loc AgentPermissionReadOnlyDesc}" />
                                                </StackPanel>
                                            </ListBoxItem>
                                            <ListBoxItem>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc AgentPermissionAutoEdit}" />
                                                    <TextBlock Classes="muted"
                                                               Text="{loc:Loc AgentPermissionAutoEditDesc}" />
                                                </StackPanel>
                                            </ListBoxItem>
                                            <ListBoxItem>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc AgentPermissionFullAuto}" />
                                                    <TextBlock Classes="muted"
                                                               Text="{loc:Loc AgentPermissionFullAutoDesc}" />
                                                </StackPanel>
                                            </ListBoxItem>
                                        </ListBox>
                                    </Border>
                                </Flyout>
                            </ThemedIconButton.Flyout>
                        </ThemedIconButton>
                        <ThemedIconButton Classes="thinking-state"
                                          IconName="brain"
                                          Tag="{Binding ThinkingModeKey}"
                                          ToolTips="{Binding ThinkingTooltip}">
                            <ThemedIconButton.Flyout>
                                <Flyout Placement="Top">
                                    <Border Padding="6" CornerRadius="8"
                                            Background="{DynamicResource SemiGrey0}"
                                            BorderBrush="{DynamicResource SemiGrey2}"
                                            BorderThickness="1">
                                        <ListBox Classes="option-list"
                                                 SelectedIndex="{Binding ThinkingModeIndex}">
                                            <ListBoxItem>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc ThinkingModeDefault}" />
                                                    <TextBlock Classes="muted"
                                                               Text="{loc:Loc ThinkingModeDefaultDesc}" />
                                                </StackPanel>
                                            </ListBoxItem>
                                            <ListBoxItem>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc ThinkingModeNone}" />
                                                    <TextBlock Classes="muted"
                                                               Text="{loc:Loc ThinkingModeNoneDesc}" />
                                                </StackPanel>
                                            </ListBoxItem>
                                            <ListBoxItem>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc ThinkingModeMedium}" />
                                                    <TextBlock Classes="muted"
                                                               Text="{loc:Loc ThinkingModeMediumDesc}" />
                                                </StackPanel>
                                            </ListBoxItem>
                                            <ListBoxItem>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc ThinkingModeHigh}" />
                                                    <TextBlock Classes="muted"
                                                               Text="{loc:Loc ThinkingModeHighDesc}" />
                                                </StackPanel>
                                            </ListBoxItem>
                                            <ListBoxItem>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc ThinkingModeMax}" />
                                                    <TextBlock Classes="muted"
                                                               Text="{loc:Loc ThinkingModeMaxDesc}" />
                                                </StackPanel>
                                            </ListBoxItem>
                                        </ListBox>
                                    </Border>
                                </Flyout>
                            </ThemedIconButton.Flyout>
                        </ThemedIconButton>

                        <ThemedIconButton Classes="memory-status"
                                          IconName="database"
                                          ToolTips="{Binding MemoryPanel.MemoryTooltip}"
                                          Tag="{Binding MemoryPanel.MemoryStatusKey}"
                                          Command="{Binding MemoryPanel.MemoryEditorCommand}"
                                          IsVisible="{Binding MemoryPanel, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ThemedIconButton IconName="paperclip" Command="{Binding Tray.AddAttachmentCommand}" />
                        <ThemedIconButton IconName="settings">
                            <ThemedIconButton.Flyout>
                                <Flyout Placement="Top">
                                    <Border Padding="10"
                                            CornerRadius="8"
                                            Background="{DynamicResource SemiGrey0}"
                                            BorderBrush="{DynamicResource SemiGrey2}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <CheckBox Content="{loc:Loc ChatAutoCollapseThinking}"
                                                      IsChecked="{Binding IsAutoCollapseThinking}">
                                                <ToolTip.Tip>
                                                    <TextBlock Text="{loc:Loc ChatAutoCollapseThinkingTips}" />
                                                </ToolTip.Tip>
                                            </CheckBox>
                                            <CheckBox Content="{loc:Loc Plaintext}"
                                                      IsChecked="{Binding IsPlaintext}">
                                                <ToolTip.Tip>
                                                    <TextBlock Text="{loc:Loc ChatPlaintextTooltip}" />
                                                </ToolTip.Tip>
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </ThemedIconButton.Flyout>
                            <ToolTip.Tip>
                                <TextBlock Text="{loc:Loc Settings}" />
                            </ToolTip.Tip>
                        </ThemedIconButton>
                        <!-- 宿主注入 -->
                        <ContentPresenter VerticalAlignment="Center"
                                          Content="{Binding ComposerTools, RelativeSource={RelativeSource AncestorType=conv:ConversationView}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Classes="muted" VerticalAlignment="Center"
                                   Text="{Binding TokenUsageText}"
                                   IsVisible="{Binding TokenUsageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <ToolTip.Tip>
                                    <panels:ContextUsagePanel DataContext="{Binding ContextUsage}" />
                            </ToolTip.Tip>
                        </TextBlock>
                        <!-- 「没卡死,在忙别的」：整理交接文档、等 MCP 连上都走这一处。
                             文案由 BusyLabel 按 ETurnBusy 映射，再加一种不必再复制一块 StackPanel -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    IsVisible="{Binding BusyLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <u:LoadingIcon IsLoading="True" />
                            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding BusyLabel}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsGenerating}" Orientation="Horizontal" Spacing="8">
                            <u:LoadingIcon IsLoading="{Binding IsGenerating}" />
                            <ThemedIconButton IconName="stop"
                                              CurrentColor="Red"
                                              Command="{Binding StopSendingCommand}"
                                              ToolTips="{loc:Loc StopGenerating}" />
                        </StackPanel>
                        <Button CornerRadius="10"
                                IsVisible="{Binding !IsGenerating}"
                                IsEnabled="{Binding InputText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Command="{Binding SendMessageCommand}"
                                Content="{loc:Loc Send}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
