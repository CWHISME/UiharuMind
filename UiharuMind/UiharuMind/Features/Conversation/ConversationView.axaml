<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:composer="clr-namespace:UiharuMind.Features.Conversation.Composer"
             xmlns:conv="clr-namespace:UiharuMind.Features.Conversation"
             xmlns:items="clr-namespace:UiharuMind.Features.Conversation.Items"
             xmlns:panels="clr-namespace:UiharuMind.Features.Conversation.SidePanels"
             xmlns:uiHolder="clr-namespace:UiharuMind.Shared.UIHolder"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:skills="clr-namespace:UiharuMind.Core.AI.Execution.Skills;assembly=UiharuMind.Core"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="640"
             x:Class="UiharuMind.Features.Conversation.ConversationView"
             x:DataType="conv:ConversationViewModel">

    <UserControl.Resources>
        <composer:AttachmentToImageConverter x:Key="AttachmentToImageConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 子代理状态行:只有「等审批」那一档是报警(有时限、到期白跑),配色与其余两档分开 -->
        <Style Selector="Button.text-row.alert TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiOrange5}" />
        </Style>
        <Style Selector="Border.tool-row">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="ListBox.option-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.option-list ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <!-- 工具行图标态:Tag 驱动颜色区分当前状态 -->
        <Style Selector="ThemedIconButton.mode-state[Tag=Plan] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="DodgerBlue" />
        </Style>
        <Style Selector="ThemedIconButton.mode-state[Tag=Execute] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="MediumSeaGreen" />
        </Style>
        <Style Selector="ThemedIconButton.permission-state[Tag=ReadOnly] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="Gray" />
        </Style>
        <Style Selector="ThemedIconButton.permission-state[Tag=AutoEdit] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="Orange" />
        </Style>
        <Style Selector="ThemedIconButton.permission-state[Tag=FullAuto] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="OrangeRed" />
        </Style>
        <Style Selector="ThemedIconButton.sender-state[Tag=User] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="LightGreen" />
        </Style>
        <Style Selector="ThemedIconButton.sender-state[Tag=Assistant] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="DeepSkyBlue" />
        </Style>
        <Style Selector="ThemedIconButton.memory-status controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="Gray" />
        </Style>
        <Style Selector="ThemedIconButton.memory-status[Tag=Dirty] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="DarkRed" />
        </Style>
        <Style Selector="ThemedIconButton.memory-status[Tag=Error] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="Red" />
        </Style>
        <Style Selector="ThemedIconButton.memory-status[Tag=Ready] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="LawnGreen" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SemiGrey0}">

        <!-- 头部:标题 + 宿主注入的动作区 -->
        <Border Grid.Row="0" Padding="14,10"
                BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel MinWidth="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"
                               TextTrimming="CharacterEllipsis" MaxLines="1"
                               Foreground="{DynamicResource SemiGrey7}" />
                    <!-- 元信息行:模型占剩余宽度(长名字自己截断),编号钉在右端,
                         两者都短时中间留白,不会互相挤 -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <!-- 模型跟随会话。这里从前是一行只读文本,换模型要去右栏面板——
                             于是子会话窗口(它只嵌 ConversationView,没有右栏)根本换不了。
                             现在「显示当前模型」与「换模型」是同一个控件:点开是同一份
                             SessionModelPanel,右栏那两份已撤掉,一个值不再有两处能改 -->
                        <!-- HorizontalAlignment=Left 不能省:text-row 此前只用在 Auto 宽度的槽里
                             (会话编号那个),放进 * 列才暴露出内容是居中的,模型名会缩进一块 -->
                        <Button Classes="text-row" Padding="0"
                                HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                IsVisible="{Binding SessionModelLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="muted"
                                       Text="{Binding SessionModelLabel}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <Border Width="320" Padding="0" ClipToBounds="True">
                                        <panels:SessionModelPanel DataContext="{Binding SessionModel}" />
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!-- 会话编号:ContinueSubAgent、日志与 Agent/Workspaces 房间目录认的都是它。
                             显示短写省地方,点一下复制的是全串(悬停可见) -->
                        <Button Grid.Column="1" Classes="text-row"
                                Command="{Binding CopySessionIdCommand}"
                                ToolTip.Tip="{Binding SessionIdFull}"
                                IsVisible="{Binding SessionIdShort, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="muted" FontSize="11" FontFamily="{DynamicResource CodeFontFamily}"
                                       Text="{Binding SessionIdShort}" />
                        </Button>
                    </Grid>
                    <!-- 「交回主代理」的结果。那是一次性动作,没有别的反馈渠道 -->
                    <TextBlock Classes="muted" FontSize="11"
                               Text="{Binding HandoffNotice}"
                               TextTrimming="CharacterEllipsis" MaxLines="1"
                               IsVisible="{Binding HandoffNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <!-- 子会话专属:把结论交回派它出来的那个会话。会话级动作,
                         与「重新生成」同一形态放在头部——输入区那一行已经满了 -->
                    <ThemedIconButton IconName="import"
                                      Command="{Binding HandBackToParentCommand}"
                                      IsVisible="{Binding IsSubSession}"
                                      ToolTips="{loc:Loc SubAgentHandBackTip}" />
                    <ThemedIconButton IconName="repeat"
                                      Command="{Binding RegenerateLastCommand}"
                                      IsVisible="{Binding CanRegenerate}"
                                      ToolTips="{loc:Loc RegenerateBtn}" />
                    <ContentPresenter
                        Content="{Binding HeaderExtra, RelativeSource={RelativeSource AncestorType=conv:ConversationView}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 消息列表:非虚拟化 + 数据层开窗(只渲染最近一窗,顶部按批加载更早)。
             虚拟化面板在不定高气泡下 Extent 是估算值,进度条跳变/滚动回跳/跟底互搏均源于此,
             已实测不可用;开窗后布局全为真实测量,自动跟底直接复用 ScrollViewerAutoScrollHolder -->
        <Grid Grid.Row="1">
            <!-- 空状态(宿主注入):切会话分帧会先渲染一帧空列表,加载中不算"空",否则空态图标闪烁 -->
            <ContentPresenter Margin="10"
                              Content="{Binding EmptyContent, RelativeSource={RelativeSource AncestorType=conv:ConversationView}}">
                <ContentPresenter.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!Items.Count" />
                        <Binding Path="!IsSessionLoading" />
                    </MultiBinding>
                </ContentPresenter.IsVisible>
            </ContentPresenter>

            <ScrollViewer Name="Viewer"
                          Margin="0,0,3,0"
                          BringIntoViewOnFocusChange="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          uiHolder:ScrollViewExtensions.ScrollToEnd="{Binding ScrollToEnd}">
                <StackPanel Margin="10">
                    <!-- 顶部状态行(不是按钮):更早的消息由滚到顶自动续,见 OnViewerScrollChanged。
                         原先这里是一个「加载更早」按钮——要用户自己去点才回得去,是长会话里最难用的一处。
                         「已到开头」只在真的续过至少一窗之后才显示:短会话本来就没有更早的消息,
                         一上来就挂一行"已到开头"是纯噪音 -->
                    <TextBlock Classes="muted" HorizontalAlignment="Center"
                               Margin="0,0,0,10"
                               IsVisible="{Binding HasEarlierMessages}"
                               Text="{loc:Loc ChatLoadEarlier}" />
                    <TextBlock Classes="muted" HorizontalAlignment="Center"
                               Margin="0,0,0,10"
                               Text="{loc:Loc ChatHistoryStart}">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!HasEarlierMessages" />
                                <Binding Path="HasLoadedEarlier" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                    <ItemsControl Name="MessageList" ItemsSource="{Binding Items}">
                        <ItemsControl.DataTemplates>
                    <!-- 工具卡片与审批卡片。曾经放在 ConversationPageShell 里，理由是
                         「聊天档角色不挂工具，那一页用不着」——但决定用不用得着的是<b>宿主</b>
                         而不是页面：子会话浮窗直接托管本控件、不经页面壳，
                         而子代理的对话主体正是工具调用，留在上面就是一片空白 -->
                    <DataTemplate DataType="{x:Type items:ToolCallItem}">
                        <items:ToolCallCardView />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type items:ApprovalRequestItem}">
                        <items:ApprovalCardView />
                    </DataTemplate>

                    <!-- 思考过程:弱化折叠条。视觉与行为都在 ThinkingCardView 里,
                         与工具卡片同一套几何(会话流与子代理过程窗口共用同一份组件) -->
                    <DataTemplate DataType="{x:Type items:ThinkingItem}">
                        <items:ThinkingCardView />
                    </DataTemplate>

                    <!-- 交接文档:模型从这条往前看不见了,默认折叠。
                         结构与思考条/工具卡同一套几何:ToggleButton(NoneStyle) 做头部,
                         文字 VerticalAlignment=Center 居中,无按压反馈——Expander 的表头内边距
                         来自 Semi 的 ControlTheme,改不动也对不准(见 ThinkingCardView) -->
                    <DataTemplate DataType="{x:Type items:HandoffItem}">
                        <Border Classes="tool-card"
                                MaxWidth="{Binding $parent[ItemsControl].Bounds.Width,
                                Converter={x:Static AddConverter.Instance},
                                ConverterParameter=-10}">
                            <StackPanel Spacing="6">
                                <ToggleButton Classes="NoneStyle" Cursor="Hand" MaxHeight="32"
                                              Background="Transparent" Padding="0"
                                              BorderThickness="0" IsChecked="{Binding IsExpanded}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="muted title-tweak"
                                                   Text="{loc:Loc HandoffHeader}"
                                                   VerticalAlignment="Center" />
                                        <ThemedSvgIcon Grid.Column="1" Width="14" Height="14"
                                                       IconName="chevron-down"
                                                       VerticalAlignment="Center" Margin="8,0,0,0">
                                            <ThemedSvgIcon.RenderTransform>
                                                <RotateTransform Angle="{Binding IsExpanded,
                                                Converter={x:Static BoolToDoubleConverter.Instance},
                                                ConverterParameter='180:0'}" />
                                            </ThemedSvgIcon.RenderTransform>
                                        </ThemedSvgIcon>
                                    </Grid>
                                </ToggleButton>
                                <SelectableTextBlock Classes="muted" IsVisible="{Binding IsExpanded}"
                                                     Text="{Binding Message}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>

                    <!-- 正在整理交接文档:完成由交接文档卡替换,失败由错误条目替换 -->
                    <DataTemplate DataType="{x:Type items:HandoffWritingItem}">
                        <Border Background="{DynamicResource SemiGrey1}" BorderBrush="{DynamicResource SemiGrey3}"
                                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,4">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <u:LoadingIcon IsLoading="True" />
                                <TextBlock Classes="muted" Text="{Binding Message}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>

                    <!-- 错误条目(两个页面通用) -->
                    <DataTemplate DataType="{x:Type items:ErrorItem}">
                        <Border Background="{DynamicResource SemiGrey1}"
                                BorderBrush="IndianRed" BorderThickness="1"
                                CornerRadius="8" Padding="10" Margin="0,4,0,4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="⚠" Foreground="IndianRed" Margin="0,0,8,0"/>
                                <SelectableTextBlock Foreground="IndianRed" Text="{Binding Message}"
                                                     TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>

                    <!-- 标准文本气泡;特型条目模板由宿主页在其资源中提供,沿逻辑树向上查找生效 -->
                    <!-- 文本气泡:与工具/审批/思考三张卡并列,各自成组件 -->
                    <DataTemplate DataType="{x:Type items:TextConversationItem}">
                        <items:TextMessageCardView />
                    </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- composer -->
        <Border Grid.Row="2" Margin="5" Padding="5" Classes="tool-row" Name="ComposerBorder">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="4">
                <!-- 附件 chips:附件盘挂在共用 VM 上,粘贴/拖入在本组件内处理,因此 chips 也内置。
                     DataContext 整体切到附件盘,下面模板里的 $parent[ItemsControl] 才拿得到它 -->
                <StackPanel Grid.Row="0">
                <StackPanel DataContext="{Binding Tray}">
                    <ItemsControl ItemsSource="{Binding Attachments}"
                                  IsVisible="{Binding Attachments.Count}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="composer:ConversationAttachment">
                                <Border Background="{DynamicResource SemiGrey2}" CornerRadius="10"
                                        Padding="6,4" Margin="0,0,6,4" MaxWidth="180">
                                    <Grid>
                                        <Button Classes="NoneStyle" Padding="0"
                                                Cursor="Hand" HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((composer:AttachmentTrayViewData)DataContext).PreviewAttachmentCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid VerticalAlignment="Center">
                                                <Image Source="{Binding Converter={StaticResource AttachmentToImageConverter}, ConverterParameter=48}"
                                                       MaxHeight="48" MaxWidth="48" Stretch="Uniform"
                                                       IsVisible="{Binding IsImage}" />
                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            IsVisible="{Binding !IsImage}"
                                                            VerticalAlignment="Center">
                                                    <ThemedSvgIcon IconName="file-text" Width="16" Height="16"
                                                                   VerticalAlignment="Center" />
                                                    <TextBlock FontSize="11" Text="{Binding FileName}"
                                                               Margin="0,3,0,0"
                                                               MaxWidth="120" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <ThemedIconButton Classes="message-action"
                                                          IconName="trash-2"
                                                          HorizontalAlignment="Right" VerticalAlignment="Top"
                                                          Margin="0,-8,-8,0"
                                                          Command="{Binding $parent[ItemsControl].((composer:AttachmentTrayViewData)DataContext).RemoveAttachmentCommand}"
                                                          CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 发图白发的警示:当前模型看不了图,角色档又没有 ViewImage 兜底(纯提示词档)。
                         只提示,不阻止发送、不替用户换模型;换视觉模型或删掉图片后自行消失 -->
                    <TextBlock Classes="muted" FontSize="11" Margin="2,0,2,2"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SemiOrange5}"
                               Text="{loc:Loc ChatImageUnreadableWarning}"
                               IsVisible="{Binding IsImageUnreadableWarningVisible}" />
                </StackPanel>
                <!-- 名下子代理的处境:等审批 / 在跑 / 跑完了压着等交回,各占一行。
                     **位置固定**是这三行共同的存在理由:通知会飘走、工具卡跑几十轮就滚没了,
                     而审批到期会按拒绝收口、那次委派白跑,报告压着时看着就像回执丢了。
                     点一行直达该档的第一个子会话;那一档空了整行消失 -->
                <ItemsControl ItemsSource="{Binding SubAgentStatuses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="conv:SubAgentStatusViewData">
                            <Button Classes="text-row" Classes.alert="{Binding IsAlert}"
                                    HorizontalAlignment="Stretch" Margin="2,0,2,4"
                                    Command="{Binding $parent[ItemsControl].((conv:ConversationViewModel)DataContext).OpenSubAgentStatusCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <u:LoadingIcon IsLoading="True" Width="12" Height="12"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding IsSpinning}" />
                                    <Border Classes="status-dot" Tag="{Binding DotTag}"
                                            IsVisible="{Binding !IsSpinning}" />
                                    <TextBlock FontSize="11" VerticalAlignment="Center"
                                               Text="{Binding Text}" />
                                    <TextBlock FontSize="11" VerticalAlignment="Center"
                                               Text="{Binding Count}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 待发的插话:已入注入队列、模型还没消费。它们不进时间轴(位置要等消费那一刻才定),
                     不列出来的话看着像没发出去 -->
                <ItemsControl ItemsSource="{Binding PendingInterjections}"
                              IsVisible="{Binding PendingInterjections.Count}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="conv:PendingInterjectionViewData">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,2,2">
                                <u:LoadingIcon IsLoading="True" Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center"
                                           Text="{loc:Loc AgentInterjectionPending}" />
                                <TextBlock FontSize="11" VerticalAlignment="Center"
                                           MaxWidth="360" TextTrimming="CharacterEllipsis"
                                           Text="{Binding Text}" ToolTip.Tip="{Binding Text}" />
                                <!-- 撤回这条插话:提示条与注入队列一起撤掉,见 RemoveInterjection -->
                                <ThemedIconButton Classes="message-action"
                                                  IconName="trash-2"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,0,2"
                                                  ToolTip.Tip="{loc:Loc InterjectionRemoveTip}"
                                                  Command="{Binding $parent[ItemsControl].((conv:ConversationViewModel)DataContext).RemoveInterjectionCommand}"
                                                  CommandParameter="{Binding Message}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>

                <!-- 宿主注入:输入框上方区域 -->
                <ContentPresenter Grid.Row="1"
                                  Content="{Binding ComposerTop, RelativeSource={RelativeSource AncestorType=conv:ConversationView}}" />

                <!-- 点名补全:整行以 / 开头且技能名未写完时弹出。上下移动、回车/Tab 采纳、Esc 收起。
                     ↑↓/Esc 在 code-behind 拦;回车与 Tab 绑在下面的 KeyBindings 上,
                     而 Avalonia 在 raise 路由事件之前就处理 KeyBindings,所以那两个键
                     是在 SendMessage/InputExtra 命令入口改道的 -->
                <Border Grid.Row="2" Padding="6" CornerRadius="8" MaxHeight="200"
                        Background="{DynamicResource SemiGrey0}"
                        BorderBrush="{DynamicResource SemiGrey2}"
                        BorderThickness="1"
                        IsVisible="{Binding Palette.IsSkillPickerOpen}">
                    <ListBox Name="SkillPicker" Classes="option-list" Focusable="False"
                             ItemsSource="{Binding Palette.SkillCandidates}"
                             SelectedIndex="{Binding Palette.SkillCandidateIndex}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="skills:SkillCatalogEntry">
                                <StackPanel Spacing="1" Margin="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Name, StringFormat='/{0}'}" />
                                        <TextBlock FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SemiBlue5}"
                                                   IsVisible="{Binding !IsModelInvocable}"
                                                   Text="{loc:Loc AgentSkillsUserInvoked}"
                                                   ToolTip.Tip="{loc:Loc AgentSkillsUserInvokedTip}" />
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource SemiGrey5}"
                                               Text="{Binding Description}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBox Grid.Row="3" Name="InputBox" Classes="composer-input"
                         Text="{Binding InputText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         PlaceholderText="{Binding InputPlaceholder}">
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding SendMessageCommand}" Gesture="Ctrl+Enter" />
                        <KeyBinding Command="{Binding SendMessageCommand}" Gesture="Meta+Enter" />
                        <KeyBinding Command="{Binding SendMessageCommand}" Gesture="Alt+Enter" />
                        <KeyBinding Command="{Binding InputExtraCommand}" Gesture="Tab" />
                    </TextBox.KeyBindings>
                </TextBox>

                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <!-- 工具行:两类会话共用,按 IsAgentSession 切换差异项;ComposerTools 槽保留给宿主追加 -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ThemedIconButton Classes="mode-state"
                                          IconName="route"
                                          Tag="{Binding ModeKey}"
                                          Command="{Binding CycleModeCommand}"
                                          ToolTips="{Binding ModeTooltip}"
                                          IsVisible="{Binding IsModeSwitchVisible}" />
                        <ThemedIconButton Classes="sender-state"
                                          IconName="{Binding SenderIconName}"
                                          Tag="{Binding SenderModeKey}"
                                          Command="{Binding ChangeSendModeCommand}"
                                          ToolTips="{Binding SenderTooltip}"
                                          IsVisible="{Binding !IsAgentSession}" />
                        <!-- 垂直分隔线 -->
                        <Rectangle Width="1" Height="16" Fill="Gray" Margin="4,0" VerticalAlignment="Center" IsVisible="{Binding !IsAgentSession}"/>

                        <ThemedIconButton Classes="permission-state"
                                          IconName="shield"
                                          Tag="{Binding PermissionModeKey}"
                                          ToolTips="{Binding PermissionTooltip}"
                                          IsVisible="{Binding IsAgentSession}">
                            <ThemedIconButton.Flyout>
                                <Flyout Placement="Top">
                                    <Border Padding="6" CornerRadius="8"
                                            Background="{DynamicResource SemiGrey0}"
                                            BorderBrush="{DynamicResource SemiGrey2}"
                                            BorderThickness="1">
                                        <ListBox Classes="option-list"
                                                 SelectedIndex="{Binding PermissionModeIndex}">
                                            <ListBoxItem>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc AgentPermissionReadOnly}" />
                                                    <TextBlock Classes="muted"
                                                               Text="{loc:Loc AgentPermissionReadOnlyDesc}" />
                                                </StackPanel>
                                            </ListBoxItem>
                                            <ListBoxItem>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc AgentPermissionAutoEdit}" />
                                                    <TextBlock Classes="muted"
                                                               Text="{loc:Loc AgentPermissionAutoEditDesc}" />
                                                </StackPanel>
                                            </ListBoxItem>
                                            <ListBoxItem>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc AgentPermissionFullAuto}" />
                                                    <TextBlock Classes="muted"
                                                               Text="{loc:Loc AgentPermissionFullAutoDesc}" />
                                                </StackPanel>
                                            </ListBoxItem>
                                        </ListBox>
                                    </Border>
                                </Flyout>
                            </ThemedIconButton.Flyout>
                        </ThemedIconButton>

                        <ThemedIconButton Classes="memory-status"
                                          IconName="database"
                                          ToolTips="{Binding MemoryPanel.MemoryTooltip}"
                                          Tag="{Binding MemoryPanel.MemoryStatusKey}"
                                          Command="{Binding MemoryPanel.MemoryEditorCommand}"
                                          IsVisible="{Binding MemoryPanel, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ThemedIconButton IconName="paperclip" Command="{Binding Tray.AddAttachmentCommand}" />
                        <ThemedIconButton IconName="settings">
                            <ThemedIconButton.Flyout>
                                <Flyout Placement="Top">
                                    <Border Padding="10"
                                            CornerRadius="8"
                                            Background="{DynamicResource SemiGrey0}"
                                            BorderBrush="{DynamicResource SemiGrey2}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <CheckBox Content="{loc:Loc ChatAutoCollapseThinking}"
                                                      IsChecked="{Binding IsAutoCollapseThinking}">
                                                <ToolTip.Tip>
                                                    <TextBlock Text="{loc:Loc ChatAutoCollapseThinkingTips}" />
                                                </ToolTip.Tip>
                                            </CheckBox>
                                            <CheckBox Content="{loc:Loc Plaintext}"
                                                      IsChecked="{Binding IsPlaintext}">
                                                <ToolTip.Tip>
                                                    <TextBlock Text="{loc:Loc ChatPlaintextTooltip}" />
                                                </ToolTip.Tip>
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </ThemedIconButton.Flyout>
                            <ToolTip.Tip>
                                <TextBlock Text="{loc:Loc SettingsWindowTitle}" />
                            </ToolTip.Tip>
                        </ThemedIconButton>
                        <!-- 宿主注入 -->
                        <ContentPresenter VerticalAlignment="Center"
                                          Content="{Binding ComposerTools, RelativeSource={RelativeSource AncestorType=conv:ConversationView}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <!-- 默认 Placement=Pointer 会把提示面板锚在光标下:这段文本在状态栏最右、
                             紧贴窗口右缘,面板宽放不下时自动翻转到左侧,正好盖在光标底下→PointerExited→
                             面板关→PointerEntered→面板开,开开关键循环就是"hover 上一直闪"。
                             改成固定 Left,面板锚在文本自身、不随光标重叠,规避该循环(Avalonia #15486/#20980) -->
                        <TextBlock Classes="muted" VerticalAlignment="Center"
                                   Text="{Binding TokenUsageText}"
                                   ToolTip.Placement="Left"
                                   IsVisible="{Binding TokenUsageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <ToolTip.Tip>
                                    <panels:ContextUsagePanel DataContext="{Binding ContextUsage}" />
                            </ToolTip.Tip>
                        </TextBlock>
                        <!-- 「没卡死,在忙别的」：整理交接文档、等 MCP 连上都走这一处。
                             文案由 BusyLabel 按 ETurnBusy 映射，再加一种不必再复制一块 StackPanel -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    IsVisible="{Binding BusyLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <!-- IsLoading 绑到 BusyLabel 而非硬编码 True:不可见时停动画,避免后台空转 -->
                            <u:LoadingIcon IsLoading="{Binding BusyLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding BusyLabel}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsGenerating}" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                            <u:LoadingIcon IsLoading="{Binding IsGenerating}" />
                            <!-- 这里曾经有一句「别处正在运行」。删了:唤醒轮之后它变成了常态
                                 (主代理那一轮由后台驱动,而用户正看着的就是这个会话),
                                 于是一句本意为"它在别的窗口跑"的话变成了对着本窗口说的废话。
                                 IsExternallyDriven 仍然保留——停止按钮与「打字走插话还是走发送」靠它 -->
                            <ThemedIconButton IconName="stop"
                                              CurrentColor="Red"
                                              Command="{Binding StopSendingCommand}"
                                              ToolTips="{loc:Loc StopGenerating}" />
                        </StackPanel>
                        <!-- 跑着的时候<b>不藏</b>发送按钮:那时它是「插话」。藏了的话中途想说一句
                             就只剩快捷键一条路,而按钮上写的字已经说明了区别 -->
                        <Button CornerRadius="10"
                                IsEnabled="{Binding InputText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Command="{Binding SendMessageCommand}"
                                Content="{Binding SendButtonText}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 拖放高亮:文件拖进会话区时整块亮起,提示往哪儿放都行。盖在一切之上但 IsHitTestVisible=False,
             不拦鼠标与拖放事件;可见性由 code-behind 按 DragOver/DragLeave/Drop 控制 -->
        <Rectangle Name="DropOverlay"
                   Grid.Row="0"
                   Grid.RowSpan="3"
                   Margin="5"
                   RadiusX="12" RadiusY="12"
                   Fill="#1F2F81F7"
                   Stroke="#2F81F7"
                   StrokeThickness="2"
                   StrokeDashArray="8,4"
                   IsHitTestVisible="False"
                   IsVisible="False" />
    </Grid>
</UserControl>
