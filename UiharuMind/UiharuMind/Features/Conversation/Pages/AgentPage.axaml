<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:UiharuMind.Features.Conversation.Pages"
             xmlns:panels="clr-namespace:UiharuMind.Features.Conversation.SidePanels"
             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="720"
             x:Class="UiharuMind.Features.Conversation.Pages.AgentPage"
             x:DataType="pages:AgentPageData">

    <Design.DataContext>
        <pages:AgentPageData />
    </Design.DataContext>

    <!-- 五列骨架、顶栏、拖条与会话列表都在壳里,这里只给三处两页不同的东西 -->
    <pages:ConversationPageShell ShowSessionAvatar="False">

        <pages:ConversationPageShell.LeftPaneHeader>
            <Grid ColumnDefinitions="*,Auto" Margin="14,12,10,8">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="{loc:Loc AgentSessions}" />
                    <TextBlock Classes="muted" Text="{loc:Loc AgentSessionsHint}" />
                </StackPanel>
                <ThemedIconButton Grid.Column="1"
                                  Command="{Binding NewSessionCommand}"
                                  IconName="file-plus-corner"
                                  ToolTips="{loc:Loc AgentNewSession}" />
            </Grid>
        </pages:ConversationPageShell.LeftPaneHeader>

        <pages:ConversationPageShell.EmptyContent>
            <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="0,90,0,0">
                <controls:ThemedSvgIcon IconName="bot" Width="52" Height="52"
                                        HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Loc AgentEmptyTitle}" FontSize="17"
                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Classes="muted" Text="{loc:Loc AgentEmptyHint}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </pages:ConversationPageShell.EmptyContent>

        <!-- 右栏:workspace + todo/定时任务 -->
        <pages:ConversationPageShell.RightPaneContent>
            <Grid RowDefinitions="Auto,*" Margin="12">
                <panels:AgentWorkspacePanel Grid.Row="0" Margin="0,0,0,10" />
                <panels:AgentSidePanel Grid.Row="1" />
            </Grid>
        </pages:ConversationPageShell.RightPaneContent>

    </pages:ConversationPageShell>
</UserControl>
