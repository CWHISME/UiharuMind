<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:items="clr-namespace:UiharuMind.Features.Conversation.Items"
        xmlns:common="clr-namespace:UiharuMind.Shared.Controls"
        xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="640"
        Width="560"
        Height="640"
        x:Class="UiharuMind.Features.Conversation.Items.SubAgentActivityWindow"
        Title="SubAgentActivityWindow">

    <!-- 工具卡片与会话流共用 ToolCallCardView 同一个组件,观感不会飘。
         正文/思考/错误则是本窗口自己的精简模板:ConversationView 那套气泡模板的
         头像、发送者、时间戳、重试编辑分叉删除对过程条目全是惰性的
         (没有 SourceMessage,CanEdit 等一律 false),且它的正文模板里有一条
         RelativeSource AncestorType=ConversationView 的绑定,搬出那个控件就失效。 -->
    <Window.Styles>
        <Style Selector="SelectableTextBlock.muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <!-- 子代理的正文:整幅宽度。
             IsPlaintext 与会话流同一口径——只看用户的纯文本开关,与是否生成完毕无关;
             绑到窗口而非直接读配置,是因为该控件的默认值恒为 true,不绑就永远渲染不出 markdown -->
        <DataTemplate DataType="items:TextConversationItem">
            <common:SimpleMarkdownViewer Margin="0,4" HorizontalAlignment="Stretch"
                                         MarkdownText="{Binding Message}"
                                         IsPlaintext="{Binding IsPlaintext,
                                         RelativeSource={RelativeSource AncestorType=items:SubAgentActivityWindow}}" />
        </DataTemplate>

        <!-- 思考段:默认折叠。与会话流里完全同一个组件,不再各写一份模板 -->
        <DataTemplate DataType="items:ThinkingItem">
            <items:ThinkingCardView />
        </DataTemplate>

        <!-- 工具调用:与会话流里完全同一个组件,不再各写一份模板。
             子代理不可递归,所以这里的卡片不会再出现「查看过程」按钮(NestedItems 恒为空) -->
        <DataTemplate DataType="items:ToolCallItem">
            <items:ToolCallCardView />
        </DataTemplate>

        <DataTemplate DataType="items:ErrorItem">
            <Border Background="{DynamicResource SemiGrey1}" BorderBrush="IndianRed" BorderThickness="1"
                    CornerRadius="6" Padding="8" Margin="0,3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="⚠" Foreground="IndianRed" Margin="0,0,8,0" />
                    <SelectableTextBlock Foreground="IndianRed" Text="{Binding Message}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*" Margin="10">
        <Border Height="34" Background="Transparent" PointerPressed="InputElement_OnPointerPressed">
            <DockPanel LastChildFill="False">
                <TextBlock Name="TitleTextBlock" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Text="{loc:Loc SubAgentActivityTitle}" />
                <Button Content="X" Classes="CircleButton" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Click="CloseButton_Click" />
            </DockPanel>
        </Border>

        <!-- 任务书在滚动区<b>内</b>:它是一段可以很长的自由文本,钉在顶部会把窗口上半截吃掉,
             而它只在开头看一眼就够了 -->
        <ScrollViewer Grid.Row="1" Name="ActivityScroll" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <SelectableTextBlock Name="TaskTextBlock" Classes="muted" TextWrapping="Wrap"
                                     Margin="0,0,0,8" />
                <ItemsControl Name="ActivityList" />
            </StackPanel>
        </ScrollViewer>
    </Grid>

</Window>
