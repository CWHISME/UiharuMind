<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:items="clr-namespace:UiharuMind.Features.Conversation.Items"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="220"
             x:Class="UiharuMind.Features.Conversation.Items.ApprovalCardView"
             x:DataType="items:ApprovalRequestItem">

    <!-- 一次工具审批的卡片。抽成组件而非各处一份模板,理由同 ToolCallCardView:
         tool-card / result-panel / diffline 原先只定义在 AgentPage 内,
         别处要用就得复制一份样式,复制的结果就是观感飘。样式随组件走,复制不出去也就飘不了。
         muted 与 mono 不必带:主题里(Assets/Themes/CustomFontStyle.axaml)已有全局定义 -->
    <UserControl.Styles>
        <!-- result-panel 与 diffline 配色已提到 Assets/Themes/CustomStatusStyle.axaml，全局共用 -->
    </UserControl.Styles>

    <!-- 只覆盖橙色告警边框,几何一律走全局 tool-card:右边曾多留 40,
         于是同一条流上的审批卡片比工具卡片窄一截 -->
    <Border Classes="tool-card"
            MaxWidth="{Binding $parent[ItemsControl].Bounds.Width,
            Converter={x:Static AddConverter.Instance},
            ConverterParameter=-10}"
            BorderBrush="{DynamicResource SemiOrange5}" BorderThickness="1.5">
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="🔐" FontSize="13" />
                <TextBlock FontWeight="SemiBold" Text="{loc:Loc AgentApprovalTitle}" />
                <TextBlock Classes="mono" VerticalAlignment="Center" Text="{Binding ToolName}" />
            </StackPanel>
            <Border Classes="result-panel"
                    IsVisible="{Binding ArgumentSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <SelectableTextBlock Classes="mono" Text="{Binding ArgumentSummary}"
                                     TextWrapping="Wrap" MaxHeight="120" />
            </Border>
            <Border Classes="result-panel" IsVisible="{Binding HasDiff}">
                <ScrollViewer MaxHeight="260"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DiffLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Classes="mono diffline"
                                           Classes.added="{Binding IsAdded}"
                                           Classes.removed="{Binding IsRemoved}">
                                    <Run Text="{Binding Prefix}" /><Run Text="{Binding Text}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsResolved}">
                <Button CornerRadius="6"
                        Command="{Binding ResolveCommand}" CommandParameter="once"
                        Content="{loc:Loc AgentApproveOnce}" />
                <Button CornerRadius="6"
                        Command="{Binding ResolveCommand}" CommandParameter="session"
                        Content="{loc:Loc AgentApproveSession}" />
                <Button CornerRadius="6"
                        IsVisible="{Binding CanRememberCommandPattern}"
                        Command="{Binding ResolveCommand}" CommandParameter="session-command"
                        Content="{loc:Loc AgentApproveSessionCommand}"
                        ToolTip.Tip="{Binding SuggestedCommandPattern}" />
                <Button CornerRadius="6" Foreground="IndianRed"
                        Command="{Binding ResolveCommand}" CommandParameter="deny"
                        Content="{loc:Loc AgentDeny}" />
            </StackPanel>
            <TextBlock Classes="muted" IsVisible="{Binding IsResolved}"
                       Text="{Binding ResolvedText}" />
        </StackPanel>
    </Border>
</UserControl>
