<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:UiharuMind.Features.Conversation"
             xmlns:otherViews="clr-namespace:UiharuMind.Features.Conversation"
             xmlns:common="clr-namespace:UiharuMind.Features.Conversation"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:convView="clr-namespace:UiharuMind.Features.Conversation"
             xmlns:chars="clr-namespace:UiharuMind.Features.Characters"
              mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="720"
              x:Class="UiharuMind.Features.Conversation.ChatPage"
                             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls">

    <Design.DataContext>
        <pages:ChatPageData />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- <Style Selector="Button.icon"> -->
        <!--     <Setter Property="Width" Value="34" /> -->
        <!--     <Setter Property="Height" Value="34" /> -->
        <!--     <Setter Property="Padding" Value="0" /> -->
        <!--     <Setter Property="HorizontalContentAlignment" Value="Center" /> -->
        <!--     <Setter Property="VerticalContentAlignment" Value="Center" /> -->
        <!-- </Style> -->
        <Style Selector="Border.workspace-pane">
            <Setter Property="Background" Value="{DynamicResource SemiGrey0}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey7}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
        </Style>
        <Style Selector="Thumb.resize-thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Margin" Value="-7" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <!-- 布局与 agent 页同构:根网格五列,左右栏直接顶到最上面,顶栏只占中间列。
         外边距不在这里给——页面宿主(MainView 的 PageHost)已经留了一圈 -->
    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Background="{DynamicResource SemiGrey0}">

        <!-- 会话列表 pane -->
        <Border Grid.Column="0"
                Classes="workspace-pane"
                Width="{Binding LeftPaneWidth, Mode=TwoWay}"
                IsVisible="{Binding IsLeftPaneOpen}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,12,10,8">
                    <StackPanel>
                        <TextBlock Classes="section-title" Text="{loc:Loc ChatSessions}" />
                        <TextBlock Classes="muted" Text="{loc:Loc ChatSessionsHint}" />
                    </StackPanel>
                    <!-- 新建会话:内联选角色,不再开模态选择窗。图标与 agent 页的新建保持一致 -->
                    <ThemedIconButton Grid.Column="1" IconName="file-plus-corner"
                                      ToolTips="{loc:Loc ChatNewSession}">
                        <ThemedIconButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight"
                                    Opening="OnNewChatCharacterPickerOpening">
                                <chars:CharacterPickerView Name="NewChatCharacterPicker" />
                            </Flyout>
                        </ThemedIconButton.Flyout>
                    </ThemedIconButton>
                </Grid>
                <otherViews:ChatListView Margin="8,0,8,8" />
            </DockPanel>
        </Border>

        <Thumb Grid.Column="1"
               Classes="resize-thumb"
               IsVisible="{Binding IsLeftPaneOpen}"
               DragDelta="OnLeftThumbDragDelta"
               Cursor="SizeWestEast">
            <Thumb.Template>
                <ControlTemplate>
                    <!-- 命中区左移:左侧紧邻滚动条,留出死区避免抢走滚动条的点击 -->
                    <Grid Background="Transparent" Margin="8,0,0,0" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- 中间列:顶栏 + 会话内容 -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*">

            <!-- ===================== 顶栏 ===================== -->
            <Border Grid.Row="0" Height="50" Padding="10,6"
                    BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,0,0,0"
                    Background="{DynamicResource SemiGrey0}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                    <ThemedIconButton Grid.Column="0"
                                      Command="{Binding ToggleLeftPaneCommand}"
                                      IsVisible="{Binding IsLeftPaneOpen}"
                                      IconName="panel-right"
                                      ToolTips="{loc:Loc ChatSessions}" />
                    <ThemedIconButton Grid.Column="0"
                                      Command="{Binding ToggleLeftPaneCommand}"
                                      IsVisible="{Binding !IsLeftPaneOpen}"
                                      IconName="panel-left"
                                      ToolTips="{loc:Loc ChatSessions}" />

                    <Border Grid.Column="1" HorizontalAlignment="Stretch">
                        <otherViews:ModelSelectComboBoxView />
                    </Border>

                    <ThemedIconButton Grid.Column="2"
                                      Command="{Binding ToggleRightPaneCommand}"
                                      IsVisible="{Binding IsRightPaneOpen}"
                                      IconName="panel-left"
                                      ToolTips="{loc:Loc ChatDetails}" />
                    <ThemedIconButton Grid.Column="2"
                                      Command="{Binding ToggleRightPaneCommand}"
                                      IsVisible="{Binding !IsRightPaneOpen}"
                                      IconName="panel-right"
                                      ToolTips="{loc:Loc ChatDetails}" />
                </Grid>
            </Border>

            <!-- 会话内容:通用组件 -->
            <Border Grid.Row="1" Classes="workspace-pane" ClipToBounds="True">
                <convView:ConversationView DataContext="{Binding Conversation}">

                    <convView:ConversationView.EmptyContent>
                        <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="0,90,0,0">
                            <controls:ThemedSvgIcon IconName="message-circle-more" Width="52" Height="52"
                                                    HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc ChatWorkspaceEmpty}" FontSize="17"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </convView:ConversationView.EmptyContent>

                </convView:ConversationView>
            </Border>
        </Grid>

        <Thumb Grid.Column="3"
               Classes="resize-thumb"
               IsVisible="{Binding IsRightPaneOpen}"
               DragDelta="OnRightThumbDragDelta"
               Cursor="SizeWestEast">
            <Thumb.Template>
                <ControlTemplate>
                    <!-- 命中区左移:左侧紧邻滚动条,留出死区避免抢走滚动条的点击 -->
                    <Grid Background="Transparent" Margin="8,0,0,0" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- 右侧栏:会话详情插件面板 -->
        <!-- 宽度上下限归 ConversationPageDataBase 的拖动方法管,这里不再另设 Min/MaxWidth:
             两处各说一套时,拖动能到 120 而布局把它按在 260,拖到底就是一段死行程 -->
        <Border Grid.Column="4"
                Classes="workspace-pane"
                Width="{Binding RightPaneWidth, Mode=TwoWay}"
                IsVisible="{Binding IsRightPaneOpen}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*" Margin="14,12,14,8">
                    <StackPanel MinWidth="0">
                        <TextBlock Classes="section-title" Text="{loc:Loc ChatDetails}" />
                        <TextBlock Classes="muted"
                                   Text="{Binding ChatListViewModel.SelectedSession.Name}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                    </StackPanel>
                </Grid>
                <common:ChatInfoView Margin="8,0,8,8" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
