<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settingViews="clr-namespace:UiharuMind.Features.Settings"
             xmlns:lang="clr-namespace:UiharuMind.Resources.Lang"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:panels="clr-namespace:UiharuMind.Features.Conversation.SidePanels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UiharuMind.Features.Conversation.SidePanels.ChatParamsPanel">

    <Design.DataContext>
        <panels:ChatParamsViewData />
    </Design.DataContext>

    <Border BorderThickness="1" BorderBrush="{DynamicResource SemiGrey2}">
        <StackPanel>
            <u:Divider Content="{loc:Loc ParameterSettings}" />
            <settingViews:SettingPanelView Padding="10,0"
                                           IsVerticleTitle="True"
                                           SettingConfig="{Binding Character.Config.ExecutionSettings}" />
        </StackPanel>
    </Border>

</UserControl>