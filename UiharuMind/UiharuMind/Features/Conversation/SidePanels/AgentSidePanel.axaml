<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:UiharuMind.Features.Conversation"
             xmlns:pages="clr-namespace:UiharuMind.Features.Conversation.Pages"
             xmlns:panels="clr-namespace:UiharuMind.Features.Conversation.SidePanels"
             xmlns:sessions="clr-namespace:UiharuMind.Features.Conversation.SessionList"
             xmlns:convs="clr-namespace:UiharuMind.Shared.Converters"
             xmlns:chars="clr-namespace:UiharuMind.Features.Characters"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="420"
             x:Class="UiharuMind.Features.Conversation.SidePanels.AgentSidePanel"
             x:DataType="pages:AgentPageData">

    <!-- 能力 / Todo / 定时任务 页签 -->
    <UserControl.Resources>
        <!-- 工具/技能/MCP 工具三处共用一行:名字占满并省略,token 靠右对齐成一列。
             token 紧跟在变长的名字后面时,长名字会把数字顶出右边界,而且数字对不齐等于没法比 -->
        <DataTemplate x:Key="CapabilityRow" x:DataType="panels:CapabilityItem">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,1">
                <TextBlock Grid.Column="0" FontSize="12" TextTrimming="CharacterEllipsis"
                           Text="{Binding Name}" ToolTip.Tip="{Binding Description}" />
                <TextBlock Grid.Column="1" Classes="muted" FontSize="10" VerticalAlignment="Center"
                           IsVisible="{Binding HasTokenCost}" Text="{Binding TokenText}" />
            </Grid>
        </DataTemplate>

        <!-- 系统提示的一段:点开看全文。这一栏存在的意义是回答「模型现在到底看得见什么」,
             而工具那半边一直是明细、提示词这半边原先连一个数都没有 -->
        <DataTemplate x:Key="PromptSegmentRow" x:DataType="panels:PromptSegmentItem">
            <!-- text-row 是全局样式(CustomButtonStyle.axaml):无 hover 底色、无最小尺寸,
                 行高与上下那些纯文本行对得上 -->
            <Button Classes="text-row" HorizontalAlignment="Stretch" Margin="0,1"
                    ToolTip.Tip="{Binding Tip}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" FontSize="12" TextTrimming="CharacterEllipsis"
                               Text="{Binding Label}" />
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="10" VerticalAlignment="Center"
                               Text="{Binding TokenText}" />
                </Grid>
                <Button.Flyout>
                    <!-- 全文可选可复制:调机时要把它跟角色卡、跟磁盘上的 AGENTS.md 对着看 -->
                    <Flyout Placement="Left">
                        <ScrollViewer MaxHeight="420" MaxWidth="520" HorizontalScrollBarVisibility="Disabled">
                            <SelectableTextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding Text}" />
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.todo-completed">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey4}" />
        </Style>
        <Style Selector="TextBlock.capability-section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
        </Style>
    </UserControl.Styles>

                <TabControl Padding="0"
                            SelectedIndex="{Binding SelectedSidePanelIndex, Mode=TwoWay}">
                    <!-- 能力:本会话实际挂上的工具/技能/MCP。只读,要改去角色编辑页 -->
                    <!-- 标题带计数:不点开也知道里面有没有东西,"默认选哪个"因此无关紧要。
                         这一个的计数要跨三个集合求和,axaml 算不了,故在 VM 里拼好 -->
                    <TabItem Header="{Binding Conversation.Capabilities.TabHeader}" FontSize="13">
                        <!-- 横向一律不滚:右栏窄,长名字用省略号收,而不是把整栏推出去 -->
                        <ScrollViewer Margin="0,6,0,0" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           IsVisible="{Binding Conversation.Capabilities.IsEmpty}"
                                           Text="{loc:Loc AgentCapabilityEmpty}" />

                                <!-- 合计已经在工作区卡片上了,这里只留超额告警 -->
                                <TextBlock FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SemiOrange5}"
                                           IsVisible="{Binding Conversation.Capabilities.IsOverBudget}"
                                           Text="{loc:Loc AgentCapabilityOverBudget}" />

                                <!-- 提示词排在最前:它通常是这几档里最大的一笔(角色卡 + 一份 AGENTS.md),
                                     而卡片上新加的那两行正指向这里,落点要在不滚动就看得见的地方 -->
                                <StackPanel Spacing="2"
                                            IsVisible="{Binding Conversation.Capabilities.HasPromptSegments}">
                                    <TextBlock Classes="capability-section" Margin="0,4,0,2"
                                               Text="{loc:Loc AgentCapabilityPrompt}"
                                               ToolTip.Tip="{loc:Loc AgentCapabilityPromptTip}" />
                                    <ItemsControl ItemsSource="{Binding Conversation.Capabilities.PromptSegments}"
                                                  ItemTemplate="{StaticResource PromptSegmentRow}" />
                                </StackPanel>

                                <!-- MCP 排在提示词之后:它是这一栏里唯一会"今天有明天没"的部分。
                                     每个 server 就是一个分节,与「系统提示 / 工具 / 技能」同构——
                                     此前它是一张带底色的圆角卡片,而这一栏其余部分都是平铺的分节:
                                     同一个列表里一半是卡片一半是清单,会被读成两类东西,而它们不是。
                                     server 名当分节标题,连计数与占用一并由 SummaryText 交代 -->
                                <ItemsControl ItemsSource="{Binding Conversation.Capabilities.McpServers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="panels:McpServerGroupItem">
                                            <StackPanel Spacing="2" Margin="0,4,0,0">
                                                <TextBlock Classes="capability-section"
                                                           Text="{Binding Name}" TextWrapping="Wrap" />
                                                <TextBlock Classes="muted" FontSize="10"
                                                           Text="{Binding SummaryText}" TextWrapping="Wrap" />
                                                <TextBlock Classes="muted" FontSize="10"
                                                           IsVisible="{Binding InstructionsInjected}"
                                                           Text="{loc:Loc AgentCapabilityMcpInstructions}" />
                                                <TextBlock Classes="muted" FontSize="10"
                                                           Foreground="{DynamicResource SemiBlue5}"
                                                           IsVisible="{Binding HasRenamedTools}"
                                                           Text="{loc:Loc AgentCapabilityMcpRenamed}"
                                                           ToolTip.Tip="{loc:Loc AgentCapabilityMcpRenamedTip}" />
                                                <ItemsControl ItemsSource="{Binding Tools}"
                                                              ItemTemplate="{StaticResource CapabilityRow}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="2"
                                            IsVisible="{Binding Conversation.Capabilities.HasTools}">
                                    <TextBlock Classes="capability-section" Margin="0,4,0,2"
                                               Text="{Binding Conversation.Capabilities.ToolsHeader}" />
                                    <ItemsControl ItemsSource="{Binding Conversation.Capabilities.Tools}"
                                                  ItemTemplate="{StaticResource CapabilityRow}" />
                                </StackPanel>

                                <StackPanel Spacing="2"
                                            IsVisible="{Binding Conversation.Capabilities.HasSkills}">
                                    <TextBlock Classes="capability-section" Margin="0,4,0,2"
                                               Text="{Binding Conversation.Capabilities.SkillsHeader}"
                                               ToolTip.Tip="{loc:Loc AgentCapabilitySkillResidentTip}" />
                                    <ItemsControl ItemsSource="{Binding Conversation.Capabilities.Skills}"
                                                  ItemTemplate="{StaticResource CapabilityRow}" />
                                </StackPanel>

                                <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"
                                           IsVisible="{Binding !Conversation.Capabilities.IsEmpty}"
                                           Text="{loc:Loc AgentCapabilityEditHint}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- 这两个的计数来自会通知的集合,直接在标题里拼即可,不必绕 VM -->
                    <TabItem FontSize="13" IsVisible="{Binding Conversation.IsTodoListVisible}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{loc:Loc AgentTodoTitle}" />
                                <TextBlock Text="{Binding Conversation.Todos.Count}"
                                           IsVisible="{Binding Conversation.HasTodos}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Classes="muted"
                                           IsVisible="{Binding !Conversation.HasTodos}"
                                           Text="{loc:Loc AgentTodoEmpty}" />
                                <ItemsControl ItemsSource="{Binding Conversation.Todos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="conv:TodoDisplayItem">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3">
                                                <TextBlock Text="{Binding StatusGlyph}" FontSize="12"
                                                           Foreground="{DynamicResource SemiBlue5}" />
                                                <TextBlock Text="{Binding Content}" FontSize="12"
                                                           TextWrapping="Wrap" MaxWidth="220"
                                                           Classes.todo-completed="{Binding IsCompleted}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem FontSize="13">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{loc:Loc AgentScheduledTitle}" />
                                <TextBlock Text="{Binding Scheduled.Tasks.Count}"
                                           IsVisible="{Binding Scheduled.Tasks.Count}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Classes="muted"
                                           IsVisible="{Binding !Scheduled.Tasks.Count}"
                                           Text="{loc:Loc AgentScheduledEmpty}" />
                                <ItemsControl ItemsSource="{Binding Scheduled.Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sessions:ScheduledTaskDisplayItem">
                                            <Border Background="{DynamicResource SemiGrey1}"
                                                    CornerRadius="8" Padding="10,8" Margin="0,3">
                                                <StackPanel Spacing="4">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                                               Text="{Binding DisplayName}"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Classes="muted"
                                                                   Text="{Binding FireAtText}" />
                                                        <TextBlock Classes="muted"
                                                                   Text="{Binding StatusText}" />
                                                        <!-- 跑过的任务只显示当时那一档(改不动了),没跑的用下面的下拉选 -->
                                                        <TextBlock Classes="muted"
                                                                   IsVisible="{Binding !CanEditPermission}"
                                                                   Text="{Binding PermissionText}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <!-- 三档选择:与设置页「默认权限档」同一形状、同一套文案,
                                                             无人值守跑的就是这一档 -->
                                                        <ComboBox FontSize="10" Padding="6,2" CornerRadius="5"
                                                                  MinHeight="0" VerticalAlignment="Center"
                                                                  IsVisible="{Binding CanEditPermission}"
                                                                  SelectedIndex="{Binding PermissionModeIndex}"
                                                                  ToolTip.Tip="{loc:Loc AgentTaskPermission}">
                                                            <ComboBoxItem Content="{loc:Loc AgentPermissionReadOnly}" />
                                                            <ComboBoxItem Content="{loc:Loc AgentPermissionAutoEdit}" />
                                                            <ComboBoxItem Content="{loc:Loc AgentPermissionFullAuto}" />
                                                        </ComboBox>
                                                        <Button FontSize="10" Padding="6,2" CornerRadius="5"
                                                                IsVisible="{Binding CanRunNow}"
                                                                Command="{Binding $parent[TabControl].((pages:AgentPageData)DataContext).Scheduled.RunTaskNowCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="{loc:Loc AgentTaskRunNow}" />
                                                        <Button FontSize="10" Padding="6,2" CornerRadius="5"
                                                                IsVisible="{Binding CanCancel}"
                                                                Command="{Binding $parent[TabControl].((pages:AgentPageData)DataContext).Scheduled.CancelTaskCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="{loc:Loc AgentTaskCancel}" />
                                                        <Button FontSize="10" Padding="6,2" CornerRadius="5"
                                                                IsVisible="{Binding HasResultSession}"
                                                                Command="{Binding $parent[TabControl].((pages:AgentPageData)DataContext).Scheduled.OpenTaskSessionCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="{loc:Loc AgentTaskOpenSession}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
</UserControl>
