<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:UiharuMind.Features.Services"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="760"
             x:Class="UiharuMind.Features.Services.ServicesPage"
             x:DataType="pages:ServicesPageData">

    <Design.DataContext>
        <pages:ServicesPageData />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.service-card">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey2}" />
            <Setter Property="Background" Value="{DynamicResource SemiGrey0}" />
        </Style>
        <Style Selector="Border.overview-card">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey2}" />
            <Setter Property="Background" Value="{DynamicResource SemiGrey0}" />
        </Style>
        <Style Selector="Border.overview-card[Tag=Success]">
            <Setter Property="BorderBrush" Value="{DynamicResource MessageStatusSuccessBrush}" />
        </Style>
        <Style Selector="Border.overview-card[Tag=Progress]">
            <Setter Property="BorderBrush" Value="{DynamicResource MessageStatusInfoBrush}" />
        </Style>
        <Style Selector="Border.overview-card[Tag=Warning]">
            <Setter Property="BorderBrush" Value="{DynamicResource MessageStatusWarningBrush}" />
        </Style>
        <Style Selector="Border.overview-card[Tag=Danger]">
            <Setter Property="BorderBrush" Value="{DynamicResource MessageStatusErrorBrush}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey6}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBox.compact">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,14,22,24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc ServicesPageTitle}"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc ServicesPageSubtitle}"
                           Foreground="{DynamicResource SemiGrey6}" />
            </StackPanel>

            <UniformGrid Columns="4" Rows="1">
                <Border Classes="overview-card" Tag="{Binding ChatStatusKey}" Margin="0,0,10,0">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{loc:Loc ServicesChatModelService}" Classes="muted" />
                        <ToggleSwitch Grid.Column="1"
                                      Grid.RowSpan="3"
                                      VerticalAlignment="Top"
                                      IsChecked="{Binding IsChatEnabled}"
                                      IsEnabled="{Binding ChatCanToggle}" />
                        <TextBlock Grid.Row="1" Text="{Binding ChatStatusText}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Text="{Binding ChatRunningCount}" Classes="muted" />
                    </Grid>
                </Border>

                <Border Classes="overview-card" Tag="{Binding EmbeddingStatusKey}" Margin="0,0,10,0">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{loc:Loc ServicesEmbeddingModelService}" Classes="muted" />
                        <ToggleSwitch Grid.Column="1"
                                      Grid.RowSpan="3"
                                      VerticalAlignment="Top"
                                      IsChecked="{Binding IsEmbeddingEnabled}"
                                      IsEnabled="{Binding !IsEmbeddingBusy}" />
                        <TextBlock Grid.Row="1" Text="{Binding EmbeddingStatusText}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2"
                                   Text="{Binding EmbeddingConfiguredModelDisplay}"
                                   ToolTip.Tip="{Binding EmbeddingConfiguredModelPath}"
                                   Classes="muted"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <Border Classes="overview-card" Margin="0,0,10,0">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Text="{loc:Loc ServicesRuntimeBackendService}" Classes="muted" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding RuntimeVersionName}"
                                   ToolTip.Tip="{Binding RuntimeVersionName}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2"
                                   Text="{Binding RuntimePath}"
                                   ToolTip.Tip="{Binding RuntimePath}"
                                   Classes="muted"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <Border Classes="overview-card">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Text="{loc:Loc ServicesRemoteApiService}" Classes="muted" />
                        <TextBlock Grid.Row="1" Text="{Binding RemoteModelCount}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2"
                                   Text="{Binding FavoriteModel}"
                                   Classes="muted"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </UniformGrid>

            <Grid ColumnDefinitions="0.95*,1.45*" ColumnSpacing="16">
                <StackPanel Spacing="14">
                    <Border Classes="service-card">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{loc:Loc ServicesChatRuntimeDetails}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Loc ServicesChatRuntimeDetailsDesc}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                <TextBlock Text="{loc:Loc ServicesCurrentModel}" Classes="muted" />
                                <TextBlock Grid.Column="1" Text="{Binding ChatCurrentModel}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Text="{loc:Loc ServicesBackend}" Classes="muted" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChatBackend}" />

                                <TextBlock Grid.Row="2" Text="{Binding ChatEndpointOrPathLabel}" Classes="muted" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding ChatModelPath}"
                                           ToolTip.Tip="{Binding ChatModelPath}"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="3" Text="{loc:Loc ServicesModelCount}" Classes="muted" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ChatModelCount}" />
                            </Grid>

                            <ProgressBar IsVisible="{Binding ChatIsLoading}"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ChatLoadingPercent}" />

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Classes="compact"
                                        Content="{loc:Loc ServicesReload}"
                                        Command="{Binding ReloadChatModelCommand}"
                                        IsEnabled="{Binding ChatCanReload}" />
                                <Button Classes="compact"
                                        Content="{loc:Loc ServicesGoToModelPage}"
                                        Command="{Binding GoToModelPageCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="service-card">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{loc:Loc ServicesDeviceResourceTitle}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Loc ServicesDeviceResourceDesc}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                <TextBlock Text="{loc:Loc ServicesDeviceCpuUsage}" Classes="muted" />
                                <TextBlock Grid.Column="1" Text="{Binding DeviceCpuUsageText}" />

                                <TextBlock Grid.Row="1" Text="{loc:Loc ServicesDeviceMemory}" Classes="muted" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceMemoryText}" />

                                <TextBlock Grid.Row="2" Text="{loc:Loc ServicesDeviceCpu}" Classes="muted" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding DeviceCpuName}"
                                           ToolTip.Tip="{Binding DeviceCpuName}"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="3" Text="{loc:Loc ServicesDeviceGpu}" Classes="muted" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{Binding DeviceGpuName}"
                                           ToolTip.Tip="{Binding DeviceGpuName}"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="4" Text="{loc:Loc ServicesDeviceGpuMemory}" Classes="muted" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           Text="{Binding DeviceGpuMemoryText}"
                                           ToolTip.Tip="{Binding DeviceGpuMemoryNote}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="service-card">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{loc:Loc ServicesEmbeddingRuntimeDetails}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Loc ServicesEmbeddingRuntimeDetailsDesc}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                <TextBlock Text="{loc:Loc ServicesEmbeddingSource}" Classes="muted" />
                                <TextBlock Grid.Column="1" Text="{Binding EmbeddingConfiguredSourceText}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Text="{loc:Loc ServicesConfiguredModel}" Classes="muted" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding EmbeddingConfiguredModelPath}"
                                           ToolTip.Tip="{Binding EmbeddingConfiguredModelPath}"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="2" Text="{loc:Loc ServicesBackend}" Classes="muted" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EmbeddingRuntimeBackend}" />

                                <TextBlock Grid.Row="3" Text="{loc:Loc ServicesRuntimeModel}" Classes="muted" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{Binding EmbeddingRuntimeModelPath}"
                                           ToolTip.Tip="{Binding EmbeddingRuntimeModelPath}"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="4" Text="{loc:Loc ServicesDimensions}" Classes="muted" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EmbeddingDimensionsText}" />

                                <TextBlock Grid.Row="5" Text="{loc:Loc ServicesLastStarted}" Classes="muted" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding EmbeddingLastStartedText}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="service-card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:Loc ServicesRecentIssue}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding EmbeddingLastError}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Classes="service-card">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <StackPanel Spacing="4" VerticalAlignment="Top">
                                    <TextBlock Text="{loc:Loc ServicesEmbeddingConfiguration}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Loc ServicesEmbeddingSettingsDesc}"
                                               Classes="muted"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          MinWidth="150"
                                          MaxWidth="190"
                                          VerticalAlignment="Top"
                                          ItemsSource="{Binding EmbeddingSourceModeOptions}"
                                          SelectedItem="{Binding SelectedEmbeddingSourceMode}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="pages:EmbeddingSourceModeOption">
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Border IsVisible="{Binding IsLocalEmbeddingSource}"
                                    BorderBrush="{DynamicResource SemiGrey2}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding SelectedEmbeddingSourceMode.Description}" Classes="muted" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ManagedEmbeddingSummaryText}" Classes="muted" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                        <TextBlock Text="{loc:Loc ServicesBackend}"
                                                   Classes="muted"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="160"
                                                  HorizontalAlignment="Left"
                                                  ItemsSource="{Binding LocalEmbeddingBackendOptions}"
                                                  SelectedItem="{Binding SelectedLocalEmbeddingBackend}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="pages:EmbeddingBackendOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="{loc:Loc ServicesConfiguredModel}"
                                                   Grid.Row="1"
                                                   Classes="muted"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="1"
                                                  Grid.Column="1"
                                                  ItemsSource="{Binding ManagedEmbeddingModels}"
                                                  SelectedItem="{Binding SelectedManagedEmbeddingModel}"
                                                  MaxDropDownHeight="280"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="pages:EmbeddingModelCandidateViewData">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="4">
                                                        <TextBlock Text="{Binding Name}"
                                                                   ToolTip.Tip="{Binding Path}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding SizeText}"
                                                                   Classes="muted"
                                                                   Margin="12,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding SelectedManagedEmbeddingModel.SourceText}"
                                                       Classes="muted" />
                                            <TextBlock Text="{Binding SelectedManagedEmbeddingModel.Path}"
                                                       ToolTip.Tip="{Binding SelectedManagedEmbeddingModel.Path}"
                                                       Classes="muted"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding ManagedEmbeddingEmptyText}"
                                               Classes="muted"
                                               IsVisible="{Binding NoManagedEmbeddingModels}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Classes="compact"
                                                Content="{loc:Loc ServicesRefreshModels}"
                                                Command="{Binding RefreshManagedEmbeddingModelListCommand}" />
                                        <Button Classes="compact"
                                                Content="{loc:Loc ServicesSelectFolder}"
                                                Command="{Binding SelectEmbeddingFolderCommand}" />
                                        <Button Classes="compact"
                                                Content="{loc:Loc ServicesOpenFolder}"
                                                Command="{Binding OpenEmbeddingFolderCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border IsVisible="{Binding IsRemoteApiSource}"
                                    BorderBrush="{DynamicResource SemiGrey2}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding SelectedEmbeddingSourceMode.Description}" Classes="muted" TextWrapping="Wrap" />
                                    <TextBox Classes="compact"
                                             PlaceholderText="{loc:Loc ServicesRemoteEndpoint}"
                                             Text="{Binding EmbeddingRemoteEndpoint}" />
                                    <TextBox Classes="compact"
                                             PlaceholderText="{loc:Loc ServicesRemoteModelId}"
                                             Text="{Binding EmbeddingRemoteModelId}" />
                                    <TextBox Classes="compact"
                                             PasswordChar="*"
                                             PlaceholderText="{loc:Loc ServicesRemoteApiKey}"
                                             Text="{Binding EmbeddingRemoteApiKey}" />
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource SemiGrey2}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{loc:Loc ServicesEmbeddingAdvanced}" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Loc ServicesEmbeddingAdvancedDesc}" Classes="muted" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{loc:Loc ServicesContextSize}" FontWeight="SemiBold" />
                                            <TextBlock Text="{loc:Loc ServicesContextSizeDesc}" Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1"
                                                 Classes="compact"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding EmbeddingContextSize}" />

                                        <StackPanel Grid.Row="1" Spacing="2">
                                            <TextBlock Text="{loc:Loc ServicesBatchSize}" FontWeight="SemiBold" />
                                            <TextBlock Text="{loc:Loc ServicesBatchSizeDesc}" Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Classes="compact"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding EmbeddingBatchSize}" />

                                        <StackPanel Grid.Row="2" Spacing="2">
                                            <TextBlock Text="{loc:Loc ServicesUBatchSize}" FontWeight="SemiBold" />
                                            <TextBlock Text="{loc:Loc ServicesUBatchSizeDesc}" Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBox Grid.Row="2"
                                                 Grid.Column="1"
                                                 Classes="compact"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding EmbeddingUBatchSize}" />

                                        <StackPanel Grid.Row="3" Spacing="2">
                                            <TextBlock Text="{loc:Loc ServicesGpuLayers}" FontWeight="SemiBold" />
                                            <TextBlock Text="{loc:Loc ServicesGpuLayersDesc}" Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBox Grid.Row="3"
                                                 Grid.Column="1"
                                                 Classes="compact"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding EmbeddingGpuLayers}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Classes="compact"
                                                Content="{loc:Loc ServicesSaveSettings}"
                                                Command="{Binding SaveEmbeddingSettingsCommand}" />
                                        <Button Classes="compact"
                                                Content="{loc:Loc ServicesRestart}"
                                                Command="{Binding RestartEmbeddingCommand}"
                                                IsEnabled="{Binding !IsEmbeddingBusy}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
