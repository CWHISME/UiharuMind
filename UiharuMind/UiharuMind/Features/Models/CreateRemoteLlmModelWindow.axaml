<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:UiharuMind.Features.Models"
        xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
        xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
        xmlns:u="https://irihi.tech/ursa"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="620"
        x:Class="UiharuMind.Features.Models.CreateRemoteLlmModelWindow"
        Width="860"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc RemoteModelWindowTitle}">

    <Design.DataContext>
        <common:CreateRemoteLlmModelWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.error">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MessageStatusErrorBrush}" />
        </Style>
        <Style Selector="Button.copy-chip">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SemiGrey0}">

        <!-- 头部:图标 + 标题 -->
        <Border Padding="18,15" BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="50,*" ColumnSpacing="12">
                <Border Width="50" Height="50" CornerRadius="8"
                        Background="{DynamicResource SemiBlue0}">
                    <controls:ThemedSvgIcon Width="24" Height="24" IconName="bot" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{loc:Loc RemoteModelCreateTitle}" FontSize="20" FontWeight="SemiBold"
                               IsVisible="{Binding !IsEditMode}" />
                    <TextBlock Text="{loc:Loc RemoteModelEditTitle}" FontSize="20" FontWeight="SemiBold"
                               IsVisible="{Binding IsEditMode}" />
                    <TextBlock Text="{loc:Loc RemoteModelSelectProviderHint}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding !IsEditMode}" />
                    <TextBlock Text="{loc:Loc RemoteModelConfigHint}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding IsEditMode}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体:左侧服务商列表 / 右侧配置详情 -->
        <Grid Grid.Row="1" ColumnDefinitions="230,*">

            <Border BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="{loc:Loc RemoteModelSelectProviderTitle}" FontWeight="SemiBold"
                               Margin="16,14,16,8" />
                    <ListBox Grid.Row="1" Background="Transparent"
                             ItemsSource="{Binding Providers}"
                             SelectedItem="{Binding SelectedProvider}"
                             IsEnabled="{Binding !IsEditMode}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DefaultEndpoint}" Classes="muted"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding DefaultEndpoint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Margin="18" Spacing="14">

                    <!-- 当前服务商下的已有模型:一键复制 -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasCopySources}">
                        <TextBlock Text="{loc:Loc RemoteModelCopyFromExisting}" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc RemoteModelCopyFromExistingHint}" Classes="muted"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding CopySources}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="copy-chip" Margin="0,0,8,8"
                                            Content="{Binding ModelName}"
                                            ToolTip.Tip="{Binding ModelPath}"
                                            Command="{Binding DataContext.SelectCopySourceCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc RemoteModelNameLabel}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding ModelName}"
                                 PlaceholderText="{loc:Loc RemoteModelNamePlaceholder}" />
                        <TextBlock Text="{loc:Loc RemoteModelNameHint}" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock Classes="error" Text="{loc:Loc NotInputModelNameTips}"
                                   IsVisible="{Binding HasNameError}" />
                        <TextBlock Classes="error" Text="{loc:Loc RepeatModelNameTips}"
                                   IsVisible="{Binding HasDuplicateNameError}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc RemoteModelIdLabel}" FontWeight="SemiBold" />
                        <ComboBox IsEditable="True"
                                  ItemsSource="{Binding ModelIdOptions}"
                                  SelectedItem="{Binding SelectedModelIdOption}"
                                  Text="{Binding ModelId}"
                                  PlaceholderText="{loc:Loc RemoteModelIdPlaceholder}"
                                  HorizontalAlignment="Stretch"
                                  IsVisible="{Binding HasModelIdOptions}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Id}" VerticalAlignment="Center" />
                                        <u:Badge Header="{loc:Loc ModelStateVision}" Background="Gold"
                                                 IsVisible="{Binding IsVision}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Text="{Binding ModelId}"
                                 PlaceholderText="{loc:Loc RemoteModelIdPlaceholder}"
                                 IsVisible="{Binding !HasModelIdOptions}" />
                        <TextBlock Text="{loc:Loc RemoteModelIdHint}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc RemoteModelContextLengthLabel}" FontWeight="SemiBold" />
                        <ComboBox IsEditable="True"
                                  ItemsSource="{Binding ContextLengthOptions}"
                                  Text="{Binding ContextLengthText}"
                                  PlaceholderText="{loc:Loc RemoteModelContextLengthPlaceholder}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Text="{loc:Loc RemoteModelContextLengthHint}" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock Classes="error" Text="{loc:Loc RemoteModelContextLengthInvalid}"
                                   IsVisible="{Binding HasContextLengthError}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc ApiKey}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding ApiKey}" PasswordChar="*"
                                 PlaceholderText="{loc:Loc RemoteModelApiKeyPlaceholder}" />
                        <TextBlock Text="{loc:Loc RemoteModelApiKeyHint}" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock Classes="error" Text="{loc:Loc NotInputModelApiKey}"
                                   IsVisible="{Binding HasApiKeyError}" />
                    </StackPanel>

                    <!-- 自定义配置:接口地址等全部平铺 -->
                    <StackPanel Spacing="14" IsVisible="{Binding !IsPresetProvider}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc RemoteModelPathLabel}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding ModelPath}"
                                     PlaceholderText="{loc:Loc RemoteModelPathPlaceholder}" />
                            <TextBlock Text="{loc:Loc RemoteModelPathHint}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc RemoteModelDescriptionLabel}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding ModelDescription}" MinHeight="80" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10"
                                     PlaceholderText="{loc:Loc RemoteModelDescriptionPlaceholder}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc RemoteModelVisionLabel}" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Loc RemoteModelVisionHint}" Classes="muted"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsChecked="{Binding IsVision}"
                                          IsEnabled="{Binding IsVisionEditable}" />
                        </Grid>
                    </StackPanel>

                    <!-- 预设服务商:默认参数收进高级设置 -->
                    <Expander Header="{loc:Loc RemoteModelAdvancedSettings}"
                              HorizontalAlignment="Stretch"
                              IsVisible="{Binding IsPresetProvider}">
                        <StackPanel Spacing="14" Margin="0,8,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc RemoteModelPathLabel}" FontWeight="SemiBold" />
                                <TextBox Text="{Binding ModelPath}"
                                         PlaceholderText="{loc:Loc RemoteModelPathPlaceholder}" />
                                <TextBlock Text="{loc:Loc RemoteModelPathHint}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc RemoteModelDescriptionLabel}" FontWeight="SemiBold" />
                                <TextBox Text="{Binding ModelDescription}" MinHeight="80" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10"
                                         PlaceholderText="{loc:Loc RemoteModelDescriptionPlaceholder}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc RemoteModelVisionLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Loc RemoteModelVisionHint}" Classes="muted"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                              IsChecked="{Binding IsVision}"
                                              IsEnabled="{Binding IsVisionEditable}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部按钮条 -->
        <Border Grid.Row="2" Padding="14" BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Loc CancelBtn}" Click="CancelButton_Click" />
                <Button IsEnabled="{Binding CanConfirm}" Click="ConfirmButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:ThemedSvgIcon Width="15" Height="15" IconName="save" />
                        <TextBlock Text="{loc:Loc CreateBtn}" IsVisible="{Binding !IsEditMode}" />
                        <TextBlock Text="{loc:Loc SaveBtn}" IsVisible="{Binding IsEditMode}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
