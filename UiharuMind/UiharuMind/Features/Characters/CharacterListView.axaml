<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewData="clr-namespace:UiharuMind.Features.Characters"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:character="clr-namespace:UiharuMind.Core.AI.Character;assembly=UiharuMind.Core"
              mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="620"
              x:Class="UiharuMind.Features.Characters.CharacterListView"
                             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls">

    <Design.DataContext>
        <viewData:CharacterListViewData />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SemiBlue0}" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- 头部压成一行:窄栏塞不下"筛选四个胶囊 + 两个开关 + 一行说明"。
             低频的那些(筛选/导入/显示内部角色)收进溢出菜单,高频的搜索与新建留在面上 -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,8">
            <TextBox Text="{Binding SearchKeyword}"
                     Watermark="{loc:Loc CharacterSearchPlaceholder}"
                     VerticalAlignment="Center" />

            <ThemedIconButton Grid.Column="1" Classes="icon" IconName="file-plus-corner"
                              ToolTips="{loc:Loc CreateBtn}">
                <!-- 新建先定档:三档的表单面孔差得太多,进去再翻旗标不好使 -->
                <ThemedIconButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="{loc:Loc CharacterKindRoleplay}"
                                  Command="{Binding NewCharacterCommand}"
                                  CommandParameter="{x:Static character:ECharacterKind.Roleplay}" />
                        <MenuItem Header="{loc:Loc CharacterKindTool}"
                                  Command="{Binding NewCharacterCommand}"
                                  CommandParameter="{x:Static character:ECharacterKind.Tool}" />
                        <MenuItem Header="{loc:Loc CharacterKindAgent}"
                                  Command="{Binding NewCharacterCommand}"
                                  CommandParameter="{x:Static character:ECharacterKind.Agent}" />
                    </MenuFlyout>
                </ThemedIconButton.Flyout>
            </ThemedIconButton>

            <ThemedIconButton Grid.Column="2" Classes="icon" IconName="ellipsis"
                              ToolTips="{loc:Loc MoreActions}">
                <ThemedIconButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <!-- 档位子菜单在代码后置里填:选项来自 FilterTags,且要标出当前选中的那一档 -->
                        <MenuItem Name="FilterMenuItem" Header="{loc:Loc Filter}" />
                        <MenuItem Header="{loc:Loc ImportBtn}" Command="{Binding ImportCharacterCommand}" />
                        <!-- IsChecked 默认是 OneWay,不写 TwoWay 的话勾了也回不到视图模型 -->
                        <MenuItem Header="{loc:Loc CharacterShowInternal}"
                                  ToggleType="CheckBox"
                                  IsChecked="{Binding IsDisplayAllCharacters, Mode=TwoWay}" />
                    </MenuFlyout>
                </ThemedIconButton.Flyout>
            </ThemedIconButton>
        </Grid>

        <ListBox Name="CharacterListBox"
                 ItemsSource="{Binding Characters}"
                 SelectedItem="{Binding SelectedCharacter}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="viewData:CharacterInfoViewData">
                    <Border Padding="8,6">
                        <Border.ContextMenu>
                            <!-- 没有「编辑」:选中即在右边编辑,再放一项只是重复 -->
                            <ContextMenu>
                                <MenuItem Header="{loc:Loc StartChat}" Command="{Binding StartChatCommand}" />
                                <MenuItem Header="{loc:Loc Copy}" Command="{Binding CopyCharacterCommand}" />
                                <MenuItem Header="{loc:Loc Delete}" Command="{Binding DeleteCharacterCommand}" />
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Ellipse Width="32" Height="32"
                                     VerticalAlignment="Center"
                                     Stroke="{DynamicResource SemiGrey2}"
                                     StrokeThickness="1">
                                <Ellipse.Fill>
                                    <ImageBrush Source="{Binding Icon}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource SemiGrey7}" />
                                    <u:Badge Grid.Column="1" Header="{Binding KindName}"
                                             Background="{Binding KindColor}" />
                                </Grid>
                                <TextBlock Classes="muted"
                                           Text="{Binding Description}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
