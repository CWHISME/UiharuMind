<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:settingViews="clr-namespace:UiharuMind.Features.Settings"
             xmlns:viewData="clr-namespace:UiharuMind.Features.Characters"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
              mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="720"
              x:Class="UiharuMind.Features.Characters.CharacterEditView"
                             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls">

    <Design.DataContext>
        <viewData:CharacterInfoViewData />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="Padding" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.edit-card">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="TextBlock.card-title">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey7}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
        </Style>
        <Style Selector="SelectableTextBlock">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey6}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Name="EditScrollViewer" BringIntoViewOnFocusChange="False">
        <StackPanel Spacing="12" Margin="14">
            <Border Name="BasicInfoSection" Classes="edit-card">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Width="96" Height="132" CornerRadius="8" ClipToBounds="True"
                            BorderBrush="{DynamicResource SemiGrey2}"
                            BorderThickness="1">
                        <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Classes="card-title" Text="{loc:Loc EditorBasicInfo}" />
                        <TextBox Text="{Binding Name}" PlaceholderText="{loc:Loc CharacterName}" />
                        <TextBox Text="{Binding Description}"
                                 PlaceholderText="{loc:Loc CharacterDesc}"
                                 MinHeight="72"
                                 AcceptsReturn="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Name="FunctionTypeSection" Classes="edit-card" IsEnabled="{Binding !IsDefault}">
                <StackPanel Spacing="10">
                    <TextBlock Classes="card-title" Text="{loc:Loc CharacterFuncType}" />
                    <!-- 档位是角色的唯一身份轴:决定表单长什么样、装不装工具、出现在哪一页 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox Width="180"
                                  ItemsSource="{Binding SelectableKinds}"
                                  SelectedItem="{Binding Kind}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static viewData:CharacterKindNameConverter.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <controls:ThemedSvgIcon Width="16" Height="16" IconName="info"
                                                VerticalAlignment="Center">
                            <ToolTip.Tip>
                                <TextBlock Text="{loc:Loc CharacterKindDesc}" FontSize="14"
                                           MaxWidth="360" TextWrapping="Wrap" />
                            </ToolTip.Tip>
                        </controls:ThemedSvgIcon>
                    </StackPanel>
                    <!-- 用户卡是单例、活引用:改了用户卡,所有开着这个开关的角色下一轮跟着变 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRoleplay}">
                        <CheckBox IsChecked="{Binding InjectUserCard}"
                                  Content="{loc:Loc CharacterInjectUserCard}" />
                        <controls:ThemedSvgIcon Width="16" Height="16" IconName="info"
                                                VerticalAlignment="Center">
                            <ToolTip.Tip>
                                <TextBlock Text="{loc:Loc CharacterInjectUserCardDesc}" FontSize="14"
                                           MaxWidth="360" TextWrapping="Wrap" />
                            </ToolTip.Tip>
                        </controls:ThemedSvgIcon>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 以下三块只对智能体档:它们描述"这个智能体有什么能力" -->
            <Border Name="ToolsSection" Classes="edit-card" IsVisible="{Binding IsAgent}">
                <StackPanel Spacing="10">
                    <TextBlock Classes="card-title" Text="{loc:Loc CharacterToolsTitle}" />
                    <TextBlock Classes="muted" Text="{loc:Loc CharacterToolsDesc}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding AgentTools.Toggles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewData:AgentToolToggle">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                    <ToggleSwitch IsChecked="{Binding IsEnabled}" MinWidth="0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding Description}" />
                                    <!-- 关掉这一档能省多少:开关旁边才是这个数字有用的地方 -->
                                    <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center"
                                               Text="{Binding TokenText}"
                                               ToolTip.Tip="{loc:Loc CharacterCapabilityTokenTip}" />
                                    <controls:ThemedSvgIcon Width="14" Height="14" IconName="info"
                                                            VerticalAlignment="Center">
                                        <ToolTip.Tip>
                                            <TextBlock Text="{Binding Description}" FontSize="14"
                                                       MaxWidth="360" TextWrapping="Wrap" />
                                        </ToolTip.Tip>
                                    </controls:ThemedSvgIcon>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Name="SkillsSection" Classes="edit-card" IsVisible="{Binding IsAgent}">
                <StackPanel Spacing="10">
                    <TextBlock Classes="card-title" Text="{loc:Loc CharacterSkillsTitle}" />
                    <TextBlock Classes="muted" Text="{loc:Loc CharacterSkillsDesc}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{loc:Loc CharacterSkillsEmpty}"
                               IsVisible="{Binding AgentTools.HasNoSkills}" />
                    <ItemsControl ItemsSource="{Binding AgentTools.Skills}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewData:AgentSkillToggle">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                                    <CheckBox IsChecked="{Binding IsEnabled}" IsEnabled="{Binding IsLoaded}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                       Text="{Binding TokenText}"
                                                       ToolTip.Tip="{loc:Loc CharacterSkillTokenTip}" />
                                            <TextBlock FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SemiBlue5}"
                                                       IsVisible="{Binding IsUserInvokedOnly}"
                                                       Text="{loc:Loc AgentSkillsUserInvoked}"
                                                       ToolTip.Tip="{loc:Loc AgentSkillsUserInvokedTip}" />
                                            <TextBlock FontSize="11" VerticalAlignment="Center"
                                                       Foreground="IndianRed"
                                                       IsVisible="{Binding !IsLoaded}"
                                                       Text="{loc:Loc AgentSkillsNotLoaded}" />
                                        </StackPanel>
                                        <TextBlock Classes="muted" Text="{Binding Description}"
                                                   TextWrapping="Wrap" MaxLines="2" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Name="McpSection" Classes="edit-card" IsVisible="{Binding IsAgent}">
                <StackPanel Spacing="10">
                    <TextBlock Classes="card-title" Text="{loc:Loc CharacterMcpTitle}" />
                    <TextBlock Classes="muted" Text="{loc:Loc CharacterMcpDesc}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{loc:Loc CharacterMcpEmpty}"
                               IsVisible="{Binding AgentTools.HasNoMcpServers}" />
                    <ItemsControl ItemsSource="{Binding AgentTools.McpServers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewData:AgentMcpServerToggle">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                                    <CheckBox IsChecked="{Binding IsEnabled}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SemiGrey5}"
                                                       Text="{Binding ToolCount, StringFormat='{}{0} tools'}" />
                                            <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                       Text="{Binding TokenText}"
                                                       ToolTip.Tip="{loc:Loc CharacterCapabilityTokenTip}" />
                                            <TextBlock FontSize="11" VerticalAlignment="Center"
                                                       Foreground="IndianRed"
                                                       IsVisible="{Binding !IsHosted}"
                                                       Text="{loc:Loc CharacterMcpNotHosted}"
                                                       ToolTip.Tip="{loc:Loc CharacterMcpNotHostedTip}" />
                                        </StackPanel>
                                        <TextBlock Classes="muted" Text="{Binding Description}"
                                                   TextWrapping="Wrap" MaxLines="2" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Name="SubAgentsSection" Classes="edit-card" IsVisible="{Binding IsAgent}">
                <StackPanel Spacing="10">
                    <TextBlock Classes="card-title" Text="{loc:Loc CharacterSubAgentsTitle}" />
                    <TextBlock Classes="muted" Text="{loc:Loc CharacterSubAgentsDesc}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding SubAgents}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewData:MountedAgentItem">
                                <Border Background="{DynamicResource SemiBlue0}"
                                        BorderBrush="{DynamicResource SemiBlue3}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,3,6,3" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SemiBlue7}" />
                                        <ThemedIconButton Classes="message-action" IconName="trash-2"
                                                          VerticalAlignment="Center"
                                                          ToolTips="{loc:Loc CharacterSubAgentsRemove}"
                                                          Command="{Binding $parent[ItemsControl].((viewData:CharacterInfoViewData)DataContext).RemoveSubAgentCommand}"
                                                          CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 内联单选,选一个加一个;已挂的与自己(防递归)不在候选里 -->
                    <Button Content="{loc:Loc AddBtn}" HorizontalAlignment="Left">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnSubAgentPickerOpening">
                                <viewData:CharacterPickerView Name="SubAgentPicker" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Border>

            <Border Name="OptionalPromptSection" Classes="edit-card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="card-title" Text="{loc:Loc OptionalPromptParams}" />
                    <SelectableTextBlock Text="{loc:Loc OptionalPromptParamsDesc}" />
                </StackPanel>
            </Border>

            <Border Name="PromptSection" Classes="edit-card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="card-title"
                               IsVisible="{Binding IsRoleplay}"
                               Text="{loc:Loc CharacterDesc}" />
                    <TextBlock Classes="card-title"
                               IsVisible="{Binding !IsRoleplay}"
                               Text="{loc:Loc SystemPrompt}" />
                    <TextBox Text="{Binding Template}"
                             MinHeight="180"
                             AcceptsReturn="True" />
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Classes="muted" Text="{loc:Loc CharacterRenderedPreview}" />
                        </Expander.Header>
                        <!-- 参数替换后的样子({{$char}}/{{$user}}/{{$lang}} 都已填好)。
                             这个能力原先藏在只读预览里,预览退役后它落在这儿 -->
                        <SelectableTextBlock Text="{Binding TemplateReadonly}" Margin="0,6,0,0" />
                    </Expander>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{loc:Loc SnippetInsert}">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnSnippetPickerOpening">
                                    <viewData:PromptSnippetPickerView Name="SnippetPicker" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <TextBlock Classes="muted" Text="{loc:Loc SnippetInsertDesc}"
                                   VerticalAlignment="Center" MaxWidth="380" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Name="GreetingSection" Classes="edit-card" IsVisible="{Binding IsRoleplay}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="card-title" Text="{loc:Loc CharacterFirstGreeting}" />
                    <TextBox Text="{Binding FirstGreeting}"
                             MinHeight="120"
                             AcceptsReturn="True" />
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Classes="muted" Text="{loc:Loc CharacterRenderedPreview}" />
                        </Expander.Header>
                        <SelectableTextBlock Text="{Binding FirstGreetingReadonly}" Margin="0,6,0,0" />
                    </Expander>
                </StackPanel>
            </Border>

            <Expander IsExpanded="True">
                <Expander.Header>
                    <TextBlock Classes="card-title" Text="{loc:Loc AdvancedOptions}" />
                </Expander.Header>
                <StackPanel Spacing="12" Margin="0,10,0,0">
                    <Border Name="DialogTemplateSection" Classes="edit-card" IsVisible="{Binding IsRoleplay}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="card-title" Text="{loc:Loc CharacterDialogTemplate}" />
                            <TextBox Text="{Binding DialogTemplate}"
                                     MinHeight="140"
                                     AcceptsReturn="True" />
                        </StackPanel>
                    </Border>
                    <Border Name="ParametersSection" Classes="edit-card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="card-title" Text="{loc:Loc ParameterSettings}" />
                            <settingViews:SettingPanelView SettingConfig="{Binding ChatPromptExecutionSettings}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
