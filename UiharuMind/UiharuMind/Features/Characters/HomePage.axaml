<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:UiharuMind.Features.Characters"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:common="clr-namespace:UiharuMind.Features.Characters"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
              mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="720"
              x:Class="UiharuMind.Features.Characters.HomePage"
                             xmlns:controls="clr-namespace:UiharuMind.Shared.Controls">

    <Design.DataContext>
        <pages:HomePageData />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Border.workspace-pane">
            <Setter Property="Background" Value="{DynamicResource SemiGrey0}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey7}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource SemiGrey0}">
        <Border Grid.Row="0"
                Padding="14,10"
                BorderBrush="{DynamicResource SemiGrey2}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="{loc:Loc CharacterWorkspace}" />
                    <TextBlock Classes="muted" Text="{loc:Loc CharacterWorkspaceHint}" />
                </StackPanel>

                <ThemedIconButton Grid.Column="1" Classes="icon" Command="{Binding ToggleDetailPaneCommand}" IconName="panel-right"  ToolTips="{loc:Loc CharacterPreview}">
                </ThemedIconButton>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Border Grid.Column="0" Classes="workspace-pane" ClipToBounds="True">
                <common:CharacterListView DataContext="{Binding CharacterListViewData}" Margin="10" />
            </Border>

            <Thumb Grid.Column="1"
                   Width="6"
                   IsVisible="{Binding IsDetailPaneOpen}"
                   DragDelta="OnLeftThumbDragDelta"
                   Cursor="SizeWestEast">
                <Thumb.Template>
                    <ControlTemplate>
                        <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource SemiGrey2}" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Border Grid.Column="2"
                    Classes="workspace-pane"
                    Width="{Binding DetailPaneWidth, Mode=TwoWay}"
                    IsVisible="{Binding IsDetailPaneOpen}"
                    Padding="14"
                    DataContext="{Binding CharacterListViewData.SelectedCharacter, Mode=OneWay}">
                <!-- 紧凑信息卡。这里曾嵌一整份只读预览(与编辑窗里那份是同一个视图),
                     同一份只读内容出现在两个层级;正文改到编辑页看,所见即所得 -->
                <StackPanel Spacing="10" VerticalAlignment="Top">
                    <Border Width="116" Height="154" CornerRadius="10" ClipToBounds="True"
                            BorderBrush="{DynamicResource SemiGrey2}"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                    </Border>

                    <SelectableTextBlock Text="{Binding Name}"
                                         FontSize="18"
                                         FontWeight="SemiBold"
                                         TextAlignment="Center"
                                         TextWrapping="Wrap"
                                         Background="Transparent"
                                         Foreground="{DynamicResource SemiGrey7}" />
                    <u:Badge Header="{Binding KindName}"
                             Background="{Binding KindColor}"
                             HorizontalAlignment="Center" />
                    <SelectableTextBlock Text="{Binding Description}"
                                         TextWrapping="Wrap"
                                         Background="Transparent"
                                         Foreground="{DynamicResource SemiGrey6}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                        <Button Command="{Binding StartChatCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <controls:ThemedSvgIcon Width="15" Height="15" IconName="message-circle-more" />
                                <TextBlock Text="{loc:Loc StartChat}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding EditCharacterCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <controls:ThemedSvgIcon Width="15" Height="15" IconName="file-text" />
                                <TextBlock Text="{loc:Loc EditCharacter}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Content="{loc:Loc Copy}" HorizontalContentAlignment="Center"
                                Command="{Binding CopyCharacterCommand}" />
                        <Button Grid.Column="1" Content="{loc:Loc Delete}" HorizontalContentAlignment="Center"
                                Command="{Binding DeleteCharacterCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
