<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:UiharuMind.Features.Characters"
        xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="760"
        Width="640"
        Height="760"
        MinWidth="520"
        MinHeight="560"
        x:Class="UiharuMind.Features.Characters.CharacterEditWindow"
        Title="{loc:Loc CharacterEditor}"
        xmlns:controls="clr-namespace:UiharuMind.Shared.Controls">

    <Window.Styles>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey7}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource SemiGrey0}">
        <Border Grid.Row="0"
                Padding="16,12"
                BorderBrush="{DynamicResource SemiGrey2}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel>
                    <TextBlock Classes="title" Text="{loc:Loc CharacterEditor}" />
                    <TextBlock Classes="muted" Text="{loc:Loc CharacterEditorHint}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Loc CancelBtn}" Click="CancelButton_Click" />
                    <Button Click="OkButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:ThemedSvgIcon Width="15" Height="15" IconName="save" />
                            <TextBlock Text="{loc:Loc SaveBtn}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 单列表单。曾经是"分区导航 + 表单 + 只读预览"三列:导航跳的是同一个 ScrollViewer 里的锚点,
             而预览与角色页右侧那份是同一个视图——同一份只读内容出现在两个层级。都已退役。 -->
        <Border Grid.Row="1"
                Background="{DynamicResource SemiGrey0}"
                BorderBrush="{DynamicResource SemiGrey2}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True"
                Margin="12">
            <common:CharacterEditView Name="EditView" />
        </Border>
    </Grid>
</Window>
