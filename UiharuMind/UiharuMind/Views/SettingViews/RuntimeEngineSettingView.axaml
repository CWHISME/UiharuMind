<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settingViewData="clr-namespace:UiharuMind.ViewModels.SettingViewData"
             xmlns:loc="clr-namespace:UiharuMind.ViewModels.Markup"
             xmlns:common="clr-namespace:UiharuMind.Views.Common"
             xmlns:u="https://irihi.tech/ursa"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="620"
             x:Class="UiharuMind.Views.SettingViews.RuntimeEngineSettingView"
             x:DataType="settingViewData:RuntimeEngineSettingData">

    <Design.DataContext>
        <settingViewData:RuntimeEngineSettingData />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.setting-card">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey2}" />
            <Setter Property="Background" Value="{DynamicResource SemiGrey0}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey6}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
            <Border Classes="setting-card">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Loc ModelRuntimeSectionTitle}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc ModelRuntimeSectionDesc}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <common:ModelRuntimeBasicSettingsView DataContext="{Binding RuntimeSettings}" />
                </StackPanel>
            </Border>

            <Border Classes="setting-card" IsVisible="{Binding IsLLamaSharpEngine}">
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc ModelRuntimeLLamaSharpTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc ModelRuntimeLLamaSharpDesc}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="setting-card" IsVisible="{Binding IsLLamaCppEngine}">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Loc ModelRuntimeLLamaCppTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc ModelRuntimeLLamaCppDesc}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc CurrentEngineTypeSetting}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableVersions}"
                                  SelectedItem="{Binding SelectedVersion}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2"
                                Content="{loc:Loc OpenDirectory}"
                                Command="{Binding OpenFolderCommand}" />
                        <Button Grid.Column="3"
                                Content="{loc:Loc CheckUpdate}"
                                Command="{Binding UpdateRemoteVersionsCommand}" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" IsVisible="{Binding IsCheckingForUpdate}">
                            <u:LoadingIcon />
                            <TextBlock Text="{loc:Loc CheckingForUpdates}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SemiGrey2}"
                            Background="{DynamicResource SemiGrey0}"
                            CornerRadius="7"
                            IsVisible="{Binding UpdatedResutInfo,FallbackValue=True, TargetNullValue=False}">
                        <ScrollViewer MaxHeight="160">
                            <SelectableTextBlock Text="{Binding UpdatedResutInfo}" Margin="10" />
                        </ScrollViewer>
                    </Border>

                    <common:DownloadListView Grid.Row="3" DataContext="{Binding RemoteDwnloadListViewModel}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
