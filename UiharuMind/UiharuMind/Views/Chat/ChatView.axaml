<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:viewData="clr-namespace:UiharuMind.ViewModels.ViewData"
             xmlns:loc="clr-namespace:UiharuMind.ViewModels.Markup"
             xmlns:converters="clr-namespace:UiharuMind.ViewModels.Converters"
             xmlns:uiHolder="clr-namespace:UiharuMind.ViewModels.UIHolder"
             xmlns:common="clr-namespace:UiharuMind.Views.Common"
             xmlns:extends="clr-namespace:UiharuMind.Extends"
              mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
              x:Class="UiharuMind.Views.OtherViews.ChatView"
                             xmlns:controls="clr-namespace:UiharuMind.Views.Controls">

    <UserControl.Resources>
        <converters:UserColumIndexConverter x:Key="UserColumIndexConverter" />
        <converters:UserLeftRightConverter x:Key="UserLeftRightConverter" />
        <converters:MultiConditionBoolOrConverter x:Key="MultiConditionBoolOrConverter" />
        <converters:ModelToBrushConverter x:Key="ModelToBrushConverter" />
    </UserControl.Resources>

    <Design.DataContext>
        <viewData:ChatViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- <Style Selector="Button.icon"> -->
        <!--     <Setter Property="HorizontalContentAlignment" Value="Center" /> -->
        <!--     <Setter Property="VerticalContentAlignment" Value="Center" /> -->
        <!-- </Style> -->
        <Style Selector="ThemedIconButton.memory-status controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="Gray" />
        </Style>
        <Style Selector="ThemedIconButton.memory-status[Tag=Dirty] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="DarkRed" />
        </Style>
        <Style Selector="ThemedIconButton.memory-status[Tag=Error] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="Red" />
        </Style>
        <Style Selector="ThemedIconButton.memory-status[Tag=Ready] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="LawnGreen" />
        </Style>
        <Style Selector="Border.message-actions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Grid.message-row:pointerover Border.message-actions">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
        </Style>
        <Style Selector="Border.tool-row">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Border.message-bubble">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SemiGrey0}">
        <Border Grid.Row="0"
                Padding="14,10"
                BorderBrush="{DynamicResource SemiGrey2}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel MinWidth="0">
                    <TextBlock Text="{Binding ChatSession.Name, TargetNullValue={loc:Loc ChatWorkspaceEmpty}}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"
                               Foreground="{DynamicResource SemiGrey7}" />
                    <TextBlock Classes="muted"
                               Text="{Binding ChatSession.MemoryTipsName}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ThemedIconButton IconName="repeat" 
                                          Command="{Binding RegenerateMessageCommand}"
                                          IsVisible="{Binding IsVisibleRegenerateButton}" ToolTips="{loc:Loc RegenerateBtn}">
                    </ThemedIconButton>
                    <!-- <StackPanel IsVisible="{Binding IsGenerating}" Orientation="Horizontal" Spacing="8"> -->
                    <!--     <u:LoadingIcon IsLoading="{Binding IsGenerating}" /> -->
                    <!--     <Button Classes="icon" Command="{Binding StopSendingCommand}"> -->
                    <!--         <controls:ThemedSvgIcon Width="16" Height="16" IconName="stop" CurrentColor="Red"/> -->
                    <!--         <ToolTip.Tip> -->
                    <!--             <TextBlock Text="{loc:Loc StopGenerating}" /> -->
                    <!--         </ToolTip.Tip> -->
                    <!--     </Button> -->
                    <!-- </StackPanel> -->
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Name="Viewer"
                      Padding="18,18,18,0"
                      u:ScrollTo.Direction="Bottom"
                      BringIntoViewOnFocusChange="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      uiHolder:ScrollViewExtensions.ScrollToEnd="{Binding ScrollToEnd}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding ChatSession.ChatItems}">
                    <ItemsControl.ItemTemplate>
                        <extends:ReuseDataTemplate>
                            <Grid Classes="message-row"
                                  ColumnDefinitions="Auto,*,Auto"
                                  Margin="0,0,0,16"
                                  Background="Transparent">
                                <Ellipse Width="34" Height="34"
                                         Stroke="{DynamicResource SemiGrey2}"
                                         StrokeThickness="1"
                                         VerticalAlignment="Top"
                                         IsVisible="{Binding !IsSystem}"
                                         Grid.Column="{Binding Role, Converter={StaticResource UserColumIndexConverter}, ConverterParameter=3}">
                                    <Ellipse.Fill>
                                        <ImageBrush Source="{Binding Icon}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>

                                <Grid Grid.Column="1"
                                      Margin="10,0"
                                      MinHeight="34"
                                      RowDefinitions="Auto,18"
                                      Background="Transparent"
                                      HorizontalAlignment="{Binding Role, Converter={StaticResource UserLeftRightConverter}}">
                                    <StackPanel HorizontalAlignment="{Binding Role, Converter={StaticResource UserLeftRightConverter}}">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    HorizontalAlignment="{Binding Role, Converter={StaticResource UserLeftRightConverter}}">
                                            <TextBlock Text="{Binding SenderName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SemiGrey7}" />
                                            <TextBlock Classes="muted" Text="{Binding Timestamp}" />
                                        </StackPanel>

                                        <Grid Margin="0,5,0,0"
                                              HorizontalAlignment="{Binding Role, Converter={StaticResource UserLeftRightConverter}}">
                                            <Border
                                                    Classes="message-bubble"
                                                    BorderBrush="{Binding SenderColor}"
                                                    HorizontalAlignment="{Binding Role, Converter={StaticResource UserLeftRightConverter}}">
                                                <Panel HorizontalAlignment="Left">
                                                    <common:SimpleMarkdownViewer
                                                        HorizontalAlignment="Left"
                                                        IsVisible="{Binding !IsImageContent}"
                                                        MarkdownText="{Binding Message}"
                                                        IsThinkingRemove="{Binding DataContext.IsNotShowThinking, ElementName=Viewer}">
                                                        <common:SimpleMarkdownViewer.IsPlaintext>
                                                            <MultiBinding Converter="{StaticResource MultiConditionBoolOrConverter}">
                                                                <Binding Path="IsUser" />
                                                                <Binding Path="!IsDone" />
                                                                <Binding Path="DataContext.IsPlaintext" ElementName="Viewer" />
                                                            </MultiBinding>
                                                        </common:SimpleMarkdownViewer.IsPlaintext>
                                                    </common:SimpleMarkdownViewer>
                                                    <Image IsVisible="{Binding IsImageContent}"
                                                           Source="{Binding MessageImage}"
                                                           MaxWidth="520"
                                                           MaxHeight="360" />
                                                </Panel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <Border Classes="message-actions"
                                            Grid.Row="1"
                                            HorizontalAlignment="{Binding Role, Converter={StaticResource UserLeftRightConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <!-- <ThemedSvgIconButton IconName="copy" Command="{Binding CopyCommand}" Width="11" Height="11"/> -->
                                            <ThemedIconButton Classes="message-action" IconName="split"
                                                              Command="{Binding BranchCommand}" ToolTips="{loc:Loc BranchChatAfterMessage}"/>
                                            <ThemedIconButton Classes="message-action" IconName="repeat"
                                                              Command="{Binding RetryCommand}" ToolTips="{loc:Loc RetryMessage}"/>
                                            <ThemedIconButton Classes="message-action" IconName="copy"
                                                              Command="{Binding CopyCommand}" ToolTips="{loc:Loc Copy}"/>
                                            <ThemedIconButton Classes="message-action" IconName="pencil"
                                                              Command="{Binding EditCommand}" ToolTips="{loc:Loc Edit}"/>
                                            <ThemedIconButton Classes="message-action" IconName="trash-2"
                                                              Command="{Binding DeleteCommand}" ToolTips="{loc:Loc Delete}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </extends:ReuseDataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="28" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="14"
                Padding="8"
                Classes="tool-row">
            <Grid RowDefinitions="*,Auto" RowSpacing="4">
                <TextBox Grid.Row="0"
                         Name="InputBox"
                         Classes="composer-input"
                         Text="{Binding InputText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"
                         MaxHeight="240"
                         PlaceholderText="{loc:Loc ChatInputTips}">
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding SendMessageCommand}" Gesture="{Binding SendGesture}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Content="{Binding SenderMode}" Command="{Binding ChangeSendModeCommand}">
                            <ToolTip.Tip>
                                <TextBlock Text="{loc:Loc SendUserDesc}" />
                            </ToolTip.Tip>
                        </Button>
                        <!-- <Button Classes="memory-status" -->
                        <!--         Tag="{Binding ChatSession.MemoryStatusKey}" -->
                        <!--         Command="{Binding ChatSession.MemoryEditorCommand}"> -->
                        <!--     <controls:ThemedSvgIcon Width="18" Height="18" -->
                        <!--               IconName="database" /> -->
                        <!--     <ToolTip.Tip> -->
                        <!--         <TextBlock Text="{Binding ChatSession.MemoryIndexTips}" /> -->
                        <!--     </ToolTip.Tip> -->
                        <!-- </Button> -->
                        <ThemedIconButton Classes="memory-status"
                                          IconName="database"
                                          ToolTips="{Binding ChatSession.MemoryIndexTips}"
                                          Tag="{Binding ChatSession.MemoryStatusKey}"
                                          Command="{Binding ChatSession.MemoryEditorCommand}"/>
                        <ThemedIconButton IconName="image" 
                                              IsVisible="{Binding IsSurportImage}"
                                              Command="{Binding UploadImageCommand}"/>
                        <ThemedIconButton IconName="settings" >
                            <ThemedIconButton.Flyout>
                                <Flyout Placement="Top">
                                    <Border Padding="10"
                                            CornerRadius="8"
                                            Background="{DynamicResource SemiGrey0}"
                                            BorderBrush="{DynamicResource SemiGrey2}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:ThemedSvgIcon Width="16"
                                                          Height="16"
                                                          VerticalAlignment="Center"
                                                          IconName="settings" />
                                                <TextBlock Text="{loc:Loc Settings}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SemiGrey7}" />
                                            </StackPanel>

                                            <Border Height="1" Background="{DynamicResource SemiGrey2}" />

                                            <CheckBox Content="{loc:Loc HideThnkingText}"
                                                      IsChecked="{Binding IsNotShowThinking}">
                                                <ToolTip.Tip>
                                                    <TextBlock Text="{loc:Loc HideThnkingTextTips}" />
                                                </ToolTip.Tip>
                                            </CheckBox>

                                            <CheckBox Content="{loc:Loc Plaintext}"
                                                      IsChecked="{Binding IsPlaintext}">
                                                <ToolTip.Tip>
                                                    <TextBlock Text="{loc:Loc ChatPlaintextTooltip}" />
                                                </ToolTip.Tip>
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </ThemedIconButton.Flyout>
                            <ToolTip.Tip>
                                <TextBlock Text="{loc:Loc Settings}" />
                            </ToolTip.Tip>
                        </ThemedIconButton>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="{loc:Loc Send}"
                            IsVisible="{Binding !IsGenerating}"
                            IsEnabled="{Binding InputText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Command="{Binding SendMessageCommand}">
                    </Button>

                    <!-- <Button Grid.Column="1" -->
                    <!--         Classes="icon" -->
                    <!--         IsVisible="{Binding IsGenerating}" -->
                    <!--         Command="{Binding StopSendingCommand}"> -->
                    <!--     <controls:ThemedSvgIcon Width="18" Height="18" IconName="stop" CurrentColor="Red"/> -->
                    <!--     <ToolTip.Tip> -->
                    <!--         <TextBlock Text="{loc:Loc StopGenerating}" /> -->
                    <!--     </ToolTip.Tip> -->
                    <!-- </Button> -->
                    <StackPanel Grid.Column="1" IsVisible="{Binding IsGenerating}" Orientation="Horizontal" Spacing="8">
                        <u:LoadingIcon IsLoading="{Binding IsGenerating}" />
                        <ThemedIconButton IconName="stop" 
                                              CurrentColor="Red"
                                              Command="{Binding StopSendingCommand}" ToolTips="{loc:Loc StopGenerating}">
                        </ThemedIconButton>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
