<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:UiharuMind.ViewModels.Pages"
             xmlns:otherViews="clr-namespace:UiharuMind.Views.OtherViews"
             xmlns:common="clr-namespace:UiharuMind.Views.Common"
             xmlns:loc="clr-namespace:UiharuMind.ViewModels.Markup"
             xmlns:conv="clr-namespace:UiharuMind.ViewModels.Conversation"
             xmlns:convView="clr-namespace:UiharuMind.Views.Common.Conversation"
             xmlns:viewsPages="clr-namespace:UiharuMind.Views.Pages"
              mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="720"
              x:Class="UiharuMind.Views.Pages.ChatPage"
                             xmlns:controls="clr-namespace:UiharuMind.Views.Controls">

    <Design.DataContext>
        <pages:ChatPageData />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- <Style Selector="Button.icon"> -->
        <!--     <Setter Property="Width" Value="34" /> -->
        <!--     <Setter Property="Height" Value="34" /> -->
        <!--     <Setter Property="Padding" Value="0" /> -->
        <!--     <Setter Property="HorizontalContentAlignment" Value="Center" /> -->
        <!--     <Setter Property="VerticalContentAlignment" Value="Center" /> -->
        <!-- </Style> -->
        <Style Selector="Border.workspace-pane">
            <Setter Property="Background" Value="{DynamicResource SemiGrey0}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey7}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
        </Style>
        <Style Selector="Thumb.resize-thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ThemedIconButton.memory-status controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="Gray" />
        </Style>
        <Style Selector="ThemedIconButton.memory-status[Tag=Dirty] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="DarkRed" />
        </Style>
        <Style Selector="ThemedIconButton.memory-status[Tag=Error] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="Red" />
        </Style>
        <Style Selector="ThemedIconButton.memory-status[Tag=Ready] controls|ThemedSvgIcon">
            <Setter Property="CurrentColor" Value="LawnGreen" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource SemiGrey0}">
        <Border Grid.Row="0"
                Height="50"
                Padding="10,6"
                BorderBrush="{DynamicResource SemiGrey2}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource SemiGrey0}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                <ThemedIconButton Grid.Column="0"
                                     Command="{Binding ToggleLeftPaneCommand}"
                                     IsVisible="{Binding IsLeftPaneOpen}"
                                     IconName="panel-right"
                                      ToolTips="{loc:Loc ChatSessions}">
                </ThemedIconButton>
                <ThemedIconButton Grid.Column="0"
                                     Command="{Binding ToggleLeftPaneCommand}"
                                     IsVisible="{Binding !IsLeftPaneOpen}"
                                     IconName="panel-left"
                                      ToolTips="{loc:Loc ChatSessions}">
                </ThemedIconButton>

                <Border Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        MinWidth="260">
                    <otherViews:ModelSelectComboBoxView />
                </Border>

                <ThemedIconButton Grid.Column="2"
                                     Command="{Binding ToggleRightPaneCommand}"
                                     IsVisible="{Binding IsRightPaneOpen}"
                                     IconName="panel-left"
                                      ToolTips="{loc:Loc ChatDetails}">
                </ThemedIconButton>
                <ThemedIconButton Grid.Column="2"
                                     Command="{Binding ToggleRightPaneCommand}"
                                     IsVisible="{Binding !IsRightPaneOpen}"
                                     IconName="panel-right"
                                      ToolTips="{loc:Loc ChatDetails}">
                </ThemedIconButton>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <Border Grid.Column="0"
                    Classes="workspace-pane"
                    Width="{Binding LeftPaneWidth, Mode=TwoWay}"
                    IsVisible="{Binding IsLeftPaneOpen}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,12,10,8">
                        <StackPanel>
                            <TextBlock Classes="section-title" Text="{loc:Loc ChatSessions}" />
                            <TextBlock Classes="muted" Text="{loc:Loc ChatSessionsHint}" />
                        </StackPanel>
                        <ThemedIconButton Grid.Column="1" Command="{Binding AddChatCommand}" IconName="message-circle-more"  />
                    </Grid>
                    <otherViews:ChatListView Margin="8,0,8,8" />
                </DockPanel>
            </Border>

            <Thumb Grid.Column="1"
                   Classes="resize-thumb"
                   IsVisible="{Binding IsLeftPaneOpen}"
                   DragDelta="OnLeftThumbDragDelta"
                   Cursor="SizeWestEast">
                <Thumb.Template>
                    <ControlTemplate>
                        <Grid Background="Transparent">
                            <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource SemiGrey2}" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Border Grid.Column="2" Classes="workspace-pane" ClipToBounds="True" MinWidth="260">
                <convView:ConversationView DataContext="{Binding Conversation}">

                    <convView:ConversationView.EmptyContent>
                        <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="0,90,0,0">
                            <controls:ThemedSvgIcon IconName="message-circle-more" Width="52" Height="52"
                                                    HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc ChatWorkspaceEmpty}" FontSize="17"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </convView:ConversationView.EmptyContent>

                    <convView:ConversationView.HeaderExtra>
                        <StackPanel Orientation="Horizontal" Spacing="8" x:DataType="conv:ConversationViewModel">
                            <TextBlock Classes="muted" VerticalAlignment="Center"
                                       Text="{Binding DataContext.ChatListViewModel.SelectedSession.MemoryTipsName, RelativeSource={RelativeSource AncestorType=viewsPages:ChatPage}}" />
                            <ThemedIconButton IconName="repeat"
                                              Command="{Binding RegenerateLastCommand}"
                                              IsVisible="{Binding CanRegenerate}"
                                              ToolTips="{loc:Loc RegenerateBtn}" />
                        </StackPanel>
                    </convView:ConversationView.HeaderExtra>

                    <convView:ConversationView.ComposerTools>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    x:DataType="conv:ConversationViewModel">
                            <Button Content="{Binding SenderMode}" Command="{Binding ChangeSendModeCommand}">
                                <ToolTip.Tip>
                                    <TextBlock Text="{loc:Loc SendUserDesc}" />
                                </ToolTip.Tip>
                            </Button>
                            <ThemedIconButton Classes="memory-status"
                                              IconName="database"
                                              ToolTips="{Binding DataContext.ChatListViewModel.SelectedSession.MemoryIndexTips, RelativeSource={RelativeSource AncestorType=viewsPages:ChatPage}}"
                                              Tag="{Binding DataContext.ChatListViewModel.SelectedSession.MemoryStatusKey, RelativeSource={RelativeSource AncestorType=viewsPages:ChatPage}}"
                                              Command="{Binding DataContext.ChatListViewModel.SelectedSession.MemoryEditorCommand, RelativeSource={RelativeSource AncestorType=viewsPages:ChatPage}}" />
                            <ThemedIconButton IconName="image" Command="{Binding AddAttachmentCommand}" />
                            <ThemedIconButton IconName="settings">
                                <ThemedIconButton.Flyout>
                                    <Flyout Placement="Top">
                                        <Border Padding="10"
                                                CornerRadius="8"
                                                Background="{DynamicResource SemiGrey0}"
                                                BorderBrush="{DynamicResource SemiGrey2}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <controls:ThemedSvgIcon Width="16"
                                                              Height="16"
                                                              VerticalAlignment="Center"
                                                              IconName="settings" />
                                                    <TextBlock Text="{loc:Loc Settings}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SemiGrey7}" />
                                                </StackPanel>

                                                <Border Height="1" Background="{DynamicResource SemiGrey2}" />

                                                <CheckBox Content="{loc:Loc HideThnkingText}"
                                                          IsChecked="{Binding IsNotShowThinking}">
                                                    <ToolTip.Tip>
                                                        <TextBlock Text="{loc:Loc HideThnkingTextTips}" />
                                                    </ToolTip.Tip>
                                                </CheckBox>

                                                <CheckBox Content="{loc:Loc Plaintext}"
                                                          IsChecked="{Binding IsPlaintext}">
                                                    <ToolTip.Tip>
                                                        <TextBlock Text="{loc:Loc ChatPlaintextTooltip}" />
                                                    </ToolTip.Tip>
                                                </CheckBox>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </ThemedIconButton.Flyout>
                                <ToolTip.Tip>
                                    <TextBlock Text="{loc:Loc Settings}" />
                                </ToolTip.Tip>
                            </ThemedIconButton>
                        </StackPanel>
                    </convView:ConversationView.ComposerTools>

                </convView:ConversationView>
            </Border>

            <Thumb Grid.Column="3"
                   Classes="resize-thumb"
                   IsVisible="{Binding IsRightPaneOpen}"
                   DragDelta="OnRightThumbDragDelta"
                   Cursor="SizeWestEast">
                <Thumb.Template>
                    <ControlTemplate>
                        <Grid Background="Transparent">
                            <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource SemiGrey2}" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Border Grid.Column="4"
                    Classes="workspace-pane"
                    Width="{Binding RightPaneWidth, Mode=TwoWay}"
                    MinWidth="260"
                    MaxWidth="360"
                    IsVisible="{Binding IsRightPaneOpen}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*" Margin="14,12,14,8">
                        <StackPanel MinWidth="0">
                            <TextBlock Classes="section-title" Text="{loc:Loc ChatDetails}" />
                            <TextBlock Classes="muted"
                                       Text="{Binding ChatListViewModel.SelectedSession.Name}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                        </StackPanel>
                    </Grid>
                    <common:ChatInfoView Margin="8,0,8,8" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
