<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lang="clr-namespace:UiharuMind.Resources.Lang"
             xmlns:loc="clr-namespace:UiharuMind.ViewModels.Markup"
        mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="50"
        x:Class="UiharuMind.Views.Windows.ScreenCapture.ScreenCaptureDockWindow"
        Title="ScreenCaptureDockWindow"
        xmlns:controls="clr-namespace:UiharuMind.Views.Controls">

    <Window.Styles>
        <Style Selector="Button">
            <!-- <Setter Property="Width" Value="32" /> -->
            <Setter Property="Height" Value="32" />
        </Style>
    </Window.Styles>

    <StackPanel Orientation="Horizontal">
        <Button Click="OnEditBtnClick">
            <controls:ThemedSvgIcon IconName="image-edit" />
            <ToolTip.Tip>
                <TextBlock Text="{loc:Loc ScreenCaptureDockWindow_BtnEdit}" />
            </ToolTip.Tip>
        </Button>
        <Button Name="ToggleOldNewBtn" Click="OnToggleOldNewBtnClick">
            <controls:ThemedSvgIcon IconName="refresh-cw" />
        </Button>
        <!-- <Button Name="OcrBtn" Click="OnOcrBtnClick"> -->
        <!--     <PathIcon Data="{StaticResource file-text}" /> -->
        <!--     <ToolTip.Tip> -->
        <!--         <TextBlock Text="{loc:Loc ScreenCaptureDockWindow_BtnOldOcr}" /> -->
        <!--     </ToolTip.Tip> -->
        <!-- </Button> -->
        <Button Click="OnExplainAiBtnClick">
            <Panel>
                <TextBlock Text="AI" FontSize="8" VerticalAlignment="Top" HorizontalAlignment="Center"
                           Margin="0,-3,0,0" />
                <controls:ThemedSvgIcon IconName="book-search" Margin="0,5,0,0" />
            </Panel>
            <ToolTip.Tip>
                <TextBlock Text="{loc:Loc ScreenCaptureDockWindow_BtnExplain}" />
            </ToolTip.Tip>
        </Button>
        <Button Click="OnOcrAiBtnClick">
            <Panel>
                <TextBlock Text="AI" FontSize="8" VerticalAlignment="Top" HorizontalAlignment="Center"
                           Margin="0,-3,0,0" />
                <controls:ThemedSvgIcon IconName="file-text" Margin="0,5,0,0" />
            </Panel>
            <ToolTip.Tip>
                <TextBlock Text="{loc:Loc ScreenCaptureDockWindow_BtnOcr}" />
            </ToolTip.Tip>
        </Button>
        <Button Click="OnVisionAiBtnClick">
            <Panel>
                <TextBlock Text="AI" FontSize="8" VerticalAlignment="Top" HorizontalAlignment="Center"
                           Margin="0,-3,0,0" />
                <controls:ThemedSvgIcon IconName="message-circle-more" Margin="0,5,0,0" />
            </Panel>
            <ToolTip.Tip>
                <TextBlock Text="{loc:Loc ScreenCaptureDockWindow_BtnVision}" />
            </ToolTip.Tip>
        </Button>
        <Button Click="OnCopyBtnClick">
            <controls:ThemedSvgIcon IconName="copy" />
            <ToolTip.Tip>
                <TextBlock Text="{loc:Loc ScreenCaptureDockWindow_BtnCopy}" />
            </ToolTip.Tip>
        </Button>
        <Button Click="OnSaveBtnClick">
            <controls:ThemedSvgIcon IconName="save" />
            <ToolTip.Tip>
                <TextBlock Text="{loc:Loc SaveBtn}" />
            </ToolTip.Tip>
        </Button>
    </StackPanel>

</Window>