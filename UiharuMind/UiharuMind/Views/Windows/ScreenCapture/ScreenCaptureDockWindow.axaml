<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lang="clr-namespace:UiharuMind.Resources.Lang"
             xmlns:loc="clr-namespace:UiharuMind.ViewModels.Markup"
        mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="50"
        x:Class="UiharuMind.Views.Windows.ScreenCapture.ScreenCaptureDockWindow"
        Title="ScreenCaptureDockWindow">

    <Window.Styles>
        <Style Selector="Button">
            <!-- <Setter Property="Width" Value="32" /> -->
            <Setter Property="Height" Value="32" />
        </Style>
    </Window.Styles>

    <StackPanel Orientation="Horizontal">
        <ThemedIconButton Click="OnEditBtnClick" IconName="image-edit" ToolTips="{loc:Loc ScreenCaptureDockWindow_BtnEdit}"/>
        <ThemedIconButton Name="ToggleOldNewBtn" Click="OnToggleOldNewBtnClick" IconName="refresh-cw" />
        <!-- <Button Name="OcrBtn" Click="OnOcrBtnClick"> -->
        <!--     <PathIcon Data="{StaticResource file-text}" /> -->
        <!--     <ToolTip.Tip> -->
        <!--         <TextBlock Text="{loc:Loc ScreenCaptureDockWindow_BtnOldOcr}" /> -->
        <!--     </ToolTip.Tip> -->
        <!-- </Button> -->
        <ThemedIconButton Click="OnExplainAiBtnClick" IconName="book-search" ToolTips="{loc:Loc ScreenCaptureDockWindow_BtnExplain}"/>
        <ThemedIconButton Click="OnOcrAiBtnClick" IconName="file-text" ToolTips="{loc:Loc ScreenCaptureDockWindow_BtnOcr}"/>
        <ThemedIconButton Click="OnVisionAiBtnClick" IconName="message-circle-more" ToolTips="{loc:Loc ScreenCaptureDockWindow_BtnVision}"/>
        <ThemedIconButton Click="OnCopyBtnClick" IconName="copy" ToolTips="{loc:Loc ScreenCaptureDockWindow_BtnCopy}"/>
        <ThemedIconButton Click="OnSaveBtnClick" IconName="save" ToolTips="{loc:Loc SaveBtn}"/>
    </StackPanel>

</Window>