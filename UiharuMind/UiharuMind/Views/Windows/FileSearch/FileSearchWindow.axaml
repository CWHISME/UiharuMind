<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UiharuMind.ViewModels"
        xmlns:controls="clr-namespace:UiharuMind.Controls"
        xmlns:icons="clr-namespace:UiharuMind.Views.Controls"
        xmlns:loc="clr-namespace:UiharuMind.ViewModels.Markup"
        xmlns:convs="clr-namespace:UiharuMind.ViewModels.Converters"
        x:Class="UiharuMind.Views.Windows.FileSearchWindow"
        Title="{loc:Loc FileSearchTitle}"
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner"
        MinWidth="500" MinHeight="400"
        DragDrop.AllowDrop="True">

    <Design.DataContext>
        <vm:SearchViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="10">

        <!-- Row 0: 搜索栏 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,5">
            <TextBox Text="{Binding SearchQuery}"
                     PlaceholderText="{loc:Loc FileSearchInputWatermark}"
                     KeyDown="OnSearchBoxKeyDown"
                     VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Command="{Binding SearchCommand}"
                    IsEnabled="{Binding !IsSearching}"
                    Margin="5,0">
                <TextBlock Text="{loc:Loc FileSearchBtn}"/>
            </Button>
        </Grid>

        <!-- Row 1: 搜索选项 -->
        <Border Grid.Row="1"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="5" Padding="8"
                Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox Content="{loc:Loc FileSearchContentSearchMode}" IsChecked="{Binding IsContentMode}">
                    <ToolTip.Tip>
                        <TextBlock Text="{loc:Loc FileSearchContentSearchModeTip}" />
                    </ToolTip.Tip>
                </CheckBox>
                <CheckBox Content="{loc:Loc FileSearchRegexMode}" IsChecked="{Binding IsRegexMode}"/>
                <CheckBox Content="{loc:Loc FileSearchCaseSensitive}" IsChecked="{Binding IsCaseSensitive}"/>
                <CheckBox Content="{loc:Loc FileSearchAutoSearch}" IsChecked="{Binding AutoSearch}"/>
            </StackPanel>
        </Border>

        <!-- Row 2: 目录 -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,5">
            <TextBlock Grid.Column="0" Text="{loc:Loc FileSearchCurrentDirectory}"
                       VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11" Foreground="Gray"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding HistoryDirectories}"
                      IsEditable="True"
                      SelectionChanged="OnDirectorySelectionChanged"
                      LostFocus="OnDirectoryLostFocus"
                      KeyDown="OnDirectoryKeyDown"
                      VerticalAlignment="Center"/>
            <icons:ThemedIconButton Grid.Column="2"
                                    IconName="folder-cog"
                                    Command="{Binding SelectDirectoryCommand}"
                                    Width="28" Height="28"
                                    Margin="4,0,0,0"
                                    ToolTip.Tip="{loc:Loc FileSearchSelectDirectory}"/>
            <icons:ThemedIconButton Grid.Column="3"
                                    IconName="square-arrow-out-up-right"
                                    Command="{Binding OpenCurrentDirectoryCommand}"
                                    Width="28" Height="28"
                                    Margin="4,0,0,0"
                                    ToolTip.Tip="{loc:Loc FileSearchOpenDirectory}"/>
        </Grid>

        <!-- Row 3: 结果 -->
        <Grid Grid.Row="3">
            <ListBox ItemsSource="{Binding Results}"
                     SelectionMode="Toggle"
                     DoubleTapped="OnResultDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="0,0,0,1" Padding="5">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <icons:ThemedSvgIcon Grid.Column="0"
                                                     Width="16" Height="16"
                                                     IconName="{Binding IsContentSearch, Converter={x:Static convs:BoolToIconConverter.Instance}}"
                                                     Margin="0,0,10,0"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="Gray"
                                               MaxLines="2" TextWrapping="Wrap"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding LineNumber, StringFormat='行: {0}'}"
                                           FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Background="#80000000" IsVisible="{Binding IsSearching}" VerticalAlignment="Top" Height="30">
                <TextBlock Text="{loc:Loc FileSearchSearching}" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
            </Border>
        </Grid>
    </Grid>
</Window>
