<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:UiharuMind.Shared.Controls"
        xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="520"
        Width="480"
        MinWidth="400"
        MinHeight="360"
        MaxHeight="640"
        SizeToContent="Height"
        x:Class="UiharuMind.Shared.Windows.PermissionGuideWindow"
        Title="UiharuMind"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Border.CardSection">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource SemiGrey0}" />
        </Style>
        <Style Selector="TextBlock.PermissionName">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.PermissionDesc">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey6}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.StatusGranted">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="ForestGreen" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="TextBlock.StatusDenied">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="Crimson" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Ellipse.StatusDotGranted">
            <Setter Property="Fill" Value="ForestGreen" />
        </Style>
        <Style Selector="Ellipse.StatusDotDenied">
            <Setter Property="Fill" Value="Crimson" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SemiGrey1}">
        <Border Height="48" Padding="20,0"
                BorderBrush="{DynamicResource SemiGrey2}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <TextBlock Text="{loc:Loc PermissionGuideTitle}"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="20,16,20,0">
            <StackPanel Spacing="12">

                <TextBlock Text="{loc:Loc PermissionGuideDesc}"
                           FontSize="13"
                           Foreground="{DynamicResource SemiGrey7}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />

                <TextBlock Text="{loc:Loc PermissionHintText}"
                           FontSize="12"
                           Foreground="{DynamicResource SemiGrey6}"
                           TextWrapping="Wrap"
                           FontStyle="Italic"
                           Margin="0,0,0,4" />

                <Border Classes="CardSection">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Width="36" Height="36" CornerRadius="8"
                                Background="{DynamicResource SemiGrey2}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <controls:ThemedSvgIcon Width="20" Height="20" IconName="settings"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{loc:Loc PermissionAccessibility}" Classes="PermissionName" />
                            <TextBlock Text="{loc:Loc PermissionAccessibilityDesc}"
                                       Classes="PermissionDesc" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Name="AccessibilityStatusDot" />
                                <TextBlock Name="AccessibilityStatusText" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Name="AccessibilitySettingsButton"
                                    FontSize="11" Padding="8,3"
                                    IsVisible="False"
                                    Content="{loc:Loc PermissionOpenSettings}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="CardSection">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Width="36" Height="36" CornerRadius="8"
                                Background="{DynamicResource SemiGrey2}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <controls:ThemedSvgIcon Width="20" Height="20" IconName="image"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{loc:Loc PermissionScreenRecording}" Classes="PermissionName" />
                            <TextBlock Text="{loc:Loc PermissionScreenRecordingDesc}"
                                       Classes="PermissionDesc" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Name="ScreenRecordingStatusDot" />
                                <TextBlock Name="ScreenRecordingStatusText" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Name="ScreenRecordingSettingsButton"
                                    FontSize="11" Padding="8,3"
                                    IsVisible="False"
                                    Content="{loc:Loc PermissionOpenSettings}" />
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,12"
                BorderBrush="{DynamicResource SemiGrey2}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Name="SkipButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{loc:Loc PermissionSkip}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
