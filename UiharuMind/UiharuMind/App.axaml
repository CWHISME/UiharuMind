<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u-Semi="clr-namespace:Ursa.Themes.Semi;assembly=Ursa.Themes.Semi"
             xmlns:lang="clr-namespace:UiharuMind.Resources.Lang"
             xmlns:loc="clr-namespace:UiharuMind.Shared.Markup"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:u="https://irihi.tech/ursa"
             x:Class="UiharuMind.App"
             Name="UiharuMind"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="MainFont">avares://UiharuMind/Assets/Fonts#HarmonyOS Sans</FontFamily>
            <FontFamily x:Key="JetBrainsMonoFont">avares://UiharuMind/Assets/Fonts#JetBrains Mono</FontFamily>
            <FontFamily x:Key="CodeFontFamily">Maple Mono, Cascadia Mono, Consolas, Menlo, monospace,avares://UiharuMind/Assets/Fonts#JetBrains Mono</FontFamily>

            <!-- AvaloniaEdit 的 Fluent 主题(下面 Application.Styles 里挂着)引用九个 Fluent 键,
                 其中 ToolTipBackground / ToolTipForeground / ToolTipBorderBrush 由 Semi 提供,
                 剩下六个没有。这三个是 <b>StaticResource</b>(解析期求值),必须住在这里——
                 补进 Styles 里够不着;另外三个是 DynamicResource 的 Color,按主题变体放在
                 Assets/ThemeColors.axaml。少任何一个,搜索面板一开就抛 KeyNotFoundException。
                 刻意不引 <FluentTheme /> 补齐:那会与 SemiTheme 打架。见 ADR 0012 -->
            <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
            <FontFamily x:Key="ContentControlThemeFontFamily">avares://UiharuMind/Assets/Fonts#HarmonyOS Sans</FontFamily>
            <Thickness x:Key="ToolTipBorderThemeThickness">1</Thickness>

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ControlTheme x:Key="{x:Type ThemedIconButton}"
                          TargetType="ThemedIconButton"
                          BasedOn="{StaticResource {x:Type u:IconButton}}" />
            <ControlTheme x:Key="{x:Type ThemedIconToggleButton}"
                          TargetType="ThemedIconToggleButton"
                          BasedOn="{StaticResource {x:Type u:IconButton}}" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- <StyleInclude Source="avares://Semi.Avalonia/Themes/Index.axaml" /> -->
        <StyleInclude Source="avares://Semi.Avalonia.ColorPicker/Index.axaml" />
        <!-- <StyleInclude Source="avares://UiharuMind/Assets/Icons.axaml"></StyleInclude> -->
        <StyleInclude Source="/Assets/Themes/CustomButtonStyle.axaml"></StyleInclude>
        <StyleInclude Source="/Assets/Themes/CustomFontStyle.axaml"></StyleInclude>
        <StyleInclude Source="/Assets/Themes/CustomInputStyle.axaml"></StyleInclude>
        <StyleInclude Source="/Assets/Themes/CustomStatusStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://UiharuMind/Assets/ThemeColors.axaml"></StyleInclude>
        <semi:SemiTheme />
        <u-Semi:UrsaSemiTheme />
        <!-- 长文本查看器(LongTextView)的内核主题。只挂 AvaloniaEdit 自己那份,
             刻意<b>不</b>挂 FluentTheme——它会与上面的 SemiTheme 打架 -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml"/>
    </Application.Styles>

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{loc:Loc MenuSettingKey}" Click="OnSettingsMenuItemClick" />
        </NativeMenu>
    </NativeMenu.Menu>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/Icon.png"
                      ToolTipText="This is a ToolTip 🌱">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <!-- <NativeMenuItemSeparator /> -->
                        <NativeMenuItem Header="{loc:Loc TrayMenuOpen}" Click="OnOpenClick" />
                        <NativeMenuItem Header="{loc:Loc TrayMenuOpenSaveDir}" Click="OnOpenSaveMenuItemClick" />
                        <!-- <NativeMenuItem Header="Settings" /> -->
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{loc:Loc TrayMenuScreenCapture, SettingProperty=CaptureScreenShortcut}" Click="OnScreenCaptureClick" />
                        <NativeMenuItem Header="{loc:Loc TrayMenuQuickAsk, SettingProperty=QuickStartChatShortcut}" Click="OnQuickAskClick" />
                        <NativeMenuItem Header="{loc:Loc TrayMenuClipboardHistory, SettingProperty=ClipboardHistoryShortcut}" Click="OnClipboardHistoryClick" />
                        <NativeMenuItem Header="{loc:Loc TrayMenuTranslateHistory, SettingProperty=QuickTranslationShortcut}" Click="OnTranslateMenuItemClick" />
                        <NativeMenuItem Header="{loc:Loc TrayMenuAutoClick, SettingProperty=QuickAutoClickShortcut}" Click="OnAutoClickMenuItemClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{loc:Loc MenuSettingKey}" Click="OnSettingsMenuItemClick" />
                        <NativeMenuItem Header="{loc:Loc TrayMenuQuit}" ToolTip="{loc:Loc TrayMenuQuitTips}" Click="OnQuitClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
