<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- .NET 10 SDK 起 dotnet test 不再走 VSTest,要显式认新运行器,否则 dotnet test 直接报错 -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- MAAI001: Microsoft.Agents.AI Harness 面为 Experimental API -->
    <!-- CS0435: xunit v3 自动生成的入口文件用 global::UiharuMind.App.Tests.* 全限定名,与主程序集内的 App 类型同名 -->
    <NoWarn>$(NoWarn);MAAI001;CS0435</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- App 项目本体。这里只测不碰 UI 线程/渲染的纯装配逻辑，
         因此不需要初始化 Avalonia 应用（条目类型的 Avalonia 依赖只要程序集可加载即可）。 -->
    <ProjectReference Include="..\UiharuMind\UiharuMind.csproj" />
  </ItemGroup>

</Project>
