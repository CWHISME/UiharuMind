<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- MAAI001: Microsoft.Agents.AI Harness 面为 Experimental API -->
        <NoWarn>$(NoWarn);MAAI001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="AngleSharp" Version="1.5.2" />
      <!-- tiktoken o200k 词表数据:Microsoft.ML.Tokenizers 本体已由 Agents.AI 传递引入 -->
      <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="6.0.0" />
      <PackageReference Include="CliWrap" Version="3.8.1" />
      <PackageReference Include="Downloader" Version="3.3.3" />
      <PackageReference Include="Glacier.Grep" Version="1.0.0" />
      <PackageReference Include="LLamaSharp" Version="0.27.0" />
      <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
      <PackageReference Include="Markdown.ColorCode" Version="3.0.0" />
      <PackageReference Include="Meziantou.Framework.Globbing" Version="4.0.0" />
      <!-- Agent Framework 面(含 preview/alpha 包)只挡编译期外流:UI 层若直接引用其类型将变成编译错误,
           迫使一切经 ICharacterRunner 收口。
           必须是 compile 而非 all —— all 会连 runtime 资产一起挡掉,
           导致这些包及其传递依赖(如 ModelContextProtocol.Core)不进 app head 输出目录,运行时抛 FileNotFoundException。
           后三项是 PrivateAssets 的默认值,显式写出以免被覆盖。
           Microsoft.Extensions.AI 是稳定的公共货币,完全不设限。 -->
      <PackageReference Include="Microsoft.Agents.AI" Version="1.13.0">
        <PrivateAssets>compile;contentfiles;analyzers;build</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.13.0-preview.260703.1">
        <PrivateAssets>compile;contentfiles;analyzers;build</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Agents.AI.Tools.Shell" Version="1.13.0-preview.260703.1">
        <PrivateAssets>compile;contentfiles;analyzers;build</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Agents.AI.Mcp" Version="1.13.0-alpha.260703.1">
        <PrivateAssets>compile;contentfiles;analyzers;build</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
      <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
      <PackageReference Include="Microsoft.SemanticKernel.Connectors.SqliteVec" Version="1.74.0-preview" />
      <PackageReference Include="ScreenCapture.NET.DX11" Version="3.0.0" />
      <PackageReference Include="SharpCompress" Version="0.49.1" />
      <PackageReference Include="SharpHook" Version="7.1.1" />
      <PackageReference Include="UTF.Unknown" Version="2.6.0" />
      <PackageReference Include="WebLookup" Version="0.2.1" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Resources\Assistant.json" />
      <EmbeddedResource Include="Resources\AssistantExplain.json" />
      <EmbeddedResource Include="Resources\AssistantSyntacticAnalysis.json" />
      <EmbeddedResource Include="Resources\ChainofThought.json" />
      <EmbeddedResource Include="Resources\Empty.json" />
      <EmbeddedResource Include="Resources\Roleplay_FirstPerson.json" />
      <EmbeddedResource Include="Resources\Roleplay_ThirdPerson.json" />
      <EmbeddedResource Include="Resources\SystemLanguage.json" />
      <EmbeddedResource Include="Resources\TranslatorAdvanced.json" />
      <EmbeddedResource Include="Resources\UserCard.json" />
      <EmbeddedResource Include="Resources\VisionOcr.json" />
      <EmbeddedResource Include="Resources\AssistantExpertQuote.json" />
      <EmbeddedResource Include="Resources\Vision.json" />
      <None Remove="Resources\UiharuKazari.json" />
      <EmbeddedResource Include="Resources\AssistantExpert.json" />
      <EmbeddedResource Include="Resources\UiharuKazari.json" />
      <None Remove="Resources\WorkspaceAgent.json" />
      <EmbeddedResource Include="Resources\WorkspaceAgent.json" />
      <None Remove="Resources\Translator.json" />
      <EmbeddedResource Include="Resources\Translator.json" />
      <None Remove="Resources\Help*.md" />
      <EmbeddedResource Include="Resources\Help*.md" />
    </ItemGroup>

</Project>
